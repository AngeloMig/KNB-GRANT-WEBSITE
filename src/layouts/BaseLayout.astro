---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
import { withBase } from '../utils/paths';
import archivoFont from '../assets/fonts/archivo-latin-variable.woff2?url';
import displayFont from '../assets/fonts/big-shoulders-display-latin-800.woff2?url';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; loader?: boolean; }
const { title = 'Grant Payad — Shopify, Webflow & WordPress Developer', description = 'Explore selected Shopify, Webflow, and WordPress projects by Grant Payad. Custom website development, platform migrations, integrations, and technical SEO.', image = '/social-preview.png', noindex = false, loader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: profile.fullName, alternateName: profile.name, jobTitle: profile.title, url: new URL(withBase('/'), Astro.site).href, sameAs: [profile.linkedin], knowsAbout: ['Shopify', 'Webflow', 'WordPress', 'Web Development', 'Technical SEO'] };
---
<!doctype html>
<html lang="en" id="top" data-loader={loader ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grant Payad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Grant Payad — Shopify, Webflow and WordPress Developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      // Hide reveal targets only when motion will run; show the intro loader once per session.
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        if (root.dataset.loader === 'true') {
          try { if (!sessionStorage.getItem('gp-intro')) root.classList.add('is-loading'); } catch (e) {}
        }
        setTimeout(function () {
          if (!root.dataset.motionReady) root.classList.remove('motion', 'is-loading');
        }, 6000);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <div class="page-shell"><Header /><main id="main"><slot /></main><Footer /></div>
    {loader && <div class="page-loader" aria-hidden="true"><div class="page-loader-top"><span>Grant Payad</span><span>Shopify · Webflow · WordPress</span></div><div class="page-loader-count">0</div></div>}
    <div class="view-cursor" aria-hidden="true">View <Arrow diagonal /></div>
  </body>
</html>
<script>
  const root = document.documentElement;
  root.dataset.motionReady = 'true';

  // Scroll reveals: [data-reveal] elements rise in once as they enter the viewport.
  const startReveals = () => {
    if (!root.classList.contains('motion')) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
  };

  // Intro loader: count to 100, lift the curtain, then start the reveals underneath it.
  const loader = document.querySelector<HTMLElement>('.page-loader');
  if (loader && root.classList.contains('is-loading')) {
    const count = loader.querySelector('.page-loader-count');
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1300);
      const eased = p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;
      if (count) count.textContent = String(Math.round(eased * 100));
      if (p < 1) { requestAnimationFrame(tick); return; }
      setTimeout(() => {
        loader.classList.add('is-lifting');
        setTimeout(startReveals, 350);
        setTimeout(() => {
          root.classList.remove('is-loading');
          try { sessionStorage.setItem('gp-intro', '1'); } catch {}
        }, 1000);
      }, 180);
    };
    requestAnimationFrame(tick);
  } else {
    startReveals();
  }

  // "View" cursor that follows the pointer over project cards (mouse and trackpad only).
  const cursor = document.querySelector<HTMLElement>('.view-cursor');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (cursor && finePointer && root.classList.contains('motion') && document.querySelector('.project-link')) {
    root.classList.add('has-view-cursor');
    const pos = { x: 0, y: 0, tx: 0, ty: 0 };
    let frame = 0;
    const follow = () => {
      pos.x += (pos.tx - pos.x) * 0.2;
      pos.y += (pos.ty - pos.y) * 0.2;
      cursor.style.transform = `translate3d(${pos.x.toFixed(1)}px, ${pos.y.toFixed(1)}px, 0)`;
      frame = Math.abs(pos.tx - pos.x) + Math.abs(pos.ty - pos.y) > 0.3 ? requestAnimationFrame(follow) : 0;
    };
    document.addEventListener('pointermove', (event) => {
      const overProject = !!(event.target as Element | null)?.closest?.('.project-link');
      if (overProject && !cursor.classList.contains('is-active')) { pos.x = event.clientX; pos.y = event.clientY; }
      pos.tx = event.clientX;
      pos.ty = event.clientY;
      cursor.classList.toggle('is-active', overProject);
      if (!frame) frame = requestAnimationFrame(follow);
    });
    document.addEventListener('pointerleave', () => cursor.classList.remove('is-active'));
  }
</script>
