---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
import { withBase } from '../utils/paths';
import archivoFont from '../assets/fonts/archivo-latin-variable.woff2?url';
import displayFont from '../assets/fonts/big-shoulders-display-latin-800.woff2?url';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; loader?: boolean; }
const { title = 'Grant Dev14 — Shopify, Webflow & WordPress Developer', description = 'Explore selected Shopify, Webflow, and WordPress projects by Grant Dev14. Custom website development, platform migrations, integrations, and technical SEO.', image = '/social-preview.png', noindex = false, loader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: profile.name, jobTitle: profile.title, url: new URL(withBase('/'), Astro.site).href, sameAs: [profile.linkedin], knowsAbout: ['Shopify', 'Webflow', 'WordPress', 'Web Development', 'Technical SEO'] };
---
<!doctype html>
<html lang="en" id="top" data-loader={loader ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grant Dev14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Grant Dev14 — Shopify, Webflow and WordPress Developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      // Hide reveal targets only when motion will run; show the intro loader once per session.
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        if (root.dataset.loader === 'true') {
          try { if (!sessionStorage.getItem('gp-intro')) root.classList.add('is-loading'); } catch (e) {}
        }
        setTimeout(function () {
          if (!root.dataset.motionReady) root.classList.remove('motion', 'is-loading');
        }, 6000);
      })();
    </script>
    <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
      // "Grow" page transition: a link to another page on this site opens it as a circle growing from
      // where it was clicked. Project pages keep their own transition (the card's picture morphs into the
      // page and back), so links into a project, and from a project back to the homepage, are left out.
      // Browsers without cross-page view transitions just load the page.
      (function () {
        var root = document.documentElement;
        var KEY = 'gp-vt-grow';
        var home = base.replace(/\/?$/, '/');
        var isProject = function (path) { return path.indexOf(home + 'work/') === 0; };
        var isHome = function (path) { return path === home || path === home + 'index.html'; };
        var link = function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || a.target === '_blank' || a.hasAttribute('download') || a.dataset.vt === 'none') return null;
          var url;
          try { url = new URL(a.href, location.href); } catch (err) { return null; }
          if (url.origin !== location.origin || url.pathname === location.pathname) return null;
          if (isProject(url.pathname) || (isProject(location.pathname) && isHome(url.pathname))) return null;
          return a;
        };
        document.addEventListener('click', function (e) {
          var a = link(e);
          if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var r = a.getBoundingClientRect();
          var x = e.clientX || r.left + r.width / 2;
          var y = e.clientY || r.top + r.height / 2;
          try { sessionStorage.setItem(KEY, JSON.stringify({ x: x / innerWidth, y: y / innerHeight, t: Date.now() })); } catch (err) {}
        }, true);
        window.addEventListener('pagereveal', function (e) {
          var raw = null;
          try { raw = sessionStorage.getItem(KEY); sessionStorage.removeItem(KEY); } catch (err) {}
          if (!raw || !e.viewTransition || !e.viewTransition.types) return;
          var o = JSON.parse(raw);
          if (Date.now() - o.t > 6000) return;
          var x = o.x * innerWidth, y = o.y * innerHeight;
          root.style.setProperty('--vt-x', x + 'px');
          root.style.setProperty('--vt-y', y + 'px');
          root.style.setProperty('--vt-r', Math.ceil(Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))) + 'px');
          e.viewTransition.types.add('grow');
          e.viewTransition.finished.finally(function () { ['--vt-x', '--vt-y', '--vt-r'].forEach(function (p) { root.style.removeProperty(p); }); });
        });
        // Start loading the page on hover or touch, so the transition starts the moment it's clicked.
        var warm = function (e) {
          var a = link(e);
          if (!a || a.dataset.warm) return;
          a.dataset.warm = '1';
          var l = document.createElement('link');
          l.rel = 'prefetch';
          l.href = a.href;
          document.head.appendChild(l);
        };
        ['pointerover', 'touchstart', 'focusin'].forEach(function (t) { document.addEventListener(t, warm, { passive: true }); });
      })();
    </script>
    <script type="speculationrules" is:inline>{"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"selector_matches":"[target=_blank], [download], [data-vt=none]"}}]},"eagerness":"moderate"}]}</script>
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <div class="page-shell"><Header /><main id="main"><slot /></main><Footer /></div>
    {loader && <div class="page-loader" aria-hidden="true"><div class="page-loader-top"><span>Grant Dev14</span><span>Shopify · Webflow · WordPress</span></div><svg class="page-loader-count" role="presentation"><text x="0" y="100%">0</text></svg></div>}
    <div class="view-cursor" aria-hidden="true">View <Arrow diagonal /></div>
  </body>
</html>
<script>
  import { captureSource } from '../scripts/lead-source';
  const root = document.documentElement;
  root.dataset.motionReady = 'true';
  // Remember how this visit started, for the lead emails.
  captureSource();

  // Headings marked data-lines reveal one line at a time (lines are split at <br>).
  if (root.classList.contains('motion')) {
    document.querySelectorAll<HTMLElement>('[data-lines]').forEach((el) => {
      const parts = el.innerHTML.split(/<br\s*\/?>/i);
      el.innerHTML = parts.map((part, i) => `<span class="line" style="--i:${i}"><span>${part.trim()}</span></span>`).join('');
    });
  }

  // Scroll reveals: [data-reveal] elements rise in once as they enter the viewport.
  const startReveals = () => {
    if (!root.classList.contains('motion')) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('[data-reveal]:not([data-reveal="load"])').forEach((el) => observer.observe(el));
  };

  startReveals();

  // Same-page links ("See my work", the review quote, back to top) glide with an eased scroll
  // instead of the browser's quick jump. A wheel, touch or key press takes over straight away.
  const glide = (top: number, done: () => void) => {
    const from = window.scrollY;
    const to = Math.max(0, Math.min(top, root.scrollHeight - window.innerHeight));
    const distance = to - from;
    if (!root.classList.contains('motion') || Math.abs(distance) < 4) { window.scrollTo({ top: to, behavior: 'instant' }); done(); return; }
    const duration = Math.min(1500, 650 + Math.abs(distance) * 0.22);
    const start = performance.now();
    let stopped = false;
    const stop = () => { stopped = true; };
    const events = ['wheel', 'touchstart', 'keydown'] as const;
    events.forEach((t) => window.addEventListener(t, stop, { passive: true, once: true }));
    root.style.scrollBehavior = 'auto';
    const finish = () => { root.style.scrollBehavior = ''; events.forEach((t) => window.removeEventListener(t, stop)); done(); };
    const step = (now: number) => {
      if (stopped) { finish(); return; }
      const p = Math.min(1, (now - start) / duration);
      const eased = p < 0.5 ? 4 * p * p * p : 1 - (-2 * p + 2) ** 3 / 2;
      window.scrollTo(0, from + distance * eased);
      if (p < 1) requestAnimationFrame(step); else finish();
    };
    requestAnimationFrame(step);
  };
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link || link.classList.contains('skip-link') || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname) return;
    const hash = url.hash;
    const target = hash === '#top' ? document.body : document.getElementById(decodeURIComponent(hash.slice(1)));
    if (!target || hash.length < 2) return;
    e.preventDefault();
    const offset = (parseFloat(getComputedStyle(root).scrollPaddingTop) || 0) + (parseFloat(getComputedStyle(target).scrollMarginTop) || 0);
    const top = target === document.body ? 0 : target.getBoundingClientRect().top + window.scrollY - offset;
    history.pushState(null, '', hash);
    glide(top, () => {
      // Keyboard users land on the section they asked for.
      if (e.detail === 0 && target !== document.body) {
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }
    });
  });

  // Intro loader: count to 100, then lift the curtain. The page underneath is already in place.
  const loader = document.querySelector<HTMLElement>('.page-loader');
  if (loader && root.classList.contains('is-loading')) {
    // SVG text, so the changing number is not treated as the page's main content (LCP).
    const count = loader.querySelector('.page-loader-count text');
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 750);
      const eased = p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;
      if (count) count.textContent = String(Math.round(eased * 100));
      if (p < 1) { requestAnimationFrame(tick); return; }
      setTimeout(() => {
        loader.classList.add('is-lifting');
        setTimeout(() => {
          root.classList.remove('is-loading');
          try { sessionStorage.setItem('gp-intro', '1'); } catch {}
        }, 750);
      }, 120);
    };
    requestAnimationFrame(tick);
  }

  // "View" cursor that follows the pointer over project cards (mouse and trackpad only).
  const cursor = document.querySelector<HTMLElement>('.view-cursor');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (cursor && finePointer && root.classList.contains('motion') && document.querySelector('.project-link')) {
    root.classList.add('has-view-cursor');
    const pos = { x: 0, y: 0 };
    const target = { x: -1, y: -1 };
    let visible = false;
    let frame = 0;
    let last = 0;

    // Frame-rate independent easing, so the circle trails the pointer by the same amount on any screen.
    const tick = (now: number) => {
      const dt = Math.min(64, now - last);
      last = now;
      const k = 1 - Math.exp(-dt / 60);
      pos.x += (target.x - pos.x) * k;
      pos.y += (target.y - pos.y) * k;
      cursor.style.transform = `translate3d(${pos.x.toFixed(2)}px, ${pos.y.toFixed(2)}px, 0)`;
      frame = visible ? requestAnimationFrame(tick) : 0;
    };
    const setVisible = (show: boolean) => {
      if (show === visible) return;
      visible = show;
      cursor.classList.toggle('is-active', show);
      root.classList.toggle('view-cursor-on', show);
      if (show && !frame) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    };
    // Over a card the circle shows; over the gaps between cards it keeps its state, so moving from card to card never flickers.
    const update = (under: Element | null) => {
      if (target.x < 0 || root.classList.contains('menu-open')) { setVisible(false); return; }
      if (under?.closest('.project-link')) {
        if (!visible) { pos.x = target.x; pos.y = target.y; }
        setVisible(true);
      } else if (!under?.closest('.project-grid')) {
        setVisible(false);
      }
    };
    document.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      target.x = event.clientX;
      target.y = event.clientY;
      update(event.target as Element | null);
    }, { passive: true });
    // Scrolling moves cards under a still pointer, so check what is underneath again.
    window.addEventListener('scroll', () => {
      if (target.x >= 0) update(document.elementFromPoint(target.x, target.y));
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => setVisible(false));
    window.addEventListener('blur', () => setVisible(false));
  }
</script>
