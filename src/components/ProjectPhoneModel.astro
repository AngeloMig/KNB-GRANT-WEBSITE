---
import type { Project } from '../data/projects';
import { withBase } from '../utils/paths';
interface Props { project: Project; index: number; }
const { project, index } = Astro.props;
const finish = ['silver', 'cosmic-orange', 'deep-blue'][index % 3];
---
<div class="detail-phone-model" data-detail-model data-model-url={withBase('/models/iphone-17-pro-max-orbit.glb')} data-finish={finish} data-project={JSON.stringify({ name: project.name, image: withBase(`/images/projects/${project.slug}-mobile-720.webp`), href: project.url, bg: project.mobileBar.bg, fg: project.mobileBar.fg })}>
  <div class="detail-phone-loading" role="status"><span class="sr-only">Loading interactive phone preview.</span></div>
  <canvas class="detail-phone-canvas" tabindex="0" role="img" aria-label={`Interactive 3D iPhone showing ${project.name}. Drag horizontally or use the left and right arrow keys to rotate. Home returns to the front.`}></canvas>
  <div class="detail-phone-controls" role="group" aria-label="Rotate 3D phone">
    <button type="button" data-turn="-1" aria-label="Rotate phone left">←</button>
    <button type="button" data-front>Front view</button>
    <button type="button" data-turn="1" aria-label="Rotate phone right">→</button>
  </div>
  <p class="detail-phone-credit">Model: <a href="https://sketchfab.com/3d-models/iphone-17-pro-max-87fc1df741384124a8ce0226d2b2058d" target="_blank" rel="noopener noreferrer">MajdyModels</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> · adapted</p>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('[data-detail-model]');
  const root = stage?.closest<HTMLElement>('.detail-canvas');
  if (stage && root) {
    let near = false, started = false;
    const start = async () => {
      if (started || !near || root.dataset.mode !== 'phone') return;
      started = true;
      root.dispatchEvent(new Event('project-phone-loading'));
      try {
        const { mountProjectPhone } = await import('../scripts/project-phone-scene');
        await mountProjectPhone(stage, root);
      } catch (error) {
        root.dispatchEvent(new Event('project-phone-error'));
        console.warn('The project preview is using its image fallback:', error);
      }
    };
    const visibility = new IntersectionObserver(([entry]) => { near = entry.isIntersecting; void start(); }, { rootMargin: '100px' });
    visibility.observe(root);
    const mode = new MutationObserver(() => void start());
    mode.observe(root, { attributes: true, attributeFilter: ['data-mode'] });
    addEventListener('pagehide', event => { if (!event.persisted) { visibility.disconnect(); mode.disconnect(); } });
  }
</script>

<style>
  .detail-phone-model{display:none;position:absolute;inset:0;z-index:1}
  :global(.detail-canvas[data-mode="phone"][data-phone-model="loading"]) .detail-phone-model,
  :global(.detail-canvas[data-mode="phone"][data-phone-model="ready"]) .detail-phone-model{display:block}
  .detail-phone-canvas{display:none;width:100%;height:100%;touch-action:pan-y;cursor:grab}
  .detail-phone-canvas:active{cursor:grabbing}
  .detail-phone-controls,.detail-phone-credit{display:none}
  :global([data-phone-model="ready"]) .detail-phone-canvas{display:block}
  :global([data-phone-model="ready"]) .detail-phone-controls{display:flex}
  :global([data-phone-model="ready"]) .detail-phone-credit{display:block}
  .detail-phone-loading{display:none;position:absolute;top:72px;left:50%;width:min(calc(100% - 64px),360px);aspect-ratio:440 / 956;transform:translateX(-50%);border:1px solid var(--rule);border-radius:17% / 8%;background:color-mix(in oklch,var(--ink) 3%,transparent);animation:detail-phone-pulse 1.8s ease-in-out infinite alternate}
  :global([data-phone-model="loading"]) .detail-phone-loading{display:block}
  @keyframes detail-phone-pulse{to{opacity:.35}}
  .detail-phone-controls{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);gap:8px;align-items:center;white-space:nowrap}
  .detail-phone-controls button{min-width:44px;min-height:44px;padding:4px 12px;background:var(--bg);color:var(--ink);border:1px solid var(--rule);border-radius:999px;font:inherit;font-size:12px;cursor:pointer}
  .detail-phone-credit{position:absolute;bottom:5px;left:8px;right:8px;margin:0;text-align:center;font-size:9px;line-height:1.3;color:var(--muted)}
  .detail-phone-credit a{text-underline-offset:2px}
  @media(max-width:640px){.detail-phone-loading{top:56px;width:min(calc(100% - 32px),300px)}}
  @media(prefers-reduced-motion:reduce){.detail-phone-loading{animation:none}}
</style>
