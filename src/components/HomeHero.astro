---
// The homepage first screen: "GRANT DEV14." drawn in dots, with the project orbit rising over it on
// a dotted track. On load the cards fan out from the front card and the dots settle into the name; whichever project is at the front gives the
// name, the header and the menu button a subtle shade of its colour. The cursor scatters the dots.
import { withBase } from '../utils/paths';
import Arrow from './Arrow.astro';
import ProjectOrbit from './ProjectOrbit.astro';
---
<section class="home-hero" aria-label="Introduction">
  <div class="wrap home-hero-top">
    <h1 class="tiny-heading">Shopify, Webflow & WordPress developer</h1>
    <div class="home-hero-name">
      <canvas class="home-hero-dots" role="img" aria-label="Grant Dev14."></canvas>
      <p class="home-hero-fallback display" aria-hidden="true">GRANT DEV14.</p>
    </div>
  </div>
  <div class="home-hero-stage">
    <canvas class="home-hero-track" aria-hidden="true"></canvas>
    <ProjectOrbit card="var(--hero-card)" />
    <span class="hero-cursor" aria-hidden="true"><span class="hero-cursor-drag">← Drag →</span><span class="hero-cursor-view">View ↗</span></span>
  </div>
  <div class="wrap home-hero-row">
    <p class="home-hero-lead">Thoughtful websites, built to work beautifully. I’m Grant: I turn designs into custom websites and ecommerce for brands and agencies.</p>
    <div class="home-hero-actions hero-actions">
      <a class="cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a>
      <a class="cta-ghost" href="#work">See my work</a>
    </div>
    <a class="intro-quote" href="#reviews"><span class="review-avatar" aria-hidden="true">C</span><span><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital · <u>Watch the video</u></small></span></a>
  </div>
  <noscript><style>.home-hero-fallback { visibility: visible !important; }</style></noscript>
</section>

<script>
  const root = document.documentElement;
  const motion = root.classList.contains('motion');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const ink = getComputedStyle(root).getPropertyValue('--ink').trim() || '#161616';
  const watch = (el: Element) => {
    const state = { on: false };
    new IntersectionObserver(([e]) => { state.on = e.isIntersecting; }, { threshold: 0 }).observe(el);
    return state;
  };

  // ── The orbit: once it's on screen it rises in and the cards fan out from behind the front
  // card, then it steps to the next project every few seconds. Drag or swipe with momentum; it settles on the nearest project. Arrows move one.
  class Orbit {
    rot = 0; front = -1;
    // A little extra turn and tilt while the page scrolls away from the hero (set by the hero).
    nudge = { rot: 0, tilt: 0 };
    // start: a card to open at the front, with no entrance (coming back from that project's page).
    constructor(el: HTMLElement, onFront: (card: HTMLElement) => void, introEl: HTMLElement = el, start = -1) {
      const ring = el.querySelector<HTMLElement>('.ob-ring')!;
      const spin = el.querySelector<HTMLElement>('.ob-spin')!;
      const cards = [...el.querySelectorAll<HTMLElement>('.ob-card')];
      const angles = cards.map((c) => Number(c.dataset.angle));
      const shades = cards.map((c) => c.querySelector<HTMLElement>('.ob-shade')!);
      const mirrors = [...el.querySelectorAll<HTMLElement>('.ob-mirror')];
      const phone3d = matchMedia('(max-width: 640px)').matches;
      // Last values written, so a frame only touches the DOM when something actually changed.
      let lastKey = '';
      const lastOpacity: string[] = [], lastShade: string[] = [], lastBlur: string[] = [];
      const captions = [...el.querySelectorAll<HTMLElement>('.ob-caption')];
      const step = 360 / cards.length;
      const seen = watch(el);
      if (!fine) el.classList.add('ob-touch');
      let vel = 0, dragging = false, lastX = 0, moved = 0, pausedUntil = 0, hover = false, next = 0, last = performance.now();
      // Dragging: where the finger has taken the ring (the ring follows it with light smoothing), and
      // recent positions, for the speed at the moment of letting go.
      let dragTo = 0;
      const samples: { t: number; r: number }[] = [];
      // Every turn is a timed tween (same speed on any screen refresh rate): gentle in, gentle out.
      const inOut = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
      const out = (t: number) => 1 - (1 - t) ** 3;
      let tween: { from: number; to: number; start: number; dur: number; ease: (t: number) => number } | null = null;
      const turnTo = (to: number, dur: number, ease = inOut) => {
        if (!motion) { this.rot = to; tween = null; return; }
        tween = { from: this.rot, to, start: performance.now(), dur, ease };
      };
      const nearest = () => Math.round(this.rot / step) * step;
      // The entrance: the ring rises from below, tipped back, and straightens up while the cards fan out
      // a little past their places and settle back (ease-out with a soft overshoot).
      const INTRO = 1900, RISE = 110, TILT = 16;
      const backOut = (t: number) => 1 + 2.2 * (t - 1) ** 3 + 1.2 * (t - 1) ** 2;
      let intro = motion && start < 0, introAt = 0, spread = intro ? 0 : 1, tilt = 0;
      if (start >= 0) { this.rot = -angles[start]; next = performance.now() + 3400; }
      const endIntro = () => { intro = false; spread = 1; tilt = 0; spin.style.setProperty('--spread', '1'); introEl.style.opacity = ''; introEl.style.translate = ''; introEl.style.scale = ''; introEl.style.willChange = ''; next = performance.now() + 3400; onFront(cards[this.front]); };
      // During the load animation the stage gets its own layer, so its fade and rise don't repaint the cards.
      if (intro) { introEl.style.opacity = '0'; introEl.style.translate = `0 ${RISE}px`; introEl.style.scale = '0.9'; introEl.style.willChange = 'opacity, translate, scale'; }
      const frame = () => {
        const time = performance.now(), dt = Math.min(3, (time - last) / 16.67);
        last = time;
        // Nothing to do while the hero is scrolled out of view.
        if (!seen.on) { requestAnimationFrame(frame); return; }
        if (intro) {
          if (!introAt) introAt = time;
          const t = Math.min(1, (time - introAt) / INTRO);
          const e = 1 - (1 - t) ** 4;
          spread = backOut(t);
          tilt = TILT * (1 - e);
          spin.style.setProperty('--spread', spread.toFixed(4));
          introEl.style.opacity = String(out(Math.min(1, t / 0.45)));
          introEl.style.translate = `0 ${(RISE * (1 - e)).toFixed(1)}px`;
          introEl.style.scale = (0.9 + 0.1 * e).toFixed(4);
          if (t >= 1) endIntro();
        } else if (dragging) {
          // Follow the finger, smoothed a little so uneven touch events don't make the ring jump.
          this.rot += (dragTo - this.rot) * (1 - 0.45 ** dt);
        } else {
          if (tween) {
            const t = Math.min(1, (time - tween.start) / tween.dur);
            this.rot = tween.from + (tween.to - tween.from) * tween.ease(t);
            if (t >= 1) tween = null;
          }
          else if (Math.abs(vel) > 0.08) { this.rot += vel * dt; vel *= 0.94 ** dt; }
          else if (Math.abs(this.rot - nearest()) > 0.05) { vel = 0; turnTo(nearest(), 700, out); }
          else if (motion && !hover && !document.hidden && time > Math.max(pausedUntil, next)) { turnTo(nearest() - step, 1400); next = time + 1400 + 3200; }
        }
        const turn = this.rot + this.nudge.rot;
        const key = `${turn.toFixed(3)}|${spread.toFixed(4)}|${this.nudge.tilt.toFixed(2)}`;
        if (key !== lastKey) {
          lastKey = key;
          spin.style.transform = `translateZ(calc(var(--r) * -1)) rotateX(${(tilt + this.nudge.tilt).toFixed(3)}deg) rotateY(${turn.toFixed(3)}deg)`;
          cards.forEach((card, i) => {
            const d = ((((angles[i] * spread + turn) % 360) + 540) % 360) - 180;
            const f = 1 - Math.abs(d) / 180;
            // Solid cards, dimmed with distance; the back half fades out. On load the other cards stay hidden
            // until they've fanned out clear of the front card (closer in, they'd cut across it).
            const fan = intro && i !== this.front ? Math.max(0, Math.min(1, (spread - 0.82) / 0.18)) : 1;
            const opacity = (Math.max(0, Math.min(1, (170 - Math.abs(d)) / 70)) * fan).toFixed(3);
            // On phones the card is a 3D phone: fading the card itself would flatten it, so its parts fade (--o).
            const shade = (0.38 * (1 - f ** 2) * (phone3d ? Number(opacity) : 1)).toFixed(3);
            if (opacity !== lastOpacity[i]) { if (phone3d) card.style.setProperty('--o', opacity); else card.style.opacity = opacity; mirrors[i].style.opacity = opacity; lastOpacity[i] = opacity; }
            // Depth: the side cards are a touch soft and the cards behind more so. Only three steps, so
            // the blur changes just as a card passes a step, not on every frame of a turn.
            // (Not on phones, where the cards are 3D phones: a blur would flatten them.)
            const blur = phone3d || Math.abs(d) < 25 ? '' : Math.abs(d) < 80 ? 'blur(0.6px)' : 'blur(1.8px)';
            if (blur !== lastBlur[i]) { card.style.filter = blur; lastBlur[i] = blur; }
            if (shade !== lastShade[i]) { shades[i].style.opacity = shade; lastShade[i] = shade; }
            const reachable = Math.abs(d) < step / 2;
            if (card.tabIndex !== (reachable ? 0 : -1)) { card.tabIndex = reachable ? 0 : -1; card.style.pointerEvents = reachable ? 'auto' : 'none'; }
          });
        }
        const now = ((Math.round(-this.rot / step) % cards.length) + cards.length) % cards.length;
        if (now !== this.front) {
          cards[this.front]?.classList.remove('is-front');
          this.front = now;
          cards[now].classList.add('is-front');
          captions.forEach((c, i) => c.classList.toggle('is-active', i === now));
          if (!intro) onFront(cards[now]);
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
      // A press becomes a drag only once it has moved a few pixels. Until then the pointer isn't captured,
      // so a plain click still reaches the card's link (a captured pointer sends the click to the ring).
      let pressed = false, pointer = 0;
      ring.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        // Stop the mouse press from starting a text selection, focusing the card or dragging its image.
        if (e.pointerType === 'mouse') e.preventDefault();
        if (intro) endIntro();
        pressed = true; pointer = e.pointerId; lastX = e.clientX; moved = 0; vel = 0; tween = null; dragTo = this.rot; samples.length = 0;
        getSelection()?.removeAllRanges();
      });
      ring.addEventListener('pointermove', (e) => {
        if (!pressed) return;
        // Let go outside the window, where the release wasn't seen: end the press.
        if (e.pointerType === 'mouse' && !e.buttons) { release(); return; }
        const dx = e.clientX - lastX; lastX = e.clientX; moved += Math.abs(dx);
        if (!dragging) {
          if (moved < 5) return;
          dragging = true;
          try { ring.setPointerCapture(pointer); } catch {}
          root.classList.add('is-orbit-dragging');
        }
        // A finger moves less far than a mouse for the same intent, so touch turns the ring a little more.
        dragTo += dx * (e.pointerType === 'mouse' ? 0.22 : 0.3);
        samples.push({ t: e.timeStamp, r: dragTo });
        while (samples.length > 2 && e.timeStamp - samples[0].t > 120) samples.shift();
      });
      const release = (e?: PointerEvent) => {
        if (!pressed) return;
        pressed = false;
        if (dragging) {
          // Letting go: the speed over the last tenth of a second carries the ring on, and it glides in
          // one movement to the card it would come to rest on (at most two cards further).
          const t = e?.timeStamp ?? performance.now(), first = samples[0], lastS = samples[samples.length - 1];
          const v = first && lastS && t - lastS.t < 80 && lastS.t - first.t > 8 ? (lastS.r - first.r) / (lastS.t - first.t) : 0;
          const home = Math.round(dragTo / step) * step;
          let target = Math.round((dragTo + v * 260) / step) * step;
          target = Math.max(home - step * 2, Math.min(home + step * 2, target));
          vel = 0;
          turnTo(target, 450 + Math.min(700, Math.abs(target - this.rot) * 9), out);
        }
        dragging = false; pausedUntil = performance.now() + 2500; root.classList.remove('is-orbit-dragging');
      };
      // On the window: before a drag starts the pointer isn't captured, so it may be let go anywhere.
      addEventListener('pointerup', release);
      addEventListener('pointercancel', release);
      ring.addEventListener('click', (e) => { if (moved > 6) e.preventDefault(); }, true);
      ring.addEventListener('pointerenter', () => { hover = true; });
      ring.addEventListener('pointerleave', () => { hover = false; });
      ring.addEventListener('focusin', () => { hover = true; });
      ring.addEventListener('focusout', () => { hover = false; });
      el.querySelectorAll<HTMLButtonElement>('.ob-arrow').forEach((b) => b.addEventListener('click', () => {
        if (intro) endIntro();
        vel = 0;
        // Quick clicks queue up: each one turns a further project from where the last was heading.
        const from = tween ? tween.to : nearest();
        turnTo(from - Number(b.dataset.dir) * step, 900);
        pausedUntil = performance.now() + 4000;
      }));
    }
  }

  // ── The dot name: the letters are sampled into dots. Each dot springs back home; the cursor pushes
  // dots away (on touch screens a ripple runs through every few seconds). The colour eases between shades.
  type Dot = { x: number; y: number; vx: number; vy: number; hx: number; hy: number; ox: number; oy: number; delay: number; dur: number; t: number; kicked: boolean };
  class DotName {
    ctx: CanvasRenderingContext2D;
    dots: Dot[] = [];
    W = 0; H = 0; gap = 6; px = -1e4; py = -1e4; awake = true;
    lch = [0.16, 0, 0]; lchTo: number[] | null = null; color = ink;
    seen: { on: boolean } = { on: false };
    // On load each dot starts somewhere random on the screen and flies home on a quick, timed ease. While
    // they fly, the dots are drawn on a temporary full-screen layer (the name's canvas can't draw outside itself).
    gliding = false; glideStart = 0; fly: HTMLCanvasElement | null = null; flyCtx: CanvasRenderingContext2D | null = null;
    flyLeft = 0; flyTop = 0; flyScroll = 0;
    // Once they've all landed, a ripple runs through the letters from left to right.
    waveAt = 0;
    // Screen areas the flying dots must stay behind (the orbit's cards), each with how visible it is.
    cover: () => { r: DOMRect; a: number }[] = () => [];
    constructor(public canvas: HTMLCanvasElement, public text: string, public ready: () => void) {
      this.ctx = canvas.getContext('2d')!;
      this.seen = watch(canvas);
      if (fine) {
        canvas.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); this.px = e.clientX - r.left; this.py = e.clientY - r.top; this.awake = true; });
        canvas.addEventListener('pointerleave', () => { this.px = this.py = -1e4; });
      } else if (motion) {
        (async () => { for (;;) { await sleep(2800); if (!this.seen.on || !this.dots.length) continue; const d = this.dots[(Math.random() * this.dots.length) | 0]; for (let k = 0; k < 24; k++) { this.px = d.hx + (k - 12) * 7; this.py = d.hy; this.awake = true; await sleep(16); } this.px = this.py = -1e4; } })();
      }
      const loop = () => {
        // Scrolled away mid-flight: land the dots at once.
        if (this.gliding && this.glideStart && !this.seen.on) this.endGlide();
        if (this.seen.on && this.awake) this.step();
        requestAnimationFrame(loop);
      };
      if (motion) requestAnimationFrame(loop);
      this.build();
      let width = innerWidth, timer = 0;
      addEventListener('resize', () => { clearTimeout(timer); timer = window.setTimeout(() => { if (Math.abs(innerWidth - width) > 40) { width = innerWidth; this.build(); } }, 250); });
    }
    async build() {
      await document.fonts.load('800 200px "Big Shoulders Display"');
      const r = this.canvas.getBoundingClientRect();
      this.W = Math.floor(r.width); this.H = Math.floor(r.height);
      if (!this.W || !this.H) return;
      const dpr = Math.min(2, devicePixelRatio || 1);
      this.canvas.width = this.W * dpr; this.canvas.height = this.H * dpr;
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const { W, H } = this;
      // Finer dots on phones, where the one-line name is small.
      this.gap = W < 500 ? 3 : W < 640 ? 4 : W < 1100 ? 5 : 6;
      const off = document.createElement('canvas'); off.width = W; off.height = H;
      const o = off.getContext('2d')!;
      // Always one line, sized to fit the width.
      const lines = [this.text];
      let size = (H / lines.length) * 1.12;
      o.font = `800 ${size}px "Big Shoulders Display"`;
      const widest = Math.max(...lines.map((l) => o.measureText(l).width));
      size = Math.min(size, (size * W * 0.98) / widest);
      o.font = `800 ${size}px "Big Shoulders Display"`;
      o.textAlign = 'center'; o.textBaseline = 'middle';
      lines.forEach((l, i) => o.fillText(l, W / 2, (H * (i + 0.5)) / lines.length + size * 0.04));
      const data = o.getImageData(0, 0, W, H).data;
      const gap = this.gap;
      // The first time (with motion on), each dot starts at a random point on the screen.
      const scatter = motion && !this.dots.length;
      this.gliding = scatter;
      if (scatter) this.makeFly();
      this.dots = [];
      for (let y = gap / 2; y < H; y += gap) for (let x = gap / 2; x < W; x += gap) {
        if (data[((y | 0) * W + (x | 0)) * 4 + 3] > 128) {
          // Offsets from home to a random point anywhere in the viewport.
          const ox = scatter ? Math.random() * innerWidth - (r.left + x) : 0, oy = scatter ? Math.random() * innerHeight - (r.top + y) : 0;
          // Each dot has its own timing: most leave straight away, some wait; some are quick, some slow.
          this.dots.push({ hx: x, hy: y, x: x + ox, y: y + oy, vx: 0, vy: 0, ox, oy, delay: Math.random() ** 1.7 * 850, dur: 500 + Math.random() * 750, t: 0, kicked: !scatter });
        }
      }
      this.awake = true;
      this.draw();
      this.ready();
    }
    // Ease the dot colour to a new oklch colour (hue takes the short way round).
    tint(l: number, c: number, h: number) {
      if (!this.lch[1]) this.lch[2] = h;
      if (!motion) { this.lch = [l, c, h]; this.color = `oklch(${l} ${c} ${h})`; this.draw(); return; }
      this.lchTo = [l, c, h];
      this.awake = true;
    }
    step() {
      let moving = 0;
      if (this.gliding) {
        const now = performance.now();
        if (!this.glideStart) {
          this.glideStart = now;
          const r = this.canvas.getBoundingClientRect();
          this.flyLeft = r.left; this.flyTop = r.top; this.flyScroll = scrollY;
        }
        const T = now - this.glideStart;
        let done = true;
        for (const d of this.dots) {
          const t = Math.min(1, Math.max(0, (T - d.delay) / d.dur));
          // Ease-out (expo): most of the way in an instant, then a soft landing.
          const left = t >= 1 ? 0 : 2 ** (-10 * t);
          d.x = d.hx + d.ox * left; d.y = d.hy + d.oy * left; d.t = t;
          if (t < 1) done = false;
        }
        this.stepTint();
        if (done) { this.endGlide(); this.waveAt = now; } else this.draw();
        return;
      }
      moving = this.stepTint();
      const R = 110;
      // The landing ripple: each dot gets a small kick upwards as the wave passes it.
      const wave = this.waveAt ? (performance.now() - this.waveAt) / 520 : -1;
      if (wave > 1.2) this.waveAt = 0; else if (wave >= 0) moving = 1;
      for (const d of this.dots) {
        if (!d.kicked && d.hx / this.W <= wave) { d.kicked = true; d.vy -= 2.2 + Math.random() * 1.6; d.vx += (Math.random() - 0.5) * 1.2; }
        const dx = d.x - this.px, dy = d.y - this.py, dist = Math.hypot(dx, dy);
        if (dist < R && dist > 0.1) { const f = (1 - dist / R) * 3.6; d.vx += (dx / dist) * f; d.vy += (dy / dist) * f; }
        d.vx += (d.hx - d.x) * 0.05; d.vy += (d.hy - d.y) * 0.05;
        d.vx *= 0.82; d.vy *= 0.82;
        d.x += d.vx; d.y += d.vy;
        // Keep going until every dot is actually home, not just slow.
        moving = Math.max(moving, Math.abs(d.vx) + Math.abs(d.vy), (Math.abs(d.hx - d.x) + Math.abs(d.hy - d.y)) * 0.1);
      }
      this.draw();
      if (moving < 0.02 && this.px < -1e3) this.awake = false;
    }
    // Ease the colour one frame towards its target; returns 1 while it's still changing.
    stepTint() {
      if (this.lchTo) {
        const [l, c, h] = this.lch, [tl, tc, th] = this.lchTo;
        const dh = ((th - h + 540) % 360) - 180;
        this.lch = [l + (tl - l) * 0.035, c + (tc - c) * 0.035, (h + dh * 0.035 + 360) % 360];
        this.color = `oklch(${this.lch[0].toFixed(3)} ${this.lch[1].toFixed(3)} ${this.lch[2].toFixed(1)})`;
        if (Math.abs(tl - l) + Math.abs(tc - c) + Math.abs(dh) / 360 < 0.002) { this.lch = [...this.lchTo]; this.lchTo = null; }
        return 1;
      }
      return 0;
    }
    makeFly() {
      const fly = document.createElement('canvas');
      fly.setAttribute('aria-hidden', 'true');
      fly.style.cssText = `position:fixed;inset:0;width:${innerWidth}px;height:${innerHeight}px;pointer-events:none;z-index:20`;
      // Small dots in motion don't need retina sharpness, and this layer covers the whole screen.
      const dpr = 1;
      fly.width = innerWidth * dpr; fly.height = innerHeight * dpr;
      this.flyCtx = fly.getContext('2d')!;
      this.flyCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      document.body.append(fly);
      this.fly = fly;
    }
    endGlide() {
      for (const d of this.dots) { d.x = d.hx; d.y = d.hy; }
      this.gliding = false;
      this.fly?.remove();
      this.fly = this.flyCtx = null;
      this.draw();
    }
    draw() {
      const { ctx } = this;
      ctx.clearRect(0, 0, this.W, this.H);
      if (this.gliding) {
        // In flight: draw on the full-screen layer, at each dot's place relative to the name.
        const f = this.flyCtx;
        if (!f || !this.glideStart) return;
        f.clearRect(0, 0, innerWidth, innerHeight);
        const left = this.flyLeft, top = this.flyTop - (scrollY - this.flyScroll), rad = this.gap * 0.36, path = new Path2D();
        // Tiny squares while flying: far cheaper to draw than circles, and the same at this size and speed.
        const side = rad * 1.8;
        // Dots still flying glow in the project's colour; the ones that have landed take the name's colour.
        const landed = new Path2D();
        for (const d of this.dots) (d.t >= 1 ? landed : path).rect(left + d.x - side / 2, top + d.y - side / 2, side, side);
        f.fillStyle = this.lch[1] > 0.01 ? `oklch(0.62 0.16 ${this.lch[2].toFixed(1)})` : this.color; f.fill(path);
        f.fillStyle = this.color; f.fill(landed);
        // The orbit stays in front: rub the dots out where a card is, as much as the card is showing.
        f.globalCompositeOperation = 'destination-out';
        for (const { r: c, a } of this.cover()) {
          if (a <= 0.01) continue;
          f.fillStyle = `rgba(0,0,0,${Math.min(1, a).toFixed(3)})`;
          f.beginPath(); f.roundRect(c.left, c.top, c.width, c.height, 12); f.fill();
        }
        f.globalCompositeOperation = 'source-over';
        return;
      }
      const still = new Path2D(), moved = new Path2D();
      const rad = this.gap * 0.36;
      for (const d of this.dots) {
        const p = Math.abs(d.x - d.hx) + Math.abs(d.y - d.hy) > 2 ? moved : still;
        p.moveTo(d.x + rad, d.y); p.arc(d.x, d.y, rad, 0, 6.2832);
      }
      ctx.fillStyle = this.color; ctx.fill(still);
      // Dots on the move light up in the project's colour (grey until a project has set one).
      ctx.fillStyle = this.lch[1] > 0.01 ? `oklch(0.6 0.14 ${this.lch[2].toFixed(1)})` : 'oklch(0.55 0 0)'; ctx.fill(moved);
    }
  }

  const hero = document.querySelector<HTMLElement>('.home-hero');
  if (hero) {
    const fallback = hero.querySelector<HTMLElement>('.home-hero-fallback')!;
    const name = new DotName(hero.querySelector('.home-hero-dots')!, 'GRANT DEV14.', () => { fallback.hidden = true; });
    const stage = hero.querySelector<HTMLElement>('.home-hero-stage')!;
    const track = hero.querySelector<HTMLCanvasElement>('.home-hero-track')!;
    const tctx = track.getContext('2d')!;
    let hue = '60';
    const ob = hero.querySelector<HTMLElement>('.ob')!;
    const obCards = [...ob.querySelectorAll<HTMLElement>('.ob-card')];
    const stageEl = hero.querySelector<HTMLElement>('.home-hero-stage')!;
    const obFoot = ob.querySelector<HTMLElement>('.ob-foot')!;
    // The name takes the first project's colour from the start, so the dots fly in already glowing in it.
    name.tint(0.33, 0.07, Number(obCards[0].dataset.hue));
    name.cover = () => {
      const base = Number(stageEl.style.opacity || 1);
      return [...obCards.map((c) => ({ r: c.getBoundingClientRect(), a: base * Number(c.style.opacity || 1) })), { r: obFoot.getBoundingClientRect(), a: base }];
    };
    // Swap in a card's tall full-page screenshot once it's at the front (decoded first, so no flash).
    const loadFull = (card: HTMLElement) => {
      const img = card.querySelector<HTMLImageElement>('img[data-full]');
      // Phones show the mobile screenshot, which doesn't scroll, so the tall desktop one isn't needed.
      if (!img || img.dataset.loaded || matchMedia('(max-width: 640px)').matches) return;
      img.dataset.loaded = 'true';
      const full = new Image();
      full.src = img.dataset.full!;
      full.decode().then(() => { img.src = full.src; img.height = 1807; }).catch(() => {});
    };
    // ── Opening a project from the orbit: the front card grows into the project page, with the browser's
    // page transition (as the project grid's cards do). For the trip the card borrows the transition name
    // of the grid card for that project; coming back, the orbit opens on that project so the page shrinks
    // back into its card.
    const VT_KEY = 'gp-orbit-vt';
    const slugOf = (c: HTMLElement) => c.getAttribute('href')!.replace(/\/$/, '').split('/').pop()!;
    const borrow = (c: HTMLElement, on: boolean) => {
      const name = `project-${slugOf(c)}`;
      const grid = [...document.querySelectorAll<HTMLElement>('.project-grid [style*="view-transition-name"]')].find((el) => el.style.viewTransitionName === name || el.dataset.vt === name);
      c.style.viewTransitionName = on ? name : '';
      if (grid) { grid.dataset.vt = name; grid.style.viewTransitionName = on ? 'none' : name; }
    };
    let start = -1, lent: HTMLElement | null = null;
    try {
      const saved = JSON.parse(sessionStorage.getItem(VT_KEY) || 'null');
      sessionStorage.removeItem(VT_KEY);
      // The page we came from: on Back, only the Navigation API knows it (the referrer is the original one).
      const prev = (window as unknown as { navigation?: { activation?: { from?: { url?: string } } } }).navigation?.activation?.from?.url || document.referrer;
      const from = prev ? new URL(prev).pathname : '';
      if (saved && Date.now() - saved.t < 30 * 60e3 && !location.hash && from.endsWith(`/work/${saved.slug}/`)) start = obCards.findIndex((c) => slugOf(c) === saved.slug);
    } catch {}
    const giveBack = (c: HTMLElement) => setTimeout(() => { borrow(c, false); if (lent === c) lent = null; }, 1500);
    if (start >= 0) { lent = obCards[start]; borrow(lent, true); giveBack(lent); }
    obCards.forEach((c) => c.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || !c.classList.contains('is-front')) return;
      if (lent) borrow(lent, false);
      borrow(c, true); lent = c;
      try { sessionStorage.setItem(VT_KEY, JSON.stringify({ slug: slugOf(c), t: Date.now() })); } catch {}
    }));
    // Back from the project page out of the browser's page cache: the card still has the name, so the page
    // shrinks back into it; then the grid card gets its name back.
    addEventListener('pageshow', (e) => { if (e.persisted && lent) giveBack(lent); });

    const orbit = new Orbit(ob, (card) => {
      hue = card.dataset.hue!;
      loadFull(card);
      // Subtle: the name, the menu button and "Let's talk" take a deep shade of the project's colour,
      // and the header and hero a faint wash of it.
      name.tint(0.33, 0.07, Number(hue));
      root.classList.add('hero-tinted');
      root.style.setProperty('--hero-wash', `oklch(0.982 0.009 ${hue})`);
      root.style.setProperty('--hero-ink', `oklch(0.33 0.07 ${hue})`);
      root.style.setProperty('--hero-hue', hue);
    }, stageEl, start);

    // ── The front card tilts a little towards the cursor, with a soft light following it.
    if (fine && motion) {
      let box: DOMRect | null = null;
      const untilt = (c: HTMLElement) => { c.classList.remove('is-tilting'); c.style.removeProperty('--tx'); c.style.removeProperty('--ty'); box = null; };
      obCards.forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          if (!c.classList.contains('is-front') || root.classList.contains('is-orbit-dragging')) { if (c.classList.contains('is-tilting')) untilt(c); return; }
          // Measured once per visit, so the tilt doesn't feed back into the next reading.
          box ??= c.getBoundingClientRect();
          const x = Math.min(1, Math.max(0, (e.clientX - box.left) / box.width)), y = Math.min(1, Math.max(0, (e.clientY - box.top) / box.height));
          c.style.setProperty('--tx', `${((0.5 - y) * 8).toFixed(2)}deg`);
          c.style.setProperty('--ty', `${((x - 0.5) * 11).toFixed(2)}deg`);
          c.style.setProperty('--gx', `${(x * 100).toFixed(1)}%`);
          c.style.setProperty('--gy', `${(y * 100).toFixed(1)}%`);
          c.classList.add('is-tilting');
        });
        c.addEventListener('pointerleave', () => untilt(c));
        c.addEventListener('pointerdown', () => untilt(c));
      });
    }

    // ── Over the ring the cursor becomes a round label (mouse and trackpad only): "Drag" over the ring,
    // "View" over the front card, so visitors know they can spin it and open a project.
    const cursor = stage.querySelector<HTMLElement>('.hero-cursor')!;
    const obRing = ob.querySelector<HTMLElement>('.ob-ring')!;
    if (fine && motion) {
      const pos = { x: 0, y: 0 }, to = { x: 0, y: 0 };
      let following = false;
      const follow = () => {
        pos.x += (to.x - pos.x) * 0.22; pos.y += (to.y - pos.y) * 0.22;
        cursor.style.translate = `${pos.x.toFixed(1)}px ${pos.y.toFixed(1)}px`;
        if (following) requestAnimationFrame(follow);
      };
      const at = (e: PointerEvent) => { const r = stage.getBoundingClientRect(); to.x = e.clientX - r.left; to.y = e.clientY - r.top; };
      obRing.addEventListener('pointerenter', (e) => { at(e); pos.x = to.x; pos.y = to.y; following = true; hero.classList.add('has-cursor'); requestAnimationFrame(follow); });
      obRing.addEventListener('pointermove', (e) => { at(e); hero.classList.toggle('cursor-view', !!(e.target as HTMLElement).closest('.is-front') && !root.classList.contains('is-orbit-dragging')); });
      obRing.addEventListener('pointerleave', () => { following = false; hero.classList.remove('has-cursor', 'cursor-view'); });
      obRing.addEventListener('pointerdown', () => { hero.classList.add('cursor-down'); hero.classList.remove('cursor-view'); });
      addEventListener('pointerup', () => hero.classList.remove('cursor-down'));
    }

    // ── The dotted track: a ring of dots under the cards that turns with them; the dots under the
    // front card light up in its colour, and the cursor nudges them aside.
    const seen = watch(stage);
    const N = 150;
    const off = Array.from({ length: N }, () => ({ x: 0, y: 0, vx: 0, vy: 0 }));
    let px = -1e4, py = -1e4, W = 0, H = 0;
    const card = hero.querySelector<HTMLElement>('.ob-card')!;
    const ring = hero.querySelector<HTMLElement>('.ob-ring')!;
    // The ring's geometry, measured once (and again on resize) instead of every frame.
    let cw = 0, R = 0, cx = 0, horizon = 0, floor = 0, lastRot = NaN, heroH = 1;
    const size = () => {
      // Read every measurement first, then write, so the browser lays out the page only once.
      const r = track.getBoundingClientRect();
      const ringBox = ring.getBoundingClientRect();
      cw = card.offsetWidth; R = cw * 1.05;
      heroH = hero.offsetHeight;
      W = Math.floor(r.width); H = Math.floor(r.height);
      const dpr = Math.min(2, devicePixelRatio || 1);
      track.width = W * dpr; track.height = H * dpr;
      tctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = ringBox.left - r.left + ringBox.width / 2;
      horizon = ringBox.top - r.top + ringBox.height / 2;
      // Just under the cards' foot (on phones the cards are tall phone frames).
      floor = ringBox.top - r.top + card.offsetHeight + 16;
      lastRot = NaN;
    };
    requestAnimationFrame(size);
    addEventListener('resize', size);
    // ── Scrolling on from the hero turns the ring a little and tips it back.
    if (motion) addEventListener('scroll', () => {
      const p = Math.min(1, Math.max(0, scrollY / (heroH * 0.75)));
      orbit.nudge = { rot: p * 22, tilt: p * 12 };
    }, { passive: true });
    if (fine) {
      stage.addEventListener('pointermove', (e) => { const r = track.getBoundingClientRect(); px = e.clientX - r.left; py = e.clientY - r.top; });
      stage.addEventListener('pointerleave', () => { px = py = -1e4; });
    }
    let nudged = false;
    const draw = () => {
      // Redraw only while the ring turns, the cursor is near, or nudged dots are settling.
      const turn = orbit.rot + orbit.nudge.rot;
      if (seen.on && (turn !== lastRot || px > -1e3 || nudged || name.lchTo)) {
        lastRot = turn;
        nudged = false;
        const P = 1800;
        tctx.clearRect(0, 0, W, H);
        // A soft pool of the front project's colour on the floor, under its reflection.
        const glow = tctx.createRadialGradient(cx, floor, 0, cx, floor, cw * 0.85);
        glow.addColorStop(0, `oklch(0.78 0.11 ${name.lch[2].toFixed(1)} / 0.4)`);
        glow.addColorStop(1, `oklch(0.78 0.11 ${name.lch[2].toFixed(1)} / 0)`);
        tctx.save(); tctx.translate(cx, floor); tctx.scale(1, 0.2); tctx.translate(-cx, -floor);
        tctx.fillStyle = glow; tctx.fillRect(cx - cw, floor - cw, cw * 2, cw * 2);
        tctx.restore();
        for (let i = 0; i < N; i++) {
          const deg = (i / N) * 360 + turn;
          const a = deg * (Math.PI / 180);
          const k = P / (P - (Math.cos(a) * R - R));
          const o = off[i];
          let x = cx + Math.sin(a) * R * k, y = horizon + (floor - horizon) * k;
          const dx = x + o.x - px, dy = y + o.y - py, dist = Math.hypot(dx, dy);
          if (dist < 90 && dist > 0.1) { const f = (1 - dist / 90) * 4; o.vx += (dx / dist) * f; o.vy += (dy / dist) * f; }
          o.vx += -o.x * 0.07; o.vy += -o.y * 0.07; o.vx *= 0.8; o.vy *= 0.8; o.x += o.vx; o.y += o.vy;
          if (Math.abs(o.x) + Math.abs(o.y) > 0.05) nudged = true;
          x += o.x; y += o.y;
          const near = Math.abs((((deg % 360) + 540) % 360) - 180) < 22;
          tctx.beginPath();
          tctx.arc(x, y, (near ? 3.4 : 2) * k ** 1.5, 0, 6.2832);
          tctx.fillStyle = near ? `oklch(0.55 0.15 ${hue})` : `oklch(0.16 0 0 / ${Math.min(0.85, 0.25 + 0.7 * (k - 0.6)).toFixed(2)})`;
          tctx.fill();
        }
      }
      if (motion) requestAnimationFrame(draw);
    };
    // Without motion the ring is drawn once, after the cards are laid out.
    requestAnimationFrame(draw);
  }
</script>

<style>
  .home-hero { --hero-card: clamp(270px, 36vw, 600px); position: relative; overflow: hidden; padding-block: 0 64px; background-color: var(--hero-wash, var(--bg)); transition: background-color 1.4s var(--ease); }
  .home-hero-name { display: grid; margin-top: 18px; }
  .home-hero-name > * { grid-area: 1 / 1; }
  .home-hero-dots { display: block; width: 100%; height: clamp(160px, 20vw, 330px); touch-action: pan-y; }
  /* Shown only without JavaScript (the dots are drawn by script). */
  .home-hero-fallback { visibility: hidden; display: grid; place-items: center; margin: 0; font-size: clamp(90px, 19vw, 320px); line-height: 1; text-align: center; }
  /* The orbit rises over the bottom of the name. */
  .home-hero-stage { position: relative; z-index: 1; margin-top: calc(var(--hero-card) * -0.16); padding-bottom: 50px; }
  .home-hero-track { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .home-hero-stage :global(.ob) { position: relative; z-index: 1; }
  .home-hero-row { position: relative; z-index: 3; display: grid; grid-template-columns: 1.1fr auto auto; gap: 24px 32px; align-items: center; margin-top: 34px; }
  .home-hero-lead { max-width: 460px; font-size: 16px; line-height: 1.5; }
  .home-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .home-hero-row .intro-quote { margin: 0; }

  /* The entrance (in place of a loading screen): the header drops in, the small heading and the row under
     the orbit rise in one after another, while the dots fly into the name and the orbit comes up. */
  :global(html.motion .site-header .wordmark), :global(html.motion .site-header .header-contact) { animation: hero-drop 0.9s var(--ease) backwards; }
  :global(html.motion .site-header .header-contact) { animation-delay: 0.12s; }
  :global(html.motion) .home-hero .tiny-heading { animation: reveal-rise 0.9s var(--ease) 0.35s backwards; }
  :global(html.motion) .home-hero-row > * { animation: reveal-rise 1s var(--ease) backwards; }
  :global(html.motion) .home-hero-lead { animation-delay: 0.8s; }
  :global(html.motion) .home-hero-actions { animation-delay: 0.9s; }
  :global(html.motion) .home-hero-row .intro-quote { animation-delay: 1s; }
  @keyframes hero-drop { from { opacity: 0.01; transform: translateY(-22px); } }

  /* The round "Drag" / "View" label that stands in for the cursor over the ring. */
  .hero-cursor { position: absolute; z-index: 4; left: 0; top: 0; display: grid; place-items: center; width: 96px; height: 96px; margin: -48px 0 0 -48px; border-radius: 50%; background: var(--ink); color: var(--bg); font-size: 12.5px; font-weight: 500; white-space: nowrap; pointer-events: none; scale: 0; transition: scale 0.35s var(--ease), background-color 0.3s; }
  .hero-cursor > span { grid-area: 1 / 1; transition: opacity 0.25s, translate 0.35s var(--ease); }
  .hero-cursor-view { opacity: 0; translate: 0 6px; }
  .home-hero.has-cursor .hero-cursor { scale: 1; }
  .home-hero.has-cursor :global(.ob-ring), .home-hero.has-cursor :global(.ob-ring *) { cursor: none; }
  .home-hero.cursor-view .hero-cursor { background: var(--hero-ink, var(--ink)); }
  .home-hero.cursor-view .hero-cursor-drag { opacity: 0; translate: 0 -6px; }
  .home-hero.cursor-view .hero-cursor-view { opacity: 1; translate: none; }
  .home-hero.cursor-down .hero-cursor { scale: 0.82; }

  /* While the orbit is being dragged nothing on the page can be selected. */
  :global(html.is-orbit-dragging), :global(html.is-orbit-dragging *) { -webkit-user-select: none; user-select: none; cursor: grabbing; }
  /* The header shares the hero's wash (full width), and its menu button and "Let's talk" the deep shade. */
  :global(html.hero-tinted .site-header) { background: transparent; isolation: isolate; }
  :global(html.hero-tinted .site-header)::before { content: ''; position: absolute; z-index: -1; inset: 0 calc(50% - 50vw); background: var(--hero-wash); transition: background-color 1.4s var(--ease); }
  :global(html.hero-tinted .menu-toggle) { background-color: var(--hero-ink); transition: background-color 1.4s var(--ease), transform 0.3s var(--ease); }
  :global(html.hero-tinted .header-contact) { color: var(--hero-ink); transition: color 1.4s var(--ease); }

  /* Small laptops: the intro line gets its own row, with the buttons and the quote side by side below. */
  @media (max-width: 1180px) {
    .home-hero-row { grid-template-columns: auto 1fr; }
    .home-hero-lead { grid-column: 1 / -1; max-width: 620px; }
    .home-hero-row .intro-quote { justify-self: end; }
  }
  @media (max-width: 900px) {
    .home-hero-row { grid-template-columns: 1fr; }
    .home-hero-row .intro-quote { justify-self: start; }
  }
  /* Phones: the name on one line across the screen, and the orbit's phone-shaped cards a little
     bigger, rising over the bottom of the name. */
  @media (max-width: 640px) {
    .home-hero { --hero-card: 50vw; }
    .home-hero-dots { height: 23vw; }
    .home-hero-stage { margin-top: -7vw; }
  }
</style>
