---
import Arrow from './Arrow.astro';
import { profile } from '../data/profile';
import { withBase } from '../utils/paths';
const path = Astro.url.pathname;
// The header link fits the page: an invitation on project pages and About, and nothing on the
// estimator and contact pages, where the visitor is already there.
const cta = path === withBase('/estimate/') || path === withBase('/contact/') ? '' : path.startsWith(withBase('/work/')) ? 'Want one like this?' : path === withBase('/about/') ? 'Work with me' : 'Let’s talk';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
  <a class="wordmark" href={withBase('/')} aria-label="Grant Dev14 home"><span class="wordmark-line">Grant</span><span class="wordmark-line">Dev14<span class="wordmark-dot">.</span></span></a>
  <div class="header-right">
    {cta && <a class="header-contact" href={withBase('/contact/')}>{cta} <Arrow diagonal /></a>}
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-haspopup="dialog" aria-controls="site-menu"><span></span><span></span></button>
  </div>
</header>
<dialog id="site-menu" class="menu-dialog" aria-label="Main navigation">
  <div class="menu-top"><button type="button" class="menu-close" aria-label="Close navigation"><span></span><span></span></button></div>
  <span class="menu-handle" aria-hidden="true"></span>
  <div class="menu-preview" aria-hidden="true">
    <div class="menu-preview-set">{['tero', 'road-armor', 'omenz'].map((slug) => <img src={withBase(`/images/projects/${slug}-480.webp`)} alt="" width="480" height="270" loading="lazy" decoding="async" />)}</div>
    <div class="menu-preview-set"><p class="menu-preview-text">Hello,<br />I’m Grant.</p></div>
    <div class="menu-preview-set">{['coptrz', 'skinistry', 'light-my-bricks'].map((slug) => <img src={withBase(`/images/projects/${slug}-480.webp`)} alt="" width="480" height="270" loading="lazy" decoding="async" />)}</div>
    <div class="menu-preview-set"><p class="menu-preview-text">Plan<br />it.</p></div>
    <div class="menu-preview-set"><p class="menu-preview-text">Let’s<br />talk.</p></div>
    <div class="menu-preview-set"><p class="menu-preview-text">Free<br />audit.</p></div>
  </div>
  <nav class="menu-links" aria-label="Main">
    <a style="--i:0" href={withBase('/')} aria-current={path === withBase('/') ? 'page' : undefined}>Selected work <Arrow /></a>
    <a style="--i:1" href={withBase('/about/')} aria-current={path === withBase('/about/') ? 'page' : undefined} data-title><span class="menu-text">About Grant</span> <Arrow /></a>
    <a style="--i:2" href={withBase('/#services')} data-title data-section="services"><span class="menu-text">Services</span> <Arrow /></a>
    <a style="--i:3" href={withBase('/estimate/')} aria-current={path === withBase('/estimate/') ? 'page' : undefined} data-title><span class="menu-text">Estimate a project</span> <Arrow /></a>
    <a style="--i:4" href={withBase('/contact/')} aria-current={path === withBase('/contact/') ? 'page' : undefined} data-title><span class="menu-text">Get in touch</span> <Arrow /></a>
    <a style="--i:5" href={withBase('/contact/#audit')}>Free website audit <Arrow /></a>
  </nav>
  <div class="menu-bottom"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗︎</a></div>
</dialog>
<script>
  import { rememberFrom, replayTitle } from '../scripts/dot-title';
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const closeButton = document.querySelector<HTMLButtonElement>('.menu-close');
  if (dialog && toggle && closeButton) {
    const root = document.documentElement;
    const shell = document.querySelector<HTMLElement>('.page-shell');
    let closingTimer = 0;
    // Push-and-scale: freeze the page at screen size (keeping its scroll position inside it) so the
    // animation only moves one screen of content instead of the whole, very tall page.
    let frozenAt = -1;
    const freeze = () => {
      if (!shell || frozenAt >= 0) return;
      frozenAt = window.scrollY;
      shell.classList.add('is-frozen');
      shell.scrollTop = frozenAt;
    };
    const unfreeze = () => {
      if (!shell || frozenAt < 0) return;
      const top = frozenAt;
      frozenAt = -1;
      shell.classList.remove('is-frozen');
      window.scrollTo({ top, behavior: 'instant' });
    };
    // Phones: the menu button starts in the header and glides down to the bottom-right corner over the
    // first half-screen of scrolling. Only the button moves (once per frame, straight from the scroll
    // position, no transition), so it keeps up on iPhone; the close button takes the same spot.
    // It stays put while the menu is open.
    const phoneNav = matchMedia('(max-width: 640px)');
    const headerBar = document.querySelector<HTMLElement>('.site-header');
    // The bottom safe area (the iPhone home bar), read once from a probe.
    const probe = document.createElement('div');
    probe.style.cssText = 'position:fixed;visibility:hidden;pointer-events:none;padding-bottom:env(safe-area-inset-bottom)';
    document.body.append(probe);
    let gutter = 24, size = 49, safe = 0, queued = false;
    const measure = () => { gutter = headerBar ? parseFloat(getComputedStyle(headerBar).paddingRight) || 24 : 24; size = toggle.offsetHeight || 49; safe = parseFloat(getComputedStyle(probe).paddingBottom) || 0; };
    const placeButton = () => {
      queued = false;
      if (root.classList.contains('menu-open') || root.classList.contains('menu-closing') || shell?.classList.contains('is-frozen')) return;
      if (!phoneNav.matches) { toggle.style.transform = closeButton.style.transform = ''; return; }
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.5)));
      const e = p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;
      // From the header's corner (in line with the page edge) down to the bottom-right corner.
      const x = (16 - gutter) * (1 - e), y = (window.innerHeight - 24 - size - 14 - safe) * e;
      toggle.style.transform = closeButton.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
    };
    const queuePlace = () => { if (!queued) { queued = true; requestAnimationFrame(placeButton); } };
    measure();
    window.addEventListener('scroll', queuePlace, { passive: true });
    window.addEventListener('resize', () => { measure(); queuePlace(); });
    placeButton();
    toggle.addEventListener('click', () => {
      clearTimeout(closingTimer);
      root.classList.remove('menu-closing');
      freeze();
      dialog.showModal();
      root.classList.add('menu-open');
    });
    const close = () => dialog.close();
    closeButton.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    // A link to a page with a big title (About, Estimate, Get in touch): the title on that page is built
    // by dots flying out from where this link's text was (src/scripts/dot-title.ts).
    dialog.querySelectorAll<HTMLAnchorElement>('a[data-title]').forEach((link) => link.addEventListener('click', () => {
      if (link.getAttribute('aria-current')) return;
      rememberFrom(link.querySelector('.menu-text')!);
      // A title on this same page (Services, from the homepage): rebuild it once the page is back in place.
      if (link.dataset.section && new URL(link.href).pathname === location.pathname) setTimeout(() => replayTitle(link.dataset.section!), 0);
    }));
    // Following a link: put the page back instantly, so the browser jumps to the right place (e.g. #services).
    dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      if (shell) shell.style.transition = 'none';
      root.classList.remove('menu-open');
      unfreeze();
      close();
      requestAnimationFrame(() => { if (shell) shell.style.transition = ''; });
    }));
    // Link previews: hovering or focusing a menu link shows a collage for that page over the shrunk page.
    const sets = [...dialog.querySelectorAll<HTMLElement>('.menu-preview-set')];
    const showPreview = (index: number) => sets.forEach((set, i) => set.classList.toggle('is-active', i === index));
    dialog.querySelectorAll<HTMLAnchorElement>('.menu-links a').forEach((link, index) => {
      link.addEventListener('pointerenter', () => showPreview(index));
      link.addEventListener('focus', () => showPreview(index));
    });
    dialog.querySelector('.menu-links')?.addEventListener('pointerleave', () => showPreview(-1));
    dialog.addEventListener('close', () => showPreview(-1));
    dialog.addEventListener('close', () => {
      root.classList.remove('menu-open');
      root.classList.add('menu-closing');
      toggle.focus({ preventScroll: true });
      closingTimer = window.setTimeout(() => {
        root.classList.remove('menu-closing');
        unfreeze();
        placeButton();
      }, 800);
    });
    // Phones: swipe the menu down to close it. The links follow the finger a little, and spring back if
    // the swipe is short. (Touch events: the browser would take a pointer over for scrolling.)
    const phone = matchMedia('(max-width: 640px)');
    let startY = -1;
    dialog.addEventListener('touchstart', (e) => { if (phone.matches && e.touches.length === 1) { startY = e.touches[0].clientY; dialog.style.transition = 'none'; } }, { passive: true });
    dialog.addEventListener('touchmove', (e) => {
      if (startY < 0) return;
      const dy = Math.max(0, e.touches[0].clientY - startY);
      dialog.style.translate = `0 ${(dy * 0.55).toFixed(1)}px`;
      if (dy > 110) { startY = -1; dialog.style.transition = ''; dialog.style.translate = ''; close(); }
    }, { passive: true });
    const settle = () => { if (startY < 0) return; startY = -1; dialog.style.transition = ''; dialog.style.translate = ''; };
    dialog.addEventListener('touchend', settle);
    dialog.addEventListener('touchcancel', settle);

    // Keep the menu reachable once the header scrolls out of view.
    const header = document.querySelector('.site-header');
    if (header && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => toggle.classList.toggle('is-floating', !entry.isIntersecting)).observe(header);
    }
  }
</script>
