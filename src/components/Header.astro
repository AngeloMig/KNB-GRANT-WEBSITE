---
import Arrow from './Arrow.astro';
import { profile } from '../data/profile';
import { withBase } from '../utils/paths';
const path = Astro.url.pathname;
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
  <a class="wordmark" href={withBase('/')} aria-label="Grant Dev14 home"><span class="wordmark-line">Grant</span><span class="wordmark-line">Dev14<span class="wordmark-dot">.</span></span></a>
  <div class="header-right">
    <a class="header-contact" href={withBase('/contact/')}>Let’s talk <Arrow diagonal /></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-haspopup="dialog" aria-controls="site-menu"><span></span><span></span></button>
  </div>
</header>
<dialog id="site-menu" class="menu-dialog" aria-label="Main navigation">
  <div class="menu-top"><button type="button" class="menu-close" aria-label="Close navigation"><span></span><span></span></button></div>
  <div class="menu-preview" aria-hidden="true">
    <div class="menu-preview-set">{['road-armor', 'feedbird', 'omenz'].map((slug) => <img src={withBase(`/images/projects/${slug}-480.webp`)} alt="" width="480" height="270" loading="lazy" decoding="async" />)}</div>
    <div class="menu-preview-set"><p class="menu-preview-text">Hello,<br />I’m Grant.</p></div>
    <div class="menu-preview-set">{['coptrz', 'skinistry', 'light-my-bricks'].map((slug) => <img src={withBase(`/images/projects/${slug}-480.webp`)} alt="" width="480" height="270" loading="lazy" decoding="async" />)}</div>
    <div class="menu-preview-set"><p class="menu-preview-text">Plan<br />it.</p></div>
    <div class="menu-preview-set"><p class="menu-preview-text">Let’s<br />talk.</p></div>
    <div class="menu-preview-set"><p class="menu-preview-text">Free<br />audit.</p></div>
  </div>
  <nav class="menu-links" aria-label="Main">
    <a style="--i:0" href={withBase('/')} aria-current={path === withBase('/') ? 'page' : undefined}>Selected work <Arrow /></a>
    <a style="--i:1" href={withBase('/about/')} aria-current={path === withBase('/about/') ? 'page' : undefined}>About Grant <Arrow /></a>
    <a style="--i:2" href={withBase('/#services')}>Services <Arrow /></a>
    <a style="--i:3" href={withBase('/estimate/')} aria-current={path === withBase('/estimate/') ? 'page' : undefined}>Estimate a project <Arrow /></a>
    <a style="--i:4" href={withBase('/contact/')} aria-current={path === withBase('/contact/') ? 'page' : undefined}>Get in touch <Arrow /></a>
    <a style="--i:5" href={withBase('/contact/#audit')}>Free website audit <Arrow /></a>
  </nav>
  <div class="menu-bottom"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗︎</a></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const closeButton = document.querySelector<HTMLButtonElement>('.menu-close');
  if (dialog && toggle && closeButton) {
    const root = document.documentElement;
    const shell = document.querySelector<HTMLElement>('.page-shell');
    let closingTimer = 0;
    // Push-and-scale: freeze the page at screen size (keeping its scroll position inside it) so the
    // animation only moves one screen of content instead of the whole, very tall page.
    let frozenAt = -1;
    const freeze = () => {
      if (!shell || frozenAt >= 0) return;
      frozenAt = window.scrollY;
      shell.classList.add('is-frozen');
      shell.scrollTop = frozenAt;
    };
    const unfreeze = () => {
      if (!shell || frozenAt < 0) return;
      const top = frozenAt;
      frozenAt = -1;
      shell.classList.remove('is-frozen');
      window.scrollTo({ top, behavior: 'instant' });
    };
    toggle.addEventListener('click', () => {
      clearTimeout(closingTimer);
      root.classList.remove('menu-closing');
      freeze();
      dialog.showModal();
      root.classList.add('menu-open');
    });
    const close = () => dialog.close();
    closeButton.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    // Following a link: put the page back instantly, so the browser jumps to the right place (e.g. #services).
    dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      if (shell) shell.style.transition = 'none';
      root.classList.remove('menu-open');
      unfreeze();
      close();
      requestAnimationFrame(() => { if (shell) shell.style.transition = ''; });
    }));
    // Link previews: hovering or focusing a menu link shows a collage for that page over the shrunk page.
    const sets = [...dialog.querySelectorAll<HTMLElement>('.menu-preview-set')];
    const showPreview = (index: number) => sets.forEach((set, i) => set.classList.toggle('is-active', i === index));
    dialog.querySelectorAll<HTMLAnchorElement>('.menu-links a').forEach((link, index) => {
      link.addEventListener('pointerenter', () => showPreview(index));
      link.addEventListener('focus', () => showPreview(index));
    });
    dialog.querySelector('.menu-links')?.addEventListener('pointerleave', () => showPreview(-1));
    dialog.addEventListener('close', () => showPreview(-1));
    dialog.addEventListener('close', () => {
      root.classList.remove('menu-open');
      root.classList.add('menu-closing');
      toggle.focus({ preventScroll: true });
      closingTimer = window.setTimeout(() => {
        root.classList.remove('menu-closing');
        unfreeze();
      }, 800);
    });
    // Keep the menu reachable once the header scrolls out of view.
    const header = document.querySelector('.site-header');
    if (header && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => toggle.classList.toggle('is-floating', !entry.isIntersecting)).observe(header);
    }
  }
</script>
