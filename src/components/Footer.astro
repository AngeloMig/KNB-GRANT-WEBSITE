---
import { profile } from '../data/profile';
import { withBase } from '../utils/paths';
const footerLetters = [...'GRANT PAYAD'];
const pages = [['Selected work', '/'], ['About Grant', '/about/'], ['Services', '/#services'], ['Project estimator', '/estimate/'], ['Get in touch', '/contact/']];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-talk"><p class="footer-heading">Let’s talk.</p><a class="footer-mail" href={`mailto:${profile.email}`}>{profile.email}</a></div>
      <div class="footer-columns">
        <div><h2>Pages</h2><ul>{pages.map(([label, href]) => <li><a href={withBase(href)}>{label}</a></li>)}</ul></div>
        <div><h2>Connect</h2><ul><li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗︎</a></li><li><a href={withBase('/resume/grant-payad-resume.pdf')} download>Download résumé</a></li><li><a href={`mailto:${profile.email}`}>Email Grant</a></li></ul></div>
        <div><h2>Local time</h2><ul><li class="footer-clock">Manila, Philippines</li><li>Working across time zones</li></ul></div>
      </div>
    </div>
    <a class="footer-name" href={`mailto:${profile.email}`} aria-label="Email Grant Payad"><span class="footer-letters">{footerLetters.map((letter, index) => letter === ' ' ? <span class="footer-space">&nbsp;</span> : <span class="footer-letter" style={`--i:${index}`}>{letter}</span>)}</span><span class="footer-arrow">↗︎</span></a>
    <div class="footer-meta"><span>© {new Date().getFullYear()} Grant Payad</span><span>Built with care. Based in the Philippines.</span><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗︎</a><a href="#top">Back to top ↑︎</a></div>
  </div>
</footer>
<script>
  // Curtain reveal: the page slides up to uncover the footer. Only when the whole footer fits on screen,
  // otherwise its top would stay hidden behind the page.
  const siteFooter = document.querySelector<HTMLElement>('.site-footer');
  const updateReveal = () => {
    if (siteFooter) document.documentElement.classList.toggle('footer-reveal', siteFooter.offsetHeight <= window.innerHeight - 40);
  };
  updateReveal();
  window.addEventListener('resize', updateReveal);
  document.fonts?.ready.then(updateReveal);

  // Name cascade: GRANT PAYAD rises letter by letter once the curtain has uncovered it.
  const nameLink = document.querySelector<HTMLElement>('.footer-name');
  const pageMain = document.querySelector('main');
  if (nameLink && pageMain && document.documentElement.classList.contains('motion')) {
    nameLink.classList.add('is-waiting');
    let ticking = false;
    const check = () => {
      const box = nameLink.getBoundingClientRect();
      const line = box.top + box.height * 0.4;
      if (line > pageMain.getBoundingClientRect().bottom && line < window.innerHeight) {
        nameLink.classList.replace('is-waiting', 'is-cascading');
        window.removeEventListener('scroll', onScroll);
        window.setTimeout(() => nameLink.classList.remove('is-cascading'), 1800);
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; check(); });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    check();
  }

  // Live Manila time.
  const clock = document.querySelector('.footer-clock');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Manila' });
    const tick = () => { clock.textContent = `${format.format(new Date())} in Manila`; };
    tick();
    setInterval(tick, 30000);
  }

  const footerName = document.querySelector<HTMLElement>('.footer-name');
  const letterWrap = footerName?.querySelector<HTMLElement>('.footer-letters');
  const canAnimate = matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (footerName && letterWrap && canAnimate) {
    // Magnetic letters: each letter is pushed away from the pointer, then eases back into place.
    const letters = [...letterWrap.querySelectorAll<HTMLElement>('.footer-letter')].map((el) => ({ el, x: 0, y: 0, r: 0 }));
    const pointer = { x: 0, y: 0, active: false };
    let frame = 0;
    const step = () => {
      const size = letterWrap.offsetHeight;
      const radius = size * 1.7;
      let moving = pointer.active;
      for (const letter of letters) {
        let tx = 0, ty = 0, tr = 0;
        if (pointer.active) {
          const dx = letter.el.offsetLeft + letter.el.offsetWidth / 2 - pointer.x;
          const dy = letter.el.offsetTop + letter.el.offsetHeight / 2 - pointer.y;
          const distance = Math.hypot(dx, dy) || 1;
          const force = Math.max(0, 1 - distance / radius);
          const push = force * force * size * 0.55;
          tx = (dx / distance) * push;
          ty = (dy / distance) * push;
          tr = (dx / distance) * force * 16;
        }
        letter.x += (tx - letter.x) * 0.14;
        letter.y += (ty - letter.y) * 0.14;
        letter.r += (tr - letter.r) * 0.14;
        if (Math.abs(letter.x) + Math.abs(letter.y) + Math.abs(letter.r) > 0.05) moving = true;
        letter.el.style.transform = `translate(${letter.x.toFixed(2)}px, ${letter.y.toFixed(2)}px) rotate(${letter.r.toFixed(2)}deg)`;
      }
      if (moving) {
        frame = requestAnimationFrame(step);
      } else {
        frame = 0;
        letters.forEach((letter) => { letter.x = letter.y = letter.r = 0; letter.el.style.transform = ''; });
      }
    };
    footerName.addEventListener('pointermove', (event) => {
      const rect = letterWrap.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;
      pointer.active = true;
      if (!frame) frame = requestAnimationFrame(step);
    });
    footerName.addEventListener('pointerleave', () => { pointer.active = false; });
  }
</script>
