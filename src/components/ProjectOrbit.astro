---
// The homepage project orbit: every project as a browser card on a slowly turning 3D ring, with
// arrows and a caption for the card at the front. HomeHero.astro's script brings it to life.
// The front card swaps in the site's full-page screenshot (<slug>-full.webp), which scrolls on hover.
import fs from 'node:fs';
import { withBase } from '../utils/paths';
import Arrow from './Arrow.astro';
import { heroProjects as projects, canvasHues as hues } from '../data/projects';
interface Props { card?: string }
const { card = 'clamp(240px, 30vw, 460px)' } = Astro.props;
// On phones each card is drawn as one of three flagship phone designs, in turn round the ring (each
// with its own shape and camera, but no brand names or logos).
const phoneStyles = ['pro', 'ultra', 'visor'];
const host = (url: string) => new URL(url).hostname.replace('www.', '');
const hasFull = (slug: string) => fs.existsSync(`public/images/projects/${slug}-full.webp`);
// Each card's angle on the ring, signed so the cards can fan out both ways from the front card.
const step = 360 / projects.length;
const angle = (i: number) => (i <= projects.length / 2 ? i : i - projects.length) * step;
---
<div class="ob" data-model-load="fallback" style={`--card:${card};--r:calc(var(--card) * 1.05)`} data-orbit-model={withBase('/models/iphone-17-pro-max-orbit.glb')} data-orbit-projects={JSON.stringify(projects.map(p => ({ name: p.name, image: withBase(`/images/projects/${p.slug}-mobile-720.webp`), href: withBase(`/work/${p.slug}/`), bg: p.mobileBar.bg, fg: p.mobileBar.fg })))}>
  <script is:inline>
    // Run before the phones are parsed so the older design never flashes first.
    // This small watchdog also works if the main module cannot download or start.
    (() => {
      const root = document.currentScript.parentElement;
      const mobile = matchMedia('(max-width: 640px)');
      let timeout;
      let attempted = false;
      const settle = (state) => {
        clearTimeout(timeout);
        root.dataset.modelLoad = state;
        root.querySelector('.ob-ring')?.setAttribute('aria-busy', 'false');
        if (state === 'fallback') {
          root.classList.remove('ob-model-ready');
          const credit = root.querySelector('[data-model-credit]');
          if (credit) credit.setAttribute('aria-hidden', 'true');
        }
      };
      // The phone cards stay on screen while the 3D model loads in the background (HomeHero.astro
      // starts it after the page has opened), and it fades in over them once it's ready.
      const begin = () => {
        if (!mobile.matches || attempted) return;
        attempted = true;
        root.dataset.modelLoad = 'pending';
      };
      root.addEventListener('orbit-model-ready', () => settle('ready'));
      root.addEventListener('orbit-model-error', () => settle('fallback'));
      mobile.addEventListener('change', begin);
      begin();
      // The desktop cards also give feedback while their opening and first image prepare.
      if (!mobile.matches) {
        root.dataset.previewLoad = 'loading';
        const finish = () => {
          root.dataset.previewLoad = 'ready';
          root.querySelector('.ob-ring')?.setAttribute('aria-busy', 'false');
        };
        const safety = setTimeout(finish, 3500);
        root.addEventListener('orbit-preview-ready', () => {
          const image = root.querySelector('.ob-card.is-front img');
          const done = () => { clearTimeout(safety); finish(); };
          if (image) image.decode().then(done, done); else done();
        }, { once: true });
      }
    })();
  </script>
  <canvas class="ob-model-canvas" aria-hidden="true"></canvas>
  <div class="ob-loading" role="status" aria-live="polite">
    <span class="ob-loading-indicator"><span>Loading projects</span><span class="ob-loading-dots" aria-hidden="true"><i></i><i></i><i></i></span></span>
    <span class="ob-skeleton ob-skeleton-left" aria-hidden="true"></span>
    <span class="ob-skeleton ob-skeleton-center" aria-hidden="true"></span>
    <span class="ob-skeleton ob-skeleton-right" aria-hidden="true"></span>
  </div>
  <div class="ob-ring" aria-roledescription="carousel" aria-label="Projects">
    <div class="ob-spin">{projects.map((p, i) => (
      <a class="ob-card" href={withBase(`/work/${p.slug}/`)} style={`--a:${angle(i)}deg;--ph:${hues[p.canvas] ?? 0}`} data-phone={phoneStyles[i % phoneStyles.length]} data-angle={angle(i)} data-hue={hues[p.canvas] ?? 0} draggable="false">
        <span class="ob-bar" aria-hidden="true"><i></i><i></i><i></i><b>{host(p.url)}</b></span>
        <span class="ob-shade" aria-hidden="true"></span>
        <span class="ob-glare" aria-hidden="true"></span>
        {/* Phones only: the card is a 3D phone. Its body is a stack of rounded slices between the screen and
            the back, so the metal sides are solid all the way round (corners too), with buttons on both sides. */}
        <span class="ob-body" aria-hidden="true"><i style="--s:1"></i><i style="--s:2"></i><i style="--s:3"></i></span>
        <span class="ob-edge ob-edge-l" aria-hidden="true"></span><span class="ob-edge ob-edge-r" aria-hidden="true"></span>
        <span class="ob-back" aria-hidden="true"><span class="ob-cam"><i></i><i></i><i></i><i></i><b></b></span></span>
        {/* The light first-screen shot loads with the page; the tall full-page shot is swapped in later,
            on desktop hover (HomeHero.astro), so it never slows the first load.
            On phones the card is a phone showing the site's mobile screenshot instead. */}
        <span class="ob-shot"><picture><source media="(max-width: 640px)" srcset={`${withBase(`/images/projects/${p.slug}-mobile-220.webp`)} 220w, ${withBase(`/images/projects/${p.slug}-mobile-330.webp`)} 330w, ${withBase(`/images/projects/${p.slug}-mobile-440.webp`)} 440w, ${withBase(`/images/projects/${p.slug}-mobile-720.webp`)} 720w`} sizes="63vw" width="440" height="956" /><img src={withBase(`/images/projects/${p.slug}-640.webp`)} srcset={`${withBase(`/images/projects/${p.slug}-640.webp`)} 640w, ${withBase(`/images/projects/${p.slug}-960.webp`)} 960w, ${withBase(`/images/projects/${p.slug}-1440.webp`)} 1440w, ${withBase(`/images/projects/${p.slug}-1920.webp`)} 1920w`} sizes="(max-width: 640px) 63vw, min(45vw, 750px)" data-full={hasFull(p.slug) ? withBase(`/images/projects/${p.slug}-full.webp`) : undefined} alt={`${p.name} homepage`} width="640" height="360" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" draggable="false" /></picture></span>
      </a>
    ))}{projects.map((p, i) => (
      // Each card's reflection on the floor: it sits on the same spot of the ring, so it turns with it.
      <span class="ob-mirror" style={`--a:${angle(i)}deg`} aria-hidden="true"><picture><source media="(max-width: 640px)" srcset={withBase(`/images/projects/${p.slug}-mobile-220.webp`)} width="440" height="956" /><img src={withBase(`/images/projects/${p.slug}-640.webp`)} alt="" width="640" height="360" loading="lazy" decoding="async" draggable="false" /></picture></span>
    ))}</div>
  </div>
  <div class="ob-foot">
    <button type="button" class="ob-arrow" data-dir="-1" aria-label="Previous project">←</button>
    <div class="ob-captions" aria-live="polite">{projects.map((p, i) => <p class:list={['ob-caption', { 'is-active': i === 0 }]}><strong>{p.name}</strong><span>{p.platform} · {p.category}</span><a href={withBase(`/work/${p.slug}/`)}>View project <Arrow diagonal /></a></p>)}</div>
    <button type="button" class="ob-arrow" data-dir="1" aria-label="Next project">→</button>
  </div>
  <p class="ob-model-credit" aria-hidden="true" data-model-credit>3D model: <a href="https://sketchfab.com/3d-models/iphone-17-pro-max-87fc1df741384124a8ce0226d2b2058d" target="_blank" rel="noopener noreferrer">MajdyModels</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>. Geometry optimized; screens and finishes adapted.</p>
  <script is:inline>
    (() => {
      const root = document.currentScript.parentElement;
      root.querySelector('.ob-ring').setAttribute('aria-busy', String(root.dataset.modelLoad === 'loading' || root.dataset.previewLoad === 'loading'));
    })();
  </script>
</div>

<style>
  /* --ds: each card's depth size (set by the hero); --front-grow: the extra room the bigger front card needs below it. */
  .ob { position: relative; --front-grow: 0px; }
  .ob-model-canvas{display:none}
  .ob-model-credit{display:none}
  .ob-loading{display:none;position:absolute;inset:0 0 auto;height:calc(var(--card) * .66);pointer-events:none;z-index:3;color:var(--hero-ink,var(--ink))}
  .ob-loading-indicator{position:absolute;left:50%;top:calc(100% + 8px);transform:translateX(-50%);display:inline-flex;align-items:center;gap:9px;font-size:12px;line-height:1.5;white-space:nowrap}
  .ob-loading-dots{display:inline-flex;gap:3px}
  .ob-loading-dots i{width:3px;height:3px;border-radius:50%;background:currentColor;animation:ob-loading-dot 1.2s ease-in-out infinite;opacity:.3}
  .ob-loading-dots i:nth-child(2){animation-delay:.15s}
  .ob-loading-dots i:nth-child(3){animation-delay:.3s}
  @keyframes ob-loading-dot{50%{opacity:1}}
  .ob-skeleton{display:none}
  @media(min-width:641px){.ob[data-preview-load="loading"] .ob-loading{display:block}}
  .ob-ring { position: relative; height: calc(var(--card) * 0.66 + var(--front-grow)); perspective: 1800px; cursor: grab; touch-action: pan-y; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
  .ob-ring:active { cursor: grabbing; }
  .ob-spin { position: absolute; left: 50%; top: 0; width: var(--card); margin-left: calc(var(--card) / -2); transform-style: preserve-3d; will-change: transform; }
  /* No grey tap flash, long-press menu or image drag on the cards. */
  .ob-card, .ob-card img { -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; -webkit-user-drag: none; }
  .ob-card::selection, .ob-card *::selection { background: transparent; }
  /* The front card tilts towards the cursor (--tx, --ty), easing back when it leaves. */
  @property --tx { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @property --ty { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  /* Each card's depth size: not inherited, so changing it every frame of a turn restyles only the card, not all of its contents. */
  @property --ds { syntax: '<number>'; inherits: false; initial-value: 1; }
  .ob-card { position: absolute; inset: 0 0 auto; display: block; border-radius: 12px; overflow: hidden; background: var(--bg); box-shadow: 0 30px 60px oklch(0 0 0 / 0.22); transform: rotateY(calc(var(--a) * var(--spread, 1))) translateZ(var(--r)) rotateX(var(--tx)) rotateY(var(--ty)) scale(var(--ds, 1)); transition: --tx 0.7s var(--ease), --ty 0.7s var(--ease); -webkit-user-drag: none; }
  .ob-card:global(.is-tilting) { transition: --tx 0.15s linear, --ty 0.15s linear; }
  /* A soft light that follows the cursor across the tilted card. */
  .ob-glare { position: absolute; z-index: 3; inset: 0; background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), oklch(1 0 0 / 0.42), transparent 55%); mix-blend-mode: soft-light; opacity: 0; transition: opacity 0.5s; pointer-events: none; }
  .ob-card:global(.is-tilting) .ob-glare { opacity: 1; }
  /* The reflection: flipped under its card, fading out a short way down the floor. */
  .ob-mirror { position: absolute; left: 0; top: 0; width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; pointer-events: none; transform: rotateY(calc(var(--a) * var(--spread, 1))) translateZ(var(--r)) translateY(calc((24px + var(--card) * 0.5625) * (1 + var(--ds, 1)) / 2 + 10px * var(--ds, 1) + var(--card) * 0.5625 * (var(--ds, 1) - 1) / 2)) scale(var(--ds, 1)) scaleY(-1); -webkit-mask-image: linear-gradient(to top, rgb(0 0 0 / 0.3), transparent 38%); mask-image: linear-gradient(to top, rgb(0 0 0 / 0.3), transparent 38%); }
  .ob-mirror img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: bottom; filter: blur(1.5px); }
  /* Dims cards that are turned away (an overlay's opacity is cheap to animate, unlike a filter). */
  .ob-shade { position: absolute; z-index: 2; inset: 0; background: #000; opacity: 0; pointer-events: none; }
  .ob-bar { display: flex; align-items: center; gap: 5px; height: 24px; padding-inline: 10px; background: #f4f4f5; border-bottom: 1px solid #e4e4e7; }
  .ob-bar i { width: 7px; height: 7px; border-radius: 50%; background: #d4d4d8; }
  .ob-bar b { margin-inline: auto; padding: 2px 10px; border-radius: 5px; background: #e4e4e7; font-size: 10px; font-weight: 400; color: #52525b; }
  .ob-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; pointer-events: none; }
  /* Full-page screenshot in a 16:9 window: hovering the front card scrolls slowly down the site. */
  .ob-shot { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .ob-shot img { height: auto; aspect-ratio: auto; transition: transform 1.1s var(--ease); }
  .ob-card:global(.is-front):hover .ob-shot img { transform: translateY(calc(-100% + var(--card) * 0.5625)); transition: transform 16s cubic-bezier(0.37, 0, 0.63, 1); }
  .ob-card::after { content: 'Hover to scroll ↓'; position: absolute; right: 12px; bottom: 12px; padding: 5px 11px; border-radius: 99px; background: oklch(0.16 0 0 / 0.78); color: #fff; font-size: 11px; opacity: 0; transform: translateY(4px); transition: opacity 0.35s, transform 0.4s var(--ease); pointer-events: none; }
  .ob-card:global(.is-front)::after { opacity: 1; transform: none; transition-delay: 0.6s; }
  .ob-card:global(.is-front):hover::after { opacity: 0; transition-delay: 0s; }
  /* Touch screens can't hover: the front card scrolls down and back on its own, slowly. */
  :global(.ob-touch) .ob-card:global(.is-front) .ob-shot img { animation: ob-auto 16s 1.2s ease-in-out infinite alternate; }
  :global(.ob-touch) .ob-card::after { content: none; }
  /* Phones: each card is a phone showing the site's mobile screenshot (one screen, so no scrolling). */
  .ob-shot picture, .ob-mirror picture { display: contents; }
  .ob-edge, .ob-back, .ob-body { display: none; }
  @media (max-width: 640px) {
    .ob[data-model-load="loading"] .ob-spin{visibility:hidden;pointer-events:none}
    .ob[data-model-load="loading"] .ob-loading{display:block}
    .ob-loading{height:calc(var(--card) * 2.26)}
    .ob-loading-indicator{top:50%;transform:translate(-50%,-50%)}
    .ob-skeleton{display:block;position:absolute;left:50%;top:0;width:var(--card);height:calc(var(--card) * 2.16);margin-left:calc(var(--card) / -2);border:1px solid currentColor;border-radius:26px;background:color-mix(in oklch,currentColor 5%,var(--bg));opacity:.14}
    .ob-skeleton-left{transform:translateX(-82%) scale(.83) rotate(-9deg);transform-origin:50% 75%}
    .ob-skeleton-right{transform:translateX(82%) scale(.83) rotate(9deg);transform-origin:50% 75%}
    .ob-skeleton-center{animation:ob-loading-pulse 1.8s ease-in-out infinite alternate}
    @keyframes ob-loading-pulse{to{opacity:.28}}
    .ob-model-canvas{position:absolute;left:0;right:0;top:calc(-1 * var(--model-padding,0px));width:100%;height:var(--model-height,0px);pointer-events:none;z-index:2;opacity:0}
    .ob:global(.ob-model-ready) .ob-model-canvas{display:block;opacity:1;transition:opacity .6s}
    @starting-style { .ob:global(.ob-model-ready) .ob-model-canvas{opacity:0} }
    .ob:global(.ob-model-ready) .ob-card{opacity:0!important;transition:opacity .6s}
    .ob-model-credit{display:block;visibility:hidden;text-align:center;font-size:9px;line-height:1.5;color:var(--muted);margin:14px 24px 0}
    .ob:global(.ob-model-ready) .ob-model-credit{visibility:visible}
    .ob-ring { height: calc(var(--card) * 2.26 + var(--front-grow)); }
    /* A 3D phone: the screen on the front, a back 9px behind it, and metal sides joining them. */
    /* (The card itself paints nothing and isn't faded, which would flatten it: each part fades with --o.) */
    /* Depth in proportion to a large phone: about a tenth of its width. */
    .ob-card { --t: calc(var(--card) * 0.09); overflow: visible; transform-style: preserve-3d; border-radius: 26px; background: none; box-shadow: none; }
    .ob-shot, .ob-bar, .ob-shade, .ob-glare { -webkit-backface-visibility: hidden; backface-visibility: hidden; }
    .ob-shot, .ob-bar, .ob-edge, .ob-back, .ob-body i { opacity: var(--o, 1); }
    .ob-body { position: absolute; inset: 0; display: block; transform-style: preserve-3d; pointer-events: none; }
    .ob-body i { position: absolute; inset: 0; border-radius: 26px; background: #a3a5aa; box-shadow: inset 0 0 0 1.5px #6d6f74; transform: translateZ(calc(var(--t) * var(--s) / -4)); }
    .ob-shade, .ob-glare { border-radius: 26px; }
    /* The buttons, standing slightly proud of the sides: on the left the action button and the two
       volume buttons, on the right the side button and the camera button. */
    .ob-edge { position: absolute; top: 0; bottom: 0; display: block; width: calc(var(--t) * 0.5); background: linear-gradient(180deg, transparent 19%, #7b7d82 19% 23.5%, transparent 23.5% 27%, #7b7d82 27% 34%, transparent 34% 36.5%, #7b7d82 36.5% 43.5%, transparent 43.5%); border-radius: 2px; }
    .ob-edge-l { left: -1.5px; transform-origin: 0 50%; transform: translateZ(calc(var(--t) * -0.25)) rotateY(90deg) translateX(calc(var(--t) * -0.25)); }
    .ob-edge-r { right: -1.5px; transform-origin: 100% 50%; transform: translateZ(calc(var(--t) * -0.25)) rotateY(-90deg) translateX(calc(var(--t) * 0.25)); background: linear-gradient(180deg, transparent 26%, #7b7d82 26% 36%, transparent 36% 58%, #74767b 58% 66%, transparent 66%); }
    /* The back: matte glass in the project's colour, with a soft sheen and the metal rim. */
    .ob-back { position: absolute; inset: 0; display: block; border-radius: 26px; transform: translateZ(calc(var(--t) * -1)) rotateY(180deg); -webkit-backface-visibility: hidden; backface-visibility: hidden; background: linear-gradient(115deg, oklch(1 0 0 / 0.16), transparent 35% 70%, oklch(1 0 0 / 0.08)), radial-gradient(120% 80% at 30% 15%, oklch(0.56 0.06 var(--ph)), oklch(0.32 0.045 var(--ph)) 72%); box-shadow: inset 0 0 0 1.5px #6d6f74, inset 0 0 0 3.5px oklch(0.4 0.03 var(--ph)); }
    /* The camera block: a bar across the top with three lenses and a flash. */
    .ob-cam { position: absolute; left: 7%; right: 7%; top: 3.5%; height: 21%; border-radius: 20px; background: linear-gradient(160deg, oklch(0.42 0.05 var(--ph)), oklch(0.24 0.03 var(--ph))); box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.18), 0 4px 10px oklch(0 0 0 / 0.35); }
    .ob-cam i { position: absolute; width: 27%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #59606e 0 8%, #11131a 22%, #050608 60%, #2b2d33 62% 70%, #0b0c0f 72%); box-shadow: 0 0 0 2px oklch(0.6 0.02 var(--ph) / 0.6); }
    .ob-cam i:nth-child(1) { left: 6%; top: 6%; }
    .ob-cam i:nth-child(2) { left: 6%; bottom: 6%; }
    .ob-cam i:nth-child(3) { left: 36%; top: 50%; translate: 0 -50%; }
    .ob-cam i:nth-child(4) { display: none; }
    .ob-cam b { position: absolute; right: 12%; top: 50%; width: 9%; aspect-ratio: 1; translate: 0 -50%; border-radius: 50%; background: radial-gradient(circle, #fff7e0, #c9b98a 70%); }
    /* The browser bar becomes the phone's camera island. */
    .ob-bar { position: absolute; z-index: 3; left: 50%; top: 7px; width: 30%; height: 13px; padding: 0; translate: -50% 0; border: 0; border-radius: 99px; background: #0d0d0d; }
    .ob-bar > * { display: none; }
    /* Lighter on phones: no reflections (they're barely visible at this size, and costly to move). */
    .ob-mirror { display: none; }

    /* "Ultra" style: squarer corners, a small punch-hole camera, and a column of separate camera rings. */
    .ob-card[data-phone="ultra"] { border-radius: 12px; }
    .ob-card[data-phone="ultra"] .ob-shot, .ob-card[data-phone="ultra"] .ob-back, .ob-card[data-phone="ultra"] .ob-body i, .ob-card[data-phone="ultra"] .ob-shade, .ob-card[data-phone="ultra"] .ob-glare { border-radius: 12px; }
    .ob-card[data-phone="ultra"] .ob-shot { border-width: 4px; }
    .ob-card[data-phone="ultra"] .ob-body i { background: #7c7e84; box-shadow: inset 0 0 0 1.5px #4d4f54; }
    .ob-card[data-phone="ultra"] .ob-cam { left: 9%; right: auto; top: 3.5%; width: 26%; height: 50%; border-radius: 0; background: none; box-shadow: none; }
    .ob-card[data-phone="ultra"] .ob-cam i { display: block; left: 0; width: 92%; translate: none; box-shadow: 0 0 0 2.5px #2b2c30, 0 0 0 4px #85878c; }
    .ob-card[data-phone="ultra"] .ob-cam i:nth-child(1) { top: 0; }
    .ob-card[data-phone="ultra"] .ob-cam i:nth-child(2) { top: 26%; bottom: auto; }
    .ob-card[data-phone="ultra"] .ob-cam i:nth-child(3) { top: 52%; }
    .ob-card[data-phone="ultra"] .ob-cam i:nth-child(4) { top: 78%; width: 60%; left: 16%; }
    .ob-card[data-phone="ultra"] .ob-cam b { right: -110%; top: 14%; width: 30%; }

    /* "Visor" style: a punch-hole camera, and a camera bar right across the back. */
    .ob-card[data-phone="visor"] { border-radius: 22px; }
    .ob-card[data-phone="visor"] .ob-shot, .ob-card[data-phone="visor"] .ob-back, .ob-card[data-phone="visor"] .ob-body i, .ob-card[data-phone="visor"] .ob-shade, .ob-card[data-phone="visor"] .ob-glare { border-radius: 22px; }
    .ob-card[data-phone="visor"] .ob-cam { left: -1px; right: -1px; top: 15%; height: 11%; border-radius: 99px; background: linear-gradient(180deg, #2a2c31, #0d0e11); box-shadow: 0 3px 8px oklch(0 0 0 / 0.4), inset 0 1px 0 oklch(1 0 0 / 0.12); }
    .ob-card[data-phone="visor"] .ob-cam i { width: auto; height: 70%; top: 15%; translate: none; box-shadow: none; }
    .ob-card[data-phone="visor"] .ob-cam i:nth-child(1) { left: 12%; }
    .ob-card[data-phone="visor"] .ob-cam i:nth-child(2) { left: 26%; bottom: auto; }
    .ob-card[data-phone="visor"] .ob-cam i:nth-child(3) { left: 40%; }
    .ob-card[data-phone="visor"] .ob-cam b { right: 22%; width: 6%; }

    /* The punch-hole front camera (Ultra and Visor) instead of the pill island. */
    .ob-card[data-phone="ultra"] .ob-bar, .ob-card[data-phone="visor"] .ob-bar { top: 9px; width: 11px; height: 11px; }
    /* The screen, inside the phone's black bezel. */
