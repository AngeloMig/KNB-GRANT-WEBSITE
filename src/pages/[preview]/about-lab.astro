---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import CopyEmail from '../../components/CopyEmail.astro';
import CompanyLogo from '../../components/CompanyLogo.astro';
import { aboutIdeas } from '../../data/about-ideas';
import { experience, profile } from '../../data/profile';
import { services } from '../../data/services';
import { projects } from '../../data/projects';
import { withBase } from '../../utils/paths';
import '../../styles/about-lab.css';
export function getStaticPaths() { return import.meta.env.DEV ? [{params:{preview:'ideas'}}] : []; }
const examples = ['road-armor','teamtown','coptrz'].map(slug=>projects.find(p=>p.slug===slug)!);
const tools = [
  {name:'Build the website',items:['HTML','CSS','JavaScript','jQuery','PHP','Liquid','SASS','MySQL']},
  {name:'Choose the platform',items:['Shopify','Shopify Plus','Webflow','WordPress','WooCommerce','BigCommerce']},
  {name:'Design & connect',items:['Figma','GSAP','Adobe Photoshop','HubSpot','ActiveCampaign','Klaviyo']},
];
const process = [
  ['Understand','Start with the business, the people using the website and what needs to change.','Goals · Content · Scope'],
  ['Build','Turn the agreed design and requirements into working pages and features.','Structure · Development · Integrations'],
  ['Check','Review the website on different screen sizes and test the important customer journeys.','Phones · Forms · Checkout'],
  ['Handover','Review the finished work together and agree on launch and ongoing support.','Walkthrough · Launch · Next steps'],
];
---
<BaseLayout title="20 About Page Ideas | Grant Dev14" description="Local interactive comparison of twenty About page improvements." noindex>
  <div class="wrap al-root">
    <header class="al-intro"><a class="text-link" href={withBase('/about/')}>Current About page <Arrow diagonal /></a><div><h1 class="display">A little more Grant.</h1><p>Twenty ways to make the About page clearer, more personal and easier to explore. Compare one idea at a time.</p></div><p class="al-preview-note">Design preview · Suggested sections and sample wording are labelled. Choose a few to combine; the current About page is unchanged.</p></header>
    <div class="al-toolbar"><label>Choose an idea<select id="al-select">{aboutIdeas.map((idea,i)=><option value={i}>{String(i+1).padStart(2,'0')} — {idea.name}</option>)}</select></label><div class="al-step-controls"><button type="button" id="al-prev" aria-label="Previous idea"><span class="al-reverse"><Arrow /></span></button><span id="al-count" aria-hidden="true">01 / 20</span><button type="button" id="al-next" aria-label="Next idea"><Arrow /></button></div><button type="button" id="al-all" aria-pressed="false">Show all ideas</button><label class="al-pause"><input id="al-pause" type="checkbox" /> Pause motion</label></div>
    <div class="al-layout">
      <details class="al-directory" open><summary>Browse the 20 ideas</summary><nav aria-label="About page ideas"><ol>{aboutIdeas.map((idea,i)=><li><a href={`#about-idea-${i+1}`} data-al-select={i}><span>{String(i+1).padStart(2,'0')}</span><span>{idea.name}<small>{idea.kind}{'recommended' in idea && idea.recommended ? ' · Recommended' : ''}</small></span><i aria-hidden="true"></i></a></li>)}</ol></nav></details>
      <div class="al-stage" id="al-stage">
        {aboutIdeas.map((idea,i)=><section class="al-panel" id={`about-idea-${i+1}`} data-al-panel={i} aria-labelledby={`al-title-${i}`}>
          <header class="al-caption"><div><span>{String(i+1).padStart(2,'0')} / {idea.kind}</span><h2 id={`al-title-${i}`}>{idea.name}</h2></div>{'recommended' in idea && idea.recommended && <span class="al-recommended">Worth starting with</span>}</header>
          <div class:list={['al-demo',`al-demo-${i+1}`]}>
            {i===0 && <div class="al-editorial"><span class="al-side">Hello, I’m Grant.<br />Based in the Philippines.</span><div><h3>Thoughtful websites.<br /><em>Built to work.</em></h3><p>I build Shopify, Webflow and WordPress websites for brands and agencies, with care for the details people see and the structure behind them.</p><a class="al-link" href={withBase('/#work')}>Explore selected work <Arrow diagonal /></a></div><span class="al-word" aria-hidden="true">GRANT.</span></div>}
            {i===1 && <div class="al-portrait-layout"><div class="al-portrait" data-treatment="dots"><span class="display" aria-hidden="true">G.</span><p>Grant’s portrait goes here</p><small>Use a real, approved photo.</small></div><div><h3>The person<br />behind the build.</h3><p>A real portrait can bring warmth to the page while the type and thin rules keep it connected to the rest of the portfolio.</p><div class="al-options" data-local-options><button type="button" aria-pressed="true" data-portrait="dots">Dot treatment</button><button type="button" aria-pressed="false" data-portrait="plain">Clean frame</button></div></div></div>}
            {i===2 && <div><h3>Grant, at a glance.</h3><div class="al-facts">{[['Based in','Philippines','Working with brands and agencies across time zones.'],['Builds with','Shopify · Webflow · WordPress','Custom themes, migrations, integrations and technical SEO.'],['Experience includes','Development & team leadership','Hands-on website development, project coordination and quality assurance.']].map(([label,value,detail])=><details><summary><span>{label}</span><strong>{value}</strong><span aria-hidden="true">+</span></summary><p>{detail}</p></details>)}</div></div>}
            {i===3 && <div class="al-audience"><div class="al-options" data-local-options><button type="button" data-target="brand" aria-pressed="true">I’m a brand</button><button type="button" data-target="agency" aria-pressed="false">I’m an agency</button></div><div data-audience="brand"><h3>Your website.<br />A capable pair of hands.</h3><p>From a new storefront to everyday improvements, bring the design and the business needs together in a website that is easy to use.</p></div><div data-audience="agency" hidden><h3>Your design.<br />Thoughtfully developed.</h3><p>Shopify, Webflow and WordPress development, backed by experience working with agency teams and coordinating website projects.</p></div><a class="al-link" href={withBase('/contact/')}>Talk about the work <Arrow diagonal /></a></div>}
            {i===4 && <div class="al-platform"><div class="al-options" data-local-options>{services.slice(0,3).map((s,j)=><button type="button" data-platform={j} aria-pressed={j===0}>{s.short}</button>)}</div>{services.slice(0,3).map((s,j)=><div class="al-platform-body" data-platform-panel={j} hidden={j!==0}><div><h3>{s.name}</h3><p>{s.text}</p><a class="al-link" href={s.href}>Discuss your website <Arrow diagonal /></a></div><figure><img src={s.shots[0].src} alt={`${s.shots[0].name} website preview`} width="960" height="600" loading="lazy" decoding="async" /><figcaption><a class="al-link" href={s.shots[0].href}>{s.shots[0].name} <Arrow diagonal /></a><span>{[s.shots[0].engagement,s.shots[0].agency].filter(Boolean).join(" · ")}</span></figcaption></figure></div>)}</div>}
            {i===5 && <div><h3>Where I’ve worked.</h3><div class="al-career">{experience.map((item,j)=><details open={j===0}><summary><span>{item.dates}</span><strong>{item.company}</strong><span aria-hidden="true">+</span></summary><div><h4>{item.role}</h4><p>{item.summary}</p></div></details>)}</div></div>}
            {i===6 && <div class="al-proof-layout"><div><CompanyLogo name={experience[0].company} logo={experience[0].logo} size={40}/><h3>Development.<br />Within a team.</h3><p>{experience[0].summary}</p><small>{experience[0].role}<br />{experience[0].dates}</small></div><figure><img src={withBase('/images/projects/road-armor-960.webp')} alt="Road Armor website preview" width="960" height="600" loading="lazy" decoding="async"/><figcaption><a class="al-link" href={withBase('/work/road-armor/')}>Road Armor <Arrow diagonal /></a><span>Company project · Rivyl</span></figcaption></figure></div>}
            {i===7 && <div class="al-process"><p class="al-sample">Suggested process</p><h3>From a conversation<br />to a working website.</h3><div class="al-process-tabs" role="group" aria-label="Working process">{process.map(([label],j)=><button type="button" data-process={j} aria-pressed={j===0}><span>{String(j+1).padStart(2,'0')}</span>{label}</button>)}</div>{process.map(([label,copy,tags],j)=><div class="al-process-detail" data-process-panel={j} hidden={j!==0}><h4>{label}</h4><p>{copy}</p><small>{tags}</small></div>)}</div>}
            {i===8 && <div class="al-leadership"><h3>Hands on.<br />Team minded.</h3><p>Development experience alongside team leadership, project coordination and quality assurance.</p><div class="al-three">{[['Develop','Website development across Shopify, Webflow and WordPress.'],['Coordinate','Working with designers and developers to move projects through delivery.'],['Review','Quality assurance and attention to the details of a working website.']].map(([name,text])=><details><summary>{name}<span aria-hidden="true">+</span></summary><p>{text}</p></details>)}</div></div>}
            {i===9 && <div class="al-project-proof"><h3>Don’t just list it.<br />Show the work.</h3><div class="al-options" data-local-options>{examples.map((p,j)=><button type="button" data-proof={j} aria-pressed={j===0}>{p.platform}</button>)}</div>{examples.map((p,j)=><figure data-proof-panel={j} hidden={j!==0}><a href={withBase(`/work/${p.slug}/`)}><img src={withBase(`/images/projects/${p.slug}-960.webp`)} alt={`${p.name} website preview`} width="960" height="600" loading="lazy" decoding="async"/></a><figcaption><a class="al-link" href={withBase(`/work/${p.slug}/`)}>{p.name} <Arrow diagonal /></a><span>{[p.engagement,p.agency].filter(Boolean).join(' · ')}</span></figcaption></figure>)}</div>}
            {i===10 && <div class="al-foundations"><div><h3>The visible details.<br />The useful foundations.</h3><div class="al-options" data-local-options><button type="button" data-layer="front" aria-pressed="true">What people see</button><button type="button" data-layer="back" aria-pressed="false">What supports it</button></div></div><div class="al-layer" data-layer-panel="front"><span class="al-layer-title">A clear experience</span><h4>Find it. Read it.<br />Use it.</h4><p>Responsive layouts, clear navigation and considered interactions.</p></div><div class="al-layer al-layer-dark" data-layer-panel="back" hidden><span class="al-layer-title">A solid structure</span><h4>Built for<br />what comes next.</h4><p>Maintainable code, integrations, technical SEO and ongoing improvements.</p></div></div>}
            {i===11 && <div><h3>The right tools<br />for the work.</h3><div class="al-options" data-local-options>{tools.map((group,j)=><button type="button" data-tools={j} aria-pressed={j===0}>{group.name}</button>)}</div>{tools.map((group,j)=><ul class="al-tools" data-tools-panel={j} hidden={j!==0}>{group.items.map(tool=><li>{tool}</li>)}</ul>)}</div>}
            {i===12 && <div><h3>What do you<br />need help with?</h3><div class="al-plain-help">{[['“We’re moving to a new platform.”','Platform migrations, URL mapping, integrations and technical SEO.'],['“Our website needs to do more.”','Custom themes, new sections and third-party integrations.'],['“We need ongoing help.”','Monthly support for updates, fixes and website improvements.']].map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div><a class="al-link" href={withBase('/#services')}>Explore the services <Arrow diagonal /></a></div>}
            {i===13 && <div class="al-collaboration"><div><p class="al-sample">Illustrative notes</p><h3>A clearer picture<br />of the work.</h3><p>A small example can explain the working relationship better than another list of tools.</p><div class="al-options" data-local-options><button type="button" data-note="update" aria-pressed="true">Project update</button><button type="button" data-note="handover" aria-pressed="false">Handover</button></div></div><div class="al-note" data-note-panel="update"><span>Example · Project update</span><h4>Here’s where<br />things stand.</h4><dl><dt>Prepared</dt><dd>The new page layout is ready for review.</dd><dt>To check together</dt><dd>Content, images and the main enquiry form.</dd><dt>Next</dt><dd>Confirm feedback before preparing launch.</dd></dl></div><div class="al-note" data-note-panel="handover" hidden><span>Example · Handover note</span><h4>Ready for<br />your team.</h4><ul><li>Walk through the updated pages.</li><li>Explain how to update content.</li><li>Review the remaining priorities.</li></ul></div></div>}
            {i===14 && <div class="al-time"><div><h3>Based in the Philippines.<br />Connected across time zones.</h3><p>See the local time, then agree on working hours together.</p><label>Compare with<select id="al-city"><option value="Europe/London">London</option><option value="Australia/Sydney">Sydney</option><option value="America/New_York">New York</option></select></label></div><div class="al-clocks"><div><span>Manila</span><time data-zone="Asia/Manila">—</time><small>Grant’s local time</small></div><div><span id="al-city-name">London</span><time id="al-compare-time" data-zone="Europe/London">—</time><small id="al-city-date">Local time</small></div></div></div>}
            {i===15 && <div class="al-principles"><h3>Care, in the details.</h3><div class="al-principle-list">{[['Clear','A structure people can understand, with navigation that helps them find what matters.'],['Usable','A website that feels good to use across screen sizes and everyday customer journeys.'],['Maintainable','A foundation that can be updated and improved as the business changes.']].map(([label,text],j)=><button type="button" data-principle={j} aria-expanded={j===0}><span>{label}</span><small hidden={j!==0}>{text}</small><Arrow diagonal /></button>)}</div></div>}
            {i===16 && <div class="al-faq"><h3>A few things<br />you might ask.</h3>{[['Can you work from our design?','Grant works with brands and agencies to turn designs into responsive websites. Share the design and the scope through the contact page.'],['Can you help with an existing website?','Services include custom development, integrations, technical SEO and ongoing website improvements. The right approach depends on the existing site.'],['Do you offer ongoing support?','Yes. The support page compares 20, 40 and 80-hour monthly plans, plus a dedicated-developer option.']].map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div>}
            {i===17 && <div class="al-education"><span class="display">2019</span><div><h3>A foundation<br />in web development.</h3><p>BS Information Technology<br />Major in Web Development</p><details><summary>Bulacan State University <span aria-hidden="true">+</span></summary><p>The education section can sit alongside the career story, rather than becoming another large block at the end of the page.</p></details></div></div>}
            {i===18 && <div class="al-resume"><div class="al-resume-sheet"><span>Grant Dev14</span><h3>Website developer.<br />Team lead.</h3><p>Shopify · Webflow · WordPress</p><details><summary>Quick professional summary <span aria-hidden="true">+</span></summary><p>Custom themes, migrations, integrations and technical SEO, supported by development team leadership and project coordination.</p></details><span class="al-resume-rule" aria-hidden="true"></span></div><div><h3>Keep the<br />useful details.</h3><p>A clear résumé download for recruiters, agency leads and anyone who wants the professional summary in one place.</p><a class="al-button" href={withBase('/resume/grant-payad-resume.pdf')} download>Download résumé <Arrow diagonal /></a></div></div>}
            {i===19 && <div class="al-ending"><span class="al-ending-dot" aria-hidden="true"></span><h3>Good work starts<br />with a conversation.</h3><p>Have a website to build, improve or keep moving?</p><CopyEmail email={profile.email}/><div class="al-ending-links"><a class="al-link" href={withBase('/contact/')}>Tell me about it <Arrow diagonal /></a><a class="al-link" href={withBase('/#work')}>See the work <Arrow diagonal /></a></div></div>}
          </div>
          <footer class="al-explanation"><p><strong>Why it helps</strong>{idea.why}</p><p><strong>Try it</strong>{idea.try}</p><p class="al-source">{idea.status}</p></footer>
        </section>)}
      </div>
    </div>
    <p class="sr-only" id="al-announcement" role="status" aria-live="polite"></p>
  </div>
</BaseLayout>
<script>
  import { mountAboutLab } from '../../scripts/about-lab';
  const root=document.querySelector<HTMLElement>('.al-root'); if(root) mountAboutLab(root);
</script>
