---
// Design preview: 20 ideas for the navigation (header, menu and getting around). Local preview only:
// in a build this route has no pages. Open http://localhost:4321/ideas/nav/. Header ideas run inside
// small scrolling boxes with a mock header, so each can be tried on its own.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { projects, canvasHues } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Hide on scroll down'], [2, 'Sliding underline'], [3, 'Header that shrinks'], [4, '“Let’s talk” online dot'], [5, 'Header follows the section'], [6, 'Scroll progress line'], [7, 'Menu button morph'],
  [8, 'Menu links in dots'], [9, 'Preview per menu link'], [10, 'Numbers and counts'], [11, 'Links rise in'], [12, 'Latest project in the menu'], [13, 'Contact block in the menu'], [14, 'Circle reveal'], [15, 'Scrambled hover'],
  [16, 'Quick jump (⌘K)'], [17, 'Breadcrumb on project pages'], [18, 'Back-to-top pill'], [19, 'Section dots'], [20, 'Mobile bottom bar'],
] as const;
const GROUPS: Record<number, string> = { 1: 'Header', 8: 'Menu', 16: 'Getting around' };
const NOTES: Record<number, [string, string]> = {
  1: ['scroll inside the box', 'The header slides away while you scroll down to read, and comes back the moment you scroll up.'],
  2: ['hover the links', 'A line under the current page that slides to whichever link you point at.'],
  3: ['scroll inside the box', 'After the first screen the header becomes a slim bar with a soft background.'],
  4: ['live, from Manila time', 'A green dot beside “Let’s talk” during your working hours; outside them it says when you’re back.'],
  5: ['scroll inside the box', 'Over dark sections the header switches to light text, so it always reads.'],
  6: ['scroll inside the box', 'A thin line along the bottom of the header shows how far down the page you are.'],
  7: ['press it', 'The two lines turn into a cross with a small spin, and the button fills with the project colour.'],
  8: ['open it, then hover a link', 'In the menu, the link you point at is drawn big in dots beside the list.'],
  9: ['open it, then hover a link', 'Each link shows its own picture that follows the cursor.'],
  10: ['', 'Every link numbered, with a count where it helps: “Selected work (6)”.'],
  11: ['open and close it', 'Links rise in one by one from behind a mask when the menu opens, and drop away on close.'],
  12: ['', 'The newest project in the menu, so returning visitors see what’s new.'],
  13: ['click the email', 'Email (copied in one click), LinkedIn and your local time at the bottom of the menu.'],
  14: ['press the button', 'The menu opens as a circle growing out of the menu button, and closes back into it.'],
  15: ['hover the links', 'Letters shuffle for a moment, then settle.'],
  16: ['press ⌘K or Ctrl K, or type below', 'Type to jump to any page or project.'],
  17: ['', 'On a project page: Work / Shopify / Tero, each part a link back to the right place.'],
  18: ['scroll inside the box', 'A small pill appears once you’ve scrolled, with a ring showing how far down you are. Click to go back up.'],
  19: ['scroll inside the box, or click a dot', 'Small dots on the right edge, one per homepage section; the current one grows, and clicking jumps there.'],
  20: ['tap the tabs', 'On phones, the four places people need most stay at the bottom, in reach of a thumb.'],
};
const tag = (n: number) => ({ name: IDEAS[n - 1][1], note: NOTES[n][0], why: NOTES[n][1] });
const img = (slug: string, size = '-480') => withBase(`/images/projects/${slug}${size}.webp`);
const links = [
  { label: 'Selected work', href: withBase('/'), count: projects.length, img: img(projects[0].slug) },
  { label: 'About Grant', href: withBase('/about/'), img: img(projects[1].slug) },
  { label: 'Services', href: withBase('/#services'), count: 4, img: img(projects[2].slug) },
  { label: 'Estimate a project', href: withBase('/estimate/'), img: img(projects[3].slug) },
  { label: 'Get in touch', href: withBase('/contact/'), img: img(projects[4].slug) },
];
const latest = projects[0];
const latestHue = canvasHues[latest.canvas] ?? 245;
const pages = [
  ...links.map((l) => ({ label: l.label, hint: 'Page' })),
  { label: 'Free website audit', hint: 'Page' },
  ...projects.map((p) => ({ label: p.name, hint: `${p.platform} · ${p.category}` })),
];
const filler = (n: number) => Array.from({ length: n }, () => 'Page content: scroll inside this box to see the header react.');
const MockHeader = 'nv-mh';
---
<BaseLayout title="Navigation ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current site', href: '/' }]} />
  <div class="wrap nv-page">
    <header class="nv-head">
      <span class="tiny-heading">Preview · navigation</span>
      <h1 class="display">Twenty ideas<br />for getting around</h1>
      <p>Header ideas run inside small scrolling boxes with a stand-in header, so each can be tried on its own. Pick the numbers you like and I’ll build them into the real header and menu.</p>
    </header>

    {IDEAS.map(([n]) => {
      const t = tag(n);
      return (
        <section class="nv" id={`idea-${n}`}>
          {GROUPS[n] && <p class="nv-group">{GROUPS[n]}</p>}
          <div class="nv-top"><span class="idea-tag"><b>{n}</b>{t.name}{t.note && <em>{t.note}</em>}</span><p class="nv-why">{t.why}</p></div>

          {[1, 3, 5, 6, 18, 19].includes(n) && (
            <div class={`nv-box nv-box-${n}`} data-box={n}>
              <div class={MockHeader}><span class="nv-mh-mark">Grant<br />Dev14.</span><span class="nv-mh-right"><span>Let’s talk ↗</span><i class="nv-mh-btn"></i></span>{n === 6 && <span class="nv-progress"></span>}</div>
              {n === 5
                ? [['Light section', false], ['Dark section', true], ['Light again', false], ['Dark again', true]].map(([h, dark]) => <div class:list={['nv-sec', { 'is-dark': dark }]} data-dark={dark ? '1' : '0'}><h3 class="display">{h}</h3></div>)
                : n === 19
                  ? ['Hero', 'Work', 'Reviews', 'Services', 'Experience', 'Let’s talk'].map((h, i) => <div class="nv-sec" data-i={i} id={`nv-s${i}`}><h3 class="display">{h}</h3><p>{filler(1)}</p></div>)
                  : <div class="nv-fill">{filler(n === 3 ? 6 : 9).map((p, i) => <p>{i === 0 && n === 3 ? 'The first screen: the full header. Scroll down.' : p}</p>)}</div>}
              {n === 18 && <button type="button" class="nv-top-pill" aria-label="Back to top"><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" class="bg" /><circle cx="20" cy="20" r="18" class="fg" pathLength="100" /></svg><span>↑</span></button>}
              {n === 19 && <nav class="nv-secdots" aria-label="Sections">{['Hero', 'Work', 'Reviews', 'Services', 'Experience', 'Let’s talk'].map((h, i) => <a href={`#nv-s${i}`} aria-label={h} data-i={i}><span>{h}</span></a>)}</nav>}
            </div>
          )}

          {n === 2 && (
            <nav class="nv-under" aria-label="Underline demo">{links.slice(0, 4).map((l, i) => <a href="#idea-2" aria-current={i === 0 ? 'page' : undefined}>{l.label}</a>)}<span class="nv-under-line" aria-hidden="true"></span></nav>
          )}

          {n === 4 && <a class="nv-online" href={withBase('/contact/')}><i></i><span>Let’s talk</span><small></small><Arrow diagonal /></a>}

          {n === 7 && (
            <div class="nv-morph-row">{[245, 20, 105].map((h) => <button type="button" class="nv-morph" style={`--h:${h}`} aria-label="Open navigation" aria-pressed="false"><span></span><span></span></button>)}</div>
          )}

          {[8, 9, 10, 11, 12, 13, 15].includes(n) && (
            <div class={`nv-menu-demo nv-menu-${n}`}>
              {n !== 10 && n !== 12 && n !== 13 && n !== 15 && <button type="button" class="nv-open">{n === 11 ? 'Open the menu' : 'Open the menu'}</button>}
              <div class:list={['nv-menu', { 'is-open': [10, 12, 13, 15].includes(n) }]}>
                <nav class="nv-menu-links" aria-label={`Menu demo ${n}`}>{links.map((l, i) => <a href={l.href} style={`--i:${i}`} data-img={l.img} data-label={l.label.toUpperCase()} data-scramble={n === 15 ? '' : undefined}>{n === 10 && <b>{String(i + 1).padStart(2, '0')}</b>}<span>{l.label}</span>{n === 10 && l.count && <em>({l.count})</em>}</a>)}</nav>
                {n === 8 && <canvas class="nv-menu-dots" aria-hidden="true"></canvas>}
                {n === 9 && <img class="nv-menu-float" alt="" aria-hidden="true" />}
                {n === 12 && <a class="nv-latest" href={withBase(`/work/${latest.slug}/`)} style={`--h:${latestHue}`}><img src={img(latest.slug, '-320')} alt="" width="320" height="180" /><span><small>Latest project</small><strong>{latest.name}</strong><em>{latest.platform} · {latest.category}</em></span><Arrow diagonal /></a>}
                {n === 13 && <div class="nv-contact"><button type="button" class="nv-copy" data-email={profile.email}><span>{profile.email}</span><small>Click to copy</small></button><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><p><span class="nv-clock"></span> in Manila</p></div>}
              </div>
            </div>
          )}

          {n === 14 && (
            <div class="nv-circle-demo"><button type="button" class="nv-circle-btn" aria-label="Open navigation"><span></span><span></span></button><div class="nv-circle-menu">{links.map((l, i) => <a href={l.href} style={`--i:${i}`}>{l.label}</a>)}</div></div>
          )}

          {n === 16 && (
            <div class="nv-k">
              <label class="nv-k-input"><span aria-hidden="true">⌘K</span><input type="search" placeholder="Where to? Try “Shopify”, “about” or a project" aria-label="Search pages and projects" /></label>
              <ul class="nv-k-list">{pages.map((p) => <li><a href="#idea-16"><strong>{p.label}</strong><span>{p.hint}</span></a></li>)}</ul>
            </div>
          )}

          {n === 17 && (
            <nav class="nv-crumb" aria-label="Breadcrumb"><a href={withBase('/#work')}>Work</a><span aria-hidden="true">/</span><a href={withBase('/#work')}>{latest.platform}</a><span aria-hidden="true">/</span><span aria-current="page">{latest.name}</span></nav>
          )}

          {n === 20 && (
            <div class="nv-phone"><div class="nv-phone-screen"><div class="nv-phone-page"><p class="display">GRANT<br />DEV14.</p><p>Page content scrolls here.</p></div><nav class="nv-tabbar" aria-label="Mobile bar">{[['Work', '▦'], ['About', '◉'], ['Estimate', '◷'], ['Talk', '✉']].map(([l, ic], i) => <a href="#idea-20" aria-current={i === 0 ? 'page' : undefined}><i aria-hidden="true">{ic}</i>{l}</a>)}</nav></div></div>
          )}
        </section>
      );
    })}
  </div>
</BaseLayout>

<script>
  import { Dots } from './_dots';
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const boxes = new Map([...document.querySelectorAll<HTMLElement>('[data-box]')].map((b) => [Number(b.dataset.box), b]));

  // 1: hide on scroll down, show on scroll up.
  { const b = boxes.get(1)!, h = b.querySelector<HTMLElement>('.nv-mh')!; let last = 0; b.addEventListener('scroll', () => { const y = b.scrollTop; h.classList.toggle('is-hidden', y > last && y > 60); last = y; }, { passive: true }); }
  // 3: slim bar after the first screen.
  { const b = boxes.get(3)!, h = b.querySelector<HTMLElement>('.nv-mh')!; b.addEventListener('scroll', () => h.classList.toggle('is-slim', b.scrollTop > 120), { passive: true }); }
  // 5: light text over dark sections.
  { const b = boxes.get(5)!, h = b.querySelector<HTMLElement>('.nv-mh')!; const secs = [...b.querySelectorAll<HTMLElement>('.nv-sec')];
    b.addEventListener('scroll', () => { const top = b.getBoundingClientRect().top + 40; const under = secs.find((s) => { const r = s.getBoundingClientRect(); return r.top <= top && r.bottom > top; }); h.classList.toggle('is-light', under?.dataset.dark === '1'); }, { passive: true }); }
  // 6: progress line.
  { const b = boxes.get(6)!, line = b.querySelector<HTMLElement>('.nv-progress')!; b.addEventListener('scroll', () => { line.style.scale = `${clamp(b.scrollTop / (b.scrollHeight - b.clientHeight))} 1`; }, { passive: true }); }
  // 18: back-to-top pill with a progress ring.
  { const b = boxes.get(18)!, pill = b.querySelector<HTMLElement>('.nv-top-pill')!, ring = pill.querySelector<SVGCircleElement>('.fg')!;
    b.addEventListener('scroll', () => { const p = clamp(b.scrollTop / (b.scrollHeight - b.clientHeight)); pill.classList.toggle('is-on', b.scrollTop > 120); ring.style.strokeDashoffset = String(100 - p * 100); }, { passive: true });
    pill.addEventListener('click', () => b.scrollTo({ top: 0, behavior: 'smooth' })); }
  // 19: section dots.
  { const b = boxes.get(19)!, dots = [...b.querySelectorAll<HTMLElement>('.nv-secdots a')];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) dots.forEach((d) => d.classList.toggle('is-on', d.dataset.i === (e.target as HTMLElement).dataset.i)); }), { root: b, rootMargin: '-45% 0px -50% 0px' });
    b.querySelectorAll('.nv-sec').forEach((s) => io.observe(s)); dots[0].classList.add('is-on');
    dots.forEach((d) => d.addEventListener('click', (e) => { e.preventDefault(); b.querySelector(d.getAttribute('href')!)!.scrollIntoView({ behavior: 'smooth', block: 'start' }); })); }

  // 2: sliding underline.
  const under = document.querySelector<HTMLElement>('.nv-under');
  if (under) {
    const line = under.querySelector<HTMLElement>('.nv-under-line')!, as = [...under.querySelectorAll<HTMLAnchorElement>('a')];
    const to = (a: HTMLElement) => { line.style.left = `${a.offsetLeft}px`; line.style.width = `${a.offsetWidth}px`; };
    const current = () => as.find((a) => a.getAttribute('aria-current')) ?? as[0];
    requestAnimationFrame(() => to(current()));
    as.forEach((a) => { a.addEventListener('pointerenter', () => to(a)); a.addEventListener('click', (e) => { e.preventDefault(); as.forEach((o) => o.removeAttribute('aria-current')); a.setAttribute('aria-current', 'page'); to(a); }); });
    under.addEventListener('pointerleave', () => to(current()));
  }

  // 4 and 13: Manila time.
  const manila = () => new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }));
  const clock = () => new Date().toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila' });
  const online = document.querySelector<HTMLElement>('.nv-online');
  const tick = () => {
    if (online) { const m = manila(), h = m.getHours(), day = m.getDay(), on = h >= 9 && h < 18 && day > 0 && day < 6; online.classList.toggle('is-on', on); online.querySelector('small')!.textContent = on ? 'Online now' : `Back at 9 am · ${clock()} in Manila`; }
    document.querySelectorAll('.nv-clock').forEach((el) => { el.textContent = clock(); });
  };
  tick(); setInterval(tick, 20000);

  // 7: menu button morph.
  document.querySelectorAll<HTMLButtonElement>('.nv-morph').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); b.setAttribute('aria-label', on ? 'Close navigation' : 'Open navigation'); }));

  // Menus that open and close (8, 9, 11).
  document.querySelectorAll<HTMLElement>('.nv-menu-demo').forEach((demo) => {
    const btn = demo.querySelector<HTMLButtonElement>('.nv-open'), menu = demo.querySelector<HTMLElement>('.nv-menu')!;
    btn?.addEventListener('click', () => { const open = !menu.classList.contains('is-open'); menu.classList.toggle('is-open', open); btn.textContent = open ? 'Close the menu' : 'Open the menu'; });
    demo.querySelectorAll<HTMLAnchorElement>('.nv-menu-links a').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
  });
  // 8: the hovered link drawn in dots.
  const dotCanvas = document.querySelector<HTMLCanvasElement>('.nv-menu-dots');
  if (dotCanvas) {
    const dots = new Dots(dotCanvas, 'WORK', { color: '#f2f0ea', accent: 'oklch(0.8 0.12 245)', hidden: true });
    document.querySelectorAll<HTMLElement>('.nv-menu-8 .nv-menu-links a').forEach((a) => a.addEventListener('pointerenter', () => dots.setText(a.dataset.label!)));
  }
  // 9: a picture per link that follows the cursor.
  const m9 = document.querySelector<HTMLElement>('.nv-menu-9 .nv-menu');
  if (m9) {
    const f = m9.querySelector<HTMLImageElement>('.nv-menu-float')!;
    m9.querySelectorAll<HTMLAnchorElement>('.nv-menu-links a').forEach((a) => { a.addEventListener('pointerenter', () => { f.src = a.dataset.img!; m9.classList.add('is-previewing'); }); a.addEventListener('pointerleave', () => m9.classList.remove('is-previewing')); });
    m9.addEventListener('pointermove', (e) => { const r = m9.getBoundingClientRect(); f.style.translate = `${e.clientX - r.left + 30}px ${e.clientY - r.top - 90}px`; });
  }
  // 13: copy the email.
  document.querySelectorAll<HTMLButtonElement>('.nv-copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.email!); b.querySelector('small')!.textContent = 'Copied ✓'; } catch { b.querySelector('small')!.textContent = 'Press ⌘C to copy'; }
    setTimeout(() => { b.querySelector('small')!.textContent = 'Click to copy'; }, 1800);
  }));

  // 14: the menu grows as a circle from its button.
  const circle = document.querySelector<HTMLElement>('.nv-circle-demo');
  circle?.querySelector('button')!.addEventListener('click', () => circle.classList.toggle('is-open'));

  // 15: letters shuffle, then settle from left to right.
  const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
  document.querySelectorAll<HTMLElement>('[data-scramble] span').forEach((el) => {
    const text = el.textContent!; let frame = 0;
    el.parentElement!.addEventListener('pointerenter', () => {
      cancelAnimationFrame(frame); el.style.minWidth = `${el.offsetWidth}px`;
      const start = performance.now();
      const step = (now: number) => { const t = clamp((now - start) / 450), fixed = Math.floor(t * text.length); el.textContent = [...text].map((c, i) => (i < fixed || c === ' ' ? c : glyphs[(Math.random() * glyphs.length) | 0])).join(''); if (t < 1) frame = requestAnimationFrame(step); else el.textContent = text; };
      frame = requestAnimationFrame(step);
    });
  });

  // 16: quick jump.
  const k = document.querySelector<HTMLElement>('.nv-k');
  if (k) {
    const input = k.querySelector('input')!, items = [...k.querySelectorAll<HTMLLIElement>('li')];
    let sel = 0;
    const vis = () => items.filter((li) => !li.hidden);
    const mark = () => vis().forEach((li, i) => li.classList.toggle('is-sel', i === sel));
    input.addEventListener('input', () => { const q = input.value.trim().toLowerCase(); items.forEach((li) => { li.hidden = !!q && !li.textContent!.toLowerCase().includes(q); }); sel = 0; mark(); });
    input.addEventListener('keydown', (e) => { const v = vis(); if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(v.length - 1, sel + 1); mark(); } if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); mark(); } });
    addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); k.scrollIntoView({ block: 'center' }); input.focus(); } });
    mark();
  }

  // 20: tabs.
  document.querySelectorAll<HTMLAnchorElement>('.nv-tabbar a').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); a.parentElement!.querySelectorAll('a').forEach((o) => o.removeAttribute('aria-current')); a.setAttribute('aria-current', 'page'); }));
</script>

<style is:global>
  .nv-page { padding-bottom: 160px; }
  .nv-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .nv-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .nv-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .nv { padding-block: 52px; border-top: 1px solid var(--line); }
  .nv-group { margin: 0 0 20px; font: 800 clamp(28px, 3vw, 44px) / 1 "Big Shoulders Display", sans-serif; text-transform: uppercase; }
  .nv-top { display: grid; gap: 4px; margin-bottom: 26px; }
  .nv-why { max-width: 680px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }

  /* Scrolling boxes with a stand-in header (1, 3, 5, 6, 18, 19). */
  .nv-box { position: relative; height: 380px; overflow: auto; border-radius: 22px; background: var(--surface); overscroll-behavior: contain; }
  .nv-mh { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 22px 26px; transition: translate 0.45s var(--ease), padding 0.45s var(--ease), background-color 0.45s, color 0.45s, box-shadow 0.45s; }
  .nv-mh-mark { font-size: 20px; font-weight: 500; line-height: 0.98; letter-spacing: -0.03em; transition: font-size 0.45s var(--ease); }
  .nv-mh-right { display: flex; align-items: center; gap: 22px; font-size: 13px; }
  .nv-mh-btn { width: 44px; height: 44px; border-radius: 50%; background: var(--ink); transition: width 0.45s var(--ease), height 0.45s var(--ease), background-color 0.45s; }
  .nv-mh.is-hidden { translate: 0 -110%; }
  .nv-mh.is-slim { padding-block: 10px; background: oklch(1 0 0 / 0.82); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 6px 24px -14px oklch(0 0 0 / 0.35); }
  .nv-mh.is-slim .nv-mh-mark { font-size: 15px; }
  .nv-mh.is-slim .nv-mh-btn { width: 34px; height: 34px; }
  .nv-mh.is-light { color: #fff; }
  .nv-mh.is-light .nv-mh-btn { background: #fff; }
  .nv-fill { display: grid; gap: 14px; padding: 20px 26px 60px; }
  .nv-fill p { margin: 0; padding: 26px; border-radius: 14px; background: var(--bg); color: var(--muted); font-size: 14px; }
  .nv-box-5 .nv-mh { position: sticky; margin-bottom: -88px; }
  .nv-sec { display: grid; align-content: center; min-height: 300px; padding: 90px 26px 30px; }
  .nv-sec h3 { margin: 0; font-size: 56px; text-transform: uppercase; }
  .nv-sec p { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
  .nv-sec.is-dark { background: var(--ink); color: #fff; }
  .nv-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--ink); transform-origin: 0 50%; scale: 0 1; }
  .nv-top-pill { position: sticky; left: calc(100% - 70px); bottom: 18px; display: grid; place-items: center; width: 48px; height: 48px; margin: -66px 0 0 auto; margin-right: 18px; padding: 0; border: 0; border-radius: 50%; background: var(--bg); box-shadow: 0 8px 24px -10px oklch(0 0 0 / 0.35); cursor: pointer; opacity: 0; translate: 0 12px; transition: opacity 0.35s, translate 0.45s var(--ease); }
  .nv-top-pill.is-on { opacity: 1; translate: none; }
  .nv-top-pill svg { position: absolute; inset: 4px; rotate: -90deg; }
  .nv-top-pill circle { fill: none; stroke-width: 2; }
  .nv-top-pill .bg { stroke: var(--line); }
  .nv-top-pill .fg { stroke: var(--ink); stroke-dasharray: 100; stroke-dashoffset: 100; stroke-linecap: round; }
