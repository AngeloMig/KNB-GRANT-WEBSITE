  @media (max-width: 600px) { .ab-tnt-head { display: none; } .ab-tnt-row { grid-template-columns: 1fr; gap: 4px; } }

  /* 15 trading card */
  .ab-tcg-stage { display: grid; place-items: center; background: radial-gradient(circle at 50% 30%, oklch(0.3 0.05 280), oklch(0.15 0.03 280)); min-height: 620px; }
  .ab-tcg { --rx: 0deg; --ry: 0deg; --px: 50%; --py: 50%; position: relative; width: 320px; aspect-ratio: 63 / 88; padding: 0; border: 0; background: none; perspective: 1000px; cursor: pointer; font: inherit; color: inherit; text-align: left; }
  .ab-tcg-face { position: absolute; inset: 0; border-radius: 18px; padding: 14px; display: flex; flex-direction: column; gap: 8px; backface-visibility: hidden; transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 0.15s; overflow: hidden; }
  .ab-tcg[aria-pressed='true'] .ab-tcg-front { transform: rotateY(180deg); transition: transform 0.7s var(--ease); }
  .ab-tcg-back { transform: rotateY(-180deg); transition: transform 0.7s var(--ease); background: linear-gradient(160deg, oklch(0.35 0.1 280), oklch(0.25 0.08 250)); color: #fff; border: 8px solid oklch(0.82 0.12 85); justify-content: center; gap: 12px; padding: 22px; }
  .ab-tcg[aria-pressed='true'] .ab-tcg-back { transform: rotateY(0); }
  .ab-tcg-front { background: linear-gradient(170deg, oklch(0.9 0.08 85), oklch(0.82 0.12 75)); border: 8px solid oklch(0.82 0.12 85); color: oklch(0.25 0.05 60); box-shadow: 0 30px 50px -20px oklch(0 0 0 / 0.6); }
  .ab-tcg-top { display: flex; justify-content: space-between; align-items: baseline; } .ab-tcg-top b { font: 800 24px "Big Shoulders Display", sans-serif; } .ab-tcg-top span { font-size: 12px; font-weight: 700; }
  .ab-tcg-art { flex: 0 0 38%; border-radius: 6px; border: 3px solid oklch(0.7 0.1 70); background: radial-gradient(circle at 30% 30%, oklch(0.75 0.12 250), oklch(0.4 0.14 280)); display: grid; place-items: center; }
  .ab-tcg-mono { font: 800 64px "Big Shoulders Display", sans-serif; color: oklch(1 0 0 / 0.9); text-shadow: 0 4px 0 oklch(0.3 0.1 280); } .ab-tcg-mono.small { font-size: 36px; text-align: center; margin-top: 8px; }
  .ab-tcg-type { font-size: 11px; font-weight: 700; text-align: center; padding: 3px; background: oklch(0.75 0.1 75 / 0.5); border-radius: 4px; }
  .ab-tcg-move { display: grid; gap: 1px; padding: 6px 0; border-bottom: 1px solid oklch(0.6 0.1 70 / 0.4); } .ab-tcg-move b { font-size: 14px; } .ab-tcg-move small { font-size: 11px; line-height: 1.3; }
  .ab-tcg-foot { margin-top: auto; display: flex; justify-content: space-between; font-size: 10.5px; font-weight: 700; }
  .ab-holo { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: color-dodge; opacity: 0.55; background: radial-gradient(circle at var(--px) var(--py), oklch(1 0 0 / 0.7), transparent 40%), linear-gradient(115deg, transparent 20%, oklch(0.8 0.2 330 / 0.5) 36%, oklch(0.85 0.17 200 / 0.5) 46%, oklch(0.9 0.18 120 / 0.5) 56%, transparent 72%) var(--px) var(--py) / 250% 250%; }
  .ab-tcg-job { display: grid; } .ab-tcg-job b { font-size: 15px; } .ab-tcg-job small { font-size: 11.5px; opacity: 0.8; }

  /* 16 stories */
  .ab-story-stage { display: grid; place-items: center; background: oklch(0.94 0.01 270); }
  .ab-story { position: relative; width: min(340px, 100%); aspect-ratio: 9 / 16; border-radius: 26px; overflow: hidden; background: #111; color: #fff; }
  .ab-story-bars { position: absolute; top: 12px; left: 12px; right: 12px; display: flex; gap: 4px; z-index: 3; }
  .ab-story-bars span { flex: 1; height: 3px; border-radius: 3px; background: oklch(1 0 0 / 0.3); overflow: hidden; }
  .ab-story-bars i { display: block; height: 100%; width: 0; background: #fff; }
  .ab-story-bars .done i { width: 100%; } .ab-story-bars .now i { animation: ab-bar 4s linear forwards; }
  @keyframes ab-bar { to { width: 100%; } }
  .ab-story-head { position: absolute; top: 26px; left: 14px; z-index: 3; display: flex; align-items: center; gap: 8px; font-size: 13px; } .ab-story-head small { opacity: 0.6; }
  .ab-av { width: 30px; height: 30px; border-radius: 50%; background: #fff; color: #111; display: grid; place-items: center; font-weight: 800; }
  .ab-slide { position: absolute; inset: 0; padding: 90px 26px 40px; display: flex; flex-direction: column; justify-content: center; gap: 10px; background: linear-gradient(160deg, oklch(0.55 0.17 var(--h)), oklch(0.3 0.12 calc(var(--h) + 40))); animation: ab-up 0.5s var(--ease); }
  .ab-slide small { font-size: 14px; opacity: 0.8; } .ab-slide b { font: 800 clamp(48px, 9vw, 64px)/0.95 "Big Shoulders Display", sans-serif; } .ab-slide p { margin: 0; font-size: 15px; opacity: 0.9; }
  .ab-slide .ab-btn { position: relative; z-index: 4; align-self: start; margin-top: 14px; background: #fff; color: #111; border-color: #fff; }
  .ab-tap { position: absolute; top: 60px; bottom: 0; width: 40%; border: 0; background: none; cursor: pointer; z-index: 2; } .ab-tap.prev { left: 0; } .ab-tap.next { right: 0; width: 60%; }

  /* 17 day */
  .ab-day { --d: 0; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 30px; align-items: start; }
