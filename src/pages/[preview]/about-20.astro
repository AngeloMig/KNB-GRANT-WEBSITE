  .ab-sketch-note { position: absolute; font: italic 600 clamp(11px, 1.6vw, 20px) "Bradley Hand", "Segoe Print", cursive; color: oklch(0.5 0.2 27); opacity: 0; transition: opacity 0.4s, transform 0.4s; transform: rotate(-4deg); }
  .ab-sketch-note.n1 { left: 50%; top: 32%; } .ab-sketch-note.n2 { left: 66%; top: 52%; } .ab-sketch-note.n3 { left: 27%; top: 70%; }
