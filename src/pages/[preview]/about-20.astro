---
// Design preview: 20 creative ideas for the About page (a second set; the first, more conventional set
// is /ideas/about-lab/). Local preview only: in a build this route has no pages.
// Open http://localhost:4321/ideas/about-20/. Everything comes from the current About page (bio, experience,
// tools, education) unless it says "Needs you". No quotes, photos or numbers are invented.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { withBase } from '../../utils/paths';
import { experience, profile } from '../../data/profile';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Bio length dial'], [2, 'Words that light up'], [3, 'The desk, from above'], [4, 'Toss the photos'], [5, 'Career as a git log'],
  [6, 'Level up'], [7, 'The swinging ID card'], [8, 'Passport stamps'], [9, 'Tools on a keyboard'], [10, 'Tools in orbit'],
  [11, 'X-ray lens'], [12, 'Sketch to site'], [13, 'The team, drawn in'], [14, 'This, not that'], [15, 'Collectible card'],
  [16, 'By the numbers, as stories'], [17, 'A day, sunrise to sunset'], [18, 'Ask me anything (⌘K)'], [19, 'The résumé unfolds'], [20, 'Signed, Grant'],
  [21, 'Inspect element on Grant'], [22, 'Dots that become words'], [23, 'A window onto Manila'], [24, 'Choose your own website'], [25, 'The career, as an album'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['Real · your bio', 'One bio, three lengths. Pick Short, Medium or Long and it rewrites itself, with the reading time. Busy founders get one line; the curious get the lot.'],
  2: ['Real · your words', 'Your line about details and foundations, set huge. Words light up one by one as you scroll through it.'],
  3: ['Illustrated · no photo needed', 'A drawn top-down desk: laptop, notebook, coffee, phone and diploma. Tap the glowing dots to learn a fact from each object.'],
  4: ['Needs your photos', 'A stack of polaroids: drag the top one and toss it aside to see the next. The frames are placeholders for your own photos.'],
  5: ['Real · your experience', 'Your career written as a developer would: a git log, with the freelance work as a branch that merges back in. Types itself out.'],
  6: ['Real · roles and tags', 'The career as game levels. An XP bar fills from 2019 to now, each level unlocks the skills (tags) you picked up there.'],
  7: ['Real · your degree', 'Education as an ID card on a lanyard. Grab it and swing it; it settles back with a little bounce.'],
  8: ['Real · quick facts', 'Quick facts as passport stamps that thump onto the page one after another.'],
  9: ['Real · your 20 tools', 'Your tools as keys on a keyboard. Hover, click, or type a letter on your own keyboard to press the matching keys.'],
  10: ['Real · your 20 tools', 'The same tools as planets in three orbits (development, platforms, design & integrations). Hover to pause and read one.'],
  11: ['Real screenshot · example code', '“The details you see, and the foundations you don’t”: move the lens over a finished page to see the code underneath.'],
  12: ['Real screenshot', 'A hand-drawn wireframe draws itself, then the finished Tero homepage fades in beneath it. From sketch to site.'],
  13: ['Needs you · team sizes', 'Team leadership, drawn: client, you, designers, developers and QA, connected line by line. Tap a role to see what you did.'],
  14: ['Wording to approve', 'Principles as a list of what you avoid, struck through, and what you do instead.'],
  15: ['Real · facts on the card', 'You as a collectible trading card with a holographic shine that follows the pointer. Tap to flip it over.'],
  16: ['Real · counted from the site', 'A story you tap through, like Instagram: years building, top platform, top industry, where clients are.'],
  17: ['Needs your schedule', 'A working day in Manila. The sky changes from sunrise to night as you scroll, with what happens at each hour.'],
  18: ['Real · facts from the site', 'A search box that answers questions about you: type “shopify”, “team” or “degree”. Press ⌘K (or Ctrl K) to jump in.'],
  19: ['Real · your résumé', 'The résumé as a folded paper that opens out as it comes into view, with the download button.'],
  20: ['Real · links to Contact', 'A sign-off: your name writes itself in ink, then a simple invitation to get in touch.'],
  21: ['Real · facts as CSS', 'Your intro, inspected like a web page in the browser’s dev tools. Hover any part and it outlines itself, with its “styles”: your facts written as CSS.'],
  22: ['Real · facts in dots', 'Thousands of dots (the site’s own dot style) that rearrange themselves into GRANT, then 2019, SHOPIFY, MANILA… Move your cursor through them to scatter them.'],
  23: ['Real · live Manila time', 'A window looking out over Manila, drawn live: the sky, sun, moon, stars and city lights follow the real time there, with what you’re probably doing. Drag the hours to see the whole day. Your hours are a guess to confirm.'],
  24: ['Illustrative story', 'A tiny choose-your-own-adventure: pick your website problem and see how working with you plays out, ending at the right next step (audit or estimate).'],
  25: ['Real · your career', 'Your career as a record. Each role is a track whose length is how long you were there (2:05 = 2 years, 5 months). Pick one: the record spins, the needle drops and the liner notes show the role.'],
};
const img = (slug: string, w = 960) => withBase(`/images/projects/${slug}-${w}.webp`);
const bio = {
  short: 'I build Shopify, Webflow and WordPress websites for brands and agencies, and I’ve led the teams that build them.',
  medium: ['I build websites across Shopify, Webflow, and WordPress, working with brands and agencies to turn designs into responsive, usable web experiences.', 'My experience spans ecommerce development, custom themes, platform migrations, third-party integrations, and technical SEO.'],
  long: ['I build websites across Shopify, Webflow, and WordPress, working with brands and agencies to turn designs into responsive, usable web experiences.', 'My experience spans ecommerce development, custom themes, platform migrations, third-party integrations, and technical SEO. Alongside hands-on development, I’ve led development teams and coordinated projects from planning through delivery.', 'I care about the details you see, and the foundations you don’t: clear structure, maintainable code, and a site that feels good to use.', `Before that: a BS in Information Technology, majoring in web development, at Bulacan State University (2019). Since then: ${experience.map((e) => e.company).join(', ')}.`],
};
const manifesto = 'A developer with an eye for detail. And a mindset for making things work. I care about the details you see, and the foundations you don’t.';
const toolGroups = [
  { id: 'dev', label: 'Development', h: 110, tools: ['HTML', 'CSS', 'JavaScript', 'jQuery', 'PHP', 'Liquid', 'SASS', 'MySQL'] },
  { id: 'platforms', label: 'Platforms', h: 300, tools: ['Shopify', 'Shopify Plus', 'Webflow', 'WordPress', 'WooCommerce', 'BigCommerce'] },
  { id: 'design', label: 'Design & integrations', h: 50, tools: ['Figma', 'GSAP', 'Adobe Photoshop', 'HubSpot', 'ActiveCampaign', 'Klaviyo'] },
];
const allTools = toolGroups.flatMap((g) => g.tools.map((t) => ({ t, g: g.id, h: g.h })));
const chron = [...experience].reverse();
const hash = (s: string) => [...s].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7).toString(16).slice(0, 7).padStart(7, '0');
const startYear = 2019;
const years = new Date().getFullYear() - startYear;
const byPlatform = Object.entries(projects.reduce<Record<string, number>>((a, p) => ((a[p.platform] = (a[p.platform] || 0) + 1), a), {})).sort((a, b) => b[1] - a[1]);
const groupOf = (c: string) => /auto|4wd/i.test(c) ? 'Automotive' : /fashion|lingerie/i.test(c) ? 'Fashion' : /beauty|wellness/i.test(c) ? 'Beauty & wellness' : /agency|design/i.test(c) ? 'Agencies & design' : c;
const byIndustry = Object.entries(projects.reduce<Record<string, number>>((a, p) => ((a[groupOf(p.category)] = (a[groupOf(p.category)] || 0) + 1), a), {})).sort((a, b) => b[1] - a[1]);
const stories = [
  { k: 'Building websites since', big: String(startYear), small: `${years} years and counting` },
  { k: 'Top platform', big: byPlatform[0][0], small: `${byPlatform[0][1]} of the ${projects.length} projects on this site` },
  { k: 'Most built-for industry', big: byIndustry[0][0], small: `${byIndustry[0][1]} projects, from ${projects.filter((p) => groupOf(p.category) === byIndustry[0][0]).map((p) => p.name).join(' and ')}` },
  { k: 'Clients in', big: 'Australia & the UK', small: 'and more, worked remotely from Manila' },
  { k: 'Next up', big: 'Your website?', small: 'Tap to say hello' },
];
const facts = [
  ['platforms shopify webflow wordpress', 'Builds on Shopify, Webflow and WordPress (WooCommerce too).'],
  ['shopify rivyl senior', 'Senior Shopify Web Developer at Rivyl, Jun 2022 to Sep 2026.'],
  ['team lead leadership tecniqode', 'Team Leader and full-stack developer at Tecniqode Web Solutions, 2019 to 2021.'],
  ['agency cardell media uk', 'Shopify developer for the clients of Cardell Media, a UK digital marketing agency.'],
  ['freelance dingus zazzy', 'Freelance full-stack developer with Dingus & Zazzy across WordPress, Shopify and Webflow.'],
  ['degree education university bsit school', 'BS Information Technology, major in Web Development, Bulacan State University, 2019.'],
  ['location where based manila philippines timezone', 'Based in the Philippines (Manila time, GMT+8), working with clients worldwide.'],
  ['migration seo speed', 'Platform migrations, technical SEO and page-speed work are part of most projects.'],
  ['tools code liquid javascript php', `Tools: ${allTools.slice(0, 8).map((t) => t.t).join(', ')}.`],
  ['design figma gsap', 'Design and integrations: Figma, GSAP, Photoshop, HubSpot, ActiveCampaign, Klaviyo.'],
  ['resume cv download', 'The résumé is a PDF on this page: Download résumé.'],
  ['contact email hire', `Email ${profile.email}, or use the contact form.`],
];
const MON: Record<string, number> = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
const ym = (s: string) => { const [m, y] = s.trim().split(' '); return Number(y) * 12 + MON[m]; };
// Track length = time in the role, written m:ss style as years:months.
const tracks = chron.map((e) => { const [a, b] = e.dates.split('—'); const n = ym(b) - ym(a) + 1; return { company: e.company, role: e.role, dates: e.dates, summary: e.summary, tags: e.tags, len: `${Math.floor(n / 12)}:${String(n % 12).padStart(2, '0')}` }; });
const totalMonths = chron.reduce((s, e) => { const [a, b] = e.dates.split('—'); return s + ym(b) - ym(a) + 1; }, 0);
const words = ['GRANT', String(startYear), 'SHOPIFY', 'WEBFLOW', 'MANILA', 'HELLO'];
const wordCaptions = ['Grant Dev14', `Building websites since ${startYear}`, 'Senior Shopify developer', 'Webflow and WordPress too', 'Based in the Philippines', 'Say hi'];
const DATA = { stories, facts, tools: allTools, words, wordCaptions, tracks, base: withBase('/') };
---
<BaseLayout title="About ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Open the About page', href: '/about/' }, { label: 'First set of About ideas', href: '/ideas/about-lab/' }]} />
  <script type="application/json" id="ab-data" set:html={JSON.stringify(DATA)} />
  <div class="wrap ab-page">
    <header class="ab-head">
      <span class="tiny-heading">Preview · About page</span>
      <h1 class="display">Twenty ways<br />to meet Grant</h1>
      <p>A second, more playful set of About page ideas. They use what’s on the About page today (your bio, career, tools and degree). <b>Needs you</b> marks the few that wait for photos or facts only you have. Ideas 3, 4, 5 and 18 in the <a href={withBase('/ideas/sections/')}>sections preview</a> also suit this page.</p>
    </header>

    {/* 1 */}
    <section class="ab" id="idea-1"><div class="ab-top"><span class="idea-tag"><b>1</b>{IDEAS[0][1]}<em>{NOTES[1][0]}</em></span><p>{NOTES[1][1]}</p></div>
      <div class="ab-stage ab-dial" data-dial>
        <div class="ab-dial-switch" role="group" aria-label="Bio length">{['short', 'medium', 'long'].map((k, i) => <button type="button" data-len={k} aria-pressed={i === 1 ? 'true' : 'false'}>{k[0].toUpperCase() + k.slice(1)}</button>)}<span class="ab-dial-thumb"></span></div>
        <p class="ab-dial-meta">…</p>
        <div class="ab-dial-text">
          <div data-bio="short" hidden><p class="ab-lead">{bio.short}</p></div>
          <div data-bio="medium">{bio.medium.map((p, i) => <p class={i === 0 ? 'ab-lead' : ''}>{p}</p>)}</div>
          <div data-bio="long" hidden>{bio.long.map((p, i) => <p class={i === 0 ? 'ab-lead' : ''}>{p}</p>)}</div>
        </div>
      </div>
    </section>

    {/* 2 */}
    <section class="ab" id="idea-2"><div class="ab-top"><span class="idea-tag"><b>2</b>{IDEAS[1][1]}<em>{NOTES[2][0]}</em></span><p>{NOTES[2][1]}</p></div>
      <div class="ab-lit" data-lit><p>{manifesto.split(' ').map((w) => <span>{w} </span>)}</p></div>
    </section>

    {/* 3 */}
    <section class="ab" id="idea-3"><div class="ab-top"><span class="idea-tag"><b>3</b>{IDEAS[2][1]}<em>{NOTES[3][0]}</em></span><p>{NOTES[3][1]}</p></div>
      <div class="ab-stage ab-desk" data-desk>
        <div class="ab-desktop">
          <div class="ab-obj ab-laptop"><div class="ab-screen" style={`background-image:url(${img('road-armor', 640)})`}></div><div class="ab-keys"></div><button type="button" class="ab-spot" data-say="Shopify, Webflow and WordPress, from custom themes to platform migrations." aria-label="Laptop"></button></div>
          <div class="ab-obj ab-notebook"><i></i><i></i><i></i><i class="s"></i><b></b><button type="button" class="ab-spot" data-say="Every build starts on paper: the pages, the content, and what each one needs to do." aria-label="Notebook"></button></div>
          <div class="ab-obj ab-mug"><span class="ab-steam"><i></i><i></i><i></i></span><button type="button" class="ab-spot" data-say="clock" aria-label="Coffee"></button></div>
          <div class="ab-obj ab-phone"><i></i><button type="button" class="ab-spot" data-say={`Say hello: ${profile.email}`} aria-label="Phone"></button></div>
          <div class="ab-obj ab-diploma"><small>Bulacan State University</small><b>BS Information Technology</b><small>Web Development · 2019</small><button type="button" class="ab-spot" data-say="A BS in Information Technology, majoring in web development, from Bulacan State University in 2019." aria-label="Diploma"></button></div>
          <div class="ab-obj ab-plant"><i></i><i></i><i></i></div>
        </div>
        <p class="ab-desk-say" aria-live="polite">Tap a glowing dot.</p>
      </div>
    </section>

    {/* 4 */}
    <section class="ab" id="idea-4"><div class="ab-top"><span class="idea-tag"><b>4</b>{IDEAS[3][1]}<em>{NOTES[4][0]}</em></span><p>{NOTES[4][1]}</p></div>
      <div class="ab-stage ab-polas" data-polas>
        <div class="ab-pola-stack">{[['Your desk', 245], ['Manila', 30], ['Graduation, 2019', 300], ['With the Rivyl team', 150], ['Off the clock', 80]].map(([c, h], i) => <figure class="ab-pola" style={`--h:${h};--r:${[-4, 3, -2, 5, -1][i]}deg`}><div class="ab-pola-photo"><span>Photo: {c}</span></div><figcaption>{c}</figcaption></figure>)}</div>
        <p class="ab-hint">Drag the top photo and let go to toss it.</p>
      </div>
    </section>

    {/* 5 */}
    <section class="ab" id="idea-5"><div class="ab-top"><span class="idea-tag"><b>5</b>{IDEAS[4][1]}<em>{NOTES[5][0]}</em></span><p>{NOTES[5][1]}</p></div>
      <div class="ab-stage ab-term" data-term>
        <div class="ab-term-bar"><span></span><span></span><span></span><b>~/grant — career</b></div>
        <pre><code><span class="ab-l"><span class="p">$</span> git log --graph --oneline career</span>
<span class="ab-l"><span class="g">*</span>   <span class="h">{hash(experience[0].company)}</span> <span class="ref">(HEAD -&gt; career)</span> {experience[0].role} @ {experience[0].company}</span>
<span class="ab-l"><span class="g">|</span>           <span class="d">{experience[0].dates} · {experience[0].tags.slice(0, 4).join(', ')}</span></span>
<span class="ab-l"><span class="g">*</span>   <span class="h">{hash('merge')}</span> Merge branch 'freelance' into career</span>
<span class="ab-l"><span class="g">|\</span></span>
<span class="ab-l"><span class="g">| *</span> <span class="h">{hash(experience[2].company)}</span> {experience[2].role} @ {experience[2].company}</span>
<span class="ab-l"><span class="g">| |</span>         <span class="d">{experience[2].dates} · {experience[2].tags.slice(0, 3).join(', ')}</span></span>
<span class="ab-l"><span class="g">* |</span> <span class="h">{hash(experience[1].company)}</span> {experience[1].role} @ {experience[1].company}</span>
<span class="ab-l"><span class="g">|/</span>          <span class="d">{experience[1].dates} · agency clients, UK</span></span>
<span class="ab-l"><span class="g">*</span>   <span class="h">{hash(experience[3].company)}</span> {experience[3].role} @ {experience[3].company}</span>
<span class="ab-l"><span class="g">|</span>           <span class="d">{experience[3].dates}</span></span>
<span class="ab-l"><span class="g">*</span>   <span class="h">{hash('bsu')}</span> <span class="ref">(tag: v1.0)</span> BS Information Technology, Bulacan State University</span>
<span class="ab-l"><span class="p">$</span> <span class="ab-cursor"></span></span></code></pre>
      </div>
    </section>

    {/* 6 */}
    <section class="ab" id="idea-6"><div class="ab-top"><span class="idea-tag"><b>6</b>{IDEAS[5][1]}<em>{NOTES[6][0]}</em></span><p>{NOTES[6][1]}</p></div>
      <div class="ab-stage ab-levels" data-levels>
        <div class="ab-xp"><span>XP</span><div class="ab-xp-bar"><i></i></div><b class="ab-xp-lv">LV 1</b></div>
        <ol class="ab-lv-list">{chron.map((e, i) => <li style={`--i:${i}`}><span class="ab-lv-n">Level {i + 1}</span><b>{e.role}</b><small>{e.company} · {e.dates.replace(' — ', '–')}</small><div class="ab-badges">{e.tags.slice(0, 4).map((t) => <span>{t}</span>)}</div></li>)}</ol>
        <div class="ab-toast" aria-live="polite"></div>
      </div>
    </section>

    {/* 7 */}
    <section class="ab" id="idea-7"><div class="ab-top"><span class="idea-tag"><b>7</b>{IDEAS[6][1]}<em>{NOTES[7][0]}</em></span><p>{NOTES[7][1]}</p></div>
      <div class="ab-stage ab-lanyard" data-lanyard>
        <div class="ab-swing">
          <span class="ab-strap"></span><span class="ab-clip"></span>
          <div class="ab-idcard"><div class="ab-id-top">Bulacan State University</div><div class="ab-id-body"><div class="ab-id-photo">Photo</div><div><small>Name</small><b>{profile.name}</b><small>Course</small><b>BS Information Technology</b><small>Major</small><b>Web Development</b></div></div><div class="ab-id-foot"><span>Class of 2019</span><span class="ab-id-bars"></span></div></div>
        </div>
        <p class="ab-hint">Grab the card and swing it.</p>
      </div>
    </section>

    {/* 8 */}
    <section class="ab" id="idea-8"><div class="ab-top"><span class="idea-tag"><b>8</b>{IDEAS[7][1]}<em>{NOTES[8][0]}</em></span><p>{NOTES[8][1]}</p></div>
      <div class="ab-stage ab-passport" data-passport>
        <div class="ab-page-l"><small>Passport · Pasaporte</small><b>Grant Dev14</b><dl><dt>Nationality</dt><dd>Filipino</dd><dt>Profession</dt><dd>Website developer</dd><dt>Valid for</dt><dd>Shopify · Webflow · WordPress</dd></dl><p class="ab-mrz">P&lt;PHLGRANT&lt;&lt;DEV14&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</p></div>
        <div class="ab-page-r">{[['Philippines', 'Home base', 'c', 245, -8], ['BSIT', 'Graduated 2019', 'r', 20, 6], ['Team lead', '2019 – 2021', 'c', 150, -3], ['Agency work', 'UK · 2021 – 2022', 'r', 300, 9], ['Senior Shopify', '2022 – 2026', 'c', 60, -11], ['Remote', 'Worldwide', 'r', 200, 4]].map(([a, b, s, h, r], i) => <span class={`ab-stamp s-${s}`} style={`--h:${h};--r:${r}deg;--i:${i}`}><b>{a}</b><small>{b}</small></span>)}</div>
      </div>
    </section>

    {/* 9 */}
    <section class="ab" id="idea-9"><div class="ab-top"><span class="idea-tag"><b>9</b>{IDEAS[8][1]}<em>{NOTES[9][0]}</em></span><p>{NOTES[9][1]}</p></div>
      <div class="ab-stage ab-kb-stage" data-kb>
        <p class="ab-kb-read" aria-live="polite">Type a letter, or hover a key.</p>
        <div class="ab-kb">{allTools.map((t) => <button type="button" class="ab-key" style={`--h:${t.h}`} data-t={t.t} data-g={t.g}><small>{t.t[0]}</small>{t.t}</button>)}<span class="ab-key ab-space" aria-hidden="true"></span></div>
      </div>
    </section>

    {/* 10 */}
    <section class="ab" id="idea-10"><div class="ab-top"><span class="idea-tag"><b>10</b>{IDEAS[9][1]}<em>{NOTES[10][0]}</em></span><p>{NOTES[10][1]}</p></div>
      <div class="ab-stage ab-orbit" data-orbit>
        <div class="ab-sys">
          <span class="ab-sun">Grant</span>
          {toolGroups.map((g, k) => <div class="ab-ring" style={`--r:${[66, 40, 92][k]}%;--dur:${[60, 90, 120][k]}s;--dir:${k % 2 ? -1 : 1};--h:${g.h}`}>{g.tools.map((t, i) => <span class="ab-planet" style={`--a:${(360 / g.tools.length) * i}deg`}><b>{t}</b></span>)}</div>)}
        </div>
        <ul class="ab-orbit-key">{toolGroups.map((g) => <li style={`--h:${g.h}`}><i></i>{g.label} <span>{g.tools.length}</span></li>)}</ul>
      </div>
    </section>

    {/* 11 */}
    <section class="ab" id="idea-11"><div class="ab-top"><span class="idea-tag"><b>11</b>{IDEAS[10][1]}<em>{NOTES[11][0]}</em></span><p>{NOTES[11][1]}</p></div>
      <div class="ab-stage ab-xray-stage"><div class="ab-xray" data-xray>
        <img src={img('tero')} alt="The Tero homepage" width="960" height="540" />
        <div class="ab-xray-code" aria-hidden="true"><pre>{`{% section 'header' %}
<main id="MainContent">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'hero' %}
        <h1>{{ block.settings.title }}</h1>
        {{ block.settings.video | video_tag:
           autoplay: true, muted: true }}
      {% when 'cta' %}
        <a href="{{ block.settings.link }}"
           class="button">Join Tero</a>
    {% endcase %}
  {% endfor %}
</main>
{% section 'footer' %}
<!-- loading="lazy" · width · height -->
<!-- schema.org · og:image · canonical -->`}</pre></div>
        <span class="ab-lens-ring" aria-hidden="true"></span>
      </div><p class="ab-hint">Move over the page to look underneath.</p></div>
    </section>

    {/* 12 */}
    <section class="ab" id="idea-12"><div class="ab-top"><span class="idea-tag"><b>12</b>{IDEAS[11][1]}<em>{NOTES[12][0]}</em></span><p>{NOTES[12][1]}</p></div>
      <div class="ab-stage ab-sketch-stage" data-sketch>
        <div class="ab-sketch">
          <img src={img('tero')} alt="The finished Tero homepage" width="960" height="540" />
          <svg viewBox="0 0 960 540" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M28 30 L932 33 L930 510 L30 508 Z" />
            <path pathLength="1" d="M40 72 L920 74" />
            <path pathLength="1" d="M60 46 L150 47 M780 48 L900 46" />
            <path pathLength="1" d="M70 200 L460 196 M70 250 L400 252 M70 300 L330 298" />
            <path pathLength="1" d="M70 360 L230 358 L232 404 L72 406 Z" />
