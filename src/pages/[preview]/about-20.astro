  .ab-sun2 { position: absolute; left: calc(12% + var(--d) * 64%); top: calc(70% - sin(calc(var(--d) * 180deg)) * 50%); width: 70px; height: 70px; border-radius: 50%; background: radial-gradient(circle, oklch(0.95 0.12 85), oklch(0.8 0.17 60)); box-shadow: 0 0 60px oklch(0.85 0.15 75 / 0.8); transition: left 0.6s var(--ease), top 0.6s var(--ease); }
