  @media (max-width: 640px) { .ab-org { min-height: 600px; } .ab-node { min-width: 0; padding: 8px 10px; } .ab-node b { font-size: 12px; } .ab-node small { font-size: 9.5px; } }

  /* 14 this, not that */
  .ab-tnt { background: var(--bg); border: 1px solid var(--line); }
