  .ab-ask-results { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 8px; min-height: 60px; }
  .ab-ask-results li { padding: 16px 18px; border-radius: 14px; background: var(--bg); font-size: 16px; animation: ab-up 0.4s var(--ease) both; animation-delay: calc(var(--i) * 60ms); }
  .ab-ask-results mark { background: oklch(0.9 0.12 95); border-radius: 3px; padding: 0 2px; }
  .ab-ask-results .none { color: var(--muted); } .ab-ask-results a { color: var(--ink); text-decoration: underline; }

  /* 19 fold */
  .ab-fold-stage { display: grid; justify-items: center; gap: 24px; background: oklch(0.9 0.01 260); perspective: 1600px; }
  .ab-fold { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: min(960px, 100%); transform-style: preserve-3d; }
  .ab-panel { padding: 26px 22px; background: #fff; font-size: 12.5px; min-height: 420px; transition: transform 1.1s var(--ease), box-shadow 1.1s; box-shadow: inset 0 0 0 1px oklch(0.92 0 0); }
  .ab-panel p { margin: 0 0 10px; } .ab-panel small { color: var(--muted); }
  .ab-panel h5 { margin: 18px 0 8px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); } .ab-panel h5:first-child { margin-top: 0; }
  .ab-cv-name { display: block; font: 800 34px/1 "Big Shoulders Display", sans-serif; margin-bottom: 6px; }
  .ab-cv-tools { line-height: 1.7; }
  .ab-panel.p1 { transform-origin: right; transform: rotateY(-120deg); box-shadow: inset -60px 0 60px -30px oklch(0 0 0 / 0.25); }
  .ab-panel.p3 { transform-origin: left; transform: rotateY(120deg); box-shadow: inset 60px 0 60px -30px oklch(0 0 0 / 0.25); }
  .ab-fold-stage.is-open .ab-panel.p1, .ab-fold-stage.is-open .ab-panel.p3 { transform: none; box-shadow: inset 0 0 0 1px oklch(0.92 0 0); }
  .ab-fold-stage.is-open .ab-panel.p3 { transition-delay: 0.35s; }
  @media (max-width: 760px) { .ab-fold { grid-template-columns: 1fr; } .ab-panel { min-height: 0; } .ab-panel.p1 { transform-origin: bottom; transform: rotateX(110deg); } .ab-panel.p3 { transform-origin: top; transform: rotateX(-110deg); } }

  /* 20 signature */
  .ab-sign { text-align: center; display: grid; justify-items: center; gap: 4px; background: #fffdf8; }
  .ab-sign-pre { margin: 0; font-size: clamp(18px, 2vw, 24px); color: var(--muted); max-width: 560px; }
  .ab-sig { width: min(560px, 100%); height: auto; margin: -6px 0 6px; }
  .ab-sig text { font: italic 400 150px "Snell Roundhand", "Brush Script MT", "Segoe Script", cursive; fill: transparent; stroke: oklch(0.3 0.1 255); stroke-width: 2; stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .ab-sig path { fill: none; stroke: oklch(0.3 0.1 255); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .ab-sign.is-signed .ab-sig text { animation: ab-sign 2.6s ease-in-out forwards; }
  .ab-sign.is-signed .ab-sig path { animation: ab-draw 0.7s ease-out 2.4s forwards; }
  @keyframes ab-sign { 80% { stroke-dashoffset: 0; fill: transparent; } 100% { stroke-dashoffset: 0; fill: oklch(0.3 0.1 255); } }

  .ab-more-head { padding: 90px 0 20px; border-top: 1px solid var(--line); }
  .ab-more-head h2 { font-size: clamp(56px, 9vw, 140px); margin: 12px 0 0; }

  /* 21 inspect */
  .ab-inspect { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); padding: 0; background: oklch(0.17 0.01 260); }
  .ab-browser { position: relative; background: #fff; }
  .ab-browser-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--surface); }
  .ab-browser-bar > span { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .ab-browser-bar i { margin-left: 10px; font-style: normal; font-size: 12px; color: var(--muted); }
  .ab-inspect-btn { margin-left: auto; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); font: 600 12px Archivo, sans-serif; cursor: pointer; }
  .ab-inspect-btn[aria-pressed='true'] { background: oklch(0.55 0.15 245); color: #fff; border-color: transparent; }
  .ab-insp-page { padding: clamp(28px, 4vw, 52px); }
  .ab-insp-page h3 { margin: 0 0 18px; font: 800 clamp(44px, 6vw, 84px)/0.95 "Big Shoulders Display", sans-serif; width: fit-content; }
  .ab-insp-page p { font-size: clamp(17px, 1.8vw, 22px); line-height: 1.5; margin: 0 0 14px; max-width: 640px; }
  .ab-insp-page a { display: inline-block; margin-top: 10px; font-weight: 600; text-decoration: underline; }
  .ab-inspect:not(.is-off) [data-el] { cursor: crosshair; }
  .ab-insp-box { position: absolute; pointer-events: none; opacity: 0; background: oklch(0.72 0.12 245 / 0.28); outline: 1.5px solid oklch(0.58 0.16 245); box-shadow: 0 0 0 7px oklch(0.88 0.1 75 / 0.38); border-radius: 2px; transition: left 0.35s var(--ease), top 0.35s var(--ease), width 0.35s var(--ease), height 0.35s var(--ease), opacity 0.2s; }
  .ab-insp-box.on { opacity: 1; }
  .ab-inspect.is-off .ab-insp-box { opacity: 0; }
  .ab-insp-tag { position: absolute; left: -7px; bottom: calc(100% + 10px); padding: 4px 8px; border-radius: 4px; background: oklch(0.25 0.02 260); color: #fff; font: 11px ui-monospace, Menlo, monospace; white-space: nowrap; }
  .ab-devtools { color: oklch(0.85 0 0); font: 13px/1.7 ui-monospace, "SF Mono", Menlo, monospace; border-left: 1px solid oklch(0.3 0.01 260); }
  .ab-dt-tabs { display: flex; gap: 16px; padding: 12px 16px; border-bottom: 1px solid oklch(0.3 0.01 260); font-family: Archivo, sans-serif; font-size: 12px; color: oklch(0.6 0 0); }
  .ab-dt-tabs b { color: #fff; border-bottom: 2px solid oklch(0.65 0.15 245); padding-bottom: 10px; margin-bottom: -13px; }
  .ab-dt-code { margin: 0; padding: 18px 16px; white-space: pre-wrap; min-height: 220px; }
  .ab-dt-code .sel { color: oklch(0.82 0.13 85); } .ab-dt-code .k { color: oklch(0.76 0.13 330); } .ab-dt-code .v { color: oklch(0.82 0.1 200); } .ab-dt-code .c { color: oklch(0.55 0 0); }
  @media (max-width: 800px) { .ab-inspect { grid-template-columns: 1fr; } .ab-devtools { border-left: 0; border-top: 1px solid oklch(0.3 0.01 260); } .ab-dt-code { min-height: 150px; font-size: 12px; } }

  /* 22 morph */
  .ab-morph { padding-bottom: 30px; }
  .ab-morph-cv { display: block; width: 100%; height: clamp(180px, 30vw, 400px); touch-action: pan-y; cursor: crosshair; }
  .ab-morph-cap { margin: 14px 0 12px; text-align: center; font-size: 18px; font-weight: 600; }
  .ab-morph-dots { display: flex; justify-content: center; gap: 10px; }
  .ab-morph-dots button { width: 11px; height: 11px; padding: 0; border-radius: 50%; border: 0; background: var(--line); cursor: pointer; transition: transform 0.3s, background 0.3s; }
  .ab-morph-dots button[aria-pressed='true'] { background: var(--ink); transform: scale(1.3); }

  /* 23 window */
  .ab-window-stage { --dark: 0; --sky1: oklch(0.7 0.11 240); --sky2: oklch(0.9 0.05 220); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(24px, 5vw, 70px); align-items: center; background: oklch(0.92 0.025 70); }
