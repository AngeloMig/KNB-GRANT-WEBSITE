<script>
  type Data = { stories: { k: string; big: string; small: string }[]; facts: [string, string][]; tools: { t: string; g: string; h: number }[]; words: string[]; wordCaptions: string[]; tracks: { company: string; role: string; dates: string; summary: string; tags: string[]; len: string }[]; base: string };
  const D: Data = JSON.parse(document.getElementById('ab-data')!.textContent!);
  const root = document.documentElement;
  const motion = () => root.classList.contains('motion') && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const onView = (el: Element, fn: () => void, threshold = 0.35) => { const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); fn(); } }, { threshold }); io.observe(el); };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const scrollFx = (fn: () => void) => { let q = false; addEventListener('scroll', () => { if (!q) { q = true; requestAnimationFrame(() => { q = false; fn(); }); } }, { passive: true }); fn(); };

  // 1 ─ Bio dial
  document.querySelectorAll<HTMLElement>('[data-dial]').forEach((box) => {
    const btns = [...box.querySelectorAll<HTMLButtonElement>('[data-len]')];
    const set = (k: string) => {
      btns.forEach((b, i) => { b.setAttribute('aria-pressed', String(b.dataset.len === k)); if (b.dataset.len === k) box.style.setProperty('--i', String(i)); });
      box.querySelectorAll<HTMLElement>('[data-bio]').forEach((d) => (d.hidden = d.dataset.bio !== k));
      const words = box.querySelector<HTMLElement>(`[data-bio="${k}"]`)!.textContent!.trim().split(/\s+/).length;
      box.querySelector('.ab-dial-meta')!.textContent = `${words} words · about ${Math.max(5, Math.round(words / 3.8 / 5) * 5)} seconds to read`;
    };
    btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.len!)));
    set('medium');
  });

  // 2 ─ Words light up on scroll
  document.querySelectorAll<HTMLElement>('[data-lit]').forEach((box) => {
    const words = [...box.querySelectorAll('span')];
    scrollFx(() => { const r = box.getBoundingClientRect(); const p = motion() ? Math.min(1, Math.max(0, (innerHeight * 0.8 - r.top) / (r.height + innerHeight * 0.2))) : 1; const n = Math.round(p * words.length); words.forEach((w, i) => w.classList.toggle('on', i < n)); });
  });

  // 3 ─ Desk
  document.querySelectorAll<HTMLElement>('[data-desk]').forEach((box) => {
    const say = box.querySelector('.ab-desk-say')!;
    box.querySelectorAll<HTMLButtonElement>('.ab-spot').forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.say === 'clock' ? `Manila, GMT+8. It’s ${new Date().toLocaleTimeString('en-US', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' })} here right now, so probably on coffee number two.` : b.dataset.say!;
      say.textContent = t; say.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'ease-out' });
      box.querySelectorAll('.ab-spot').forEach((x) => x.classList.toggle('seen', x === b || x.classList.contains('seen')));
    }));
  });

  // 4 ─ Polaroids
  document.querySelectorAll<HTMLElement>('[data-polas]').forEach((box) => {
    const stack = box.querySelector<HTMLElement>('.ab-pola-stack')!;
    let sx = 0, sy = 0, dx = 0, dy = 0, card: HTMLElement | null = null;
    const top = () => stack.lastElementChild as HTMLElement;
    stack.addEventListener('pointerdown', (e) => { card = top(); if (!(e.target as HTMLElement).closest('.ab-pola') || !card) return; sx = e.clientX; sy = e.clientY; card.setPointerCapture(e.pointerId); card.style.transition = 'none'; });
    stack.addEventListener('pointermove', (e) => { if (!card || !card.hasPointerCapture(e.pointerId)) return; dx = e.clientX - sx; dy = e.clientY - sy; card.style.transform = `translate(${dx}px, ${dy}px) rotate(${dx / 12}deg)`; });
    const release = async () => {
      if (!card) return; const c = card; card = null; c.style.transition = '';
      if (Math.hypot(dx, dy) > 90) { c.style.transform = `translate(${dx * 4}px, ${dy * 4}px) rotate(${dx / 4}deg)`; c.style.opacity = '0'; await wait(380); c.style.transition = 'none'; stack.prepend(c); c.style.transform = ''; c.style.opacity = ''; void c.offsetWidth; c.style.transition = ''; }
      else c.style.transform = '';
      dx = dy = 0;
    };
    stack.addEventListener('pointerup', release); stack.addEventListener('pointercancel', release);
  });

  // 5 ─ Git log types out
  document.querySelectorAll<HTMLElement>('[data-term]').forEach((box) => {
    const lines = [...box.querySelectorAll<HTMLElement>('.ab-l')];
    if (!motion()) { lines.forEach((l) => l.classList.add('on')); return; }
    onView(box, async () => { for (const l of lines) { l.classList.add('on'); await wait(l === lines[0] ? 700 : 220); } });
  });

  // 6 ─ Level up
  document.querySelectorAll<HTMLElement>('[data-levels]').forEach((box) => {
    const items = [...box.querySelectorAll<HTMLElement>('.ab-lv-list li')], toast = box.querySelector<HTMLElement>('.ab-toast')!, lv = box.querySelector('.ab-xp-lv')!;
    onView(box, async () => {
      for (let i = 0; i < items.length; i++) {
        box.style.setProperty('--xp', String((i + 1) / items.length)); await wait(motion() ? 700 : 0);
        items[i].classList.add('on'); lv.textContent = `LV ${i + 1}`;
        toast.textContent = `Level ${i + 1} unlocked: ${items[i].querySelector('b')!.textContent}`; toast.classList.remove('show'); void toast.offsetWidth; toast.classList.add('show');
        await wait(motion() ? 900 : 0);
      }
    });
  });

  // 7 ─ Lanyard swing (a damped pendulum)
  document.querySelectorAll<HTMLElement>('[data-lanyard]').forEach((box) => {
    const swing = box.querySelector<HTMLElement>('.ab-swing')!;
    let a = motion() ? 0.5 : 0, v = 0, drag = false, pivot = { x: 0, y: 0 }, running = false;
    const step = () => { if (!drag) { v += -0.012 * Math.sin(a); v *= 0.985; a += v; } swing.style.transform = `rotate(${a}rad)`; if (drag || Math.abs(v) > 0.0004 || Math.abs(a) > 0.002) requestAnimationFrame(step); else { running = false; a = 0; swing.style.transform = ''; } };
    const go = () => { if (!running) { running = true; requestAnimationFrame(step); } };
    swing.addEventListener('pointerdown', (e) => { const r = box.getBoundingClientRect(); pivot = { x: r.left + r.width / 2, y: r.top + 10 }; drag = true; swing.setPointerCapture(e.pointerId); go(); });
    swing.addEventListener('pointermove', (e) => { if (!drag) return; const na = Math.atan2(-(e.clientX - pivot.x), e.clientY - pivot.y); v = na - a; a = Math.max(-1.2, Math.min(1.2, na)); });
    swing.addEventListener('pointerup', () => { drag = false; go(); });
    onView(box, go);
  });

  // 8 ─ Passport stamps
  document.querySelectorAll<HTMLElement>('[data-passport]').forEach((box) => onView(box, () => box.classList.add('is-stamped'), 0.4));

  // 9 ─ Keyboard
  document.querySelectorAll<HTMLElement>('[data-kb]').forEach((box) => {
    const keys = [...box.querySelectorAll<HTMLButtonElement>('.ab-key[data-t]')], read = box.querySelector('.ab-kb-read')!;
    const groups: Record<string, string> = { dev: 'Development', platforms: 'Platforms', design: 'Design & integrations' };
    const press = (list: HTMLButtonElement[], label: string) => { list.forEach((k) => { k.classList.remove('down'); void k.offsetWidth; k.classList.add('down'); setTimeout(() => k.classList.remove('down'), 380); }); read.textContent = label; };
    keys.forEach((k) => { k.addEventListener('pointerenter', () => press([k], `${k.dataset.t} · ${groups[k.dataset.g!]}`)); k.addEventListener('click', () => press([k], `${k.dataset.t} · ${groups[k.dataset.g!]}`)); });
    let seen = false; new IntersectionObserver(([e]) => (seen = e.isIntersecting)).observe(box);
    addEventListener('keydown', (e) => { if (!seen || e.metaKey || e.ctrlKey || (e.target as HTMLElement).matches('input,textarea,select')) return; const l = e.key.toUpperCase(); if (!/^[A-Z]$/.test(l)) return; const hit = keys.filter((k) => k.dataset.t![0].toUpperCase() === l); press(hit, hit.length ? `${l}: ${hit.map((k) => k.dataset.t).join(', ')}` : `${l}: nothing in the toolkit starts with ${l}`); });
  });

  // 11 ─ X-ray lens
  document.querySelectorAll<HTMLElement>('[data-xray]').forEach((box) => {
    let auto = true, t0 = performance.now();
    const set = (x: number, y: number) => { box.style.setProperty('--x', `${x}px`); box.style.setProperty('--y', `${y}px`); };
    box.addEventListener('pointermove', (e) => { auto = false; const r = box.getBoundingClientRect(); set(e.clientX - r.left, e.clientY - r.top); });
    box.addEventListener('pointerleave', () => { auto = true; t0 = performance.now(); });
    const loop = (now: number) => { if (auto) { const r = box.getBoundingClientRect(); const t = (now - t0) / 1000 * (motion() ? 0.6 : 0); set(r.width * (0.5 + 0.3 * Math.cos(t)), r.height * (0.5 + 0.25 * Math.sin(t * 1.6))); } requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  });

  // 12 ─ Sketch to site
  document.querySelectorAll<HTMLElement>('[data-sketch]').forEach((box) => {
    const play = () => { box.classList.remove('is-drawn'); void box.offsetWidth; box.classList.add('is-drawn'); };
    onView(box, play, 0.4); box.querySelector('[data-resketch]')!.addEventListener('click', play);
  });

  // 13 ─ Org chart
  document.querySelectorAll<HTMLElement>('[data-org]').forEach((box) => {
    onView(box, () => box.classList.add('is-drawn'), 0.4);
    const say = box.querySelector('.ab-org-say')!;
    box.querySelectorAll<HTMLButtonElement>('.ab-node').forEach((n) => n.addEventListener('click', () => { say.textContent = `${n.querySelector('b')!.textContent}: ${n.dataset.d}`; box.querySelectorAll('.ab-node').forEach((x) => x.classList.toggle('on', x === n)); }));
  });

  // 14 ─ This, not that
  document.querySelectorAll<HTMLElement>('[data-tnt]').forEach((box) => onView(box, () => box.classList.add('is-in'), 0.3));

  // 15 ─ Trading card tilt + flip
  document.querySelectorAll<HTMLButtonElement>('[data-tcg]').forEach((card) => {
    card.addEventListener('pointermove', (e) => { const r = card.getBoundingClientRect(); const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height; card.style.setProperty('--rx', `${(0.5 - py) * 18}deg`); card.style.setProperty('--ry', `${(px - 0.5) * 22}deg`); card.style.setProperty('--px', `${px * 100}%`); card.style.setProperty('--py', `${py * 100}%`); });
    card.addEventListener('pointerleave', () => { card.style.setProperty('--rx', '0deg'); card.style.setProperty('--ry', '0deg'); });
    card.addEventListener('click', () => card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true')));
  });

  // 16 ─ Stories
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((box) => {
    const slides = [...box.querySelectorAll<HTMLElement>('.ab-slide')], bars = [...box.querySelectorAll<HTMLElement>('.ab-story-bars span')];
    let i = 0, timer = 0, seen = false;
    const show = (n: number) => { i = (n + slides.length) % slides.length; slides.forEach((s, k) => (s.hidden = k !== i)); bars.forEach((b, k) => { b.className = k < i ? 'done' : k === i ? 'now' : ''; }); clearTimeout(timer); if (seen && motion()) timer = window.setTimeout(() => show(i + 1), 4000); };
    box.querySelector('.ab-tap.next')!.addEventListener('click', () => show(i + 1));
    box.querySelector('.ab-tap.prev')!.addEventListener('click', () => show(i - 1));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; show(i); }, { threshold: 0.5 }).observe(box);
  });

  // 17 ─ Day sky
  document.querySelectorAll<HTMLElement>('[data-day]').forEach((box) => {
    const items = [...box.querySelectorAll<HTMLElement>('li')], time = box.querySelector('.ab-time')!;
    scrollFx(() => {
      const mid = innerHeight * 0.5; let cur = items[0];
      items.forEach((li) => { const r = li.getBoundingClientRect(); if (r.top < mid) cur = li; li.classList.toggle('on', li === cur); });
      const idx = items.indexOf(cur); box.style.setProperty('--d', String(idx / (items.length - 1))); time.textContent = cur.dataset.t!;
    });
  });

  // 18 ─ Ask
  document.querySelectorAll<HTMLElement>('[data-ask]').forEach((box) => {
    const input = box.querySelector('input')!, out = box.querySelector('.ab-ask-results')!;
    const run = () => {
      const q = input.value.trim().toLowerCase(); if (!q) { out.innerHTML = ''; return; }
      const words = q.split(/\s+/);
      const hits = D.facts.map(([k, a]) => ({ a, s: words.reduce((s, w) => s + (k.includes(w) ? 2 : 0) + (a.toLowerCase().includes(w) ? 1 : 0), 0) })).filter((h) => h.s > 0).sort((a, b) => b.s - a.s).slice(0, 4);
      const mark = (t: string) => words.reduce((s, w) => (w.length > 1 ? s.replace(new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig'), '<mark>$1</mark>') : s), t.replace(/</g, '&lt;'));
      out.innerHTML = hits.length ? hits.map((h, i) => `<li style="--i:${i}">${mark(h.a)}</li>`).join('') : `<li class="none">Nothing yet on “${q.replace(/</g, '&lt;')}”. Try “shopify” or “team”, or <a href="../../contact/">ask Grant directly</a>.</li>`;
    };
    input.addEventListener('input', run);
    box.querySelectorAll<HTMLButtonElement>('.ab-ask-sugg button').forEach((b) => b.addEventListener('click', () => { input.value = b.textContent!; run(); input.focus(); }));
    addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); box.scrollIntoView({ block: 'center', behavior: motion() ? 'smooth' : 'auto' }); input.focus({ preventScroll: true }); } });
  });

  // 19 ─ Résumé unfolds
  document.querySelectorAll<HTMLElement>('[data-fold]').forEach((box) => onView(box, () => box.classList.add('is-open'), 0.35));

  // 20 ─ Signature
  document.querySelectorAll<HTMLElement>('[data-sign]').forEach((box) => onView(box, () => box.classList.add('is-signed'), 0.5));

  // 21 ─ Inspect element
  document.querySelectorAll<HTMLElement>('[data-inspect]').forEach((box) => {
    const browser = box.querySelector<HTMLElement>('.ab-browser')!, hl = box.querySelector<HTMLElement>('.ab-insp-box')!, tag = hl.querySelector<HTMLElement>('.ab-insp-tag')!;
    const code = box.querySelector<HTMLElement>('.ab-dt-code')!, btn = box.querySelector<HTMLButtonElement>('.ab-inspect-btn')!;
    const els = [...box.querySelectorAll<HTMLElement>('[data-el]')];
    let on = true, auto = 0, i = 0;
    const show = (el: HTMLElement) => {
      const b = browser.getBoundingClientRect(), r = el.getBoundingClientRect();
      hl.style.cssText = `left:${r.left - b.left - 3}px;top:${r.top - b.top - 3}px;width:${r.width + 6}px;height:${r.height + 6}px`;
      hl.classList.add('on');
      tag.textContent = `${el.dataset.el}  ${Math.round(r.width)} × ${Math.round(r.height)}`;
      code.innerHTML = `<span class="sel">.grant ${el.dataset.el}</span> {\n${el.dataset.css!.split('\n').map((l) => { const [k, ...v] = l.split(':'); return `  <span class="k">${k}</span>: <span class="v">${v.join(':').trim().replace(/\/\*.*?\*\//, (m) => `<span class="c">${m}</span>`)}</span>`; }).join('\n')}\n}`;
      code.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 250 });
    };
    const stopAuto = () => { clearInterval(auto); auto = 0; };
    const startAuto = () => { if (!on || auto || !motion()) return; auto = window.setInterval(() => { i = (i + 1) % els.length; show(els[i]); }, 2300); };
    els.forEach((el, k) => {
      el.addEventListener('pointerenter', () => { if (!on) return; stopAuto(); i = k; show(el); });
      el.addEventListener('click', (e) => { if (!on) return; e.preventDefault(); stopAuto(); i = k; show(el); });
    });
    browser.addEventListener('pointerleave', startAuto);
    btn.addEventListener('click', () => {
      on = !on; btn.setAttribute('aria-pressed', String(on)); box.classList.toggle('is-off', !on);
      if (on) { show(els[i]); startAuto(); } else { stopAuto(); hl.classList.remove('on'); code.innerHTML = '<span class="c">/* Inspect is off: the page works as normal.\n   Turn it on to look inside. */</span>'; }
    });
    onView(box, () => { show(els[0]); startAuto(); });
    addEventListener('resize', () => { if (on) show(els[i]); });
  });

  // 22 ─ Dots that become words
  document.querySelectorAll<HTMLElement>('[data-morph]').forEach((box) => {
    const cv = box.querySelector('canvas')!, ctx = cv.getContext('2d')!, cap = box.querySelector('.ab-morph-cap')!;
    const pick = [...box.querySelectorAll<HTMLButtonElement>('[data-w]')];
    type P = { x: number; y: number; tx: number; ty: number; vx: number; vy: number; c: number };
    let W = 0, H = 0, gap = 6, ps: P[] = [], targets: [number, number][][] = [], cur = 0, seen = false, mx = -1e4, my = -1e4, timer = 0, built = false;
    const sample = (word: string) => {
      const o = document.createElement('canvas'); o.width = W; o.height = H; const c = o.getContext('2d', { willReadFrequently: true })!;
      let size = H * 0.82; c.font = `800 ${size}px "Big Shoulders Display", sans-serif`;
      const w = c.measureText(word).width; if (w > W * 0.92) { size *= (W * 0.92) / w; c.font = `800 ${size}px "Big Shoulders Display", sans-serif`; }
      c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillText(word, W / 2, H / 2 + size * 0.05);
      const d = c.getImageData(0, 0, W, H).data, out: [number, number][] = [];
      for (let y = 0; y < H; y += gap) for (let x = 0; x < W; x += gap) if (d[(y * W + x) * 4 + 3] > 128) out.push([x, y]);
      return out;
    };
    const go = (k: number) => {
      cur = k; const t = targets[k];
      for (let i = ps.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [ps[i], ps[j]] = [ps[j], ps[i]]; }
      ps.forEach((p, i) => { const q = t[i % t.length]; p.tx = q[0]; p.ty = q[1]; if (!motion()) { p.x = p.tx; p.y = p.ty; } });
      cap.textContent = D.wordCaptions[k]; pick.forEach((d, i) => d.setAttribute('aria-pressed', String(i === k)));
      clearTimeout(timer); if (motion()) timer = window.setTimeout(() => { if (seen) go((cur + 1) % targets.length); }, 3400);
    };
    const build = async () => {
      await document.fonts.load('800 100px "Big Shoulders Display"');
      const r = cv.getBoundingClientRect(); W = Math.round(r.width); H = Math.round(r.height); gap = W < 600 ? 4 : 6;
      const dpr = Math.min(2, devicePixelRatio || 1); cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      targets = D.words.map(sample);
      const n = Math.max(...targets.map((t) => t.length));
      ps = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, tx: 0, ty: 0, vx: 0, vy: 0, c: Math.random() }));
      built = true; go(cur);
    };
    const ink = getComputedStyle(root).getPropertyValue('--ink').trim() || '#222';
    const frame = () => {
      if (seen && built) {
        ctx.clearRect(0, 0, W, H);
        const s = gap * 0.62, h = s / 2;
        for (const p of ps) {
          const dx = p.x - mx, dy = p.y - my, d2 = dx * dx + dy * dy;
          if (d2 < 7000) { const d = Math.sqrt(d2) || 1, f = ((7000 - d2) / 7000) * 4; p.vx += (dx / d) * f; p.vy += (dy / d) * f; }
          p.vx += (p.tx - p.x) * 0.05; p.vy += (p.ty - p.y) * 0.05; p.vx *= 0.8; p.vy *= 0.8; p.x += p.vx; p.y += p.vy;
        }
        ctx.fillStyle = ink; for (const p of ps) if (p.c > 0.07) ctx.fillRect(p.x - h, p.y - h, s, s);
        ctx.fillStyle = 'oklch(0.6 0.15 245)'; for (const p of ps) if (p.c <= 0.07) ctx.fillRect(p.x - h, p.y - h, s, s);
      }
      requestAnimationFrame(frame);
    };
    cv.addEventListener('pointermove', (e) => { const r = cv.getBoundingClientRect(); mx = e.clientX - r.left; my = e.clientY - r.top; });
    cv.addEventListener('pointerleave', () => { mx = my = -1e4; });
    pick.forEach((b, i) => b.addEventListener('click', () => go(i)));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen && !built) void build(); else if (seen) go(cur); }, { threshold: 0.2 }).observe(box);
    let rw = innerWidth; addEventListener('resize', () => { if (Math.abs(innerWidth - rw) > 40) { rw = innerWidth; void build(); } });
    requestAnimationFrame(frame);
  });

  // 23 ─ A window onto Manila (live time; the hours of the day are a guess)
  document.querySelectorAll<HTMLElement>('[data-window]').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('.ab-w-range')!;
    const stars = box.querySelector('.ab-stars')!;
    for (let i = 0; i < 70; i++) stars.insertAdjacentHTML('beforeend', `<i style="left:${Math.random() * 100}%;top:${Math.random() * 62}%;--d:${(Math.random() * 3).toFixed(2)}s;--s:${(0.6 + Math.random()).toFixed(2)}"></i>`);
    const lights = box.querySelector('.lights')!;
    for (let i = 0; i < 46; i++) lights.insertAdjacentHTML('beforeend', `<rect x="${(Math.random() * 590).toFixed(0)}" y="${(165 + Math.random() * 50).toFixed(0)}" width="5" height="6" style="--k:${Math.random().toFixed(2)}" />`);
    const manila = () => { const [h, m] = new Date().toLocaleTimeString('en-GB', { timeZone: 'Asia/Manila', hour12: false, hour: '2-digit', minute: '2-digit' }).split(':').map(Number); return (h % 24) * 60 + m; };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const mix = (A: number[], B: number[], t: number) => A.map((v, i) => lerp(v, B[i], t));
    const ok = (c: number[]) => `oklch(${c[0].toFixed(3)} ${c[1].toFixed(3)} ${c[2].toFixed(1)})`;
    const status = (h: number) => h < 6 ? 'Asleep. Your message will be the first thing he reads.' : h < 9 ? 'Coffee, then the inbox.' : h < 12 ? 'At the desk, building.' : h < 13 ? 'Lunch, away from the screen.' : h < 18 ? 'At the desk: reviews, fixes and calls.' : h < 22 ? 'Off the clock. Replies tomorrow morning.' : 'Winding down for the night.';
    let live = true;
    const set = (min: number) => {
      const h = min / 60;
      const dark = h < 5 || h > 20 ? 1 : h < 7 ? 1 - (h - 5) / 2 : h > 18 ? (h - 18) / 2 : 0;
      const dusk = Math.max(0, 1 - Math.abs(h - 18.4) / 1.3) + Math.max(0, 1 - Math.abs(h - 5.9) / 1.3);
      const top = mix([0.7, 0.11, 240], [0.17, 0.05, 275], dark);
      const bot = mix(mix([0.9, 0.05, 220], [0.3, 0.07, 285], dark), [0.78, 0.14, 50], Math.min(1, dusk) * 0.85);
      box.style.setProperty('--sky1', ok(top)); box.style.setProperty('--sky2', ok(bot)); box.style.setProperty('--dark', dark.toFixed(3));
      const sp = (h - 5.8) / 13, mp = ((h + 24 - 18.6) % 24) / 11.2;
      box.style.setProperty('--sun-x', `${8 + sp * 84}%`); box.style.setProperty('--sun-y', `${78 - Math.sin(Math.PI * Math.min(1, Math.max(0, sp))) * 62}%`); box.style.setProperty('--sun-o', sp > 0 && sp < 1 ? '1' : '0');
      box.style.setProperty('--moon-x', `${8 + mp * 84}%`); box.style.setProperty('--moon-y', `${70 - Math.sin(Math.PI * Math.min(1, Math.max(0, mp))) * 52}%`); box.style.setProperty('--moon-o', mp > 0 && mp < 1 ? '1' : '0');
      const t = new Date(2000, 0, 1, Math.floor(h), min % 60).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).toLowerCase();
      box.querySelector('.ab-w-time')!.textContent = t;
      box.querySelector('.ab-w-status')!.textContent = status(h);
      range.value = String(min);
      box.querySelector('.ab-kicker')!.textContent = live ? 'Manila, right now' : 'Manila, any time of day';
    };
    range.addEventListener('input', () => { live = false; set(Number(range.value)); });
    box.querySelector('.ab-w-now')!.addEventListener('click', () => { live = true; set(manila()); });
    set(manila()); setInterval(() => { if (live) set(manila()); }, 30000);
  });

  // 24 ─ Choose your own website
  document.querySelectorAll<HTMLElement>('[data-cyoa]').forEach((box) => {
    type Node = { t: string; c?: [string, string][]; end?: [string, string] };
    const S: Record<string, Node> = {
      start: { t: 'Your website isn’t pulling its weight, and something has to change. What’s the problem?', c: [['It’s slow, and sales are flat', 'slow'], ['It’s on the wrong platform', 'move'], ['I don’t have one yet', 'new']] },
      slow: { t: 'You were about to pay for a full redesign. Grant asks one question first: what’s actually slowing it down? A quick look finds oversized images, a pile of unused apps and a checkout that stalls on phones.', c: [['Fix those first', 'slowfix'], ['Redesign anyway', 'redesign']] },
      slowfix: { t: 'The fixes take days, not months. Pages load fast, checkout works on every phone, and the redesign budget stays in your pocket for now.', end: ['Get a free audit of your site', 'contact/#audit'] },
      redesign: { t: 'Fair enough. Grant plans the new site around what that first look found, so the new design is fast from day one, not just pretty.', end: ['Estimate your redesign', 'estimate/'] },
      move: { t: 'You want to move from WooCommerce to Shopify, but you’re worried about losing your Google rankings and your customers’ order history.', c: [['Tell Grant what worries you', 'movefear'], ['Move it yourself this weekend', 'diy']] },
      diy: { t: 'Saturday: export. Sunday: import. Monday: half the product images are missing and every old link leads nowhere. You call Grant anyway.', c: [['Start again, properly', 'movefear']] },
      movefear: { t: 'Every old page is mapped to its new address, products and customers come across, and the switch happens overnight. On Monday, Google finds everything where it expects it.', end: ['Estimate your migration', 'estimate/'] },
      new: { t: 'You have a brand, some photos and plenty of opinions, but no website. Shopify, Webflow or WordPress?', c: [['I sell products', 'newshop'], ['It mostly needs to look great', 'newflow']] },
      newshop: { t: 'Shopify, then. Grant builds the store around your products, sets up payments and shipping, and shows you how to run it yourself.', end: ['Estimate your new store', 'estimate/'] },
      newflow: { t: 'Webflow suits that: design-led, quick to edit, with no plugins to babysit. Grant turns your look into a site you can update yourself.', end: ['Estimate your new site', 'estimate/'] },
    };
    const page = box.querySelector<HTMLElement>('.ab-book-page')!, text = box.querySelector<HTMLElement>('.ab-book-text')!, choices = box.querySelector<HTMLElement>('.ab-book-choices')!, num = box.querySelector('.ab-book-n')!;
    let n = 0, token = 0;
    const show = async (id: string) => {
      const node = S[id], my = ++token; n++;
      num.textContent = `Page ${n}`; page.classList.remove('turn'); void page.offsetWidth; page.classList.add('turn');
      choices.innerHTML = ''; text.textContent = '';
      if (motion()) { for (let i = 1; i <= node.t.length; i += 2) { if (my !== token) return; text.textContent = node.t.slice(0, i); await wait(12); } }
      text.textContent = node.t;
      if (node.c) node.c.forEach(([label, to], i) => { const b = document.createElement('button'); b.type = 'button'; b.textContent = label; b.style.setProperty('--i', String(i)); b.addEventListener('click', () => show(to)); choices.append(b); });
      if (node.end) { choices.innerHTML = `<p class="ab-book-end">The end. Or the beginning.</p><div class="ab-book-cta"><a class="ab-btn" href="${D.base}${node.end[1]}">${node.end[0]}</a><button type="button" class="ab-btn ghost">Start over</button></div>`; choices.querySelector('button')!.addEventListener('click', () => { n = 0; show('start'); }); }
    };
    onView(box, () => show('start'), 0.3);
  });

  // 25 ─ The career, as an album
  document.querySelectorAll<HTMLElement>('[data-album]').forEach((box) => {
    const liner = box.querySelector('.ab-liner')!;
    const play = (btn: HTMLButtonElement, html: string) => {
      box.querySelectorAll('.ab-tracks button').forEach((b) => b.classList.toggle('on', b === btn));
      box.classList.remove('is-playing'); void box.offsetWidth; box.classList.add('is-playing');
      liner.innerHTML = html; liner.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 400, easing: 'ease-out' });
    };
    box.querySelectorAll<HTMLButtonElement>('[data-tr]').forEach((b) => b.addEventListener('click', () => { const t = D.tracks[Number(b.dataset.tr)]; play(b, `<h4>${t.role}</h4><p class="m">${t.company} · ${t.dates}</p><p>${t.summary}</p><p class="ft">Featuring ${t.tags.join(', ')}</p>`); }));
    const bonus = box.querySelector<HTMLButtonElement>('[data-bonus]')!;
    bonus.addEventListener('click', () => play(bonus, '<h4>Intro: BS Information Technology</h4><p class="m">Bulacan State University · 2019</p><p>A degree majoring in web development: where it all started.</p>'));
    onView(box, () => { if (motion()) setTimeout(() => box.querySelector<HTMLButtonElement>('[data-tr="0"]')!.click(), 500); }, 0.4);
  });
</script>

<style is:global>
  .ab-page { padding-bottom: 120px; }
  .ab-head { padding: 40px 0 70px; max-width: 900px; }
  .ab-head h1 { font-size: clamp(64px, 11vw, 170px); margin: 14px 0 22px; }
  .ab-head p { font-size: 17px; max-width: 660px; color: var(--muted); }
  .ab-head a { color: var(--ink); text-decoration: underline; }
  .ab { padding: 64px 0; border-top: 1px solid var(--line); }
  .ab-top { max-width: 820px; margin-bottom: 26px; }
  .ab-top p { margin: 0; color: var(--muted); }
  .ab-stage { position: relative; border-radius: 26px; background: var(--surface); padding: clamp(24px, 4vw, 56px); overflow: hidden; }
  .ab-btn { display: inline-flex; align-items: center; padding: 13px 22px; border-radius: 999px; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); font: 600 14px Archivo, sans-serif; cursor: pointer; text-decoration: none; }
  .ab-btn.ghost { background: transparent; color: var(--ink); }
  .ab-hint { margin: 18px 0 0; color: var(--muted); font-size: 13.5px; text-align: center; }
  @keyframes ab-up { from { opacity: 0; transform: translateY(12px); } }

  /* 1 */
  .ab-dial { --i: 1; }
  .ab-dial-switch { position: relative; display: inline-grid; grid-template-columns: repeat(3, 110px); padding: 5px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); }
  .ab-dial-switch button { position: relative; z-index: 1; padding: 10px 0; border: 0; background: none; font: 600 14px Archivo, sans-serif; cursor: pointer; transition: color 0.3s; }
  .ab-dial-switch button[aria-pressed='true'] { color: var(--bg); }
  .ab-dial-thumb { position: absolute; top: 5px; bottom: 5px; left: 5px; width: 110px; border-radius: 999px; background: var(--ink); transform: translateX(calc(var(--i) * 110px)); transition: transform 0.45s var(--ease); }
  .ab-dial-meta { margin: 14px 0 22px; font-size: 13px; color: var(--muted); }
  .ab-dial-text { max-width: 820px; }
  .ab-dial-text > div { animation: ab-up 0.5s var(--ease); }
  .ab-dial-text p { font-size: 17px; margin: 0 0 14px; }
  .ab-dial-text .ab-lead { font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2; letter-spacing: -0.02em; }
  @media (max-width: 480px) { .ab-dial-switch { grid-template-columns: repeat(3, 90px); } .ab-dial-thumb { width: 90px; transform: translateX(calc(var(--i) * 90px)); } }

  /* 2 */
  .ab-lit p { margin: 0; font-size: clamp(38px, 6.2vw, 96px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; max-width: 1400px; }
  .ab-lit span { color: oklch(0.86 0 0); transition: color 0.35s; }
  .ab-lit span.on { color: var(--ink); }

  /* 3 desk */
  .ab-desk { background: oklch(0.82 0.04 60); }
  .ab-desktop { position: relative; aspect-ratio: 16 / 9; max-width: 1100px; margin: 0 auto; border-radius: 18px; background: repeating-linear-gradient(90deg, oklch(0.62 0.07 55) 0 3px, oklch(0.6 0.07 52) 3px 7px), oklch(0.6 0.07 55); box-shadow: inset 0 0 80px oklch(0.4 0.06 50 / 0.5); }
  .ab-obj { position: absolute; }
  .ab-laptop { left: 30%; top: 12%; width: 40%; aspect-ratio: 16 / 13; transform: rotate(-3deg); }
  .ab-screen { height: 56%; border-radius: 10px 10px 0 0; background: oklch(0.2 0 0) center / cover; border: 7px solid oklch(0.22 0 0); }
  .ab-keys { height: 44%; border-radius: 0 0 14px 14px; background: linear-gradient(oklch(0.8 0 0), oklch(0.72 0 0)); box-shadow: 0 16px 20px -10px oklch(0 0 0 / 0.5); position: relative; }
  .ab-keys::before { content: ''; position: absolute; inset: 12% 8% 40%; border-radius: 6px; background: repeating-linear-gradient(90deg, oklch(0.6 0 0) 0 7%, transparent 7% 8%), oklch(0.6 0 0 / 0.3); }
  .ab-keys::after { content: ''; position: absolute; left: 38%; right: 38%; bottom: 10%; height: 22%; border-radius: 6px; background: oklch(0.68 0 0); }
  .ab-notebook { left: 6%; top: 18%; width: 20%; aspect-ratio: 3 / 4; background: #fffdf3; border-radius: 4px 10px 10px 4px; transform: rotate(8deg); box-shadow: 0 14px 20px -12px oklch(0 0 0 / 0.5); padding: 14% 12%; display: grid; align-content: start; gap: 9%; }
  .ab-notebook i { height: 2px; background: oklch(0.55 0.1 250 / 0.6); border-radius: 2px; } .ab-notebook i.s { width: 60%; }
  .ab-notebook b { position: absolute; left: 0; top: 0; bottom: 0; width: 9%; background: oklch(0.55 0.15 25); border-radius: 4px 0 0 4px; }
  .ab-mug { left: 77%; top: 14%; width: 10%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 50% 50%, oklch(0.35 0.06 50) 0 55%, oklch(0.95 0 0) 56%); box-shadow: 0 10px 14px -8px oklch(0 0 0 / 0.6); }
  .ab-mug::after { content: ''; position: absolute; right: -24%; top: 35%; width: 30%; height: 30%; border: 5px solid oklch(0.95 0 0); border-radius: 50%; }
  .ab-steam { position: absolute; inset: -40% 20% 60%; display: flex; gap: 20%; justify-content: center; }
  .ab-steam i { width: 3px; height: 100%; border-radius: 3px; background: linear-gradient(transparent, oklch(1 0 0 / 0.7)); animation: ab-steam 2.6s ease-in-out infinite; }
  .ab-steam i:nth-child(2) { animation-delay: 0.6s; } .ab-steam i:nth-child(3) { animation-delay: 1.2s; }
  @keyframes ab-steam { 0% { opacity: 0; transform: translateY(10px) scaleY(0.6); } 50% { opacity: 1; } 100% { opacity: 0; transform: translateY(-14px) skewX(12deg); } }
  .ab-phone { left: 76%; top: 52%; width: 9%; aspect-ratio: 9 / 18; border-radius: 14px; background: oklch(0.18 0 0); transform: rotate(-14deg); padding: 6%; box-shadow: 0 12px 16px -10px oklch(0 0 0 / 0.6); }
  .ab-phone i { display: block; height: 100%; border-radius: 9px; background: linear-gradient(160deg, oklch(0.55 0.12 250), oklch(0.4 0.12 290)); }
  .ab-diploma { left: 8%; top: 64%; width: 25%; padding: 2.4% 2%; border-radius: 6px; background: #fdfaf0; border: 3px double oklch(0.6 0.08 80); transform: rotate(-5deg); text-align: center; display: grid; gap: 2px; box-shadow: 0 12px 16px -12px oklch(0 0 0 / 0.5); }
  .ab-diploma small { font-size: clamp(7px, 0.8vw, 11px); color: var(--muted); } .ab-diploma b { font: italic 600 clamp(9px, 1.15vw, 16px) Georgia, serif; }
  .ab-plant { left: 88%; top: 76%; width: 10%; aspect-ratio: 1; }
  .ab-plant i { position: absolute; inset: 0; border-radius: 50% 0; background: oklch(0.55 0.13 145); transform: rotate(calc(var(--k, 0) * 60deg)); transform-origin: 50% 50%; }
  .ab-plant i:nth-child(2) { --k: 1; background: oklch(0.6 0.13 140); } .ab-plant i:nth-child(3) { --k: 2; background: oklch(0.5 0.12 150); }
  .ab-spot { position: absolute; left: 50%; top: 50%; width: 24px; height: 24px; margin: -12px; border-radius: 50%; border: 3px solid #fff; background: oklch(0.6 0.2 30); cursor: pointer; box-shadow: 0 0 0 0 oklch(0.6 0.2 30 / 0.6); animation: ab-pulse 1.8s infinite; padding: 0; }
  .ab-spot.seen { background: oklch(0.55 0.15 150); animation: none; }
  @keyframes ab-pulse { 70% { box-shadow: 0 0 0 14px oklch(0.6 0.2 30 / 0); } 100% { box-shadow: 0 0 0 0 oklch(0.6 0.2 30 / 0); } }
  @media (max-width: 640px) { .ab-diploma { top: 58%; width: 30%; } .ab-desk-say { margin-top: 40px !important; font-size: 15px !important; } }
  .ab-desk-say { max-width: 680px; margin: 22px auto 0; text-align: center; font-size: 18px; font-weight: 500; min-height: 54px; }

  /* 4 polaroids */
  .ab-polas { background: oklch(0.93 0.02 80); }
  .ab-pola-stack { position: relative; width: min(320px, 76vw); aspect-ratio: 5 / 6; margin: 10px auto 0; touch-action: none; }
  .ab-pola { position: absolute; inset: 0; margin: 0; padding: 14px 14px 56px; background: #fff; box-shadow: 0 18px 30px -18px oklch(0 0 0 / 0.45); transform: rotate(var(--r)); transition: transform 0.45s var(--ease), opacity 0.35s; cursor: grab; user-select: none; }
  .ab-pola:last-child { box-shadow: 0 26px 40px -18px oklch(0 0 0 / 0.5); }
  .ab-pola-photo { height: 100%; display: grid; place-items: center; background: linear-gradient(140deg, oklch(0.85 0.07 var(--h)), oklch(0.62 0.1 calc(var(--h) + 40))); color: oklch(1 0 0 / 0.85); font-size: 13px; }
  .ab-pola figcaption { position: absolute; left: 0; right: 0; bottom: 14px; text-align: center; font: italic 600 18px "Bradley Hand", "Segoe Print", cursive; color: oklch(0.35 0 0); }

  /* 5 terminal */
  .ab-term { background: oklch(0.17 0.01 260); color: oklch(0.86 0 0); padding: 0; }
  .ab-term-bar { display: flex; gap: 7px; align-items: center; padding: 14px 18px; background: oklch(0.22 0.01 260); }
  .ab-term-bar span { width: 11px; height: 11px; border-radius: 50%; background: oklch(0.65 0.2 25); } .ab-term-bar span:nth-child(2) { background: oklch(0.8 0.15 85); } .ab-term-bar span:nth-child(3) { background: oklch(0.7 0.17 145); }
  .ab-term-bar b { margin-left: 12px; font: 500 12px ui-monospace, Menlo, monospace; color: oklch(0.65 0 0); }
  .ab-term pre { margin: 0; padding: 24px 26px 30px; font: clamp(11px, 1.15vw, 14.5px)/1.75 ui-monospace, "SF Mono", Menlo, monospace; overflow-x: auto; }
  .ab-l { opacity: 0; transition: opacity 0.2s; } .ab-l.on { opacity: 1; }
  .ab-term .g { color: oklch(0.72 0.17 25); } .ab-term .h { color: oklch(0.82 0.14 85); } .ab-term .ref { color: oklch(0.75 0.14 150); } .ab-term .d { color: oklch(0.6 0 0); } .ab-term .p { color: oklch(0.72 0.14 245); }
  .ab-cursor { display: inline-block; width: 9px; height: 1.1em; vertical-align: -0.2em; background: oklch(0.86 0 0); animation: ab-blink 1s steps(1) infinite; }
  @keyframes ab-blink { 50% { opacity: 0; } }

  /* 6 levels */
  .ab-levels { --xp: 0; background: oklch(0.22 0.04 285); color: #fff; padding-bottom: 72px; }
  .ab-xp { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; margin-bottom: 26px; font: 800 18px "Big Shoulders Display", sans-serif; letter-spacing: 0.08em; }
  .ab-xp-bar { height: 16px; border-radius: 4px; background: oklch(0.32 0.04 285); border: 2px solid oklch(0.45 0.05 285); overflow: hidden; }
  .ab-xp-bar i { display: block; height: 100%; width: calc(var(--xp) * 100%); background: repeating-linear-gradient(90deg, oklch(0.82 0.17 130) 0 10px, oklch(0.74 0.17 130) 10px 12px); transition: width 0.7s var(--ease); }
  .ab-xp-lv { color: oklch(0.85 0.16 90); }
  .ab-lv-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .ab-lv-list li { padding: 18px; border-radius: 14px; background: oklch(0.28 0.04 285); border: 2px solid oklch(0.36 0.04 285); opacity: 0.35; filter: grayscale(1); transition: 0.5s var(--ease); }
  .ab-lv-list li.on { opacity: 1; filter: none; border-color: oklch(0.82 0.17 130); transform: translateY(-4px); }
  .ab-lv-n { display: block; font: 800 14px "Big Shoulders Display", sans-serif; letter-spacing: 0.12em; color: oklch(0.85 0.16 90); text-transform: uppercase; }
  .ab-lv-list b { display: block; margin: 6px 0 4px; font-size: 15px; line-height: 1.25; } .ab-lv-list small { color: oklch(0.75 0.02 285); font-size: 12px; }
  .ab-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 12px; }
  .ab-badges span { padding: 3px 8px; border-radius: 6px; background: oklch(0.36 0.06 285); font-size: 11px; }
  .ab-lv-list li.on .ab-badges span { animation: ab-up 0.4s var(--ease) both; }
  .ab-toast { position: absolute; right: 24px; bottom: 18px; padding: 10px 16px; border-radius: 10px; background: oklch(0.82 0.17 130); color: oklch(0.2 0.04 285); font-weight: 700; font-size: 13px; opacity: 0; transform: translateY(-10px); pointer-events: none; }
  .ab-toast.show { animation: ab-toast 1.6s var(--ease); }
  @keyframes ab-toast { 15%, 80% { opacity: 1; transform: none; } }
  @media (max-width: 900px) { .ab-lv-list { grid-template-columns: repeat(2, 1fr); } .ab-toast { left: 16px; right: 16px; top: auto; bottom: 16px; } }
  @media (max-width: 520px) { .ab-lv-list { grid-template-columns: 1fr; } }

  /* 7 lanyard */
  .ab-lanyard { min-height: 520px; background: oklch(0.92 0.03 245); display: grid; justify-items: center; align-content: start; padding-top: 0; }
  .ab-swing { position: relative; display: grid; justify-items: center; transform-origin: 50% 0; touch-action: none; cursor: grab; }
  .ab-strap { width: 22px; height: 170px; background: repeating-linear-gradient(0deg, oklch(0.45 0.15 255) 0 10px, oklch(0.5 0.15 255) 10px 20px); }
  .ab-clip { width: 34px; height: 26px; margin-top: -2px; border-radius: 6px; background: linear-gradient(oklch(0.85 0 0), oklch(0.65 0 0)); }
  .ab-idcard { width: 280px; margin-top: -4px; border-radius: 16px; background: #fff; box-shadow: 0 26px 40px -22px oklch(0.2 0.05 255 / 0.6); overflow: hidden; user-select: none; }
  .ab-id-top { padding: 12px 16px; background: oklch(0.45 0.15 255); color: #fff; font-weight: 700; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
  .ab-id-body { display: grid; grid-template-columns: 84px 1fr; gap: 14px; padding: 16px; }
  .ab-id-photo { aspect-ratio: 3 / 4; border-radius: 8px; background: repeating-linear-gradient(45deg, var(--surface) 0 8px, oklch(0.92 0 0) 8px 16px); display: grid; place-items: center; font-size: 11px; color: var(--muted); }
  .ab-id-body small { display: block; font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; } .ab-id-body b { display: block; font-size: 13.5px; margin-bottom: 6px; }
  .ab-id-foot { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-top: 1px solid var(--surface); font-size: 12px; font-weight: 600; }
  .ab-id-bars { width: 90px; height: 22px; background: repeating-linear-gradient(90deg, #222 0 2px, transparent 2px 4px, #222 4px 7px, transparent 7px 8px); }

  /* 8 passport */
  .ab-passport { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 0; padding: 0; background: oklch(0.3 0.07 255); border: 14px solid oklch(0.3 0.07 255); }
  .ab-page-l, .ab-page-r { background: repeating-radial-gradient(circle at 30% 40%, oklch(0.96 0.02 200) 0 6px, oklch(0.94 0.025 200) 6px 12px); padding: 30px; min-height: 360px; }
  .ab-page-l { border-radius: 10px 0 0 10px; border-right: 1px dashed oklch(0.75 0.03 200); }
  .ab-page-r { border-radius: 0 10px 10px 0; position: relative; display: grid; grid-template-columns: repeat(3, 1fr); align-items: center; justify-items: center; gap: 10px; }
  .ab-page-l small { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: oklch(0.45 0.05 255); } .ab-page-l > b { display: block; font: 800 40px/1.1 "Big Shoulders Display", sans-serif; margin: 6px 0 16px; }
  .ab-page-l dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; font-size: 14px; } .ab-page-l dt { color: var(--muted); } .ab-page-l dd { margin: 0; font-weight: 600; }
  .ab-mrz { margin: 26px 0 0; font: 13px ui-monospace, Menlo, monospace; letter-spacing: 0.1em; color: oklch(0.4 0.03 255); overflow: hidden; white-space: nowrap; }
  .ab-stamp { --c: oklch(0.5 0.17 var(--h)); display: grid; place-items: center; text-align: center; color: var(--c); border: 3px solid var(--c); padding: 10px 12px; transform: rotate(var(--r)) scale(2.2); opacity: 0; mix-blend-mode: multiply; }
  .ab-stamp.s-c { border-radius: 50%; width: 112px; aspect-ratio: 1; box-shadow: inset 0 0 0 4px #fff0, inset 0 0 0 6px var(--c); }
  .ab-stamp.s-r { border-radius: 8px; border-style: double; border-width: 5px; }
  .ab-stamp b { font: 800 17px/1 "Big Shoulders Display", sans-serif; text-transform: uppercase; letter-spacing: 0.04em; } .ab-stamp small { font-size: 10.5px; font-weight: 600; }
  .ab-passport.is-stamped .ab-stamp { animation: ab-stamp 0.42s cubic-bezier(0.3, 1.5, 0.5, 1) forwards; animation-delay: calc(var(--i) * 0.38s); }
  @keyframes ab-stamp { 60% { opacity: 0.95; transform: rotate(var(--r)) scale(0.92); } 100% { opacity: 0.88; transform: rotate(var(--r)) scale(1); } }
  @media (max-width: 760px) { .ab-passport { grid-template-columns: minmax(0, 1fr); } .ab-page-l { border-radius: 10px 10px 0 0; border-right: 0; border-bottom: 1px dashed oklch(0.75 0.03 200); min-height: 0; } .ab-page-r { border-radius: 0 0 10px 10px; grid-template-columns: repeat(2, 1fr); padding: 20px; } .ab-stamp.s-c { width: 100px; } }

  /* 9 keyboard */
  .ab-kb-stage { background: oklch(0.88 0.01 260); }
  .ab-kb-read { margin: 0 0 18px; font-size: 18px; font-weight: 600; min-height: 28px; }
  .ab-kb { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; padding: 18px; border-radius: 20px; background: oklch(0.3 0.01 260); box-shadow: 0 30px 50px -30px oklch(0 0 0 / 0.6); }
  .ab-key { position: relative; min-height: 74px; padding: 26px 8px 8px; border: 0; border-radius: 10px; background: linear-gradient(oklch(0.97 0.02 var(--h)), oklch(0.9 0.04 var(--h))); box-shadow: 0 6px 0 oklch(0.68 0.06 var(--h)), 0 8px 12px -4px oklch(0 0 0 / 0.5); font: 600 12px/1.15 Archivo, sans-serif; color: oklch(0.3 0.05 var(--h)); cursor: pointer; text-align: left; transition: transform 0.08s, box-shadow 0.08s; }
  .ab-key small { position: absolute; top: 7px; left: 9px; font-size: 15px; font-weight: 800; opacity: 0.55; }
  .ab-key.down { transform: translateY(5px); box-shadow: 0 1px 0 oklch(0.68 0.06 var(--h)), 0 2px 4px -2px oklch(0 0 0 / 0.5); background: linear-gradient(oklch(0.85 0.1 var(--h)), oklch(0.8 0.12 var(--h))); }
  .ab-space { grid-column: span 1; --h: 260; cursor: default; }
  @media (max-width: 760px) { .ab-kb { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; padding: 12px; } .ab-key { min-height: 62px; font-size: 10.5px; } }

  /* 10 orbit */
  .ab-orbit { background: oklch(0.16 0.02 270); color: #fff; display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 20px; align-items: center; }
  .ab-sys { position: relative; width: min(620px, 100%); aspect-ratio: 1; margin: 0 auto; }
  .ab-sun { position: absolute; left: 50%; top: 50%; width: 18%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle, oklch(0.9 0.15 85), oklch(0.75 0.18 60)); color: oklch(0.25 0.05 60); font: 800 clamp(16px, 2vw, 26px) "Big Shoulders Display", sans-serif; box-shadow: 0 0 60px oklch(0.8 0.16 75 / 0.6); }
  /* Each ring turns; each tool sits on its ring (placed with cos/sin) and turns back the other way so its label stays upright. */
  .ab-ring { position: absolute; left: 50%; top: 50%; width: var(--r); aspect-ratio: 1; border-radius: 50%; border: 1px dashed oklch(1 0 0 / 0.18); translate: -50% -50%; animation: ab-spin var(--dur) linear infinite; }
  .ab-ring[style*='--dir:-1'], .ab-ring[style*='--dir:-1'] .ab-planet b { animation-direction: reverse; }
  .ab-sys:hover .ab-ring, .ab-sys:hover .ab-planet b { animation-play-state: paused; }
  @keyframes ab-spin { to { rotate: 360deg; } }
  .ab-planet { position: absolute; left: calc(50% + 50% * cos(var(--a))); top: calc(50% + 50% * sin(var(--a))); width: 0; height: 0; }
  .ab-planet b { position: absolute; translate: -50% -50%; white-space: nowrap; padding: 6px 10px; border-radius: 999px; background: oklch(0.82 0.1 var(--h)); color: oklch(0.25 0.06 var(--h)); font-size: clamp(9.5px, 1vw, 12.5px); animation: ab-counter var(--dur) linear infinite; }
  @keyframes ab-counter { to { rotate: -360deg; } }
  .ab-planet b:hover { scale: 1.25; z-index: 2; }
  .ab-orbit-key { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ab-orbit-key li { display: flex; align-items: center; gap: 10px; font-size: 15px; } .ab-orbit-key i { width: 14px; height: 14px; border-radius: 50%; background: oklch(0.82 0.1 var(--h)); } .ab-orbit-key span { color: oklch(0.7 0 0); }
  @media (max-width: 800px) { .ab-orbit { grid-template-columns: 1fr; } .ab-sys { width: 86%; } .ab-planet b { padding: 4px 7px; font-size: 9px; } }

  /* 11 x-ray */
  .ab-xray-stage { background: oklch(0.2 0.01 260); }
  .ab-xray { --x: 50%; --y: 50%; position: relative; max-width: 960px; margin: 0 auto; border-radius: 14px; overflow: hidden; cursor: none; touch-action: none; }
  .ab-xray img { display: block; width: 100%; height: auto; }
  .ab-xray-code { position: absolute; inset: 0; background: oklch(0.15 0.03 250); clip-path: circle(110px at var(--x) var(--y)); display: grid; place-items: center; }
  .ab-xray-code pre { margin: 0; font: clamp(9px, 1.3vw, 14px)/1.55 ui-monospace, Menlo, monospace; color: oklch(0.82 0.13 160); text-shadow: 0 0 8px oklch(0.8 0.15 160 / 0.6); background-image: linear-gradient(oklch(1 0 0 / 0.04) 1px, transparent 1px); background-size: 100% 4px; }
  .ab-lens-ring { position: absolute; left: var(--x); top: var(--y); width: 220px; height: 220px; margin: -110px; border-radius: 50%; border: 3px solid oklch(0.85 0.13 160); box-shadow: 0 0 0 6px oklch(0 0 0 / 0.25), 0 0 40px oklch(0.8 0.15 160 / 0.5); pointer-events: none; }
  .ab-xray-stage .ab-hint { color: oklch(0.7 0 0); }
  @media (max-width: 640px) { .ab-xray-code { clip-path: circle(70px at var(--x) var(--y)); } .ab-lens-ring { width: 140px; height: 140px; margin: -70px; } }

  /* 12 sketch */
  .ab-sketch-stage { display: grid; justify-items: center; gap: 18px; background: oklch(0.97 0.01 90); }
  .ab-sketch { position: relative; width: 100%; max-width: 960px; border-radius: 12px; overflow: hidden; background: #fffdf6; box-shadow: 0 24px 40px -28px oklch(0 0 0 / 0.4); }
  .ab-sketch img { display: block; width: 100%; height: auto; opacity: 0; filter: blur(6px) saturate(0.4); transition: opacity 1.2s ease 2.6s, filter 1.2s ease 2.6s; }
  .ab-sketch svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ab-sketch path { fill: none; stroke: oklch(0.3 0.03 260); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: opacity 0.8s ease 3s; }
