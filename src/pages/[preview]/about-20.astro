  .ab-node { position: absolute; left: calc(clamp(24px, 4vw, 56px) + (100% - 2 * clamp(24px, 4vw, 56px)) * var(--x) / 100%); top: calc(clamp(24px, 4vw, 56px) + 380px * var(--y) / 100%); transform: translate(-50%, 0) scale(0.6); opacity: 0; display: grid; gap: 2px; padding: 12px 18px; border-radius: 14px; border: 1px solid var(--line); background: var(--bg); font: inherit; text-align: center; cursor: pointer; transition: transform 0.5s var(--ease), opacity 0.4s, background 0.3s; min-width: 150px; }
  .ab-node { left: calc(clamp(24px, 4vw, 56px) + (100% - 2 * clamp(24px, 4vw, 56px)) * var(--xn, 0.5)); }
  .ab-node.n-client { --xn: 0.5; } .ab-node.n-me { --xn: 0.5; } .ab-node.n-design { --xn: 0.175; } .ab-node.n-dev { --xn: 0.5; } .ab-node.n-qa { --xn: 0.825; }
  .ab-node.n-client { top: calc(clamp(24px, 4vw, 56px) + 10px); } .ab-node.n-me { top: calc(clamp(24px, 4vw, 56px) + 150px); } .ab-node.n-design, .ab-node.n-dev, .ab-node.n-qa { top: calc(clamp(24px, 4vw, 56px) + 290px); }
  .ab-node b { font-size: 15px; } .ab-node small { font-size: 11.5px; color: var(--muted); }
  .ab-node.n-me { background: var(--ink); color: var(--bg); border-color: var(--ink); } .ab-node.n-me small { color: oklch(0.8 0 0); }
  .ab-org.is-drawn .ab-node { opacity: 1; transform: translate(-50%, 0); }
  .ab-org.is-drawn .ab-node.n-me { transition-delay: 0.3s; } .ab-org.is-drawn .ab-node.n-design { transition-delay: 0.9s; } .ab-org.is-drawn .ab-node.n-dev { transition-delay: 1s; } .ab-org.is-drawn .ab-node.n-qa { transition-delay: 1.1s; }
  .ab-node.on { outline: 3px solid oklch(0.55 0.13 160); }
