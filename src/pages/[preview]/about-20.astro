  .ab-day li.on { opacity: 1; } .ab-day li b { font: 800 26px "Big Shoulders Display", sans-serif; } .ab-day li p { margin: 0; font-size: 18px; }
  @media (max-width: 760px) { .ab-day { grid-template-columns: 1fr; } .ab-sky { top: 70px; height: 180px; z-index: 2; } .ab-time { font-size: 44px; } .ab-sun2 { width: 46px; height: 46px; } }

  /* 18 ask */
  .ab-ask { background: oklch(0.96 0.01 250); }
  .ab-ask-box { display: flex; align-items: center; gap: 14px; padding: 18px 22px; border-radius: 18px; background: var(--bg); box-shadow: 0 20px 40px -26px oklch(0.2 0.04 250 / 0.5); border: 1px solid var(--line); font-size: 22px; }
  .ab-ask-box input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: 500 clamp(17px, 2vw, 24px) Archivo, sans-serif; }
  .ab-ask-box kbd { padding: 4px 8px; border-radius: 6px; border: 1px solid var(--line); font: 600 12px Archivo, sans-serif; color: var(--muted); }
