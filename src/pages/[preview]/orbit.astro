---
// Design preview: ten improvements for the homepage project orbit, each on its own working orbit.
// Local preview only: in a build this route has no pages. Open http://localhost:4321/ideas/orbit/.
// The orbit markup is the live ProjectOrbit component; the script below is a copy of the hero's
// orbit with hooks for each idea, so nothing here changes the homepage.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import ProjectOrbit from '../../components/ProjectOrbit.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, '“Drag” cursor'], [2, 'Pause button with countdown'], [3, 'Click a side card'], [4, 'Arrow keys'], [5, 'Hover tilt and glare'],
  [6, 'Floor reflection'], [7, 'Depth for the back cards'], [8, '“02 / 06” counter'], [9, 'Card turns into the page'], [10, 'Scroll nudge'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['move over the orbit', 'Over the cards the cursor becomes a round label: “Drag” over the ring, “View” over the front card, so people know they can spin it and open it.'],
  2: ['watch the ring, then press it', 'The ring around the button fills until the orbit turns. Press it to stop the auto-turn (anything that moves on its own should be pausable).'],
  3: ['click a card on either side', 'Today only the front card can be clicked. Clicking a side card turns it to the front; clicking the front card opens the project.'],
  4: ['click the orbit, then press ← and →', 'Keyboard users can focus the orbit and turn it with the arrow keys; Home and End jump to the first and last project.'],
  5: ['move over the front card', 'The front card tilts a little towards the cursor with a soft light sweeping across it, so it feels like a real object.'],
  6: ['watch it change project', 'A faint mirror of the front card on the floor, tinted with its colour, sitting on the dotted ring.'],
  7: ['look at the cards behind', 'The cards behind are softly blurred and the side cards slightly, so the front card feels closer. Only redrawn while the orbit turns.'],
  8: ['click a dot', 'A project counter in the caption, with a dot per project; click one to turn straight to it.'],
  9: ['click the front card', 'Opening a project, the front card’s screenshot grows into the project page’s header, like the project grid’s cards already do.'],
  10: ['scroll this one past the middle of the screen', 'As you scroll on from the hero, the ring turns a little and tips back, so it reacts to the page instead of sitting still.'],
};
const n = projects.length;
---
<BaseLayout title="Orbit ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current homepage', href: '/' }, { label: 'All 20 site ideas', href: '/ideas/site/' }]} />

  <div class="wrap ox-page">
    <header class="ox-head">
      <span class="tiny-heading">Preview · project orbit</span>
      <h1 class="display">Ten ideas<br />for the orbit</h1>
      <p>Each idea runs on its own working copy of the homepage orbit, with the box taking the front project’s colour like the hero does. Pick the numbers you like and I’ll build them into the real hero; most can be combined.</p>
    </header>

    {IDEAS.map(([i, name]) => (
      <section class="ox" id={`idea-${i}`}>
        <div class="ox-top">
          <span class="idea-tag"><b>{i}</b>{name}<em>{NOTES[i][0]}</em></span>
          <p class="ox-why">{NOTES[i][1]}</p>
        </div>
        <div class={`ox-demo ox-${i}`} data-idea={i}>
          <div class="ox-floor" aria-hidden="true"></div>
          {i === 6 && <div class="ox-reflect" aria-hidden="true"><img alt="" /></div>}
          <ProjectOrbit card="var(--ox-card)" />
          {i === 1 && <span class="ox-cursor" aria-hidden="true"><span class="ox-cursor-drag">← Drag →</span><span class="ox-cursor-view">View ↗</span></span>}
          {i === 2 && (
            <button type="button" class="ox-pause" aria-label="Pause the orbit" aria-pressed="false">
              <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" class="ox-ring-bg" /><circle cx="24" cy="24" r="22" class="ox-ring" pathLength="100" /></svg>
              <span class="ox-pause-icon" aria-hidden="true"></span>
            </button>
          )}
          {i === 4 && <p class="ox-keys"><kbd>←</kbd><kbd>→</kbd> turn · <kbd>Home</kbd><kbd>End</kbd> first and last · <kbd>Enter</kbd> open</p>}
          {i === 8 && (
            <div class="ox-count">
              <span class="ox-count-num"><b>01</b> / {String(n).padStart(2, '0')}</span>
              <div class="ox-count-dots" role="group" aria-label="Go to project">{projects.map((p, k) => <button type="button" data-go={k} aria-label={p.name} aria-pressed={k === 0 ? 'true' : 'false'}></button>)}</div>
            </div>
          )}
        </div>
      </section>
    ))}
  </div>

  <div class="ox-page-mock" hidden>
    <div class="ox-pm-bg"></div>
    <img class="ox-pm-img" alt="" />
    <div class="ox-pm-copy"><span class="ox-pm-back">← All projects</span><h2 class="display ox-pm-title"></h2><p class="ox-pm-desc"></p></div>
    <button type="button" class="sx-small-btn ox-pm-close">← Back to the orbit</button>
  </div>
  <script type="application/json" id="ox-projects" set:html={JSON.stringify(projects.map((p) => ({ name: p.name, description: p.description })))} />
</BaseLayout>

<script>
  const root = document.documentElement;
  const motion = root.classList.contains('motion');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const inOut = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
  const out = (t: number) => 1 - (1 - t) ** 3;
  const WAIT = 4600;
  const data: { name: string; description: string }[] = JSON.parse(document.getElementById('ox-projects')!.textContent!);

  // ── A copy of the hero's orbit (turns, drag with momentum, snap, auto-step, arrows), with hooks.
  type Hooks = {
    onFront?: (card: HTMLElement, i: number) => void;
    // Extra turn and tilt on top of the orbit's own (idea 10).
    extra?: () => { rot: number; tilt: number };
    // Called for each card when the orbit is redrawn, with its angle from the front (ideas 7).
    onCard?: (card: HTMLElement, d: number) => void;
    // Which cards can be clicked (idea 3 lets the side cards take clicks).
    reach?: number;
  };
  class Orbit {
    rot = 0; front = -1; paused = false; hover = false; dragging = false;
    next = 0; waitFrom = 0; cards: HTMLElement[]; angles: number[]; step: number;
    tween: { from: number; to: number; start: number; dur: number; ease: (t: number) => number } | null = null;
    constructor(public el: HTMLElement, public hooks: Hooks = {}) {
      const ring = el.querySelector<HTMLElement>('.ob-ring')!, spin = el.querySelector<HTMLElement>('.ob-spin')!;
      const cards = (this.cards = [...el.querySelectorAll<HTMLElement>('.ob-card')]);
      const angles = (this.angles = cards.map((c) => Number(c.dataset.angle)));
      const shades = cards.map((c) => c.querySelector<HTMLElement>('.ob-shade')!);
      const captions = [...el.querySelectorAll<HTMLElement>('.ob-caption')];
      const step = (this.step = 360 / cards.length);
      const reach = hooks.reach ?? 0.5;
      if (!fine) el.classList.add('ob-touch');
      let on = false, vel = 0, lastX = 0, moved = 0, last = performance.now(), lastKey = '';
      new IntersectionObserver(([e]) => { on = e.isIntersecting; }).observe(el);
      this.waitFrom = last; this.next = last + WAIT;
      const nearest = () => Math.round(this.rot / step) * step;
      const frame = () => {
        const time = performance.now(), ms = Math.min(50, time - last), dt = ms / 16.67;
        last = time;
        if (!on) { requestAnimationFrame(frame); return; }
        // While held (hover, drag, paused or turning), the countdown to the next turn waits.
        if (this.hover || this.dragging || this.paused || this.tween || document.hidden) { this.next += ms; this.waitFrom += ms; }
        if (!this.dragging) {
          if (this.tween) {
            const t = Math.min(1, (time - this.tween.start) / this.tween.dur);
            this.rot = this.tween.from + (this.tween.to - this.tween.from) * this.tween.ease(t);
            if (t >= 1) { this.tween = null; this.wait(); }
          } else if (Math.abs(vel) > 0.08) { this.rot += vel * dt; vel *= 0.94 ** dt; }
          else if (Math.abs(this.rot - nearest()) > 0.05) { vel = 0; this.turnTo(nearest(), 700, out); }
          else if (motion && time > this.next) this.turnTo(nearest() - step, 1400);
        }
        const x = hooks.extra?.() ?? { rot: 0, tilt: 0 };
        const key = `${this.rot.toFixed(3)}|${x.rot.toFixed(2)}|${x.tilt.toFixed(2)}`;
        if (key !== lastKey) {
          lastKey = key;
          spin.style.transform = `translateZ(calc(var(--r) * -1)) rotateX(${x.tilt.toFixed(2)}deg) rotateY(${(this.rot + x.rot).toFixed(3)}deg)`;
          cards.forEach((card, i) => {
            const d = ((((angles[i] + this.rot + x.rot) % 360) + 540) % 360) - 180;
            const f = 1 - Math.abs(d) / 180;
            card.style.opacity = clamp((170 - Math.abs(d)) / 70).toFixed(3);
            shades[i].style.opacity = (0.38 * (1 - f ** 2)).toFixed(3);
            const reachable = Math.abs(d) < step * reach;
            card.tabIndex = Math.abs(d) < step / 2 ? 0 : -1;
            card.style.pointerEvents = reachable ? 'auto' : 'none';
            hooks.onCard?.(card, d);
          });
        }
        const now = ((Math.round(-this.rot / step) % cards.length) + cards.length) % cards.length;
        if (now !== this.front) {
          cards[this.front]?.classList.remove('is-front');
          this.front = now;
          cards[now].classList.add('is-front');
          captions.forEach((c, i) => c.classList.toggle('is-active', i === now));
          loadFull(cards[now]);
          hooks.onFront?.(cards[now], now);
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
      ring.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        if (e.pointerType === 'mouse') e.preventDefault();
        this.dragging = true; lastX = e.clientX; moved = 0; vel = 0; this.tween = null;
        ring.setPointerCapture(e.pointerId);
        root.classList.add('is-orbit-dragging');
      });
      ring.addEventListener('pointermove', (e) => { if (!this.dragging) return; const dx = e.clientX - lastX; lastX = e.clientX; moved += Math.abs(dx); this.rot += dx * 0.22; vel = dx * 0.22; });
      const release = () => { if (!this.dragging) return; this.dragging = false; this.wait(2500); root.classList.remove('is-orbit-dragging'); };
      ring.addEventListener('pointerup', release);
      ring.addEventListener('pointercancel', release);
      ring.addEventListener('click', (e) => { if (moved > 6) e.preventDefault(); }, true);
      ring.addEventListener('pointerenter', () => { this.hover = true; });
      ring.addEventListener('pointerleave', () => { this.hover = false; });
      el.querySelectorAll<HTMLButtonElement>('.ob-arrow').forEach((b) => b.addEventListener('click', () => this.by(-Number(b.dataset.dir))));
    }
    // Start the countdown to the next automatic turn.
    wait(extra = 0) { this.waitFrom = performance.now(); this.next = this.waitFrom + WAIT + extra; }
    turnTo(to: number, dur: number, ease = inOut) { if (!motion) { this.rot = to; this.tween = null; return; } this.tween = { from: this.rot, to, start: performance.now(), dur, ease }; }
    // Turn by whole projects; quick presses queue up from where the last one was heading.
    by(projects: number) { const from = this.tween ? this.tween.to : Math.round(this.rot / this.step) * this.step; this.turnTo(from + projects * this.step, 900); }
    // Turn the shortest way round to put card i at the front.
    goTo(i: number) { const from = this.tween ? this.tween.to : this.rot; const delta = ((((-this.angles[i] - from) % 360) + 540) % 360) - 180; this.turnTo(from + Math.round(delta / this.step) * this.step, 900); }
    // 0 to 1: how far through the wait before the next automatic turn.
    progress() { return this.tween ? 0 : clamp((performance.now() - this.waitFrom) / (this.next - this.waitFrom)); }
  }
  // The front card swaps in its full-page screenshot (for the hover scroll), decoded first.
  const loadFull = (card: HTMLElement) => {
    const img = card.querySelector<HTMLImageElement>('img[data-full]');
    if (!img || img.dataset.loaded) return;
    img.dataset.loaded = 'true';
    const full = new Image();
    full.src = img.dataset.full!;
    full.decode().then(() => { img.src = full.src; img.height = 1807; }).catch(() => {});
  };
  const demo = (n: number) => document.querySelector<HTMLElement>(`.ox-${n}`)!;
  const tint = (box: HTMLElement) => (card: HTMLElement) => box.style.setProperty('--h', card.dataset.hue!);
  const orbits: Orbit[] = [];
  const make = (n: number, hooks: Hooks = {}) => {
    const box = demo(n);
    const o = new Orbit(box.querySelector('.ob')!, { ...hooks, onFront: (c, i) => { tint(box)(c); hooks.onFront?.(c, i); } });
    orbits[n] = o;
    return o;
  };

  // 1: a round label follows the cursor: "Drag" over the ring, "View" over the front card.
  {
    const box = demo(1), ring = box.querySelector<HTMLElement>('.ob-ring')!, cur = box.querySelector<HTMLElement>('.ox-cursor')!;
    make(1);
    const pos = { x: 0, y: 0 }, to = { x: 0, y: 0 };
    let on = false;
    const tick = () => { pos.x += (to.x - pos.x) * 0.22; pos.y += (to.y - pos.y) * 0.22; cur.style.translate = `${pos.x.toFixed(1)}px ${pos.y.toFixed(1)}px`; if (on) requestAnimationFrame(tick); };
    const at = (e: PointerEvent) => { const r = box.getBoundingClientRect(); to.x = e.clientX - r.left; to.y = e.clientY - r.top; };
    if (fine) {
      ring.addEventListener('pointerenter', (e) => { at(e); pos.x = to.x; pos.y = to.y; on = true; box.classList.add('is-cursor'); requestAnimationFrame(tick); });
      ring.addEventListener('pointermove', (e) => { at(e); box.classList.toggle('is-view', !!(e.target as HTMLElement).closest('.is-front') && !root.classList.contains('is-orbit-dragging')); });
      ring.addEventListener('pointerleave', () => { on = false; box.classList.remove('is-cursor', 'is-view'); });
      ring.addEventListener('pointerdown', () => box.classList.add('is-down'));
      addEventListener('pointerup', () => box.classList.remove('is-down'));
    }
  }

  // 2: the countdown ring, and pause / play.
  {
    const box = demo(2), btn = box.querySelector<HTMLButtonElement>('.ox-pause')!, ring = box.querySelector<SVGCircleElement>('.ox-ring')!;
    const foot = box.querySelector('.ob-foot')!;
    foot.append(btn);
    const o = make(2);
    btn.addEventListener('click', () => {
      o.paused = !o.paused;
      btn.setAttribute('aria-pressed', String(o.paused));
      btn.setAttribute('aria-label', o.paused ? 'Play the orbit' : 'Pause the orbit');
    });
    const tick = () => { ring.style.strokeDashoffset = (100 - o.progress() * 100).toFixed(2); requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }

  // 3: the side cards take clicks too; a click on one turns it to the front.
  {
    const o = make(3, { reach: 1.5 });
    o.cards.forEach((card, i) => card.addEventListener('click', (e) => { if (!card.classList.contains('is-front')) { e.preventDefault(); o.goTo(i); } }));
  }

  // 4: arrow keys turn the focused orbit.
  {
    const box = demo(4), ring = box.querySelector<HTMLElement>('.ob-ring')!;
    const o = make(4);
    ring.tabIndex = 0;
    ring.setAttribute('aria-keyshortcuts', 'ArrowLeft ArrowRight Home End');
    ring.addEventListener('pointerdown', () => ring.focus({ preventScroll: true }));
    ring.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') o.by(1);
      else if (e.key === 'ArrowRight') o.by(-1);
      else if (e.key === 'Home') o.goTo(0);
      else if (e.key === 'End') o.goTo(o.cards.length - 1);
      else if (e.key === 'Enter' && e.target === ring) o.cards[o.front].click();
      else return;
      e.preventDefault();
      o.wait(4000);
    });
    ring.addEventListener('focus', () => { o.hover = true; });
    ring.addEventListener('blur', () => { o.hover = false; });
  }

  // 5: the front card tilts towards the cursor, with a light that follows it.
  {
    const o = make(5);
    o.cards.forEach((card) => {
      const glare = document.createElement('span');
      glare.className = 'ox-glare';
      card.append(glare);
      card.addEventListener('pointermove', (e) => {
        if (!card.classList.contains('is-front') || o.dragging) return;
        const r = card.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--tx', `${((0.5 - y) * 9).toFixed(2)}deg`);
        card.style.setProperty('--ty', `${((x - 0.5) * 12).toFixed(2)}deg`);
        card.style.setProperty('--gx', `${(x * 100).toFixed(1)}%`);
        card.style.setProperty('--gy', `${(y * 100).toFixed(1)}%`);
        card.classList.add('is-tilting');
      });
      card.addEventListener('pointerleave', () => { card.classList.remove('is-tilting'); card.style.setProperty('--tx', '0deg'); card.style.setProperty('--ty', '0deg'); });
    });
  }

  // 6: a faint reflection of the front card on the floor, crossfaded when the project changes.
  {
    const box = demo(6), reflect = box.querySelector<HTMLImageElement>('.ox-reflect img')!;
    make(6, {
      onFront: (card) => {
        // The first-screen shot, even once the card has swapped in its tall full-page one.
        const src = card.querySelector('img')!.src.replace('-full.webp', '-640.webp');
        reflect.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, fill: 'forwards' }).finished.then(() => {
          reflect.src = src;
          reflect.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 600, fill: 'forwards' });
        });
      },
    });
  }

  // 7: blur grows with distance from the front (set only when the orbit is redrawn).
  make(7, {
    onCard: (card, d) => {
      const blur = (Math.max(0, Math.abs(d) - 20) / 40) * 1.6;
      const v = blur < 0.15 ? '' : `blur(${blur.toFixed(1)}px)`;
      if (card.style.filter !== v) card.style.filter = v;
    },
  });

  // 8: the counter and a dot per project.
  {
    const box = demo(8), num = box.querySelector('.ox-count-num b')!, dots = [...box.querySelectorAll<HTMLButtonElement>('[data-go]')];
    box.querySelector('.ob-foot')!.after(box.querySelector('.ox-count')!);
    const o = make(8, { onFront: (_, i) => { num.textContent = String(i + 1).padStart(2, '0'); dots.forEach((d, k) => d.setAttribute('aria-pressed', String(k === i))); } });
    dots.forEach((d, k) => d.addEventListener('click', () => { o.goTo(k); o.wait(4000); }));
  }

  // 9: the front card's screenshot grows into a mock of the project page's header.
  {
    const mock = document.querySelector<HTMLElement>('.ox-page-mock')!;
    const pImg = mock.querySelector<HTMLImageElement>('.ox-pm-img')!, bg = mock.querySelector<HTMLElement>('.ox-pm-bg')!, copy = mock.querySelector<HTMLElement>('.ox-pm-copy')!;
    const close = mock.querySelector<HTMLButtonElement>('.ox-pm-close')!;
    let from: DOMRect | null = null;
    const o = make(9);
    const target = () => { const g = parseFloat(getComputedStyle(document.querySelector('.wrap')!).paddingLeft) || 24; const w = innerWidth - g * 2; return { left: g, top: Math.min(innerHeight * 0.42, 380), width: w, height: Math.min(w * 0.5625, innerHeight * 0.52) }; };
    const box4 = (r: { left: number; top: number; width: number; height: number }) => ({ left: `${r.left}px`, top: `${r.top}px`, width: `${r.width}px`, height: `${r.height}px` });
    o.cards.forEach((card, i) => card.addEventListener('click', (e) => {
      if (!card.classList.contains('is-front')) return;
      e.preventDefault();
      const shot = card.querySelector<HTMLElement>('.ob-shot')!;
      from = shot.getBoundingClientRect();
      pImg.src = card.querySelector('img')!.src;
      mock.style.setProperty('--h', card.dataset.hue!);
      mock.querySelector('.ox-pm-title')!.textContent = data[i].name;
      mock.querySelector('.ox-pm-desc')!.textContent = data[i].description;
      mock.hidden = false;
      const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
      pImg.animate([{ ...box4(from), borderRadius: '10px' }, { ...box4(target()), borderRadius: '18px' }], { duration: 800, easing: ease, fill: 'forwards' });
      bg.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, fill: 'forwards' });
      copy.animate([{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'none' }], { duration: 600, delay: 450, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' });
      close.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, delay: 700, fill: 'both' });
      o.paused = true;
    }));
    close.addEventListener('click', () => {
      if (!from) return;
      const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
      copy.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, fill: 'forwards' });
      close.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, fill: 'forwards' });
      bg.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 500, delay: 300, fill: 'forwards' });
      pImg.animate([{ ...box4(target()), borderRadius: '18px' }, { ...box4(from), borderRadius: '10px' }], { duration: 700, easing: ease, fill: 'forwards' }).finished.then(() => { mock.hidden = true; o.paused = false; o.wait(); });
    });
  }

  // 10: scrolling the orbit past the middle of the screen turns it a little and tips it back.
  {
    const box = demo(10);
    let p = 0;
    const measure = () => { const r = box.getBoundingClientRect(); p = clamp((innerHeight / 2 - (r.top + r.height / 2)) / (innerHeight * 0.6), -1, 1); };
    addEventListener('scroll', measure, { passive: true });
    measure();
    make(10, { extra: () => ({ rot: p * 22, tilt: Math.max(0, p) * 14 }) });
  }
</script>

<style is:global>
  .ox-page { padding-bottom: 160px; }
  .ox-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .ox-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .ox-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .ox { padding-block: 56px; border-top: 1px solid var(--line); }
  .ox-top { display: grid; gap: 4px; margin-bottom: 24px; }
  .ox-why { max-width: 680px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .ox-demo { --h: 60; --ox-card: clamp(230px, 30vw, 460px); position: relative; padding: 56px 0 36px; border-radius: 28px; overflow: hidden; background: oklch(0.982 0.009 var(--h)); transition: background-color 1.4s var(--ease); }
  .ox-demo .ob-caption strong { color: oklch(0.33 0.07 var(--h)); transition: color 1.4s var(--ease); }
  /* A plain dotted ellipse standing in for the hero's dotted track. */
  .ox-floor { position: absolute; left: 50%; top: calc(56px + var(--ox-card) * 0.5625 + 24px); width: calc(var(--ox-card) * 2.6); height: 56px; translate: -50% -50%; border: 2px dotted oklch(0.16 0 0 / 0.35); border-radius: 50%; pointer-events: none; }
