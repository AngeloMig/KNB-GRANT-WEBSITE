  .mx-tag { position: absolute; z-index: 30; left: var(--gutter); top: 22px; }
  .mx-dots { display: block; width: 100%; touch-action: pan-y; }
  .mx-row { position: relative; z-index: 3; display: grid; grid-template-columns: 1.1fr auto auto; gap: 24px 32px; align-items: center; margin-top: 34px; }
  .mx-lead { max-width: 460px; font-size: 16px; line-height: 1.5; }
  .mx-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .mx-row .intro-quote { margin: 0; }

  /* 1 */
  .mx1-stage { position: relative; margin-top: 30px; }
  .mx1 .mx-dots { width: calc(100% - 2 * var(--gutter)); height: clamp(200px, 27vw, 440px); margin-inline: auto; }
  .mx1 :global(.ob) { margin-top: calc(clamp(240px, 30vw, 460px) * -0.42); }

  /* 2 */
  /* The dot name sits between the orbit and its arrows. */
  .mx2-stage { display: flex; flex-direction: column; margin-top: 34px; }
  .mx2 :global(.ob) { display: contents; }
  .mx2 :global(.ob-ring) { order: 1; }
  .mx2-dots { order: 2; width: calc(100% - 2 * var(--gutter)); height: clamp(90px, 11vw, 180px); margin: 26px auto 0; }
  .mx2 :global(.ob-foot) { order: 3; margin-top: 10px; }
  .mx2 :global(.ob-caption strong) { display: none; }

  /* 3 */
  .mx3 { --glow: oklch(0.45 0.1 60); background: radial-gradient(ellipse 70% 60% at 50% 75%, color-mix(in oklch, var(--glow) 55%, transparent), transparent 70%), #0e0e0f; color: #f2f0ea; transition: background 0.8s; }
  .mx3 .tiny-heading { color: oklch(1 0 0 / 0.65); }
  .mx3-dots { height: clamp(180px, 24vw, 400px); margin-block: 18px 22px; }
  .mx3 :global(.ob-card) { box-shadow: 0 30px 70px oklch(0 0 0 / 0.6); }
  .mx3 .cta-primary { background: #f2f0ea; color: var(--ink); border-color: #f2f0ea; }
  .mx3 .cta-ghost { border-color: oklch(1 0 0 / 0.45); color: inherit; }
  .mx3 .mx-lead { color: oklch(1 0 0 / 0.75); }
  .mx3-row { grid-template-columns: 1fr auto; }

  /* 4 */
  .mx4-stage { position: relative; margin-top: 34px; }
  .mx4 :global(.ob-ring) { height: min(56vw, 440px); }
  .mx4 :global(.ob-spin) { top: calc(min(56vw, 440px) / 2 - var(--card) * 0.31); }
  .mx4-dots { position: absolute; z-index: 2; left: 50%; top: 0; width: min(780px, 74vw); height: min(calc(min(780px, 74vw) * 0.5625), 440px); translate: -50% 0; border-radius: 14px; background: var(--bg); box-shadow: 0 30px 80px oklch(0 0 0 / 0.14); }

  /* 5 */
  .mx5 { --mx5-card: clamp(270px, 36vw, 600px); background-color: var(--hero-wash, var(--bg)); transition: background-color 1.4s var(--ease); }
  /* The header shares the hero's wash (full width), and its button and link take the deep shade. */
  :global(html.mx-tinted) :global(.site-header) { background-color: var(--hero-wash); box-shadow: 0 0 0 100vmax var(--hero-wash); clip-path: inset(0 -100vmax); transition: background-color 1.4s var(--ease), box-shadow 1.4s var(--ease); }
  :global(html.mx-tinted) :global(.menu-toggle) { background-color: var(--hero-ink); transition: background-color 1.4s var(--ease), transform 0.3s var(--ease); }
  :global(html.mx-tinted) :global(.header-contact) { color: var(--hero-ink); transition: color 1.4s var(--ease); }
  .mx5-dots { height: clamp(160px, 20vw, 330px); margin-top: 18px; }
  /* The bigger orbit rises over the bottom of the name. */
  .mx5-stage { position: relative; z-index: 1; margin-top: calc(var(--mx5-card) * -0.16); padding-bottom: 50px; }
  .mx5-track { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .mx5 :global(.ob) { position: relative; z-index: 1; }

  @media (max-width: 900px) {
    .mx { min-height: auto; padding-block: 80px 56px; }
