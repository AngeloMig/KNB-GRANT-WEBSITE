---
// Design preview: 10 ideas for the estimator's "Ways to build it". Local preview only: in a build this
// route has no pages. Open http://localhost:4321/ideas/ways-to-build/. Every idea uses the real estimate
// model on one example project (a Shopify store, subscriptions and bundles, launch within a month).
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Speed, cost and scope meters'], [2, 'A recommended route'], [3, 'One shared timeline'], [4, 'Real launch dates'], [5, 'What each route changes'],
  [6, 'Picking updates the timeline'], [7, 'Fewer, clearer cards'], [8, 'Plain-English names'], [9, 'Compare two side by side'], [10, 'Swipe row on phones'],
] as const;
const NOTES: Record<number, string> = {
  1: 'Three small meters on each card make the trade-off visible at a glance: how fast, how costly, and whether it’s the full scope.',
  2: 'The cheapest route that still fits the date gets a “Best fit for your date” badge and a slightly raised card. People like being told.',
  3: 'All routes as rows on one week ruler, so the faster ones visibly end earlier. A dashed line marks their date.',
  4: 'Each card shows when it would actually launch, counted from today, under the weeks.',
  5: 'One line on what each route means in practice: who builds what, and what waits for later.',
  6: 'Picking a route redraws the week-by-week squares and counts the numbers to the new range, right next to the cards.',
  7: 'Only the three that matter (the standard way, the best fit, the fastest), with “Show 2 more ways” for the rest.',
  8: 'Short, human names (Steady, Faster, Launch sooner…) with the team detail underneath.',
  9: 'Tick any two routes to see them side by side: weeks, launch, cost, scope and the catch.',
  10: 'On a phone the cards become a swipe row, the next one peeking in, with the pick shown in a slim line underneath.',
};
---
<BaseLayout title="Ways to build it ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Open the estimator', href: '/estimate/' }]} />
  <div class="wrap wb-page">
    <header class="wb-head">
      <span class="tiny-heading">Preview · the estimator’s “Ways to build it”</span>
      <h1 class="display">Ten ways to<br />choose a route</h1>
      <p>Every idea runs on the real estimate model with one example project: a Shopify store with subscriptions and bundles, which the client wants live within a month. Tap the cards; several ideas can be combined.</p>
    </header>
    {IDEAS.map(([n, name]) => (
      <section class="wb" id={`idea-${n}`}>
        <div class="wb-top"><span class="idea-tag"><b>{n}</b>{name}</span><p class="wb-why">{NOTES[n]}</p></div>
        <div class:list={['wb-demo', { 'wb-phone': n === 10 }]} data-v={n}></div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import { estimate, planFor, type Answers, type Route, type Phase } from '../../data/estimator';
  const answers = { type: 'new', platform: 'shopify', catalog: 's', layouts: 6, storeFeatures: ['subscriptions', 'bundles'], integrations: ['email'], design: 'partial', content: 'partial', deadline: '4', speedup: 'advise' } as unknown as Answers;
  const r = estimate(answers);
  const routes: Route[] = r.routes;
  const deadline = 4;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // Facts per route, from what each one is.
  const NAME: Record<string, [string, string]> = {
    standard: ['Steady', '1 developer, full scope'], team2: ['Faster', '2 developers, full scope'], team3: ['Fastest full build', '3 developers, full scope'],
    phase: ['Launch sooner, add later', '1 developer, essentials first'], priority: ['Biggest fixes first', '1 developer'], theme: ['From a ready-made theme', '1 developer, premium theme'],
    both: ['Quickest launch', '3 developers, essentials first'],
  };
  const COST: Record<string, number> = { theme: 1, standard: 1, phase: 1, priority: 1, team2: 2, team3: 3, both: 3 };
  const COST_TEXT = ['', 'Lowest', 'Higher', 'Highest'];
  const FULL: Record<string, boolean> = { standard: true, team2: true, team3: true, theme: true, phase: false, priority: false, both: false };
  const CHANGES: Record<string, string> = {
    standard: 'One developer builds everything in order. The lowest cost, and the most predictable.',
    team2: 'A second developer builds the store features alongside the pages. Adds a little coordination time.',
    team3: 'Three developers split the build. The full scope, as fast as it goes; the highest team cost.',
    phase: 'Launch with the home, shop, product and checkout pages. Subscriptions and bundles follow in a second phase.',
    theme: 'Start from a quality premium theme, tailored to the brand, instead of custom-designing every page.',
    both: 'The essentials, built by three developers: the earliest launch. Everything else follows after.',
    priority: 'The fixes that matter most go first; the rest follow.',
  };
  const CATCH: Record<string, string> = { standard: 'Takes longest', team2: 'Costs more', team3: 'Costs the most for the full build', phase: 'Not everything at launch', theme: 'Less unique design', both: 'Highest cost, part launch', priority: 'Not everything at once' };
  const FIT: Record<string, string> = { fits: 'Fits your date', close: 'A little past your date', far: 'Well past your date' };
  const maxHigh = Math.max(...routes.map((x) => x.high));
  const minLow = Math.min(...routes.map((x) => x.low));
  const speedOf = (x: Route) => (x.low <= minLow + 0.5 ? 3 : x.low < r.low ? 2 : 1);
  const best = (() => {
    const fitting = routes.filter((x) => x.fit === 'fits').sort((a, b) => COST[a.id] - COST[b.id] || a.low - b.low);
    return (fitting[0] ?? [...routes].sort((a, b) => a.low - b.low)[0]).id;
  })();
  const fastest = [...routes].sort((a, b) => a.low - b.low)[0].id;
  const today = new Date();
  const dateIn = (w: number) => new Date(today.getTime() + w * 7 * 864e5).toLocaleDateString('en', { day: 'numeric', month: 'short' });
  const launch = (x: Route) => `Launch around ${dateIn(x.low)}–${dateIn(x.high)}`;
  const bar = (x: Route) => `<span class="wiz-route-bar" aria-hidden="true"><i style="width:${((x.low / maxHigh) * 100).toFixed(1)}%"></i><i style="width:${(((x.high - x.low) / maxHigh) * 100).toFixed(1)}%"></i></span>`;
  const fit = (x: Route) => (x.fit ? `<em data-fit="${x.fit}">${FIT[x.fit]}</em>` : '');
  const meter = (label: string, n: number, of = 3) => `<span class="wb-meter"><span>${label}</span><span class="wb-dots">${Array.from({ length: of }, (_, i) => `<i class="${i < n ? 'on' : ''}"></i>`).join('')}</span></span>`;
  const card = (x: Route, inner: string, extra = '') => `<button type="button" class="wiz-route ${extra}" data-route="${x.id}" aria-pressed="false">${inner}</button>`;
  const basic = (x: Route) => `<strong>${esc(x.label)}</strong><span class="wiz-route-weeks">${x.low}–${x.high} weeks</span>${bar(x)}<small>${esc(x.cost)}</small>${fit(x)}`;
  const pickable = (box: HTMLElement, onPick?: (id: string) => void) => box.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-route]');
    if (!b || (e.target as HTMLElement).closest('input')) return;
    box.querySelectorAll('[data-route]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    onPick?.(b.dataset.route!);
  });
  const list = (cards: string) => `<div class="wiz-routes-list">${cards}</div>`;

  const build: Record<number, (box: HTMLElement) => void> = {
    1: (box) => { box.innerHTML = list(routes.map((x) => card(x, `<strong>${esc(x.label)}</strong><span class="wiz-route-weeks">${x.low}–${x.high} weeks</span><span class="wb-meters">${meter('Speed', speedOf(x))}${meter('Cost', COST[x.id])}${meter('Scope', FULL[x.id] ? 3 : 2)}</span>${fit(x)}`)).join('')); pickable(box); },
    2: (box) => { box.innerHTML = list(routes.map((x) => card(x, `${x.id === best ? '<span class="wb-best">★ Best fit for your date</span>' : ''}${basic(x)}`, x.id === best ? 'is-best' : '')).join('')); pickable(box); box.querySelector<HTMLElement>(`[data-route="${best}"]`)!.setAttribute('aria-pressed', 'true'); },
    3: (box) => {
      const W = maxHigh + 1;
      box.innerHTML = `<div class="wb-gantt"><div class="wb-ruler">${Array.from({ length: W }, (_, i) => `<span>${i % 2 ? '' : i}</span>`).join('')}</div>${routes.map((x) => `<button type="button" class="wb-row" data-route="${x.id}" aria-pressed="false"><span class="wb-row-name">${esc(x.label)}<small>${esc(x.cost)}</small></span><span class="wb-row-track"><i style="left:0;width:${(x.low / W) * 100}%"></i><i class="maybe" style="left:${(x.low / W) * 100}%;width:${((x.high - x.low) / W) * 100}%"></i><b>${x.low}–${x.high} wk</b></span></button>`).join('')}<span class="wb-deadline" style="--at:${deadline / W}"><span>Your date · week ${deadline}</span></span></div>`;
      pickable(box);
    },
    4: (box) => { box.innerHTML = list(routes.map((x) => card(x, `<strong>${esc(x.label)}</strong><span class="wiz-route-weeks">${x.low}–${x.high} weeks</span><span class="wb-date">${launch(x)}</span>${bar(x)}<small>${esc(x.cost)}</small>${fit(x)}`)).join('')); pickable(box); },
    5: (box) => { box.innerHTML = list(routes.map((x) => card(x, `${basic(x)}<span class="wb-changes">${esc(CHANGES[x.id] ?? '')}</span>`)).join('')); pickable(box); },
    6: (box) => {
      box.innerHTML = `<div class="wb-six">${list(routes.map((x) => card(x, basic(x))).join(''))}<aside class="wb-six-side"><p class="wb-six-label">Your rough estimate</p><p class="wb-six-num"><span>${r.low}–${r.high}</span> weeks</p><p class="wb-six-pick">Steady · 1 developer</p><div class="wb-weeks"></div></aside></div>`;
      const grid = box.querySelector<HTMLElement>('.wb-weeks')!, num = box.querySelector<HTMLElement>('.wb-six-num span')!, pickLine = box.querySelector<HTMLElement>('.wb-six-pick')!;
      let shown = { low: r.low, high: r.high };
      const PLAN: Record<string, [number, boolean]> = { standard: [1, false], team2: [2, false], team3: [3, false], phase: [1, true], both: [3, true] };
      const draw = (id: string) => {
        const x = routes.find((y) => y.id === id)!;
        const phases: Phase[] = PLAN[id] ? planFor(r, ...PLAN[id]).phases : r.basePhases;
        const total = phases.reduce((s, p) => s + p.weeks, 0) || 1;
        let acc = 0; const bounds = phases.map((p) => { acc += (p.weeks / total) * x.low; return { end: acc, p }; });
        while (grid.children.length > x.high) grid.lastElementChild!.remove();
        let fresh = 0;
        for (let i = 0; i < x.high; i++) {
          let c = grid.children[i] as HTMLElement | undefined; const isNew = !c;
          if (!c) { c = document.createElement('span'); grid.append(c); }
          const solid = i < x.low; const ph = (solid ? bounds.find((b) => i + 0.5 <= b.end + 1e-6)?.p : undefined) ?? phases[phases.length - 1];
          c.className = `wk phase-${ph.id}${solid ? '' : ' is-maybe'}${i === x.high - 1 ? ' is-launch' : ''}${isNew ? ' is-new' : ''}`;
          if (isNew) c.style.setProperty('--d', String(fresh++));
        }
        const from = { ...shown }; shown = { low: x.low, high: x.high }; const t0 = performance.now();
        const tick = (t: number) => { const k = Math.min(1, (t - t0) / 500), e = 1 - (1 - k) ** 3; num.textContent = `${Math.round(from.low + (x.low - from.low) * e)}–${Math.round(from.high + (x.high - from.high) * e)}`; if (k < 1) requestAnimationFrame(tick); };
        requestAnimationFrame(tick);
        pickLine.textContent = `${NAME[id]?.[0] ?? x.label} · ${x.cost}`;
      };
      pickable(box, draw);
      box.querySelector<HTMLElement>('[data-route="standard"]')!.setAttribute('aria-pressed', 'true');
      draw('standard');
    },
    7: (box) => {
      const main = [...new Set(['standard', best, fastest])];
      const rest = routes.filter((x) => !main.includes(x.id));
      const tag = (id: string) => (id === best ? 'Best fit for your date' : id === fastest ? 'Fastest' : 'The standard way');
      box.innerHTML = `${list(main.map((id) => routes.find((x) => x.id === id)!).map((x) => card(x, `<span class="wb-tag">${tag(x.id)}</span>${basic(x)}`)).join(''))}<div class="wb-more" hidden>${list(rest.map((x) => card(x, basic(x))).join(''))}</div><button type="button" class="wb-more-btn">Show ${rest.length} more ways</button>`;
      const more = box.querySelector<HTMLElement>('.wb-more')!, btn = box.querySelector<HTMLButtonElement>('.wb-more-btn')!;
      btn.addEventListener('click', () => { more.hidden = !more.hidden; btn.textContent = more.hidden ? `Show ${rest.length} more ways` : 'Show fewer'; });
      pickable(box);
    },
    8: (box) => { box.innerHTML = list(routes.map((x) => card(x, `<strong class="wb-name">${NAME[x.id]?.[0] ?? x.label}</strong><span class="wb-sub">${NAME[x.id]?.[1] ?? ''}</span><span class="wiz-route-weeks">${x.low}–${x.high} weeks</span>${bar(x)}<small>${esc(x.cost)}</small>${fit(x)}`)).join('')); pickable(box); },
    9: (box) => {
      box.innerHTML = `${list(routes.map((x) => card(x, `<label class="wb-tick"><input type="checkbox" value="${x.id}" /> Compare</label>${basic(x)}`)).join(''))}<div class="wb-compare" hidden></div><p class="wb-compare-hint">Tick two routes to compare them.</p>`;
      const panel = box.querySelector<HTMLElement>('.wb-compare')!, hint = box.querySelector<HTMLElement>('.wb-compare-hint')!;
      const ticked: string[] = ['standard', best];
      const sync = () => {
        box.querySelectorAll<HTMLInputElement>('.wb-tick input').forEach((i) => { i.checked = ticked.includes(i.value); });
        const pair = ticked.map((id) => routes.find((x) => x.id === id)!);
        panel.hidden = pair.length < 2; hint.hidden = !panel.hidden;
        if (pair.length < 2) return;
        const rows: [string, (x: Route) => string][] = [['Weeks', (x) => `${x.low}–${x.high}`], ['Launch', (x) => `${dateIn(x.low)}–${dateIn(x.high)}`], ['Your date', (x) => (x.fit ? FIT[x.fit] : '—')], ['Cost', (x) => COST_TEXT[COST[x.id]]], ['At launch', (x) => (FULL[x.id] ? 'Everything' : 'The essentials')], ['The catch', (x) => CATCH[x.id] ?? '—']];
        panel.innerHTML = `<table><thead><tr><th></th>${pair.map((x) => `<th>${esc(x.label)}</th>`).join('')}</tr></thead><tbody>${rows.map(([k, f]) => `<tr><th>${k}</th>${pair.map((x) => `<td>${esc(f(x))}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
      };
      box.addEventListener('change', (e) => {
        const i = e.target as HTMLInputElement; if (!i.matches('.wb-tick input')) return;
        const at = ticked.indexOf(i.value);
        if (i.checked && at < 0) { ticked.push(i.value); if (ticked.length > 2) ticked.shift(); } else if (!i.checked && at >= 0) ticked.splice(at, 1);
        sync();
      });
      pickable(box); sync();
    },
    10: (box) => {
      box.innerHTML = `<div class="wb-handset"><p class="wb-h-title">Ways to build it</p><div class="wb-swipe">${routes.map((x) => card(x, `<strong>${NAME[x.id]?.[0] ?? x.label}</strong><span class="wb-sub">${NAME[x.id]?.[1] ?? ''}</span><span class="wiz-route-weeks">${x.low}–${x.high} wk</span>${bar(x)}${fit(x)}`)).join('')}</div><p class="wb-h-dots">${routes.map((_, i) => `<i class="${i === 0 ? 'on' : ''}"></i>`).join('')}</p><p class="wb-h-pick">Your pick: <strong>Steady · 7–10 weeks</strong></p><p class="wb-h-next">What’s next?</p></div>`;
      const swipe = box.querySelector<HTMLElement>('.wb-swipe')!, dots = [...box.querySelectorAll<HTMLElement>('.wb-h-dots i')], pick = box.querySelector<HTMLElement>('.wb-h-pick strong')!;
      swipe.addEventListener('scroll', () => { const i = Math.round(swipe.scrollLeft / (swipe.firstElementChild as HTMLElement).offsetWidth); dots.forEach((d, j) => d.classList.toggle('on', j === i)); }, { passive: true });
      pickable(box, (id) => { const x = routes.find((y) => y.id === id)!; pick.textContent = `${NAME[id]?.[0] ?? x.label} · ${x.low}–${x.high} weeks`; });
      box.querySelector<HTMLElement>('[data-route="standard"]')!.setAttribute('aria-pressed', 'true');
    },
  };
  document.querySelectorAll<HTMLElement>('.wb-demo').forEach((box) => build[Number(box.dataset.v)]?.(box));
</script>

<style is:global>
  .wb-page { padding-bottom: 160px; }
  .wb-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .wb-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .wb-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .wb { padding-block: 44px; border-top: 1px solid var(--line); }
  .wb-top { display: grid; gap: 4px; margin-bottom: 22px; }
  .wb-why { max-width: 700px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .wb-demo { max-width: 980px; }

  /* 1 · meters */
  .wb-meters { display: grid; gap: 4px; margin-top: 4px; }
  .wb-meter { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 11.5px; color: var(--muted); }
  .wb-dots { display: flex; gap: 3px; }
  .wb-dots i { width: 16px; height: 6px; border-radius: 3px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .wb-dots i.on { background: var(--ink); box-shadow: none; }

  /* 2 · best fit */
  .wiz-route.is-best { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--ink), 0 14px 30px oklch(0 0 0 / 0.1); }
  .wb-best { justify-self: start; margin-bottom: 4px; padding: 4px 10px; border-radius: 999px; background: var(--ink); color: var(--bg); font-size: 11px; font-weight: 600; }

  /* 3 · gantt */
  .wb-gantt { position: relative; display: grid; gap: 6px; padding: 18px; border: 1px solid var(--line); border-radius: 18px; }
  .wb-ruler { display: grid; grid-template-columns: repeat(var(--w, 11), 1fr); margin-left: 210px; font-size: 10px; color: var(--muted); }
  .wb-ruler { display: flex; } .wb-ruler span { flex: 1; }
  .wb-row { display: grid; grid-template-columns: 200px 1fr; gap: 10px; align-items: center; padding: 8px 0; border: 0; border-radius: 10px; background: none; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
  .wb-row:hover, .wb-row[aria-pressed="true"] { background: var(--surface); }
  .wb-row-name { display: grid; padding-left: 8px; font-size: 13px; font-weight: 600; }
  .wb-row-name small { font-weight: 400; font-size: 11px; color: var(--muted); }
  .wb-row-track { position: relative; height: 22px; }
  .wb-row-track i { position: absolute; top: 4px; height: 14px; border-radius: 4px; background: var(--ink); }
  .wb-row-track i.maybe { background: repeating-linear-gradient(135deg, color-mix(in oklch, var(--ink) 35%, transparent) 0 2px, transparent 2px 5px); border-radius: 0 4px 4px 0; }
  .wb-row-track b { position: absolute; right: 6px; top: 3px; font-size: 11px; font-weight: 600; color: var(--muted); }
  .wb-deadline { position: absolute; top: 34px; bottom: 12px; left: calc(18px + 210px + (100% - 36px - 210px) * var(--at)); border-left: 2px dashed oklch(0.62 0.17 35); }
  .wb-deadline span { position: absolute; bottom: -2px; left: 6px; white-space: nowrap; font-size: 10.5px; font-weight: 600; color: oklch(0.55 0.17 35); }

  /* 4 · dates */
  .wb-date { font-size: 12px; font-weight: 500; }

  /* 5 · changes */
  .wb-changes { padding-top: 8px; margin-top: 2px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.45; color: var(--ink); }

  /* 6 · live timeline */
  .wb-six { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
  .wb-six-side { padding: 22px; border-radius: 18px; background: var(--surface); }
  .wb-six-label { margin: 0; font-size: 11px; font-weight: 600; text-transform: uppercase; }
  .wb-six-num { margin: 8px 0 0; font-size: 15px; font-weight: 500; }
  .wb-six-num span { font-family: "Big Shoulders Display", Impact, sans-serif; font-weight: 800; font-size: 64px; line-height: 0.9; margin-right: 4px; font-variant-numeric: tabular-nums; }
  .wb-six-pick { margin: 6px 0 14px; padding: 5px 10px; width: fit-content; border-radius: 999px; background: var(--bg); font-size: 12px; font-weight: 500; }
  .wb-weeks { display: grid; grid-template-columns: repeat(10, minmax(0, 22px)); gap: 5px; }

  /* 7 · fewer */
  .wb-tag { justify-self: start; padding: 3px 9px; border-radius: 999px; background: var(--surface); font-size: 11px; font-weight: 600; }
  .wb-more { margin-top: 10px; }
  .wb-more[hidden] { display: none; }
  .wb-more-btn { margin-top: 12px; padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: none; color: var(--ink); font-size: 13px; cursor: pointer; }

  /* 8 · names */
  .wb-name { font-size: 18px !important; letter-spacing: -0.02em; }
  .wb-sub { margin-top: -4px; font-size: 11.5px; color: var(--muted); }

  /* 9 · compare */
  .wb-tick { display: flex; align-items: center; gap: 6px; justify-self: start; font-size: 11.5px; color: var(--muted); cursor: pointer; }
  .wb-tick input { accent-color: var(--ink); }
  .wb-compare { margin-top: 16px; overflow-x: auto; }
  .wb-compare[hidden] { display: none; }
  .wb-compare table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .wb-compare th, .wb-compare td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .wb-compare thead th { font-size: 14px; }
  .wb-compare tbody th { width: 120px; color: var(--muted); font-weight: 500; }
  .wb-compare-hint { margin: 12px 0 0; font-size: 13px; color: var(--muted); }

  /* 10 · phone */
  .wb-handset { width: 360px; max-width: 100%; padding: 22px 0 18px; border: 9px solid #111; border-radius: 42px; background: var(--bg); overflow: hidden; }
  .wb-h-title { margin: 0 20px 12px; font-size: 18px; font-weight: 600; }
  .wb-swipe { display: grid; grid-auto-flow: column; grid-auto-columns: 74%; gap: 10px; padding: 4px 20px 8px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; scrollbar-width: none; }
  .wb-swipe::-webkit-scrollbar { display: none; }
  .wb-swipe .wiz-route { scroll-snap-align: start; }
  .wb-h-dots { display: flex; justify-content: center; gap: 5px; margin: 6px 0 0; }
