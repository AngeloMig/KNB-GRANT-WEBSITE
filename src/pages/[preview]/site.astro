---
// Design preview: 20 improvements and new designs across the whole site (homepage, project pages,
// About, footer, 404 and site-wide touches). Local preview only: in a build this route has no pages.
// Open http://localhost:4321/ideas/site/ while `npm run dev` runs. Only real projects and pages are used.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, '“Drag” cursor on the orbit'], [2, 'Pause button for the orbit'], [3, 'Marquee that follows your scroll'], [4, 'Grid or list view of work'],
  [5, 'Dotted project images'], [6, 'Project cards that stack'], [7, 'Section titles in dots'], [8, 'Dotted service numbers'],
  [9, 'Colour that follows the section'], [10, 'Scroll through the site'], [11, 'Desktop / phone switch'], [12, 'Project pages in their own colour'],
  [13, 'Bigger “Next project”'], [14, 'Skills that link to proof'], [15, 'Footer name in dots'], [16, 'A 404 in dots'],
  [17, 'Quick jump (⌘K)'], [18, 'Dot page transition'], [19, 'Scrambled link hover'], [20, 'Motion switch'],
] as const;
const AREAS: Record<number, string> = { 1: 'Hero', 3: 'Homepage', 10: 'Project pages', 14: 'About', 15: 'Footer & 404', 17: 'Site-wide' };
const NOTES: Record<number, [string, string]> = {
  1: ['move over the cards', 'Nothing tells visitors the orbit can be dragged. Over the cards, the cursor becomes a round “Drag” label, like the “View” circle on the project grid.'],
  2: ['the ring counts down to the next project', 'Anything that moves on its own should be pausable (an accessibility rule). A small button beside the arrows shows when the orbit turns next, and stops it.'],
  3: ['scroll up and down here', 'The platform strip runs faster while you scroll and turns round when you scroll back up, so it feels connected to the page.'],
  4: ['switch views, then hover a row', 'A compact list for visitors who want to scan everything quickly; hovering a row shows its screenshot beside the cursor.'],
  5: ['hover a card', 'Screenshots drawn in the hero’s dot style until you hover, then the real site fades in. Ties the grid to the hero.'],
  6: ['scroll down through them', 'Each project slides up over the last and the one underneath steps back. A big, slow reveal of six projects.'],
  7: ['scroll it into view, or press replay', 'Section headings (SERVICES, EXPERIENCE) assemble from scattered dots the first time they come into view.'],
  8: ['hover a service', 'Each service gets a number in dots; a ripple runs through it on hover.'],
  9: ['scroll through the three panels', 'The page background eases into a faint shade of whichever project is on screen, as the hero already does with the header.'],
  10: ['keep scrolling: the site scrolls with you', 'On a project page, the full-page screenshot scrolls inside a browser window as you scroll, from the top of the site to the footer.'],
  11: ['press Phone / Desktop', 'One frame that changes shape between the desktop and phone screenshots, instead of showing both side by side.'],
  12: ['pick a project', 'Each project page takes a deep shade of its project’s colour for the title and a faint wash for the background.'],
  13: ['hover it', 'The small “Next project” link becomes a full-width panel in the next project’s colour, with its site rising into view.'],
  14: ['pick a skill', 'On About, each platform or agency shows the projects that prove it.'],
  15: ['move over the name', 'The footer’s big GRANT DEV14 in the same dots as the hero, so the page opens and closes with the name.'],
  16: ['move over it, or shuffle', 'The 404 page’s number in dots, with a real project suggested so the visit isn’t wasted.'],
  17: ['press ⌘K or Ctrl K, or the button', 'Type to jump to any page or project. Handy for agencies who come back to check specific work.'],
  18: ['press the button', 'Between pages, dots grow out from where you clicked to cover the screen, then shrink away on the new page.'],
  19: ['hover the links', 'Menu and footer links shuffle their letters for a moment on hover, then settle.'],
  20: ['turn motion off', 'A switch in the footer for anyone who finds motion distracting. It stops the orbit, dots and strips, and is remembered on that visitor’s browser.'],
};
const tag = (n: number) => ({ n, name: IDEAS[n - 1][1], note: NOTES[n][0], why: NOTES[n][1] });

const hues: Record<string, number> = { olive: 105, lilac: 295, violet: 285, rose: 20, blue: 245, clay: 60 };
const img = (slug: string, size = '-640') => withBase(`/images/projects/${slug}${size}.webp`);
const host = (url: string) => new URL(url).hostname.replace('www.', '');
const withHue = projects.map((p) => ({ ...p, hue: hues[p.canvas] ?? 60 }));
const marqueeItems = ['Shopify', 'Webflow', 'WordPress', 'Migrations', 'Technical SEO', 'Integrations'];
const services = [
  { name: 'Shopify development', tags: 'Shopify · Shopify Plus · Liquid' },
  { name: 'Webflow development', tags: 'Webflow · Finsweet Client-First · GSAP' },
  { name: 'WordPress development', tags: 'WordPress · WooCommerce · PHP' },
  { name: 'Migrations & technical SEO', tags: 'Migrations · APIs · Technical SEO' },
];
// Skills for idea 14: each platform and agency, with the projects behind it.
const skills = [
  ...[...new Set(projects.map((p) => p.platform))].map((s) => ({ label: s, match: (p: (typeof projects)[number]) => p.platform === s })),
  ...[...new Set(projects.map((p) => p.agency).filter(Boolean))].map((a) => ({ label: `With ${a}`, match: (p: (typeof projects)[number]) => p.agency === a })),
].map((s) => ({ label: s.label, slugs: projects.filter(s.match).map((p) => p.slug) }));
const pages = [
  { label: 'Home', hint: 'Page', href: withBase('/') },
  { label: 'Selected work', hint: 'Homepage section', href: withBase('/#work') },
  { label: 'Services', hint: 'Homepage section', href: withBase('/#services') },
  { label: 'About Grant', hint: 'Page', href: withBase('/about/') },
  { label: 'Estimate a project', hint: 'Page', href: withBase('/estimate/') },
  { label: 'Get in touch', hint: 'Page', href: withBase('/contact/') },
  { label: 'Free website audit', hint: 'Page', href: withBase('/contact/#audit') },
  ...projects.map((p) => ({ label: p.name, hint: `${p.platform} · ${p.category}`, href: withBase(`/work/${p.slug}/`) })),
];
const first = withHue[0];
---
<BaseLayout title="Site ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current homepage', href: '/' }, { label: 'A project page', href: `/work/${first.slug}/` }]} />

  <div class="wrap sx-page">
    <header class="sx-head">
      <span class="tiny-heading">Preview · 20 site ideas</span>
      <h1 class="display">Twenty ideas<br />for the whole site</h1>
      <p>Improvements and new designs for the hero, homepage, project pages, About, footer and 404, plus a few site-wide touches. Every demo works; try each one. Pick the numbers you like and I’ll build them into the real pages.</p>
    </header>

    {IDEAS.map(([n]) => {
      const t = tag(n);
      return (
        <section class="sx" id={`idea-${n}`}>
          {AREAS[n] && <p class="sx-area">{AREAS[n]}</p>}
          <div class="sx-top">
            <span class="idea-tag"><b>{n}</b>{t.name}<em>{t.note}</em></span>
            <p class="sx-why">{t.why}</p>
          </div>

          {n === 1 && (
            <div class="sx-orbit" data-drag>
              <div class="sx-orbit-cards">{withHue.slice(0, 3).map((p, i) => <span class={`sx-orbit-card sx-oc-${i}`}><img src={img(p.slug)} alt="" width="640" height="360" loading="lazy" /></span>)}</div>
              <span class="sx-drag-cursor" aria-hidden="true">← Drag →</span>
            </div>
          )}

          {n === 2 && (
            <div class="sx-pause" data-pause>
              <button type="button" class="ob-arrow sx-round" data-step="-1" aria-label="Previous project">←</button>
              <div class="sx-pause-captions">{withHue.map((p, i) => <p class:list={['sx-pause-cap', { 'is-on': i === 0 }]}><strong>{p.name}</strong><span>{p.platform} · {p.category}</span></p>)}</div>
              <button type="button" class="ob-arrow sx-round" data-step="1" aria-label="Next project">→</button>
              <button type="button" class="sx-pause-btn" aria-label="Pause the orbit" aria-pressed="false">
                <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" class="sx-ring-bg" /><circle cx="24" cy="24" r="22" class="sx-ring" pathLength="100" /></svg>
                <span class="sx-pause-icon" aria-hidden="true"></span>
              </button>
            </div>
          )}

          {n === 3 && (
            <div class="sx-velo" aria-hidden="true"><div class="sx-velo-track">{[0, 1, 2].map(() => marqueeItems.map((item) => <><span>{item}</span><i></i></>))}</div></div>
          )}

          {n === 4 && (
            <div class="sx-views" data-view="grid">
              <div class="sx-views-bar">
                <p>Selected work <span>({String(projects.length).padStart(2, '0')})</span></p>
                <div class="sx-switch" role="group" aria-label="View"><button type="button" data-set="grid" aria-pressed="true">Grid</button><button type="button" data-set="list" aria-pressed="false">List</button></div>
              </div>
              <div class="sx-views-grid">{withHue.map((p) => <a href={withBase(`/work/${p.slug}/`)} class="sx-vg-card"><img src={img(p.slug, '-480')} alt="" width="480" height="270" loading="lazy" /><strong>{p.name}</strong><span>{p.platform} · {p.category}</span></a>)}</div>
              <ol class="sx-views-list">{withHue.map((p, i) => <li><a href={withBase(`/work/${p.slug}/`)} data-img={img(p.slug, '-480')}><b>{String(i + 1).padStart(2, '0')}</b><strong>{p.name}</strong><span>{p.platform}</span><span>{p.category}</span><span>{p.agency ?? p.engagement}</span><Arrow diagonal /></a></li>)}</ol>
              <img class="sx-views-float" alt="" width="480" height="270" aria-hidden="true" />
            </div>
          )}

          {n === 5 && (
            <div class="sx-dither">{withHue.slice(0, 3).map((p) => <a class="sx-dither-card" href={withBase(`/work/${p.slug}/`)} style={`--h:${p.hue}`}><span class="sx-dither-media"><img src={img(p.slug)} alt={`${p.name} homepage`} width="640" height="360" /><canvas></canvas></span><strong>{p.name}</strong><span>{p.platform} · {p.category}</span></a>)}</div>
          )}

          {n === 6 && (
            <div class="sx-stack">{withHue.map((p, i) => <a class="sx-stack-card" href={withBase(`/work/${p.slug}/`)} style={`--i:${i};--h:${p.hue}`}><div class="sx-stack-copy"><b>{String(i + 1).padStart(2, '0')}</b><h3 class="display">{p.name}</h3><p>{p.description}</p><span>{p.platform} · {p.category}</span></div><img src={img(p.slug, '-960')} alt="" width="960" height="540" loading="lazy" /><span class="sx-stack-dim"></span></a>)}</div>
          )}

          {n === 7 && (
            <div class="sx-title-demo"><canvas class="sx-dots" data-text="SERVICES" data-intro data-color="ink"></canvas><button type="button" class="sx-small-btn" data-replay>Replay</button></div>
          )}

          {n === 8 && (
            <div class="sx-services">{services.map((s, i) => <a class="sx-service" href={withBase('/contact/')}><canvas class="sx-dots" data-text={String(i + 1).padStart(2, '0')} data-color="ink" data-row></canvas><h3>{s.name}</h3><span>{s.tags}</span><Arrow diagonal /></a>)}</div>
          )}

          {n === 9 && (
            <div class="sx-wash" style={`--h:${withHue[0].hue}`}>{withHue.slice(0, 3).map((p) => <div class="sx-wash-panel" data-h={p.hue}><img src={img(p.slug)} alt="" width="640" height="360" loading="lazy" /><div><strong class="display">{p.name}</strong><p>{p.description}</p></div></div>)}</div>
          )}

          {n === 10 && (
            <div class="sx-scrolly">
              <div class="sx-scrolly-sticky">
                <div class="sx-browser"><span class="ob-bar sx-bar"><i></i><i></i><i></i><b>{host(first.url)}</b></span><span class="sx-browser-view"><img src={img(first.slug, '-full')} alt={`${first.name}, full homepage`} width="640" height="1807" loading="lazy" /></span></div>
                <div class="sx-scrolly-copy"><span class="tiny-heading">{first.name}</span><p class="sx-scrolly-line">{first.overview}</p><div class="sx-progress"><span></span></div><p class="sx-scrolly-hint">Scroll to explore the site</p></div>
              </div>
            </div>
          )}

          {n === 11 && (
            <div class="sx-device-demo" data-mode="desktop">
              <div class="sx-switch" role="group" aria-label="Screen"><button type="button" data-set="desktop" aria-pressed="true">Desktop</button><button type="button" data-set="phone" aria-pressed="false">Phone</button></div>
              <div class="sx-device"><img class="sx-d-desk" src={img(withHue[1].slug, '-960')} alt={`${withHue[1].name} on desktop`} width="960" height="540" loading="lazy" /><img class="sx-d-phone" src={img(withHue[1].slug, '-mobile-440')} alt={`${withHue[1].name} on a phone`} loading="lazy" /></div>
            </div>
          )}

          {n === 12 && (
            <div class="sx-proj" style={`--h:${first.hue}`}>
              <div class="sx-chips" role="group" aria-label="Project">{withHue.map((p, i) => <button type="button" data-h={p.hue} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>{p.name}</button>)}</div>
              <div class="sx-proj-page">
                <span class="sx-proj-back">← All projects</span>
                <h3 class="display sx-proj-title">{first.name}</h3>
                <div class="sx-proj-row"><p class="sx-proj-desc">{first.description}</p><dl class="sx-proj-facts"><div><dt>Platform</dt><dd>{first.platform}</dd></div><div><dt>Category</dt><dd>{first.category}</dd></div><div><dt>Agency</dt><dd>{first.agency ?? '—'}</dd></div></dl></div>
              </div>
              <script type="application/json" class="sx-proj-data" set:html={JSON.stringify(withHue.map((p) => ({ name: p.name, description: p.description, platform: p.platform, category: p.category, agency: p.agency ?? '—' })))} />
            </div>
          )}

          {n === 13 && (
            <a class="sx-next" href={withBase(`/work/${withHue[1].slug}/`)} style={`--h:${withHue[1].hue}`}>
              <span class="sx-next-label">Next project</span>
              <strong class="display">{withHue[1].name}</strong>
              <span class="sx-next-meta">{withHue[1].platform} · {withHue[1].category}</span>
              <span class="sx-next-arrow"><Arrow diagonal /></span>
              <img src={img(withHue[1].slug, '-960')} alt="" width="960" height="540" loading="lazy" />
            </a>
          )}

          {n === 14 && (
            <div class="sx-skills">
              <div class="sx-chips" role="group" aria-label="Skill">{skills.map((s, i) => <button type="button" data-slugs={s.slugs.join(' ')} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label} <span>{s.slugs.length}</span></button>)}</div>
              <ul class="sx-skill-list">{withHue.map((p) => <li data-slug={p.slug} hidden={!skills[0].slugs.includes(p.slug)}><a href={withBase(`/work/${p.slug}/`)}><img src={img(p.slug, '-320')} alt="" width="320" height="180" loading="lazy" /><strong>{p.name}</strong><span>{p.platform} · {p.category}</span></a></li>)}</ul>
            </div>
          )}

          {n === 15 && (
            <div class="sx-footer"><div class="sx-footer-top"><p class="sx-footer-talk">Let’s talk.</p><span>Pages · Connect · Local time</span></div><canvas class="sx-dots" data-text="GRANT DEV14" data-color="ink"></canvas></div>
          )}

          {n === 16 && (
            <div class="sx-404">
              <canvas class="sx-dots" data-text="404" data-color="ink"></canvas>
              <div class="sx-404-copy">
                <h3 class="display">Lost in<br />the details?</h3>
                <p>This page has moved or doesn’t exist. Here’s a project instead:</p>
                <a class="sx-404-card" href={withBase(`/work/${first.slug}/`)}><img src={img(first.slug, '-480')} alt="" width="480" height="270" /><span><strong>{first.name}</strong><small>{first.platform} · {first.category}</small></span></a>
                <button type="button" class="sx-small-btn" data-shuffle>Show another</button>
              </div>
              <script type="application/json" class="sx-404-data" set:html={JSON.stringify(withHue.map((p) => ({ name: p.name, meta: `${p.platform} · ${p.category}`, href: withBase(`/work/${p.slug}/`), img: img(p.slug, '-480') })))} />
            </div>
          )}

          {n === 17 && (
            <div class="sx-k">
              <button type="button" class="sx-k-open"><span>Search pages and projects</span><kbd>⌘K</kbd></button>
              <dialog class="sx-k-dialog" aria-label="Quick jump">
                <input type="search" placeholder="Where to? Try “Shopify” or “about”" aria-label="Search pages and projects" />
                <ul>{pages.map((p) => <li><a href={p.href}><strong>{p.label}</strong><span>{p.hint}</span></a></li>)}</ul>
                <p class="sx-k-foot"><kbd>↑</kbd><kbd>↓</kbd> to move · <kbd>Enter</kbd> to open · <kbd>Esc</kbd> to close</p>
              </dialog>
            </div>
          )}

          {n === 18 && (
            <div class="sx-dissolve"><p>Click anywhere in this box, as if it were a link.</p><button type="button" class="cta-primary">Go to About <Arrow diagonal /></button></div>
          )}

          {n === 19 && (
            <nav class="sx-scramble" aria-label="Scramble demo">{['Selected work', 'About Grant', 'Services', 'Estimate a project', 'Get in touch'].map((l) => <a href="#idea-19" data-scramble>{l}</a>)}</nav>
          )}

          {n === 20 && (
            <div class="sx-motion">
              <label class="sx-toggle"><input type="checkbox" checked /><span></span>Motion</label>
              <div class="sx-motion-demo">
                <div class="sx-motion-strip" aria-hidden="true"><div>{[0, 1].map(() => marqueeItems.map((item) => <><span>{item}</span><i></i></>))}</div></div>
                <canvas class="sx-dots" data-text="GRANT DEV14." data-color="ink" data-auto></canvas>
              </div>
            </div>
          )}
        </section>
      );
    })}
  </div>
  <canvas class="sx-veil" aria-hidden="true"></canvas>
</BaseLayout>

<script>
  const root = document.documentElement;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const ink = getComputedStyle(root).getPropertyValue('--ink').trim() || '#161616';
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  // Idea 20 can stop every demo that runs on its own.
  let still = false;

  // ── Shared: text drawn in dots (ideas 7, 8, 15, 16, 20). The cursor pushes dots away; each springs home.
  type Dot = { x: number; y: number; vx: number; vy: number; hx: number; hy: number; ox: number; oy: number; delay: number; dur: number };
  class Dots {
    ctx: CanvasRenderingContext2D; dots: Dot[] = []; W = 0; H = 0; gap = 5; px = -1e4; py = -1e4; awake = true; on = false;
    glideAt = 0; hue = 60;
    constructor(public canvas: HTMLCanvasElement, public text: string, public intro = false) {
      this.ctx = canvas.getContext('2d')!;
      new IntersectionObserver(([e]) => { this.on = e.isIntersecting; if (this.on && this.intro && !this.glideAt) this.play(); }, { threshold: 0.4 }).observe(canvas);
      const host = canvas.closest<HTMLElement>('.sx-service') ?? canvas;
      if (fine) {
        host.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); this.px = e.clientX - r.left; this.py = e.clientY - r.top; this.awake = true; });
        host.addEventListener('pointerleave', () => { this.px = this.py = -1e4; });
      }
      this.build();
    }
    async build() {
      await document.fonts.load('800 200px "Big Shoulders Display"');
      const r = this.canvas.getBoundingClientRect();
      this.W = Math.floor(r.width); this.H = Math.floor(r.height);
      if (!this.W || !this.H) return;
      const dpr = Math.min(2, devicePixelRatio || 1);
      this.canvas.width = this.W * dpr; this.canvas.height = this.H * dpr;
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const { W, H } = this;
      this.gap = H < 90 ? 3 : W < 640 ? 4 : 6;
      const off = document.createElement('canvas'); off.width = W; off.height = H;
      const o = off.getContext('2d')!;
      let size = H * 1.12;
      o.font = `800 ${size}px "Big Shoulders Display"`;
      size = Math.min(size, (size * W * 0.98) / o.measureText(this.text).width);
      o.font = `800 ${size}px "Big Shoulders Display"`;
      o.textAlign = this.canvas.dataset.row !== undefined ? 'left' : 'center'; o.textBaseline = 'middle';
      o.fillText(this.text, o.textAlign === 'left' ? 0 : W / 2, H / 2 + size * 0.04);
      const data = o.getImageData(0, 0, W, H).data;
      const g = this.gap;
      this.dots = [];
      for (let y = g / 2; y < H; y += g) for (let x = g / 2; x < W; x += g) {
        if (data[((y | 0) * W + (x | 0)) * 4 + 3] > 128) this.dots.push({ hx: x, hy: y, x, y, vx: 0, vy: 0, ox: 0, oy: 0, delay: 0, dur: 1 });
      }
      if (this.intro && !this.glideAt) for (const d of this.dots) { d.x = -1e4; }
      this.awake = true;
      this.draw();
    }
    // Fly in from random points in the box (idea 7).
    play() {
      for (const d of this.dots) { d.ox = Math.random() * this.W - d.hx; d.oy = (Math.random() * 2 - 0.5) * this.H - d.hy; d.delay = Math.random() ** 1.7 * 700; d.dur = 500 + Math.random() * 700; }
      this.glideAt = performance.now(); this.awake = true;
    }
    // A ripple swept along the text (ideas 8 and 20).
    async sweep() {
      for (let k = 0; k <= 20; k++) { this.px = (k / 20) * this.W; this.py = this.H / 2; this.awake = true; await new Promise((r) => setTimeout(r, 16)); }
      this.px = this.py = -1e4;
    }
    step() {
      if (this.glideAt) {
        const T = performance.now() - this.glideAt;
        let done = true;
        for (const d of this.dots) {
          const t = clamp((T - d.delay) / d.dur);
          const left = t >= 1 ? 0 : 2 ** (-10 * t);
          d.x = d.hx + d.ox * left; d.y = d.hy + d.oy * left;
          if (t < 1) done = false;
        }
        if (done) this.glideAt = -1;
        this.draw();
        return;
      }
      let moving = 0;
      const R = Math.max(40, Math.min(110, this.H * 0.6));
      for (const d of this.dots) {
        const dx = d.x - this.px, dy = d.y - this.py, dist = Math.hypot(dx, dy);
        if (dist < R && dist > 0.1) { const f = (1 - dist / R) * 3.6; d.vx += (dx / dist) * f; d.vy += (dy / dist) * f; }
        d.vx += (d.hx - d.x) * 0.05; d.vy += (d.hy - d.y) * 0.05;
        d.vx *= 0.82; d.vy *= 0.82; d.x += d.vx; d.y += d.vy;
        moving = Math.max(moving, Math.abs(d.vx) + Math.abs(d.vy), (Math.abs(d.hx - d.x) + Math.abs(d.hy - d.y)) * 0.1);
      }
      this.draw();
      if (moving < 0.02 && this.px < -1e3) this.awake = false;
    }
    draw() {
      const { ctx } = this, rad = this.gap * 0.36;
      ctx.clearRect(0, 0, this.W, this.H);
