---
// Design preview: 10 interactive, image-led ideas for the homepage Services section. Local preview only:
// in a build this route has no pages. Open http://localhost:4321/ideas/services/. Every idea uses the
// five real services and real project screenshots. (The pictures for "Monthly support plans" and
// "Migrations & technical SEO" are stand-ins: those two have no project of their own to show yet.)
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { projects, canvasHues } from '../../data/projects';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'A picture that follows the cursor'], [2, 'Rows that open'], [3, 'A pinned laptop'], [4, 'Fill from where you enter'], [5, 'The title becomes a marquee'],
  [6, 'Expanding columns'], [7, 'Tabs that play themselves'], [8, 'Pictures inside the letters'], [9, 'Cards that stack'], [10, 'Spotlight'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['move over the rows', 'A project screenshot floats beside the cursor, trailing it softly and leaning with its speed. Each row wipes in its own picture.'],
  2: ['hover or tap a row', 'The row opens smoothly and three screenshots rise in one after another. One row is open at a time.'],
  3: ['scroll through it', 'The services scroll past on the left while a laptop stays pinned on the right, wiping to a site built with each one.'],
  4: ['enter from above, then from below', 'The row fills with black from the side the cursor came in, and empties towards the side it leaves. Three screenshots fan out like cards.'],
  5: ['hover a row', 'The row opens into a running strip: the service name over and over, with project screenshots between the words.'],
  6: ['hover or tap a column', 'Five tall picture columns. The one you point at widens and its details fade in; the others narrow to a label.'],
  7: ['play, pause, or choose a tab', 'Tabs with a progress line, a laptop and a phone sliding in. Autoplay pauses while you read; selecting a tab keeps your choice in place.'],
  8: ['hover a name (on phones: scroll)', 'Huge service names. The one you point at fills with a slowly drifting screenshot; the rest fade back.'],
  9: ['scroll through it', 'Each service is a full card in its project’s colour. As you scroll, the next card slides over the last, which shrinks back a little.'],
  10: ['move over it, or choose a service', 'A cursor spotlight on desktop. On phones, choose a service to change its subdued background, then use the separate enquiry link.'],
};
const shot = (slug: string) => {
  const p = projects.find((x) => x.slug === slug)!;
  return { name: p.name, src: withBase(`/images/projects/${slug}-960.webp`), small: withBase(`/images/projects/${slug}-480.webp`), phone: withBase(`/images/projects/${slug}-mobile-440.webp`), hue: canvasHues[p.canvas] ?? 60 };
};
const services = [
  { name: 'Shopify development', short: 'Shopify', text: 'Custom themes, Liquid development, ecommerce builds, and integrations that connect your store to the tools you use.', tags: 'Shopify · Shopify Plus · Liquid', href: withBase('/contact/'), shots: ['tero', 'road-armor', 'omenz'].map(shot) },
  { name: 'Webflow development', short: 'Webflow', text: 'Bring your designs to life with responsive Webflow development, CMS-driven pages, and considered interactions.', tags: 'Webflow · Finsweet Client-First · GSAP', href: withBase('/contact/'), shots: ['teamtown', 'all-terrain-industries', 'narrative-hub'].map(shot) },
  { name: 'WordPress development', short: 'WordPress', text: 'Flexible business websites, custom themes, WooCommerce stores, and ongoing website improvements.', tags: 'WordPress · WooCommerce · PHP', href: withBase('/contact/'), shots: ['coptrz', 'financial-advisor-uk', 'coptrz'].map(shot) },
  { name: 'Monthly support plans', short: 'Support', text: 'A developer on call every month: 20, 40 or 80 hours for updates, fixes, speed and improvements, with a health check and a short report each month.', tags: 'Basic · Medium · Large · VIP', href: withBase('/plans/'), shots: ['skinistry', 'light-my-bricks', 'omenz'].map(shot) },
  { name: 'Migrations & technical SEO', short: 'Migrations & SEO', text: 'Platform migrations, third-party integrations, page-speed improvements, and technical search optimization.', tags: 'Migrations · APIs · Technical SEO', href: withBase('/contact/#audit'), shots: ['light-my-bricks', 'financial-advisor-uk', 'all-terrain-industries'].map(shot) },
];
---
<BaseLayout title="Services ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current homepage', href: '/#services' }]} />
  <div class="wrap sv-page" data-services={JSON.stringify(services)}>
    <header class="sv-head">
      <span class="tiny-heading">Preview · the homepage Services section</span>
      <h1 class="display">Ten ways to<br />show services</h1>
      <p>Each idea uses your five real services and real project screenshots. Hover, tap and scroll to try them. The pictures for Monthly support plans and Migrations & technical SEO are stand-ins.</p>
    </header>
    <div class="sv-preview-controls"><label class="sv-motion-control" hidden><input type="checkbox" data-motion-toggle />Pause animations</label><span>Ten local ideas · choose a number to compare</span></div>
    <noscript><p>These interactive previews need JavaScript. You can still <a href={withBase('/#services')}>view the current services section</a>.</p></noscript>
    {IDEAS.map(([n, name]) => (
      <section class="sv" id={`idea-${n}`}>
        <div class="sv-top"><span class="idea-tag"><b>{n}</b>{name}<em>{NOTES[n][0]}</em></span><p class="sv-why">{NOTES[n][1]}</p></div>
        <div class:list={['sv-demo', `sv-v${n}`]} data-v={n}></div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import { mountServicesPreview } from '../../scripts/services-preview';
  const page = document.querySelector<HTMLElement>('.sv-page');
  if (page) mountServicesPreview(page);
</script>

<style is:global>
  .sv-page { padding-bottom: 200px; --sv-ease: cubic-bezier(0.22, 1, 0.36, 1); }
  .sv-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .sv-head h1 { margin: 0; font-size: clamp(52px, 8vw, 96px); letter-spacing:-.02em; }
  .sv-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .sv { padding-block: 56px; border-top: 1px solid var(--line); scroll-margin-top:88px; }
  .sv-preview-controls { position:sticky; top:12px; z-index:5; display:flex; align-items:center; flex-wrap:wrap; justify-content:space-between; gap:8px 24px; min-height:60px; padding:8px 12px; background:var(--bg); border-bottom:1px solid var(--line); }
  .sv-motion-control { display:inline-flex; gap:10px; align-items:center; min-height:44px; font-size:13px; cursor:pointer; }
  .sv-motion-control input { width:16px; height:16px; accent-color:var(--ink); }
  .sv-motion-control[hidden] { display:none; }
  .sv-preview-controls > span { font-size:12px; color:var(--muted); }
  .sv-top { display: grid; gap: 4px; margin-bottom: 26px; }
  .sv-why { max-width: 720px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .sv-demo { position: relative; }
  .sv-n { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* The shared list (ideas 1, 4, 5, 10) */
  .sv-list { border-top: 1px solid var(--line); }
  .sv-row { position: relative; display: grid; grid-template-columns: 34px minmax(0,1fr) minmax(0,1fr) 24px; gap: 24px; align-items: start; padding: 30px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .sv-row .sv-n { grid-column:1; grid-row:1; }
  .sv-row :is(h3,.sv-service-name) { grid-column:2; grid-row:1; min-width:0; display:block; margin: 0; font-size: 24px; line-height:1.25; font-weight: 500; letter-spacing: -0.025em; transition: translate 0.5s var(--sv-ease); }
  .sv-row .sv-copy { grid-column:3; grid-row:1; min-width:0; }
  .sv-copy :is(p,.sv-description) { display:block; margin: 0; max-width: 470px; font-size: 14px; line-height: 1.65; } .sv-copy small { display: block; margin-top: 14px; font-size: 11px; color: var(--muted); }
  .sv-row .sv-arrow { grid-column:4; grid-row:1; justify-self:end; align-self:start; white-space:nowrap; font-style: normal; font-size: 20px; line-height:1.25; transition: rotate 0.4s var(--sv-ease); }
  .sv-row:hover .sv-arrow { rotate: 45deg; }
  .sv-thumb { display: none; }

  /* 1 */
  .sv-v1 .sv-row:hover h3 { translate: 14px 0; }
  .sv-float { position: absolute; z-index: 4; left: 0; top: 0; width: 340px; aspect-ratio: 16 / 10; margin: -106px 0 0 28px; border-radius: 14px; overflow: hidden; pointer-events: none; opacity: 0; scale: 0.5; box-shadow: 0 24px 50px oklch(0 0 0 / 0.25); transition: opacity 0.3s, scale 0.55s var(--sv-ease); will-change: transform; }
  .sv-float.on { opacity: 1; scale: 1; }
  .sv-page.is-touch .sv-float { display:none; }
  .sv-float img, .sv-screen img, .sv-spot-imgs img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; clip-path: inset(100% 0 0 0); transition: clip-path 0.6s var(--sv-ease); }
  .sv-float img.on, .sv-screen img.on, .sv-spot-imgs img.on { clip-path: inset(0); z-index: 2; }
  .sv-float img.was, .sv-screen img.was, .sv-spot-imgs img.was { clip-path: inset(0); z-index: 1; transition: none; }

  /* 2 */
  .sv-acc { border-bottom: 1px solid var(--line); } .sv-acc:first-child { border-top: 1px solid var(--line); }
  .sv-acc-head { display: grid; grid-template-columns: 34px minmax(0,1fr) auto 24px; gap: 24px; align-items: baseline; width: 100%; min-height:64px; padding: 26px 0; border: 0; background: none; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
  .sv-acc-head .sv-service-name { margin: 0; min-width:0; font-size: 24px; font-weight: 500; line-height:1.25; letter-spacing: -0.025em; } .sv-acc.on .sv-acc-head .sv-service-name { font-weight:600; }
  .sv-acc-head small { font-size: 11px; color: var(--muted); }
  .sv-acc-head i { position: relative; width: 16px; height: 16px; align-self: center; } .sv-acc-head i::before, .sv-acc-head i::after { content: ""; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: var(--ink); transition: rotate 0.5s var(--sv-ease); } .sv-acc-head i::after { rotate: 90deg; } .sv-acc.on .sv-acc-head i::after { rotate: 0deg; }
  .sv-acc-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.45s var(--sv-ease); } .sv-acc.on .sv-acc-body { grid-template-rows: 1fr; }
  .sv-acc-inner { min-height: 0; overflow: hidden; display: grid; grid-template-columns: 0.8fr 1.6fr; gap: 40px; padding-left: 58px; }
  .sv-acc-text { padding-bottom: 34px; } .sv-acc-text p { margin: 0 0 16px; max-width: 380px; font-size: 14.5px; line-height: 1.65; color: var(--muted); } .sv-acc-text a { display:inline-flex; align-items:center; min-height:44px; font-size: 14px; font-weight: 500; text-underline-offset: 4px; }
  .sv-acc-shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding-bottom: 34px; }
  .sv-acc-shots figure { margin: 0; opacity: 0; translate: 0 46px; transition: opacity 0.5s, translate 0.8s var(--sv-ease); } .sv-acc.on .sv-acc-shots figure { opacity: 1; translate: 0 0; transition-delay: calc(0.12s + var(--k) * 0.09s); }
  .sv-acc-shots img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 10px; box-shadow: 0 0 0 1px var(--line); } .sv-acc-shots figcaption { margin-top: 8px; font-size: 11.5px; color: var(--muted); }

  /* 3 */
  .sv-v3 { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 60px; align-items: start; }
  .sv-pin-item { display: grid; align-content: center; justify-items: start; gap: 10px; min-height: 62vh; }
  .sv-pin-item h3 { color:var(--muted); transition:color .2s; } .sv-pin-item.on h3 { color:var(--ink); }
  .sv-pin-item h3 { margin: 0; font-size: clamp(30px, 3.4vw, 48px); font-weight: 500; letter-spacing: -0.035em; } .sv-pin-item p { margin: 0; max-width: 420px; font-size: 15px; line-height: 1.65; color: var(--muted); } .sv-pin-item small { font-size: 11px; color: var(--muted); } .sv-pin-item a { margin-top: 8px; font-size: 14px; font-weight: 500; text-underline-offset: 4px; }
  .sv-pin-stage { position: sticky; top: 14vh; display: grid; align-content: center; gap: 16px; height: 72vh; }
  .sv-laptop { display: grid; justify-items: center; width:90%; margin-inline:auto; } .sv-screen { position: relative; width: 100%; aspect-ratio: 16 / 10; border: 10px solid #111; border-bottom-width: 14px; border-radius: 16px 16px 4px 4px; background: #111; overflow: hidden; } .sv-laptop-base { width: 110%; height: 12px; border-radius: 0 0 14px 14px; background: linear-gradient(#d4d4d8, #a1a1aa); }
  .sv-pin-count { margin: 0; text-align: center; font-size: 12px; color: var(--muted); } .sv-pin-count b { color: var(--ink); } .sv-pin-count span { margin-left: 10px; }

  /* 4 */
  .sv-v4 .sv-row { padding-inline: 18px; transition: color 0.35s; } .sv-v4 .sv-row > *:not(.sv-fill):not(.sv-fan) { position: relative; z-index: 1; }
  .sv-fill { position: absolute; inset: 0; background: var(--ink); transform: scaleY(0); transition: transform 0.55s var(--sv-ease); }
  .sv-v4 .sv-row.is-in { color: var(--bg); } .sv-v4 .sv-row.is-in .sv-fill { transform: scaleY(1); } .sv-v4 .sv-row.is-in .sv-n, .sv-v4 .sv-row.is-in .sv-copy small { color: oklch(0.8 0 0); }
  .sv-fan { position: absolute; z-index: 3; left: calc(50% - 206px); top: 50%; width: 130px; aspect-ratio: 16 / 10; pointer-events: none; }
  .sv-fan img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 8px; box-shadow: 0 10px 24px oklch(0 0 0 / 0.35); opacity: 0; translate: 0 -30%; scale: 0.7; transition: opacity 0.3s, translate 0.6s var(--sv-ease), rotate 0.6s var(--sv-ease), scale 0.6s var(--sv-ease); }
  .sv-row.is-in .sv-fan img { opacity: 1; scale: 1; } .sv-row.is-in .sv-fan img:nth-child(1) { translate: -55% -50%; rotate: -10deg; } .sv-row.is-in .sv-fan img:nth-child(2) { translate: 0 -58%; transition-delay: 0.05s; z-index: 1; } .sv-row.is-in .sv-fan img:nth-child(3) { translate: 55% -50%; rotate: 10deg; transition-delay: 0.1s; }

  /* 5 */
  .sv-v5 .sv-row { overflow: hidden; }
  .sv-touch-help { display:none; color:var(--muted); font-size:13px; line-height:1.5; margin:0 0 20px; }
  .sv-mq { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; background: oklch(0.3 0.07 var(--hue)); color: #fff; clip-path: inset(50% 0); transition: clip-path 0.55s var(--sv-ease); pointer-events: none; }
  .sv-v5 .sv-row:hover .sv-mq, .sv-v5 .sv-row.is-in .sv-mq { clip-path: inset(0); }
  .sv-mq-track { display: flex; align-items: center; gap: 28px; padding-left: 28px; width: max-content; animation: sv-mq 22s linear infinite; animation-play-state: paused; } .sv-v5 .sv-row:hover .sv-mq-track, .sv-v5 .sv-row.is-in .sv-mq-track { animation-play-state: running; }
  .sv-mq b { font-family: "Big Shoulders Display", Impact, sans-serif; font-size: clamp(34px, 4.4vw, 62px); line-height: 1; white-space: nowrap; text-transform: uppercase; } .sv-mq img { height: 62px; width: 110px; object-fit: cover; object-position: top; border-radius: 999px; }
  @keyframes sv-mq { to { transform: translateX(-50%); } }

  /* 6 */
  .sv-cols { display: flex; gap: 8px; height: 500px; }
  .sv-col { position: relative; flex: 1 1 0; min-width: 0; border-radius: 18px; overflow: hidden; cursor: pointer; background: #111; transition: flex-grow 0.75s var(--sv-ease); outline-offset: 3px; } .sv-col.on { flex-grow: 5.5; }
  .sv-col > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0.55; scale: 1.18; transition: opacity 0.6s, scale 1.1s var(--sv-ease); } .sv-col.on > img { opacity: 0.9; scale: 1; }
  .sv-col::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, oklch(0 0 0 / 0.92), oklch(0 0 0 / 0.6)); pointer-events:none; }
  .sv-col-trigger { position:absolute; inset:0; z-index:1; border:0; padding:0; background:none; color:#fff; font:inherit; cursor:pointer; }
  .sv-col-trigger:focus-visible { outline:2px solid #fff; outline-offset:-6px; border-radius:inherit; }
  .sv-col-label { position: absolute; z-index: 1; left: 50%; bottom: 20px; translate: -50% 0; writing-mode: vertical-rl; rotate: 180deg; color: #fff; font-size: 15px; font-weight: 500; white-space: nowrap; transition: opacity 0.3s; } .sv-col-label i { font-style: normal; font-size: 11px; opacity: 0.7; margin-bottom: 10px; } .sv-col.on .sv-col-label { opacity: 0; }
  .sv-col-body { position: absolute; z-index: 2; left: 26px; right: 26px; bottom: 24px; display: grid; gap: 8px; max-width: 460px; color: #fff; opacity: 0; translate: 0 18px; transition: opacity 0.3s, translate 0.6s var(--sv-ease); pointer-events: none; } .sv-col.on .sv-col-body { opacity: 1; translate: 0 0; transition-delay: 0.15s; pointer-events: auto; }
  .sv-col-body h3 { margin: 0; font-size: 28px; font-weight: 500; letter-spacing: -0.03em; } .sv-col-body p { margin: 0; font-size: 14px; line-height: 1.6; min-width:0; } .sv-col-body small { font-size: 11px; color:#e6e6e6; } .sv-col-body a { display:inline-flex; align-items:center; min-height:44px; color: #fff; font-size: 14px; font-weight: 500; text-underline-offset: 4px; }

  /* 7 */
  .sv-tabs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 22px; }
  .sv-tab-controls { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px 24px; margin-bottom:16px; }
  .sv-tab-controls p { margin:0; font-size:13px; color:var(--muted); }
  .sv-tab-play { min-height:44px; border:1px solid var(--ink); border-radius:999px; background:none; color:var(--ink); padding:8px 16px; font:inherit; font-size:13px; cursor:pointer; }
  .sv-tab-play:disabled { opacity:.6; cursor:default; }
  .sv-tab { position: relative; display: grid; gap: 4px; min-height:56px; padding: 0 0 14px; border: 0; background: none; color: var(--muted); font: inherit; font-size: 16px; font-weight: 500; text-align: left; cursor: pointer; transition: color 0.3s; white-space: nowrap; } .sv-tab span { font-size: 11px; font-weight: 400; } .sv-tab.on { color: var(--ink); }
  .sv-tab i { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; border-radius: 2px; background: var(--line); overflow: hidden; } .sv-tab i::after { content: ""; position: absolute; inset: 0; background: var(--ink); transform: scaleX(0); transform-origin: left; }
  .sv-tab.on i { animation: sv-tick 5.2s linear forwards; } .sv-tab.on i::after { animation: sv-prog 5.2s linear forwards; }
  .sv-v7.is-paused .sv-tab.on i, .sv-v7.is-paused .sv-tab.on i::after, .sv-v7.is-off .sv-tab.on i, .sv-v7.is-off .sv-tab.on i::after { animation-play-state: paused; }
  @keyframes sv-prog { to { transform: scaleX(1); } } @keyframes sv-tick { to { opacity: 1; } }
  .sv-panels { display: grid; min-width:0; overflow:clip; border-radius:16px; } .sv-panel { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0,0.8fr) minmax(0,1.2fr); gap: 30px; align-items: center; min-width:0; min-height: 460px; padding: 40px; border-radius: 16px; background: oklch(0.95 0.02 var(--hue)); visibility: hidden; opacity: 0; transition: opacity 0.4s, visibility 0s 0.4s; } .sv-panel.on { visibility: visible; opacity: 1; transition: opacity 0.5s; }
  .sv-panel-text { display: grid; gap: 12px; justify-items: start; } .sv-panel-text > * { opacity: 0; translate: 0 18px; transition: opacity 0.5s, translate 0.7s var(--sv-ease); } .sv-panel.on .sv-panel-text > * { opacity: 1; translate: 0 0; } .sv-panel.on .sv-panel-text > :nth-child(2) { transition-delay: 0.06s; } .sv-panel.on .sv-panel-text > :nth-child(3) { transition-delay: 0.12s; } .sv-panel.on .sv-panel-text > :nth-child(4) { transition-delay: 0.18s; }
  .sv-panel-text h3 { margin: 0; font-size: clamp(28px, 3vw, 42px); font-weight: 500; letter-spacing: -0.035em; } .sv-panel-text p { margin: 0; font-size: 15px; line-height: 1.65; color: color-mix(in oklch, var(--ink) 70%, transparent); } .sv-panel-text small { font-size: 11px; color: var(--muted); } .sv-panel-text a { padding: 12px 20px; border-radius: 999px; background: var(--ink); color: var(--bg); font-size: 14px; text-decoration: none; }
  .sv-panel-media { position: relative; } .sv-panel-desk { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 14px; box-shadow: 0 24px 50px oklch(0 0 0 / 0.16); opacity: 0; translate: 0 40px; scale: 0.96; transition: opacity 0.5s, translate 0.9s var(--sv-ease), scale 0.9s var(--sv-ease); }
  .sv-panel-phone { position: absolute; right: -10px; bottom: -26px; width: 22%; aspect-ratio: 440 / 900; object-fit: cover; object-position: top; border: 5px solid #111; border-radius: 20px; box-shadow: 0 18px 36px oklch(0 0 0 / 0.25); opacity: 0; translate: 40px 30px; transition: opacity 0.5s, translate 0.9s var(--sv-ease); }
  .sv-panel.on .sv-panel-desk { opacity: 1; translate: 0 0; scale: 1; transition-delay: 0.1s; } .sv-panel.on .sv-panel-phone { opacity: 1; translate: 0 0; transition-delay: 0.26s; }

  /* 8 */
  .sv-v8 { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 30px; align-items: end; }
  .sv-bigs { display: grid; }
  .sv-big { display: flex; align-items: baseline; gap: 16px; width: fit-content; max-width:100%; overflow-wrap:anywhere; font-family: "Big Shoulders Display", Impact, sans-serif; font-weight: 800; font-size: clamp(56px, 8vw, 96px); line-height: 1; letter-spacing: -0.01em; text-transform: uppercase; text-decoration: none; color: var(--ink); background-size: 115% auto; background-position: 0% 20%; -webkit-background-clip: text; background-clip: text; transition: color 0.45s, translate 0.6s var(--sv-ease); }
  .sv-big span { flex:none; font-family: Archivo, sans-serif; font-size: 12px; font-weight: 400; letter-spacing: 0; color: var(--muted); -webkit-text-fill-color: var(--muted); -webkit-text-stroke:0; }
