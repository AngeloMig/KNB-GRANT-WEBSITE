---
// Design preview: 20 improvements for the full-screen menu, keeping its design (the page shrinks aside
// as a card, the links fill the right). Local preview only: in a build this route has no pages.
// Open http://localhost:4321/ideas/menu/. Each idea runs in its own small copy of the menu.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { projects, canvasHues } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, '3D tilt'], [2, '“Close” cursor'], [3, 'Live preview'], [4, 'Better previews'], [5, 'Colour follows the project'],
  [6, 'Dot word behind the list'], [7, 'Focus on hover'], [8, 'Mask reveal'], [9, 'Numbers and counts'], [10, '“You’re here” marker'],
  [11, 'Project links under work'], [12, 'One button'], [13, 'Keyboard shortcuts'], [14, 'Search field'], [15, 'Estimate button'],
  [16, 'Contact block'], [17, 'Latest project card'], [18, 'Recently viewed'], [19, 'Carlos’s quote'], [20, 'A phone layout'],
] as const;
const GROUPS: Record<number, string> = { 1: 'The page beside the menu', 6: 'The links', 14: 'Extras in the menu', 20: 'Phones' };
const NOTES: Record<number, [string, string]> = {
  1: ['open the menu', 'The shrunk page turns slightly in 3D as it moves aside, matching the orbit’s depth.'],
  2: ['open it, then move over the page', 'Over the shrunk page the cursor becomes a round “Close” label; clicking or scrolling the page closes the menu.'],
  3: ['open it, then hover “Selected work” or “Services”', 'On the homepage, the shrunk page itself scrolls to the section you point at. This one shows the real homepage.'],
  4: ['open it, then hover each link', 'Every link gets a preview of its own: projects, a résumé card, the services, the estimator’s first question, an email card and an audit card.'],
  5: ['pick a project, then open the menu', 'The dark background takes a deep shade of the hero’s front project, as the header already does.'],
  6: ['open it, then hover the links', 'The hovered link’s name drawn huge and faint in dots behind the list.'],
  7: ['open it, then hover the links', 'The other links dim while the one you point at slides right and its arrow turns.'],
  8: ['open and close it', 'Links rise in from behind a mask one by one, and drop away before the menu closes.'],
  9: ['open the menu', 'Each link numbered, with a count where it helps.'],
  10: ['open the menu', 'A dot and “You’re here” beside the page you’re on (here: the homepage).'],
  11: ['open it, then hover “Selected work”', 'The six projects (Tero first) open under Selected work as small links straight to each one.'],
  12: ['press the button twice', 'The menu button turns into the close button in the same spot, instead of a second button appearing.'],
  13: ['open it, then press 1–6, ↑ ↓ or Esc', 'Number keys pick a link, arrow keys move between them, Esc closes.'],
  14: ['open it and type', 'A search field at the top: type to find any page or project.'],
  15: ['open the menu', 'A clear “Get a free estimate” pill, your main call to action, always in the menu.'],
  16: ['open it, then click the email', 'Email copied in one click, LinkedIn, and Manila time with an online dot.'],
  17: ['open the menu', 'The newest project, Tero, as a card at the bottom of the menu.'],
  18: ['open the menu · example visits', 'The last two projects this visitor opened, so they can get back to them. Shown here with example visits.'],
  19: ['open the menu', 'Carlos’s real line at the bottom of the menu, with a link to his video.'],
  20: ['open it, then swipe the menu down', 'On phones the page slides down instead of left, the links are bigger, and swiping down closes the menu.'],
};
const tag = (n: number) => ({ name: IDEAS[n - 1][1], note: NOTES[n][0], why: NOTES[n][1] });
const img = (slug: string, size = '-480') => withBase(`/images/projects/${slug}${size}.webp`);
const links = [
  { label: 'Selected work', href: withBase('/'), hash: '#work', count: projects.length },
  { label: 'About Grant', href: withBase('/about/'), hash: '' },
  { label: 'Services', href: withBase('/#services'), hash: '#services', count: 4 },
  { label: 'Estimate a project', href: withBase('/estimate/'), hash: '' },
  { label: 'Get in touch', href: withBase('/contact/'), hash: '' },
  { label: 'Free website audit', href: withBase('/contact/#audit'), hash: '' },
];
const latest = projects[0];
const hueOf = (p: (typeof projects)[number]) => canvasHues[p.canvas] ?? 60;
const searchItems = [...links.map((l) => ({ label: l.label, hint: 'Page' })), ...projects.map((p) => ({ label: p.name, hint: `${p.platform} · ${p.category}` }))];
const services = ['Shopify development', 'Webflow development', 'WordPress development', 'Migrations & technical SEO'];
---
<BaseLayout title="Menu ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the real menu', href: '/' }]} />
  <div class="wrap mn-pagewrap">
    <header class="mn-head">
      <span class="tiny-heading">Preview · menu</span>
      <h1 class="display">Twenty ideas<br />for the menu</h1>
      <p>Each idea runs in a small copy of the current menu: press the round menu button and the page shrinks aside, just like on the site. Links inside the demos don’t leave this page.</p>
    </header>

    {IDEAS.map(([n]) => {
      const t = tag(n);
      return (
        <section class="mn" id={`idea-${n}`}>
          {GROUPS[n] && <p class="mn-group">{GROUPS[n]}</p>}
          <div class="mn-top"><span class="idea-tag"><b>{n}</b>{t.name}<em>{t.note}</em></span><p class="mn-why">{t.why}</p></div>

          {n === 5 && <div class="mn-chips" role="group" aria-label="Front project">{projects.map((p, i) => <button type="button" data-h={hueOf(p)} aria-pressed={i === 0 ? 'true' : 'false'}>{p.name}</button>)}</div>}

          <div class:list={['mn-stage', `mn-${n}`, { 'mn-phone': n === 20 }]} data-idea={n} style={n === 5 ? `--mh:${hueOf(projects[0])}` : undefined}>
            {/* The page, which shrinks aside when the menu opens. */}
            <div class="mn-card">
              {n === 3
                ? <iframe class="mn-frame" src={withBase('/')} title="The homepage, as a live preview" tabindex="-1" loading="lazy"></iframe>
                : (
                  <div class="mn-mock">
                    <div class="mn-mock-head"><span>Grant<br />Dev14.</span><span>Let’s talk ↗</span></div>
                    <p class="mn-mock-name display">GRANT DEV14.</p>
                    <div class="mn-mock-cards">{projects.slice(0, 3).map((p) => <img src={img(p.slug)} alt="" width="480" height="270" loading="lazy" />)}</div>
                  </div>
                )}
              {n !== 12 && <button type="button" class="mn-btn" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>}
            </div>
            {n === 12 && <button type="button" class="mn-btn mn-one" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>}
            {n !== 12 && <button type="button" class="mn-x" aria-label="Close navigation"><span></span><span></span></button>}

            {n === 2 && <span class="mn-close-cursor" aria-hidden="true">Close</span>}
            {n === 6 && <canvas class="mn-dotword" aria-hidden="true"></canvas>}
            {n === 4 && (
              <div class="mn-previews" aria-hidden="true">
                <div class="mn-pv" data-for="0">{projects.slice(0, 3).map((p) => <img src={img(p.slug)} alt="" width="480" height="270" loading="lazy" />)}</div>
                <div class="mn-pv mn-pv-card" data-for="1"><span class="mn-doc"><b>{profile.name}</b><i></i><i></i><i class="s"></i><i></i><i class="s"></i><i></i><i></i></span><p><strong>About Grant</strong>Résumé, experience and tools</p></div>
                <div class="mn-pv mn-pv-card" data-for="2"><ol>{services.map((s, i) => <li><b>0{i + 1}</b>{s}</li>)}</ol></div>
                <div class="mn-pv mn-pv-card" data-for="3"><p class="mn-q">What are you building?</p><div class="mn-opts"><span>A new store</span><span>A redesign</span><span>Move platforms</span></div><small>Two minutes · free</small></div>
                <div class="mn-pv mn-pv-card" data-for="4"><p class="mn-q">Say hello</p><p>{profile.email}</p><small>Replies within a working day · example</small></div>
                <div class="mn-pv mn-pv-card" data-for="5"><p class="mn-q">Free website audit</p><div class="mn-rings">{[['Speed', 92], ['SEO', 88], ['Access', 95]].map(([l, v]) => <span style={`--v:${v}`}><b>{v}</b>{l}</span>)}</div><small>Example scores</small></div>
              </div>
            )}

            {/* The menu itself, on the right. */}
            <div class="mn-menu">
              {n === 14 && <label class="mn-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search pages and projects" aria-label="Search pages and projects" /></label>}
              {n === 14 && <ul class="mn-results" hidden>{searchItems.map((s) => <li><a href="#idea-14"><strong>{s.label}</strong><span>{s.hint}</span></a></li>)}</ul>}
              <nav class="mn-links" aria-label={`Menu demo ${n}`}>{links.map((l, i) => (
                <>
                  <a href={l.href} data-hash={l.hash} style={`--i:${i}`} aria-current={n === 10 && i === 0 ? 'page' : undefined}>
                    {n === 9 && <b class="mn-num">{String(i + 1).padStart(2, '0')}</b>}
                    {n === 13 && <kbd class="mn-key">{i + 1}</kbd>}
                    <span class="mn-label"><span>{l.label}</span></span>
                    {n === 9 && l.count && <em class="mn-count">({l.count})</em>}
                    {n === 10 && i === 0 && <span class="mn-here"><i></i>You’re here</span>}
                    <Arrow />
                  </a>
                  {n === 11 && i === 0 && <div class="mn-sub">{projects.map((p) => <a href={withBase(`/work/${p.slug}/`)}>{p.name}</a>)}</div>}
                </>
              ))}</nav>
              <div class="mn-bottom">
                {n === 15 && <a class="mn-estimate" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a>}
                {n === 16 && <div class="mn-contact"><button type="button" class="mn-copy" data-email={profile.email}><span>{profile.email}</span><small>Click to copy</small></button><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><p><i class="mn-dot"></i><span class="mn-clock"></span> in Manila</p></div>}
                {n === 17 && <a class="mn-latest" href={withBase(`/work/${latest.slug}/`)} style={`--h:${hueOf(latest)}`}><img src={img(latest.slug, '-320')} alt="" width="320" height="180" /><span><small>Latest project</small><strong>{latest.name}</strong></span><Arrow diagonal /></a>}
                {n === 18 && <div class="mn-recent"><small>Recently viewed · example</small>{[projects[2], projects[3]].map((p) => <a href={withBase(`/work/${p.slug}/`)}><img src={img(p.slug, '-320')} alt="" width="320" height="180" /><span>{p.name}</span></a>)}</div>}
                {n === 19 && <a class="mn-quote" href={withBase('/#reviews')}><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital · <u>Watch the video</u></small></a>}
                {![16, 17, 18, 19].includes(n) && <div class="mn-default-bottom"><span>{profile.email}</span><span>LinkedIn ↗</span></div>}
              </div>
            </div>
            {n === 13 && <p class="mn-toast" aria-live="polite"></p>}
          </div>
          {n === 13 && <p class="mn-keys-hint"><kbd>1</kbd>–<kbd>6</kbd> pick a link · <kbd>↑</kbd><kbd>↓</kbd> move · <kbd>Enter</kbd> open · <kbd>Esc</kbd> close</p>}
        </section>
      );
    })}
  </div>
</BaseLayout>

<script>
  import { Dots } from './_dots';
  let active: { stage: HTMLElement; close: () => void } | null = null;

  document.querySelectorAll<HTMLElement>('.mn-stage').forEach((stage) => {
    const n = Number(stage.dataset.idea);
    const btn = stage.querySelector<HTMLButtonElement>('.mn-btn')!;
    const links = [...stage.querySelectorAll<HTMLAnchorElement>('.mn-links > a')];
    const isOpen = () => stage.classList.contains('is-open');
    const open = () => {
      stage.classList.remove('is-closing');
      stage.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true'); btn.setAttribute('aria-label', 'Close navigation');
      active = { stage, close };
      if (n === 14) setTimeout(() => stage.querySelector<HTMLInputElement>('.mn-search input')?.focus({ preventScroll: true }), 500);
    };
    const finish = () => { stage.classList.remove('is-open', 'is-closing'); btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-label', 'Open navigation'); stage.querySelectorAll('.is-key').forEach((el) => el.classList.remove('is-key')); };
    // 8: the links drop away first, then the page comes back.
    function close() { if (!isOpen()) return; if (n === 8) { stage.classList.add('is-closing'); setTimeout(finish, 420); } else finish(); if (active?.stage === stage) active = null; }
    btn.addEventListener('click', () => (isOpen() ? close() : open()));
    stage.querySelector('.mn-x')?.addEventListener('click', close);
    // Links in the demos stay on this page.
    stage.querySelectorAll<HTMLAnchorElement>('.mn-menu a').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));

    // 2: a "Close" label over the shrunk page; click or scroll it to close.
    if (n === 2) {
      const card = stage.querySelector<HTMLElement>('.mn-card')!, cur = stage.querySelector<HTMLElement>('.mn-close-cursor')!;
      card.addEventListener('pointermove', (e) => { if (!isOpen()) return; const r = stage.getBoundingClientRect(); cur.style.translate = `${e.clientX - r.left}px ${e.clientY - r.top}px`; stage.classList.add('is-cursor'); });
      card.addEventListener('pointerleave', () => stage.classList.remove('is-cursor'));
      card.addEventListener('click', (e) => { if (isOpen() && !(e.target as HTMLElement).closest('.mn-btn')) { stage.classList.remove('is-cursor'); close(); } });
      card.addEventListener('wheel', (e) => { if (isOpen()) { e.preventDefault(); stage.classList.remove('is-cursor'); close(); } }, { passive: false });
    }

    // 3: the real homepage scrolls to the section you point at.
    if (n === 3) {
      const frame = stage.querySelector<HTMLIFrameElement>('.mn-frame')!;
      links.forEach((a) => a.addEventListener('pointerenter', () => {
        const win = frame.contentWindow, doc = frame.contentDocument;
        if (!win || !doc) return;
        const target = a.dataset.hash ? doc.querySelector<HTMLElement>(a.dataset.hash) : null;
        win.scrollTo({ top: target ? target.getBoundingClientRect().top + win.scrollY - 20 : 0, behavior: 'smooth' });
      }));
    }

    // 4: each link's own preview.
    if (n === 4) {
      const pvs = [...stage.querySelectorAll<HTMLElement>('.mn-pv')];
      links.forEach((a, i) => a.addEventListener('pointerenter', () => pvs.forEach((p) => p.classList.toggle('is-on', Number(p.dataset.for) === i))));
      stage.querySelector('.mn-links')!.addEventListener('pointerleave', () => pvs.forEach((p) => p.classList.remove('is-on')));
    }

    // 6: the hovered link drawn faintly in dots behind the list.
    if (n === 6) {
      const cv = stage.querySelector<HTMLCanvasElement>('.mn-dotword')!;
      let dots: Dots | null = null;
      links.forEach((a) => a.addEventListener('pointerenter', () => { const word = a.textContent!.trim().split(' ')[0].toUpperCase(); if (!dots) dots = new Dots(cv, word, { color: 'oklch(1 0 0 / 0.14)', accent: 'oklch(1 0 0 / 0.3)', hidden: true }); dots.setText(word); }));
    }

    // 11: the project links open under Selected work.
    if (n === 11) {
      const sub = stage.querySelector<HTMLElement>('.mn-sub')!;
      links[0].addEventListener('pointerenter', () => sub.classList.add('is-on'));
      links.slice(1).forEach((a) => a.addEventListener('pointerenter', () => sub.classList.remove('is-on')));
    }

    // 14: search.
    if (n === 14) {
      const input = stage.querySelector<HTMLInputElement>('.mn-search input')!, results = stage.querySelector<HTMLElement>('.mn-results')!, nav = stage.querySelector<HTMLElement>('.mn-links')!;
      const items = [...results.querySelectorAll<HTMLLIElement>('li')];
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        results.hidden = !q; nav.hidden = !!q;
        items.forEach((li) => { li.hidden = !li.textContent!.toLowerCase().includes(q); });
      });
    }

    // 20: swipe the menu down to close.
    if (n === 20) {
      let y0 = -1;
      const menu = stage.querySelector<HTMLElement>('.mn-menu')!;
      menu.addEventListener('pointerdown', (e) => { y0 = e.clientY; });
      menu.addEventListener('pointermove', (e) => { if (y0 < 0 || !isOpen()) return; const dy = Math.max(0, e.clientY - y0); menu.style.translate = `0 ${dy * 0.6}px`; if (dy > 90) { y0 = -1; menu.style.translate = ''; close(); } });
      const up = () => { y0 = -1; menu.style.translate = ''; };
      addEventListener('pointerup', up);
    }
  });

  // 5: the menu takes the chosen project's colour.
  document.querySelectorAll<HTMLButtonElement>('.mn-chips button').forEach((b) => b.addEventListener('click', () => {
    b.parentElement!.querySelectorAll('button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    document.querySelector<HTMLElement>('.mn-5')!.style.setProperty('--mh', b.dataset.h!);
  }));

  // 13: keyboard, for whichever demo menu is open.
  addEventListener('keydown', (e) => {
    if (!active) return;
    const { stage, close } = active;
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (stage.dataset.idea !== '13') return;
    const links = [...stage.querySelectorAll<HTMLAnchorElement>('.mn-links > a')], toast = stage.querySelector<HTMLElement>('.mn-toast')!;
    const at = links.findIndex((a) => a.classList.contains('is-key'));
    const pick = (i: number) => { links.forEach((a, k) => a.classList.toggle('is-key', k === i)); links[i].focus({ preventScroll: true }); };
    if (/^[1-6]$/.test(e.key)) { const i = Number(e.key) - 1; pick(i); toast.textContent = `Would open: ${links[i].textContent!.trim()}`; toast.classList.add('is-on'); setTimeout(() => toast.classList.remove('is-on'), 1400); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); pick(Math.min(links.length - 1, at + 1)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); pick(Math.max(0, at - 1)); }
  });

  // 16: copy the email, and Manila time with an online dot.
  document.querySelectorAll<HTMLButtonElement>('.mn-copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.email!); b.querySelector('small')!.textContent = 'Copied ✓'; } catch { b.querySelector('small')!.textContent = 'Press ⌘C to copy'; }
    setTimeout(() => { b.querySelector('small')!.textContent = 'Click to copy'; }, 1800);
  }));
  const clock = () => {
    const m = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' })), h = m.getHours(), d = m.getDay();
    document.querySelectorAll('.mn-clock').forEach((el) => { el.textContent = new Date().toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila' }); });
    document.querySelectorAll('.mn-dot').forEach((el) => el.classList.toggle('is-on', h >= 9 && h < 18 && d > 0 && d < 6));
  };
  clock(); setInterval(clock, 20000);
</script>

<style is:global>
  .mn-pagewrap { padding-bottom: 160px; }
  .mn-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .mn-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .mn-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .mn { padding-block: 52px; border-top: 1px solid var(--line); }
  .mn-group { margin: 0 0 20px; font: 800 clamp(28px, 3vw, 44px) / 1 "Big Shoulders Display", sans-serif; text-transform: uppercase; }
  .mn-top { display: grid; gap: 4px; margin-bottom: 22px; }
  .mn-why { max-width: 700px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .mn-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .mn-chips button { padding: 8px 16px; border: 1px solid var(--line); border-radius: 99px; background: none; color: var(--ink); font: 500 13px Archivo, sans-serif; cursor: pointer; }
  .mn-chips button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  /* The stage: a small copy of the site with its menu. */
  .mn-stage { --mh: 0; position: relative; height: clamp(480px, 46vw, 620px); border-radius: 24px; overflow: hidden; background: var(--ink); color: #fff; perspective: 1600px; isolation: isolate; }
  .mn-5 { background: oklch(0.24 0.05 var(--mh)); transition: background-color 0.8s var(--ease); }
  .mn-card { position: absolute; z-index: 2; inset: 0; overflow: hidden; background: var(--bg); color: var(--ink); transform-origin: 50% 50%; transition: transform 0.85s cubic-bezier(0.76, 0, 0.24, 1), border-radius 0.85s; }
  .mn-stage.is-open .mn-card { transform: translateX(-46%) scale(0.84); border-radius: 20px; }
  .mn-1.is-open .mn-card { transform: translateX(-47%) scale(0.8) rotateY(16deg); box-shadow: -30px 30px 80px oklch(0 0 0 / 0.5); }
  .mn-mock { display: grid; gap: 18px; height: 100%; padding: 26px 30px; }
  .mn-mock-head { display: flex; justify-content: space-between; align-items: start; padding-right: 70px; font-size: 18px; font-weight: 500; line-height: 0.98; letter-spacing: -0.03em; }
  .mn-mock-head span:last-child { font-size: 13px; font-weight: 400; padding-top: 12px; }
  .mn-mock-name { margin: 0; font-size: clamp(70px, 11vw, 170px); text-align: center; letter-spacing: -0.02em; }
  .mn-mock-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .mn-mock-cards img { width: 100%; height: auto; border-radius: 10px; box-shadow: 0 20px 40px oklch(0 0 0 / 0.18); }
  .mn-frame { width: 100%; height: 100%; border: 0; pointer-events: none; }
  .mn-btn, .mn-x { position: absolute; z-index: 4; top: 22px; right: 26px; display: grid; place-items: center; width: 52px; height: 52px; padding: 0; border: 0; border-radius: 50%; background: var(--ink); color: #fff; cursor: pointer; }
  .mn-btn span, .mn-x span { position: absolute; width: 20px; height: 1.5px; background: currentColor; transition: translate 0.4s var(--ease), rotate 0.5s var(--ease); }
  .mn-btn span:first-child { translate: 0 -4px; }
  .mn-btn span:last-child { translate: 0 4px; }
  .mn-x { z-index: 3; background: #fff; color: var(--ink); opacity: 0; scale: 0.6; pointer-events: none; transition: opacity 0.35s, scale 0.5s var(--ease); }
  .mn-x span:first-child { rotate: 45deg; }
  .mn-x span:last-child { rotate: -45deg; }
  .mn-stage.is-open .mn-x { opacity: 1; scale: 1; pointer-events: auto; transition-delay: 0.35s; }
  /* 12: one button that turns into the close button in place. */
  .mn-one { z-index: 5; transition: background-color 0.4s, color 0.4s, rotate 0.6s var(--ease); }
  .mn-12.is-open .mn-one { background: #fff; color: var(--ink); rotate: 90deg; }
  .mn-12.is-open .mn-one span:first-child { translate: 0; rotate: 45deg; }
  .mn-12.is-open .mn-one span:last-child { translate: 0; rotate: -45deg; }

  .mn-menu { position: absolute; z-index: 1; top: 0; bottom: 0; right: 5%; width: min(46%, 560px); display: flex; flex-direction: column; justify-content: center; padding-block: 90px 24px; opacity: 0; pointer-events: none; transition: opacity 0.4s; }
