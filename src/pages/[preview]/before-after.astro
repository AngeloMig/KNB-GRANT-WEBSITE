  .b7-stamp { position: absolute; right: 22px; bottom: 16px; padding: 6px 14px; border: 3px solid oklch(0.5 0.15 150); border-radius: 8px; color: oklch(0.5 0.15 150); font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; rotate: -12deg; opacity: 0; scale: 2; } .b7-paper.is-clear .b7-stamp { animation: ba-stamp 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.3) forwards; } @keyframes ba-stamp { to { opacity: 0.9; scale: 1; } }
  /* 18 filmstrip */
  .b8-strip { --t: 0; position: relative; display: grid; gap: 14px; } .b8-row { display: grid; gap: 6px; } .b8-row p { display: flex; justify-content: space-between; margin: 0; font-size: 13px; } .b8-row p span { color: #6b6b6b; transition: color 0.3s; } .b8-row.ready p span { color: oklch(0.42 0.12 150); font-weight: 600; } .b8-row[data-k="before"].ready p span { color: oklch(0.48 0.17 28); }
  .b8-frames { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; } .b8-frame { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 6px 1.4fr 1fr; gap: 3px; aspect-ratio: 4 / 5; padding: 5px 5px 16px; border-radius: 6px; background: #fff; box-shadow: inset 0 0 0 1px #e0e0e0; opacity: 0.25; transition: opacity 0.3s; } .b8-frame.shown { opacity: 1; }
  .b8-frame i { border-radius: 2px; background: transparent; } .b8-frame .n, .b8-frame .h { grid-column: 1 / -1; } .b8-frame[data-l="1"] .n, .b8-frame[data-l="2"] .n, .b8-frame[data-l="3"] .n { background: #161616; } .b8-frame[data-l="2"] .h, .b8-frame[data-l="3"] .h { background: linear-gradient(120deg, oklch(0.55 0.13 250), oklch(0.72 0.13 190)); } .b8-frame[data-l="3"] .t { background: oklch(0.88 0.06 80); } .b8-frame[data-l="3"] .t:last-of-type { background: oklch(0.88 0.06 150); }
