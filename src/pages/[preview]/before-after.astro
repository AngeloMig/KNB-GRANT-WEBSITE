  .b1-badge { display: flex; align-items: center; gap: 8px; margin: 0; font-size: clamp(10px, 1.3vw, 12.5px); } .b1-badge b { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; font: 500 13px ui-monospace, Menlo, monospace; background: color-mix(in oklch, var(--good) 18%, #fff); color: oklch(0.4 0.12 150); box-shadow: inset 0 0 0 2px var(--good); } .b1-before .b1-badge b { background: color-mix(in oklch, var(--poor) 14%, #fff); color: oklch(0.45 0.17 28); box-shadow: inset 0 0 0 2px var(--poor); }
  .b1-handle { position: absolute; top: 0; bottom: 0; left: calc(var(--p) * 100%); width: 3px; margin-left: -1.5px; background: #161616; pointer-events: none; } .b1-handle i { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; background: #161616; color: #fff; font-style: normal; font-size: 13px; }
