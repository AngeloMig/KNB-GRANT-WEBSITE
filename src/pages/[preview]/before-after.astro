  .b5-track { position: relative; height: 22px; border-radius: 6px; background: #f1f1f1; } .b5-was { position: absolute; inset: 0 auto 0 0; border-radius: 6px; background: repeating-linear-gradient(135deg, #cfcfcf 0 2px, transparent 2px 6px); } .b5-now { position: absolute; inset: 0 auto 0 0; border-radius: 6px; background: var(--c); mix-blend-mode: multiply; }
  .b5-mark { position: absolute; top: -5px; bottom: -5px; width: 2px; margin-left: -1px; background: #161616; font: 500 10px ui-monospace, Menlo, monospace; } .b5-mark { text-indent: -9999px; overflow: visible; } .b5-mark::after { content: "was"; position: absolute; top: -13px; left: 50%; translate: -50% 0; text-indent: 0; font: 400 9.5px Archivo, sans-serif; color: #6b6b6b; }
