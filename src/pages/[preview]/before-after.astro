  .b6-before { clip-path: inset(calc(var(--p) * 100%) 0 0 0); background: #fbf8f8; }
  .b6-url { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 12.5px; color: #4d5156; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .b6-url i { flex: none; width: 22px; height: 22px; border-radius: 50%; background: #e8eaed; } .b6-after .b6-url i { background: oklch(0.6 0.13 250); }
