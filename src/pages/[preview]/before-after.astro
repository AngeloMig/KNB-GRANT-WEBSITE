  .b8-playhead { position: absolute; top: 20px; bottom: 0; left: calc(var(--t) * 100%); width: 2px; margin-left: -1px; background: oklch(0.62 0.2 28); pointer-events: none; }
  /* 19 heartbeat */
  .b9-monitor { --gh: 25; position: relative; height: 190px; border-radius: 14px; background: #0c1210 linear-gradient(oklch(1 0 0 / 0.05) 1px, transparent 1px) 0 0 / 100% 24px; overflow: hidden; color: oklch(0.82 0.17 var(--gh)); }
  .b9-monitor::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, oklch(1 0 0 / 0.05) 1px, transparent 1px) 0 0 / 24px 100%; }
