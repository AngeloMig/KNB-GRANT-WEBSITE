  .b4-state { font-style: normal; font-size: 11.5px; color: var(--c); transition: color 0.3s; } .b4-state::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 7px; border-radius: 50%; background: var(--c); }
  /* 15 bars */
