  .b6-links { display: flex; gap: 14px; margin: 2px 0 0; font-size: 13px; color: #1a0dab; } .b6-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; font-family: Archivo, sans-serif; } .b6-tags span { padding: 4px 9px; border-radius: 999px; font-size: 11.5px; } .b6-tags.is-good span { background: color-mix(in oklch, var(--good) 18%, #fff); color: oklch(0.4 0.12 150); } .b6-tags.is-poor span { background: color-mix(in oklch, var(--poor) 13%, #fff); color: oklch(0.45 0.17 28); }
  .b6-scan { position: absolute; left: 0; right: 0; top: calc(var(--p) * 100%); height: 2px; margin-top: -1px; background: var(--good); box-shadow: 0 0 18px 4px color-mix(in oklch, var(--good) 60%, transparent); opacity: calc(sin(var(--p) * 3.1416) * 4); }
  /* 17 school report */
  .b7-paper { position: relative; display: grid; gap: 10px; padding: 24px 26px; border-radius: 4px; background: #fffdf5 repeating-linear-gradient(transparent 0 33px, oklch(0.85 0.03 250 / 0.5) 33px 34px); box-shadow: 0 0 0 1px #e9e4d2, 0 10px 24px oklch(0 0 0 / 0.08); rotate: -0.6deg; }
  .b7-title { display: flex; justify-content: space-between; margin: 0 0 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; } .b7-title span { font-weight: 400; text-transform: none; letter-spacing: 0; color: #6b6b6b; }
  .b7-row { --c: oklch(0.52 0.2 28); display: grid; grid-template-columns: auto 1fr 56px 34px; gap: 10px; align-items: baseline; font-size: 15px; } .b7-row[data-tone="ok"] { --c: oklch(0.55 0.15 60); } .b7-row[data-tone="good"] { --c: oklch(0.45 0.14 150); }
  .b7-row i { border-bottom: 2px dotted #c9c3ad; translate: 0 -4px; } .b7-grade { font: 700 30px / 1 "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive; color: var(--c); text-align: center; rotate: -6deg; } .b7-grade.write { animation: ba-write 0.4s var(--ba-ease); } @keyframes ba-write { from { scale: 1.6; opacity: 0; } }
  .b7-score { font: 12px ui-monospace, Menlo, monospace; color: #8a8a8a; text-align: right; }
