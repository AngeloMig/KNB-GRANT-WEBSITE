  .b2-page { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 14px 1.3fr 1fr; gap: 8px; height: 220px; margin-top: -8px; padding: 12px; border-radius: 0 0 10px 10px; box-shadow: inset 0 0 0 1px #e4e4e4; }
