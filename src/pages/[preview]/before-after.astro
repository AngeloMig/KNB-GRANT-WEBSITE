---
// Design preview: the "Illustrative report" in the Migrations & technical SEO service card.
// 1–10 are improvements to the card as it is; 11–20 are different ways to show a before and after.
// Local preview only: in a build this route has no pages. Open http://localhost:4321/ideas/before-after/.
// Every figure here is an example (the live card's own example scores), and each idea says so.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'A handle you can drag'], [2, 'Show the gain'], [3, 'A play button'], [4, 'What each number means'], [5, 'Rings that celebrate'],
  [6, 'Fixes that tick off'], [7, 'The move, in motion'], [8, 'Two tabs, less crowded'], [9, 'Check your own site'], [10, 'The card warms up'],
  [11, 'Drag to compare'], [12, 'The loading race'], [13, 'Speedometer'], [14, 'Departure board'], [15, 'Bars that overtake'],
  [16, 'The search listing, repaired'], [17, 'School report'], [18, 'Filmstrip'], [19, 'Heartbeat'], [20, 'Radar'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['drag the handle', 'The progress line becomes a real handle: grab it and scrub between before and after yourself. A small “Drag” hint shows until it’s used.'],
  2: ['', 'Each score gets a green “+48” chip that counts up with it, so the improvement is the headline, not just the final number.'],
  3: ['press Play', 'A Play button runs the whole before-to-after once, eased, and it plays by itself the first time the card scrolls into view.'],
  4: ['scrub it', 'A plain line under each score says what it means for a visitor: load time, issues left, warnings, pages that are hard to find.'],
  5: ['watch a score pass 90', 'The ring colour blends smoothly from red through amber to green, and each ring pops with a tick the moment it passes 90.'],
  6: ['scrub slowly', 'An example checklist of fixes; each one ticks off as the scores climb past it, so the “after” is explained, not just shown.'],
  7: ['pick a route, then scrub', 'A parcel travels from the old platform to the new one as the move progresses; picking another route swaps the names and each step’s details.'],
  8: ['tap the tabs', 'The card splits into two tabs, “Speed & SEO” and “Migration”, so each half has room and the card is far less crowded.'],
  9: ['', 'The example report ends with an invitation to request a real audit. This local preview only demonstrates the form; nothing is sent.'],
  10: ['scrub it', 'The whole card follows the scores: it warms from a tired red to a fresh green, and the big word behind fills in as you go.'],
  11: ['drag across the page', 'One page, split by a handle: the slow, jumpy “before” on one side and the fast, settled “after” on the other.'],
  12: ['press Run the race', 'Two browsers load the same page side by side, in real time: one takes 6.8 seconds, the other 1.9. You feel the difference.'],
  13: ['pick a score, then scrub', 'One big dial. The needle swings from the red into the green for whichever score you pick.'],
  14: ['tap Before / After', 'The scores as a split-flap departure board: each digit flips over to its new number.'],
  15: ['scrub it', 'Each score as a bar that grows past a hatched marker of where it started, with the gain written at the end.'],
  16: ['scrub it', 'What technical SEO actually changes: a messy search listing (cut-off title, no description, ugly address) wipes into a clean one. No ranking is promised.'],
  17: ['scrub it', 'A school report: grades rewrite themselves from F and C+ to A+ in pen, the teacher’s comment changes, and a stamp lands at the end.'],
  18: ['drag the time, or press Play', 'A filmstrip of the page loading, second by second, like PageSpeed’s own: before stays blank for seconds, after is there almost at once.'],
  19: ['scrub it', 'The site’s pulse on a monitor: an erratic line with a stall settles into a steady, healthy beat.'],
  20: ['scrub it', 'All four scores as one shape: a dashed outline of the “before”, and the “after” growing out to the edges.'],
};
---
<BaseLayout title="Before and after ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'See the live card on the homepage', href: '/#services' }]} />
  <div class="wrap ba-page">
    <header class="ba-pagehead">
      <span class="tiny-heading">Preview · the Migrations & technical SEO card</span>
      <h1 class="display">Before<br />and after</h1>
      <p>Ten improvements to the card as it is now (1–10), then ten different ways to show a before and after (11–20). All figures are the card’s own example scores, labelled as examples. Each one plays once as it scrolls into view.</p>
      <label class="ba-motion-control"><input id="ba-still" type="checkbox" /> Use still previews</label>
    </header>
    {IDEAS.map(([n, name]) => (
      <>
        {n === 1 && <h2 class="ba-part">Improvements to the current card</h2>}
        {n === 11 && <h2 class="ba-part">New before-and-after variants</h2>}
        <section class="ba" id={`idea-${n}`} aria-labelledby={`ba-title-${n}`}>
          <div class="ba-top"><h3 class="idea-tag" id={`ba-title-${n}`}><b>{n}</b>{name}{NOTES[n][0] && <em>{NOTES[n][0]}</em>}</h3><p class="ba-why">{NOTES[n][1]}</p></div>
          <div class:list={['ba-demo', `ba-v${n}`, { 'ba-stage': n <= 10 }]} data-v={n}></div>
        </section>
      </>
    ))}
  </div>
</BaseLayout>

<script>
  import { arrowMarkup } from '../../utils/arrow';
  const CATS = ['Performance', 'Accessibility', 'Best practices', 'SEO'];
  const B = [48, 81, 92, 78], A = [96, 100, 100, 100];
  const lerp = (a: number, b: number, p: number) => a + (b - a) * p;
  const tone = (s: number) => (s >= 90 ? 'good' : s >= 50 ? 'ok' : 'poor');
  // Red (25) through amber (80) to green (150), for colours that blend rather than step.
  const hueOf = (s: number) => (s < 50 ? 25 : s < 90 ? 25 + ((s - 50) / 40) * 55 : 80 + Math.min(1, (s - 90) / 8) * 70);
  const avg = (p: number) => B.reduce((sum, b, i) => sum + lerp(b, A[i], p), 0) / 4;
  const $ = <T extends HTMLElement = HTMLElement>(root: ParentNode, sel: string) => root.querySelector<T>(sel)!;
  const $$ = <T extends HTMLElement = HTMLElement>(root: ParentNode, sel: string) => [...root.querySelectorAll<T>(sel)];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const still = $<HTMLInputElement>(document, '#ba-still');
  const page = $(document, '.ba-page');
  const stops = new Set<() => void>(), staticStates = new Set<() => void>();
  const motionAllowed = () => !reduced.matches && !still.checked;
  const syncMotion = () => {
    page.classList.toggle('is-still', !motionAllowed());
    if (!motionAllowed()) { stops.forEach(stop => stop()); staticStates.forEach(show => show()); }
  };
  still.addEventListener('change', syncMotion); reduced.addEventListener('change', syncMotion);
  document.addEventListener('visibilitychange', () => { if (document.hidden) stops.forEach(stop => stop()); });
  // Decorative loops run only for the cards currently near the viewport.
  const visibility = new IntersectionObserver(entries => entries.forEach(entry => entry.target.classList.toggle('ba-visible', entry.isIntersecting)), {rootMargin:'80px'});

  function once(box:HTMLElement, fn:()=>void, threshold=.55) {
    let timer=0;
    const io=new IntersectionObserver(([entry])=>{
      clearTimeout(timer);
      if(entry.isIntersecting && motionAllowed()) timer=window.setTimeout(()=>{
        if(!document.hidden && motionAllowed()) { io.disconnect(); fn(); }
      },350);
    },{threshold});
    if(motionAllowed()) io.observe(box);
    const cancel=()=>{clearTimeout(timer);io.disconnect();};
    stops.add(cancel); return cancel;
  }

  /* ---------- Shared parts ---------- */
  const head = (title = 'A healthier website.', withSwitch = true, eyebrow = 'Illustrative report') => `<header class="ba-head"><div><span>${eyebrow}</span><strong>${title}</strong></div>${withSwitch ? '<div class="ba-switch" role="group" aria-label="Before or after"><button type="button" data-phase="before">Before</button><button type="button" data-phase="after">After</button></div>' : ''}</header>`;
  const scrub = (cls = '', l = 'Before', r = 'After') => `<div class="ba-scrub ${cls}"><div class="ba-range-wrap"><input class="ba-range" type="range" min="0" max="100" value="0" aria-label="${l} to ${r}" /><span class="ba-hint" aria-hidden="true">‹ Drag ›</span></div><div class="ba-scrub-labels"><span>${l}</span><span class="ba-pct">0%</span><span>${r}</span></div></div>`;
  const gauges = (extra: (i: number) => string = () => '') => `<ul class="ba-gauges">${CATS.map((c, i) => `<li class="ba-gauge" data-i="${i}"><div class="ba-ring"><svg viewBox="0 0 80 80" aria-hidden="true"><circle class="t" cx="40" cy="40" r="34"/><circle class="f" cx="40" cy="40" r="34" pathLength="100"/></svg><strong>0</strong><i class="ba-tick" aria-hidden="true">✓</i></div><span>${c}</span>${extra(i)}</li>`).join('')}</ul>`;
  const note = (t = 'Example scores, not measured client results.') => `<p class="ba-note">${t}</p>`;
  const card = (inner: string) => `<div class="ba-card">${inner}</div>`;
  const paintGauges = (box: HTMLElement, p: number) => {
    $$(box, '.ba-gauge').forEach((g, i) => {
      const v = lerp(B[i], A[i], p), s = Math.round(v);
      $(g, 'strong').textContent = String(s);
      g.querySelector('.f')!.setAttribute('stroke-dasharray', `${v.toFixed(2)} 100`);
      g.dataset.tone = tone(s);
      g.style.setProperty('--gh', hueOf(v).toFixed(1));
    });
  };
  const ROUTES = [
    { from: 'WooCommerce', to: 'Shopify', detail: 'Move products and content. Map old URLs. Check checkout and tracking.', steps: ['Products, customers & URL map', 'Theme build & app setup', 'Test checkout & tracking'] },
    { from: 'WordPress', to: 'Webflow', detail: 'Rebuild key pages and CMS content. Keep useful URLs. Check forms and search settings.', steps: ['Pages, CMS & URL map', 'Rebuild pages & collections', 'Check forms & search settings'] },
    { from: 'Magento', to: 'Shopify', detail: 'Plan the catalogue move. Reconnect business tools. Test orders before launch.', steps: ['Catalogue & URL map', 'Reconnect business tools', 'Test orders before launch'] },
  ];
  const mig = (parcel = false) => `<div class="ba-mig"><div class="ba-mig-head"><strong>Example migration</strong><span class="ba-mig-status">Plan the move</span></div><div class="ba-route"><div class="ba-plat"><small>Existing platform</small><b class="ba-from">${ROUTES[0].from}</b></div><div class="ba-track${parcel ? ' has-parcel' : ''}"><i class="ba-parcel" aria-hidden="true"></i><span aria-hidden="true">→</span></div><div class="ba-plat ba-plat-to"><small>New platform</small><b class="ba-to">${ROUTES[0].to}</b></div></div><div class="ba-chips">${ROUTES.map((r, i) => `<button type="button" data-route="${i}" aria-pressed="${i === 0}">${r.from} → ${r.to}</button>`).join('')}</div><p class="ba-mig-detail">${ROUTES[0].detail}</p><ol class="ba-steps">${['Plan', 'Move', 'Check & launch'].map((s, i) => `<li><i></i><b>${s}</b><small>${ROUTES[0].steps[i]}</small></li>`).join('')}</ol></div>`;
  const paintMig = (box: HTMLElement, p: number) => {
    const step = Math.min(2, Math.floor(p * 3)), done = p > 0.999;
    $$(box, '.ba-steps li').forEach((li, i) => { li.dataset.state = i < step || done ? 'done' : i === step ? 'active' : 'next'; });
    $(box, '.ba-steps').style.setProperty('--p', p.toFixed(4));
    $(box, '.ba-mig-status').textContent = done ? 'Live on the new platform' : ['Plan the move', 'Build & reconnect', 'Check before launch'][step];
    $(box, '.ba-track').style.setProperty('--p', p.toFixed(4));
  };
  const bindRoutes = (box: HTMLElement, replay: () => void) => $$(box, '[data-route]').forEach((b) => b.addEventListener('click', () => {
    const r = ROUTES[Number(b.dataset.route)];
    $$(box, '[data-route]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    [['.ba-from', r.from], ['.ba-to', r.to]].forEach(([sel, text]) => { const el = $(box, sel); el.classList.remove('swap'); void el.offsetWidth; el.textContent = text; el.classList.add('swap'); });
    $(box, '.ba-mig-detail').textContent = r.detail;
    $$(box, '.ba-steps small').forEach((s, i) => { s.textContent = r.steps[i]; });
    replay();
  }));

  /** One before-to-after driver per demo: the switch, the scrubber, a Play button, and one play when first seen. */
  function drive(box: HTMLElement, render: (p: number) => void, opts: { auto?: boolean; dur?: number } = {}) {
    let p = motionAllowed() ? 0 : 1, raf = 0, target=p;
    const range = box.querySelector<HTMLInputElement>('.ba-range'), wrap = box.querySelector<HTMLElement>('.ba-scrub');
    const btns = $$(box, '[data-phase]'), play = box.querySelector<HTMLElement>('.ba-play'), pct = box.querySelector<HTMLElement>('.ba-pct');
    const paint = () => {
      render(p);
      box.dataset.progress=String(Math.round(p*100));
      if (range) range.value = String(Math.round(p * 100));
      wrap?.style.setProperty('--p', p.toFixed(4));
      if (pct) pct.textContent = `${Math.round(p * 100)}%`;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.phase === (p<.001?'before':p>.999?'after':''))));
    };
    const to = (next: number, dur = opts.dur ?? 1300) => {
      cancelAnimationFrame(raf);
      target=next;
      if(!motionAllowed()) {p=target;raf=0;paint();return;}
      const from = p, t0 = performance.now();
      const step = (t: number) => { const k = Math.min(1, (t - t0) / dur), e = k < 0.5 ? 4 * k ** 3 : 1 - (-2 * k + 2) ** 3 / 2; p = from + (target - from) * e; paint(); raf=k<1?requestAnimationFrame(step):0; };
      raf = requestAnimationFrame(step);
    };
    let cancelAuto=()=>{};
    const used=()=>{cancelAuto();box.classList.add('was-used');};
    range?.addEventListener('input', () => { used();cancelAnimationFrame(raf);raf=0;p=target=Number(range.value)/100;paint(); });
    btns.forEach((b) => b.addEventListener('click', () => {used();to(b.dataset.phase === 'after' ? 1 : 0);}));
    const replay = () => { used();cancelAnimationFrame(raf); p = 0; paint(); to(1, 2400); };
    play?.addEventListener('click', replay);
    if (opts.auto !== false) cancelAuto=once(box,()=>to(1,2200));
    stops.add(()=>{if(raf){cancelAnimationFrame(raf);raf=0;p=target;paint();}});
    staticStates.add(()=>{cancelAuto();p=target=1;paint();});
    paint();
    return { to, replay, get: () => p, set: (v: number) => { used();cancelAnimationFrame(raf);raf=0;p=target=Math.min(1,Math.max(0,v));paint(); } };
  }

  const build: Record<number, (box: HTMLElement) => void> = {
    /* ===== Improvements ===== */
    1: (box) => { box.innerHTML = card(head() + scrub('is-big') + gauges() + note()); drive(box, (p) => paintGauges(box, p)); },
    2: (box) => {
      box.innerHTML = card(head() + scrub() + gauges(() => '<em class="ba-gain">+0</em>') + note());
      drive(box, (p) => { paintGauges(box, p); $$(box, '.ba-gain').forEach((g, i) => { const d = Math.round((A[i] - B[i]) * p); g.textContent = `+${d}`; g.classList.toggle('on', d > 0); }); });
    },
    3: (box) => { box.innerHTML = card(head() + scrub() + gauges() + `<div class="ba-playrow"><button type="button" class="ba-play"><i aria-hidden="true">▶</i> Play the before and after</button>${note()}</div>`); drive(box, (p) => paintGauges(box, p)); },
    4: (box) => {
      box.innerHTML = card(head() + scrub() + gauges(() => '<small class="ba-mean"></small>') + note('Example scores and figures, not measured client results.'));
      const plural = (n: number, one: string, many: string, none: string) => (n === 0 ? none : `${n} ${n === 1 ? one : many}`);
      drive(box, (p) => {
        paintGauges(box, p);
        const m = $$(box, '.ba-mean');
        m[0].textContent = `Loads in ${lerp(6.8, 1.9, p).toFixed(1)} s`;
        m[1].textContent = plural(Math.round(lerp(9, 0, p)), 'issue to fix', 'issues to fix', 'No issues found');
        m[2].textContent = plural(Math.round(lerp(4, 0, p)), 'warning', 'warnings', 'No warnings');
        m[3].textContent = plural(Math.round(lerp(12, 0, p)), 'search check left', 'search checks left', 'Search checks complete');
      });
    },
    5: (box) => {
      box.innerHTML = card(head() + scrub() + gauges() + note());
      drive(box, (p) => { paintGauges(box, p); $$(box, '.ba-gauge').forEach((g) => { const good = g.dataset.tone === 'good'; if (good && !g.classList.contains('pop')) g.classList.add('pop'); if (!good) g.classList.remove('pop'); }); });
    },
    6: (box) => {
      const fixes: [number, string, string][] = [[0.12, 'Compress and resize images', 'Performance'], [0.28, 'Remove unused apps and scripts', 'Performance'], [0.44, 'Fix headings, labels and alt text', 'Accessibility'], [0.6, 'Add missing titles and descriptions', 'SEO'], [0.76, 'Fix broken links and redirects', 'SEO'], [0.92, 'Update outdated code', 'Best practices']];
      box.innerHTML = card(head() + scrub() + gauges() + `<ul class="ba-fixes">${fixes.map(([, t, c]) => `<li><i aria-hidden="true">✓</i><span>${t}</span><small>${c}</small></li>`).join('')}</ul>` + note('An example list of fixes, not a client’s report.'));
      drive(box, (p) => { paintGauges(box, p); $$(box, '.ba-fixes li').forEach((li, i) => li.classList.toggle('done', p >= fixes[i][0])); });
    },
    7: (box) => { box.innerHTML = card(mig(true) + scrub('', 'Start', 'Launched')); const d = drive(box, (p) => paintMig(box, p)); bindRoutes(box, d.replay); },
    8: (box) => {
      box.innerHTML = card(`${head()}<div class="ba-tabs" role="tablist" aria-label="Report view"><button type="button" role="tab" id="ba-tab-0" aria-controls="ba-panel-0" aria-selected="true" data-tab="0">Speed & SEO</button><button type="button" role="tab" id="ba-tab-1" aria-controls="ba-panel-1" aria-selected="false" tabindex="-1" data-tab="1">Migration</button><i aria-hidden="true"></i></div><div class="ba-tabpanels"><div class="ba-tabpanel on" id="ba-panel-0" role="tabpanel" aria-labelledby="ba-tab-0">${gauges()}${note()}</div><div class="ba-tabpanel" id="ba-panel-1" role="tabpanel" aria-labelledby="ba-tab-1">${mig()}</div></div>${scrub()}`);
      const d = drive(box, (p) => { paintGauges(box, p); paintMig(box, p); });
      bindRoutes(box, d.replay);
      const tabs=$$<HTMLButtonElement>(box,'[data-tab]');
      const choose=(i:number)=>{tabs.forEach((tab,k)=>{tab.setAttribute('aria-selected',String(k===i));tab.tabIndex=k===i?0:-1;});$$(box,'.ba-tabpanel').forEach((panel,k)=>panel.classList.toggle('on',k===i));$(box,'.ba-tabs').style.setProperty('--tab',String(i));};
      tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>choose(i));tab.addEventListener('keydown',event=>{const next=event.key==='Home'?0:event.key==='End'?1:['ArrowLeft','ArrowRight'].includes(event.key)?1-i:-1;if(next<0)return;event.preventDefault();choose(next);tabs[next].focus();});});
    },
    9: (box) => {
      box.innerHTML = card(head() + scrub() + gauges() + `<form class="ba-own"><label for="ba-own-in">These are example scores. <strong>Request a real audit:</strong></label><div><input id="ba-own-in" placeholder="yourstore.com" inputmode="url" autocomplete="off" /><button type="submit">Preview audit request ${arrowMarkup(true)}</button></div><p class="ba-own-msg" role="status">Local preview only. Nothing is sent.</p></form>`);
      drive(box, (p) => paintGauges(box, p));
      $(box, '.ba-own').addEventListener('submit', (e) => { e.preventDefault(); const v = $<HTMLInputElement>(box, '#ba-own-in').value.trim(); $(box, '.ba-own-msg').textContent = v ? `Preview: an audit request would include ${v}. Nothing has been sent.` : 'Type your website address first.'; });
    },
    10: (box) => {
      box.innerHTML = `<span class="ba-ghost" aria-hidden="true">MIGRATIONS &amp; SEO</span>${card(head() + scrub() + gauges() + note())}`;
      drive(box, (p) => { paintGauges(box, p); box.style.setProperty('--p', p.toFixed(4)); });
    },

    /* ===== Variants ===== */
    11: (box) => {
      const page = (k: string) => `<div class="b1-page b1-${k}"><div class="b1-nav"><i></i><span></span><span></span><span></span></div><div class="b1-hero">${k === 'before' ? '<b class="b1-spin"></b>' : '<strong>New season, now in.</strong><em>Shop now</em>'}</div><div class="b1-tiles"><i></i><i></i><i></i></div><p class="b1-badge"><b>${k === 'before' ? '48' : '96'}</b>${k === 'before' ? 'Loads in 6.8 s · jumps as it loads' : 'Loads in 1.9 s · steady'}</p></div>`;
      box.innerHTML = `${head('The same page, twice.')}<div class="b1-view">${page('after')}${page('before')}<span class="b1-handle" aria-hidden="true"><i>‹ ›</i></span><span class="b1-tag b1-tag-a">After</span><span class="b1-tag b1-tag-b">Before</span></div>${scrub('is-slim')}${note('An example page and example figures.')}`;
      const view = $(box, '.b1-view');
      const d = drive(box, (p) => view.style.setProperty('--p', p.toFixed(4)));
      let dragging = false;
      const at = (e: PointerEvent) => { const r = view.getBoundingClientRect(); d.set((e.clientX - r.left) / r.width); };
      view.addEventListener('pointerdown', (e) => { dragging = true; view.setPointerCapture(e.pointerId); at(e); });
      view.addEventListener('pointermove', (e) => { if (dragging) at(e); });
      view.addEventListener('pointerup', () => { dragging = false; });
      view.addEventListener('pointercancel', () => { dragging = false; });
    },
    12: (box) => {
      box.innerHTML = `${head('Same page, two load times.', false)}<div class="b2-lanes">${(['before', 'after'] as const).map((k) => `<div class="b2-lane" data-k="${k}"><div class="b2-bar"><i></i><i></i><i></i><span>${k === 'before' ? 'Before' : 'After'}</span><b class="b2-time">0.0 s</b></div><div class="b2-page"><span class="b2-spin"></span><i class="b2-b b2-nav"></i><i class="b2-b b2-hero"></i><i class="b2-b b2-t"></i><i class="b2-b b2-t"></i><i class="b2-b b2-t"></i></div><p class="b2-res">Waiting…</p></div>`).join('')}</div><div class="ba-playrow"><button type="button" class="ba-play"><i aria-hidden="true">▶</i> Run the race</button>${note('Example load times, played in real time.')}</div>`;
      const T = { before: 6.8, after: 1.9 }; let raf = 0;
      const lanes = $$(box, '.b2-lane');
      const paint=(seconds:number)=>{
        box.dataset.progress=String(Math.round(Math.min(1,seconds/T.before)*100));
        lanes.forEach(lane=>{
          const total=T[lane.dataset.k as 'before'|'after'],k=Math.min(1,seconds/total),blocks=$$(lane,'.b2-b');
          $(lane,'.b2-time').textContent=`${Math.min(seconds,total).toFixed(1)} s`;
          blocks.forEach((block,i)=>block.classList.toggle('in',k>=(i+1)/blocks.length));
          lane.classList.toggle('done',k>=1);lane.classList.toggle('running',k<1);
          $(lane,'.b2-res').textContent=k>=1?'Loaded ✓':'Loading…';
        });
      };
      const finish=()=>{cancelAnimationFrame(raf);raf=0;paint(T.before);};
      let cancelAuto=()=>{};
      const run=()=>{
        cancelAuto();cancelAnimationFrame(raf);
        if(!motionAllowed()){finish();return;}
        const t0=performance.now();paint(0);
        const step=(time:number)=>{const seconds=(time-t0)/1000;paint(seconds);raf=seconds<T.before?requestAnimationFrame(step):0;};
        raf=requestAnimationFrame(step);
      };
      $(box,'.ba-play').addEventListener('click',run);cancelAuto=once(box,run);
