---
// Design preview: 10 new sections for the project pages, shown on Tero (and Road Armor for the
// before/after). Local preview only: in a build this route has no pages, and its media lives in
// public/_preview (removed from docs/ by the build). Open http://localhost:4321/ideas/project-sections/.
// Everything marked "Real" was read from the live site on 8 Nov 2026; "Needs you" sections are layouts only.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'The fonts it uses'], [2, 'Speed report'], [3, 'Built with'], [4, 'Before and after'], [5, 'A tour of the pages'],
  [6, 'Phone, tablet, desktop'], [7, 'In motion'], [8, 'Plan one like this'], [9, 'At a glance'], [10, 'In the client’s words'],
  [11, 'Feature hotspots'], [12, 'Brand kit'], [13, 'Scroll story'], [14, 'More like this'], [15, 'Live check and time zone'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['Real · read from tero.au', 'The typefaces the site uses, as a specimen: big “Aa”, the alphabet and a sample line. Found automatically from the live site.'],
  2: ['Real · measured today', 'The site’s own Google Lighthouse scores, drawn like PageSpeed. Worth showing only where they’re strong: Tero scores 49 for performance on a phone (it’s a heavy video site), so this one would stay off its page.'],
  3: ['Real · detected on tero.au', 'The platform, theme and tools the site runs on, found in its code, as chips. You’d confirm the list once per project.'],
  4: ['Needs an old screenshot', 'Drag the handle to compare the old site with the new one. Road Armor today on the right; the left needs a screenshot of the site before (the Wayback Machine’s copies of these sites load without their styling).'],
  5: ['Real · Tero’s own pages', 'More than the homepage: a filmstrip of the key pages (here the Origin story, a product page and the Journal), each opening larger.'],
  6: ['Real · three captures', 'One frame that changes width: tap Phone, Tablet or Desktop and it resizes to show how the layout adapts.'],
  7: ['Real · recorded from tero.au', 'A short silent clip of the site in use (here a scroll down the homepage), looping inside a browser frame, so its motion comes across.'],
  8: ['Real · works today', '“Want one like this?” with the estimator already set up for this kind of project (a new Shopify store), so it starts two questions in.'],
  9: ['Needs your facts', 'The project in numbers: your role, how long it took, pages built, what launched. The values here are blanks for you to fill in.'],
  10: ['Needs client approval', 'A short quote and who said it, shown only once the client has approved the words. No quote is shown here.'],
  11: ['Real · notes to confirm', 'Numbered dots on the homepage. Tap one to read about that part. The notes here describe what’s on the live site; you’d confirm the wording.'],
  12: ['Real · from the page’s data', 'The brand on one sheet: the colours read from the site, its typeface and crops of its own imagery, laid out like a designer’s brand board.'],
  13: ['Captions need you', 'Scroll on and the laptop stays put while the full homepage scrolls inside it, with a caption for each part. The screenshot is real; the captions are placeholders for a line from you.'],
  14: ['Real · same platform', 'Before the next project, a few more built on the same platform, so a visitor keeps browsing instead of leaving.'],
  15: ['Live check real · city needs you', 'A badge showing the site answered when the page was built, and the client’s local time next to Grant’s. The .au address says Australia; the city (Melbourne here) is a guess to confirm.'],
};
const fullpages = (await import('../../data/project-fullpages.json')).default as Record<string, { desktop: Record<string, number>; palette: { hex: string; share: number }[] }>;
const teroFull = fullpages.tero;
const { projects } = await import('../../data/projects');
const similar = projects.filter((p) => p.platform === 'Shopify' && p.slug !== 'tero').slice(0, 3);
const hotspots = [
  { x: 20, y: 11, title: 'Four ways in', text: 'Origin, Library, Product and Journal: the whole site in four words.' },
  { x: 56, y: 11, title: 'The wordmark', text: 'The Tero name, set in the same monospaced type as the rest of the site.' },
  { x: 62, y: 46, title: 'The promise', text: '“A listening app for the bath”: what Tero is, in one line, over the water video.' },
  { x: 74, y: 88, title: 'Join', text: 'Sign up for access; the way in arrives by email.' },
  { x: 90, y: 88, title: 'The releases', text: 'Straight to the library of recordings.' },
];
const story = [
  { at: 0, title: 'The hero', text: 'A line from you about the opening screen.' },
  { at: 0.28, title: 'The releases', text: 'A line from you about this part of the page.' },
  { at: 0.55, title: 'The story', text: 'A line from you about this part of the page.' },
  { at: 0.82, title: 'The footer', text: 'A line from you about how the page ends.' },
];
const checkedOn = '9 Nov 2026';
const isLight = (hex: string) => { const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255); return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.55; };
// A share link that opens the estimator on a new Shopify store.
const brief = Buffer.from(JSON.stringify({ type: 'new', platform: 'shopify' })).toString('base64url');
const estimateLink = `${withBase('/estimate/')}?brief=${brief}`;
const media = (f: string) => withBase(`/_preview/project-sections/${f}`);
const stack = [
  { name: 'Shopify', note: 'Platform', kind: 'platform' },
  { name: 'Custom theme', note: '“Tero/main”, built for the brand', kind: 'theme' },
  { name: 'Klaviyo', note: 'Email sign-ups and flows', kind: 'tool' },
  { name: 'Shop Pay', note: 'Express checkout', kind: 'tool' },
  { name: 'Meta Pixel', note: 'Ad tracking', kind: 'tool' },
];
const scores = [['Performance', 49], ['Accessibility', 91], ['Best Practices', 75], ['SEO', 92]] as const;
const pages = [
  { file: 'tero-page-0.webp', title: 'Origin', sub: 'The story page' },
  { file: 'tero-page-1.webp', title: 'FATHOM', sub: 'A product page' },
  { file: 'tero-page-2.webp', title: 'Journal', sub: 'The blog' },
];
const band = (n: number) => (n >= 90 ? 'good' : n >= 50 ? 'ok' : 'poor');
---
<BaseLayout title="Project section ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Open Tero’s project page', href: '/work/tero/' }]} />
  <div class="wrap ps-page">
    <header class="ps-head">
      <span class="tiny-heading">Preview · new project page sections</span>
      <h1 class="display">Ten more<br />sections</h1>
      <p>New sections for the project pages, shown on Tero. Sections marked <b>Real</b> use what was read from the live site today; the ones marked <b>Needs you</b> are layouts waiting for your facts or a client’s approval.</p>
    </header>

    <section class="ps" id="idea-1">
      <div class="ps-top"><span class="idea-tag"><b>1</b>{IDEAS[0][1]}<em>{NOTES[1][0]}</em></span><p class="ps-why">{NOTES[1][1]}</p></div>
      <div class="ps-fonts">
        <div class="ps-font-card"><span class="ps-aa">Aa</span><div><strong>JetBrains Mono</strong><small>Headings, body and buttons</small></div></div>
        <div class="ps-font-sample"><p class="ps-alpha">ABCDEFGHIJKLM<br />NOPQRSTUVWXYZ<br />abcdefghijklm<br />nopqrstuvwxyz<br />0123456789</p><p class="ps-line">A listening app for the bath.</p><div class="ps-weights"><span style="font-weight:300">Light</span><span style="font-weight:400">Regular</span><span style="font-weight:700">Bold</span></div></div>
      </div>
    </section>

    <section class="ps" id="idea-2">
      <div class="ps-top"><span class="idea-tag"><b>2</b>{IDEAS[1][1]}<em>{NOTES[2][0]}</em></span><p class="ps-why">{NOTES[2][1]}</p></div>
      <div class="speed-check ps-speed">
        <p class="speed-check-head"><span class="speed-check-site">tero.au</span><span class="speed-check-mode">Mobile · 8 Nov 2026</span></p>
        <div class="speed-gauges">{scores.map(([n, v]) => (
          <div class="gauge" data-band={band(v)} style={`--score:${v}`}>
            <span class="gauge-ring"><svg viewBox="0 0 120 120" aria-hidden="true"><circle class="gauge-track" cx="60" cy="60" r="54" /><circle class="gauge-bar" cx="60" cy="60" r="54" pathLength="100" /></svg><span class="gauge-num">{v}</span></span>
            <span class="gauge-label">{n}</span>
          </div>
        ))}</div>
        <p class="speed-check-note">Measured with Google Lighthouse on a simulated phone. Scores move with each test and with changes to the live site.</p>
      </div>
    </section>

    <section class="ps" id="idea-3">
      <div class="ps-top"><span class="idea-tag"><b>3</b>{IDEAS[2][1]}<em>{NOTES[3][0]}</em></span><p class="ps-why">{NOTES[3][1]}</p></div>
      <div class="ps-stack">{stack.map((t) => <span class:list={['ps-chip', `is-${t.kind}`]}><strong>{t.name}</strong><small>{t.note}</small></span>)}</div>
    </section>

    <section class="ps" id="idea-4">
      <div class="ps-top"><span class="idea-tag"><b>4</b>{IDEAS[3][1]}<em>{NOTES[4][0]}</em></span><p class="ps-why">{NOTES[4][1]}</p></div>
      <div class="ps-compare" style="--at:50%">
        <img src={withBase('/images/projects/road-armor-1440.webp')} alt="Road Armor homepage today" width="1440" height="810" />
        <div class="ps-before"><div class="ps-before-inner"><span>Before</span><p>An old screenshot of the site goes here</p></div></div>
        <span class="ps-handle" aria-hidden="true"><i>‹ ›</i></span>
        <span class="ps-tag ps-tag-l">Before</span><span class="ps-tag ps-tag-r">Now</span>
        <input type="range" min="0" max="100" value="50" aria-label="Compare before and now" />
      </div>
    </section>

    <section class="ps" id="idea-5">
      <div class="ps-top"><span class="idea-tag"><b>5</b>{IDEAS[4][1]}<em>{NOTES[5][0]}</em></span><p class="ps-why">{NOTES[5][1]}</p></div>
      <div class="ps-film">{pages.map((p, i) => (
        <button type="button" class="ps-frame" style={`--i:${i}`}><span class="ps-frame-bar"><i></i><i></i><i></i></span><img src={media(p.file)} alt={`Tero ${p.title} page`} width="1100" height="688" loading="lazy" /><span class="ps-frame-cap"><strong>{p.title}</strong><small>{p.sub}</small></span></button>
      ))}</div>
    </section>

    <section class="ps" id="idea-6">
      <div class="ps-top"><span class="idea-tag"><b>6</b>{IDEAS[5][1]}<em>{NOTES[6][0]}</em></span><p class="ps-why">{NOTES[6][1]}</p></div>
      <div class="ps-resp" data-w="desktop">
        <div class="ps-resp-switch" role="group" aria-label="Screen size"><button type="button" data-w="phone">Phone</button><button type="button" data-w="tablet">Tablet</button><button type="button" data-w="desktop" aria-pressed="true">Desktop</button></div>
        <div class="ps-resp-stage"><div class="ps-resp-frame"><img data-w="phone" src={withBase('/images/projects/tero-mobile-720.webp')} alt="Tero on a phone" /><img data-w="tablet" src={media('tero-tablet.webp')} alt="Tero on a tablet" /><img data-w="desktop" src={withBase('/images/projects/tero-1440.webp')} alt="Tero on a desktop" /></div><span class="ps-resp-size"></span></div>
      </div>
    </section>

    <section class="ps" id="idea-7">
      <div class="ps-top"><span class="idea-tag"><b>7</b>{IDEAS[6][1]}<em>{NOTES[7][0]}</em></span><p class="ps-why">{NOTES[7][1]}</p></div>
      <div class="ps-motion"><div class="ps-browser"><span class="ps-frame-bar"><i></i><i></i><i></i><b>tero.au</b></span><video src={media('tero-scroll.webm')} muted loop playsinline autoplay preload="metadata" aria-label="A scroll down the Tero homepage"></video></div></div>
    </section>

    <section class="ps" id="idea-8">
      <div class="ps-top"><span class="idea-tag"><b>8</b>{IDEAS[7][1]}<em>{NOTES[8][0]}</em></span><p class="ps-why">{NOTES[8][1]}</p></div>
      <a class="ps-plan" href={estimateLink}>
        <span class="ps-plan-left"><small>Want one like this?</small><strong>Plan your own Shopify store</strong><span class="ps-plan-chips"><i>A new website or store</i><i>Shopify</i><i>Already filled in</i></span></span>
        <span class="ps-plan-go">Start the estimate ↗</span>
      </a>
    </section>

    <section class="ps" id="idea-9">
      <div class="ps-top"><span class="idea-tag"><b>9</b>{IDEAS[8][1]}<em>{NOTES[9][0]}</em></span><p class="ps-why">{NOTES[9][1]}</p></div>
      <div class="ps-glance">{[['Role', 'Your role'], ['Timeline', 'Weeks, start to launch'], ['Pages built', 'Templates and pages'], ['Launched', 'Month and year']].map(([k, hint]) => <div><small>{k}</small><strong class="ps-blank">—</strong><span>{hint}</span></div>)}</div>
    </section>

    <section class="ps" id="idea-10">
      <div class="ps-top"><span class="idea-tag"><b>10</b>{IDEAS[9][1]}<em>{NOTES[10][0]}</em></span><p class="ps-why">{NOTES[10][1]}</p></div>
      <figure class="ps-quote"><span class="ps-quote-mark" aria-hidden="true">“</span><blockquote class="ps-blank-quote">The client’s approved words go here.</blockquote><figcaption><span class="ps-avatar" aria-hidden="true"></span><span><strong>Name</strong><small>Role, company</small></span></figcaption></figure>
    </section>

    <section class="ps" id="idea-11">
      <div class="ps-top"><span class="idea-tag"><b>11</b>{IDEAS[10][1]}<em>{NOTES[11][0]}</em></span><p class="ps-why">{NOTES[11][1]}</p></div>
      <div class="ps-hot">
        <div class="ps-hot-pic">
          <img src={withBase('/images/projects/tero-1440.webp')} alt="Tero homepage" width="1440" height="810" />
          {hotspots.map((h, i) => <button type="button" class="ps-dot" style={`--x:${h.x}%;--y:${h.y}%`} aria-label={h.title} data-i={i}>{i + 1}</button>)}
        </div>
        <div class="ps-hot-note" aria-live="polite"><strong></strong><p></p></div>
      </div>
      <script type="application/json" class="ps-hot-data" set:html={JSON.stringify(hotspots)} />
    </section>

    <section class="ps" id="idea-12">
      <div class="ps-top"><span class="idea-tag"><b>12</b>{IDEAS[11][1]}<em>{NOTES[12][0]}</em></span><p class="ps-why">{NOTES[12][1]}</p></div>
      <div class="ps-kit">
        <div class="kit-logo"><img src={withBase('/images/projects/tero-1920.webp')} alt="" /><small>Wordmark</small></div>
        <div class="kit-type"><span>Aa</span><small>JetBrains Mono</small></div>
        <div class="kit-colours">{teroFull.palette.slice(0, 5).map((c) => <span class:list={[{ light: isLight(c.hex) }]} style={`--c:${c.hex}`}><small>{c.hex.toUpperCase()}</small></span>)}</div>
        <div class="kit-img kit-img-a"><img src={withBase('/images/projects/tero-1920.webp')} alt="" /></div>
        <div class="kit-img kit-img-b"><img src={media('tero-page-2.webp')} alt="" /></div>
        <div class="kit-line"><p>A LISTENING APP<br />FOR THE BATH</p><small>Tone of voice</small></div>
      </div>
    </section>

    <section class="ps ps-story-wrap" id="idea-13">
      <div class="ps-top"><span class="idea-tag"><b>13</b>{IDEAS[12][1]}<em>{NOTES[13][0]}</em></span><p class="ps-why">{NOTES[13][1]}</p></div>
      <div class="ps-story" style={`--ratio:${(teroFull.desktop['1100'] / 1100).toFixed(4)}`}>
        <div class="story-stick">
          <div class="story-laptop"><div class="story-screen"><img src={withBase('/images/projects/full/tero-desktop-1100.webp')} alt="Tero full homepage" width="1100" height={teroFull.desktop['1100']} /></div><span class="story-base"></span></div>
          <ol class="story-caps">{story.map((c, i) => <li data-at={c.at} class={i === 0 ? 'is-on' : ''}><small>{String(i + 1).padStart(2, '0')}</small><strong>{c.title}</strong><p>{c.text}</p></li>)}</ol>
        </div>
      </div>
    </section>

    <section class="ps" id="idea-14">
      <div class="ps-top"><span class="idea-tag"><b>14</b>{IDEAS[13][1]}<em>{NOTES[14][0]}</em></span><p class="ps-why">{NOTES[14][1]}</p></div>
      <div class="ps-more-like"><p class="ps-more-title">More Shopify work</p><div class="ps-more-grid">{similar.map((p) => (
        <a class="ps-like" href={withBase(`/work/${p.slug}/`)}><img src={withBase(`/images/projects/${p.slug}-640.webp`)} alt="" width="640" height="360" loading="lazy" /><strong>{p.name}</strong><small>{p.category}</small></a>
      ))}</div></div>
    </section>

    <section class="ps" id="idea-15">
      <div class="ps-top"><span class="idea-tag"><b>15</b>{IDEAS[14][1]}<em>{NOTES[15][0]}</em></span><p class="ps-why">{NOTES[15][1]}</p></div>
      <div class="ps-live">
        <span class="live-badge"><i></i>Live now · checked {checkedOn}</span>
        <div class="live-clocks">
          <div class="live-clock" data-tz="Asia/Manila"><small>Grant · Philippines</small><strong>--:--</strong><span></span></div>
          <span class="live-diff"></span>
          <div class="live-clock" data-tz="Australia/Melbourne"><small>Client · Melbourne <em>to confirm</em></small><strong>--:--</strong><span></span></div>
        </div>
        <p class="live-note"></p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // 4 · before/after handle
  document.querySelectorAll<HTMLElement>('.ps-compare').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('input')!;
    range.addEventListener('input', () => box.style.setProperty('--at', `${range.value}%`));
  });
  // 5 · filmstrip: tap a page to see it larger
  document.querySelectorAll<HTMLElement>('.ps-frame').forEach((f) => f.addEventListener('click', () => f.parentElement!.querySelectorAll('.ps-frame').forEach((x) => x.classList.toggle('is-open', x === f && !f.classList.contains('is-open')))));
  // 11 · hotspots
  document.querySelectorAll<HTMLElement>('.ps-hot').forEach((box) => {
    const data = JSON.parse(box.parentElement!.querySelector('.ps-hot-data')!.textContent!) as { title: string; text: string }[];
    const note = box.querySelector<HTMLElement>('.ps-hot-note')!;
    const open = (i: number) => { box.querySelectorAll('.ps-dot').forEach((d) => d.classList.toggle('is-on', Number((d as HTMLElement).dataset.i) === i)); note.querySelector('strong')!.textContent = `${i + 1} · ${data[i].title}`; note.querySelector('p')!.textContent = data[i].text; note.classList.add('is-on'); };
    box.querySelectorAll<HTMLElement>('.ps-dot').forEach((d) => d.addEventListener('click', () => open(Number(d.dataset.i))));
    open(0);
  });
  // 13 · scroll story: the full page scrolls inside the pinned laptop as the section passes
  document.querySelectorAll<HTMLElement>('.ps-story').forEach((box) => {
    const img = box.querySelector<HTMLElement>('.story-screen img')!, caps = [...box.querySelectorAll<HTMLElement>('.story-caps li')];
    let queued = false;
    const update = () => {
      queued = false;
      const r = box.getBoundingClientRect(), total = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / (total || 1)));
      const screen = img.parentElement!;
      img.style.transform = `translateY(${(-(img.offsetHeight - screen.clientHeight) * p).toFixed(1)}px)`;
      let on = 0; caps.forEach((c, i) => { if (p >= Number(c.dataset.at) - 0.02) on = i; });
      caps.forEach((c, i) => c.classList.toggle('is-on', i === on));
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  });
  // 15 · clocks
  document.querySelectorAll<HTMLElement>('.ps-live').forEach((box) => {
    const clocks = [...box.querySelectorAll<HTMLElement>('.live-clock')];
    const offset = (tz: string) => { const d = new Date(); const s = d.toLocaleString('en-US', { timeZone: tz }); return (new Date(s).getTime() - new Date(d.toLocaleString('en-US', { timeZone: 'UTC' })).getTime()) / 36e5; };
    const tick = () => {
      clocks.forEach((c) => { const tz = c.dataset.tz!; const now = new Date(); c.querySelector('strong')!.textContent = now.toLocaleTimeString('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit' }); c.querySelector('span')!.textContent = now.toLocaleDateString('en-GB', { timeZone: tz, weekday: 'long' }); });
      const diff = offset(clocks[1].dataset.tz!) - offset(clocks[0].dataset.tz!);
      box.querySelector('.live-diff')!.textContent = diff === 0 ? 'Same time' : `${diff > 0 ? '+' : '−'}${Math.abs(diff)} h`;
      box.querySelector('.live-note')!.textContent = diff === 0 ? 'Same working hours.' : `Melbourne is ${Math.abs(diff)} hour${Math.abs(diff) === 1 ? '' : 's'} ${diff > 0 ? 'ahead of' : 'behind'} Grant, so most of the working day overlaps.`;
    };
    tick(); setInterval(tick, 30000);
  });
  // 6 · responsive frame
  document.querySelectorAll<HTMLElement>('.ps-resp').forEach((box) => {
    const size = box.querySelector<HTMLElement>('.ps-resp-size')!;
    const label: Record<string, string> = { phone: '390 px', tablet: '768 px', desktop: '1440 px' };
    const set = (w: string) => { box.dataset.w = w; box.querySelectorAll<HTMLButtonElement>('.ps-resp-switch button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.w === w))); size.textContent = label[w]; };
    box.querySelectorAll<HTMLButtonElement>('.ps-resp-switch button').forEach((b) => b.addEventListener('click', () => set(b.dataset.w!)));
    set('desktop');
  });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;700&display=swap');
  .ps-page { padding-bottom: 160px; }
  .ps-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .ps-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .ps-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .ps { padding-block: 44px; border-top: 1px solid var(--line); }
  .ps-top { display: grid; gap: 4px; margin-bottom: 22px; }
  .ps-why { max-width: 720px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }

  /* 1 · fonts */
  .ps-fonts { display: grid; grid-template-columns: 340px 1fr; gap: 16px; }
  .ps-font-card { display: grid; align-content: space-between; min-height: 260px; padding: 24px; border-radius: 22px; background: #6b8f92; color: #fff; font-family: "JetBrains Mono", monospace; }
  .ps-aa { font-size: 140px; line-height: 0.9; letter-spacing: -0.04em; }
  .ps-font-card strong { display: block; font-size: 20px; } .ps-font-card small { opacity: 0.8; font-size: 12px; }
  .ps-font-sample { display: grid; gap: 14px; padding: 24px; border-radius: 22px; background: var(--surface); font-family: "JetBrains Mono", monospace; }
  .ps-alpha { margin: 0; font-size: 22px; line-height: 1.35; letter-spacing: 0.06em; }
  .ps-line { margin: 0; font-size: 26px; text-transform: uppercase; letter-spacing: 0.04em; }
  .ps-weights { display: flex; gap: 18px; font-size: 15px; color: var(--muted); }

  /* 2 · speed */
  .ps-speed { max-width: 560px; box-shadow: 0 0 0 1px var(--line); }

  /* 3 · stack */
  .ps-stack { display: flex; flex-wrap: wrap; gap: 10px; }
