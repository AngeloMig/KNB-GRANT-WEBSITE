---
// Design preview: 30 ideas for the About page. Local preview only: in a build this route has no pages.
// Open http://localhost:4321/ideas/about/. Real content is used wherever the site has it; anything that
// needs your words (FAQ answers, principles, a photo…) is marked “example” and must be replaced.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import CompanyLogo from '../../components/CompanyLogo.astro';
import VideoReviews from '../../components/VideoReviews.astro';
import { projects, canvasHues } from '../../data/projects';
import { experience, profile } from '../../data/profile';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Name in dots'], [2, 'Photo in dots'], [3, 'One-line intro'], [4, 'Availability pill'], [5, 'Local time and overlap'], [6, 'Résumé preview card'],
  [7, 'Numbered sections'], [8, 'Pull quote'], [9, 'How I work'], [10, 'Working with me'], [11, 'Words that fill in'], [12, 'A day in my work'],
  [13, 'Numbers that count up'], [14, 'Skills that link to proof'], [15, 'Logo strip'], [16, 'The video review'], [17, 'Live sites list'], [18, 'Recently shipped'],
  [19, 'Tools by strength'], [20, 'Tool notes on hover'], [21, 'Tools in an orbit'], [22, 'Tools by platform'],
  [23, 'Career timeline bar'], [24, 'Company colour on hover'], [25, 'Education card'],
  [26, '“Sound like a fit?”'], [27, 'FAQ for agencies'], [28, 'Currently learning'], [29, 'Next-page panel'], [30, 'Colour per section'],
] as const;
const GROUPS: Record<number, string> = { 1: 'First screen', 7: 'Story', 13: 'Proof', 19: 'Tools of the trade', 23: 'Experience & education', 26: 'Closing' };
const NOTES: Record<number, [string, string]> = {
  1: ['move over it', 'The page title drawn in the hero’s dots, so About feels part of the same site.'],
  2: ['hover the frame', 'Your photo as a dot halftone that sharpens on hover. Placeholder figure until you send a photo.'],
  3: ['', 'One clear sentence right under the title, so visitors get who you are before reading on.'],
  4: ['example month', 'A small pill saying when you can take on new work. Only if you want to show it.'],
  5: ['live: your time and the visitor’s', 'Manila time now, the visitor’s time, and how many working hours overlap. Clients abroad ask this first.'],
  6: ['hover it', 'The résumé download as a little document card that lifts on hover, instead of a plain link.'],
  7: ['scroll inside the box', 'A numbered list down the side that lights up the section you’re reading.'],
  8: ['', 'One line from your own intro set huge, between paragraphs.'],
  9: ['example wording', 'Your process in four short steps, with a line drawing across as it comes into view.'],
  10: ['example wording', 'Three short promises about how you work with clients and agencies.'],
  11: ['scroll past it', 'Key phrases in your intro fill in with colour as you scroll past them.'],
  12: ['example times', 'A short timeline of a working day in Manila time, with when you reply and when you’re building.'],
  13: ['scroll into view', 'Numbers taken from the site’s own data: years since 2019, companies, featured projects and tools.'],
  14: ['pick a skill', 'Each platform or agency shows the projects that prove it.'],
  15: ['', 'The companies you’ve worked with, in the site’s mono logo style, moving slowly.'],
  16: ['the homepage section, reused', 'Carlos’s real video review on the About page too. No new quotes.'],
  17: ['', 'Every featured project as a row that opens the live site.'],
  18: ['', 'The newest project (Tero) as a small “latest” card.'],
  19: ['example strengths', 'Tools sized by how much you use them: daily, often, comfortable.'],
  20: ['hover a tool · example notes', 'Each tool shows one line on how you use it.'],
  21: ['drag isn’t needed: it turns', 'The tools on a turning ring, echoing the hero orbit.'],
  22: ['pick a platform · example grouping', 'Filter the tools to the ones you use on each platform.'],
  23: ['real dates', 'Your roles as bars on a timeline from 2019 to now, so the overlap (Cardell Media and Dingus & Zazzy) is clear.'],
  24: ['hover a role', 'Each experience row takes a faint colour on hover, with the logo coming forward.'],
  25: ['', 'Education as a small card instead of a plain row.'],
  26: ['move over the dots', 'An About-specific ending with the homepage’s dotted “LET’S TALK.”'],
  27: ['example answers', 'Answers to what agencies ask first: white-label, NDAs, time zones and handover.'],
  28: ['example', 'One line you update now and then, so the page feels current.'],
  29: ['hover it', 'A full-width panel at the bottom leading to your work, like the new “Next project”.'],
  30: ['scroll through it', 'The background takes a faint colour for each section as you scroll, like the hero.'],
};
const tag = (n: number) => ({ name: IDEAS[n - 1][1], note: NOTES[n][0], why: NOTES[n][1] });
const toolGroups = [
  { label: 'Development', tools: ['HTML', 'CSS', 'JavaScript', 'jQuery', 'PHP', 'Liquid', 'SASS', 'MySQL'] },
  { label: 'Platforms', tools: ['Shopify', 'Shopify Plus', 'Webflow', 'WordPress', 'WooCommerce', 'BigCommerce'] },
  { label: 'Design & integrations', tools: ['Figma', 'GSAP', 'Adobe Photoshop', 'HubSpot', 'ActiveCampaign', 'Klaviyo'] },
];
const allTools = toolGroups.flatMap((g) => g.tools);
// Examples only, for ideas 19, 20 and 22: replace with your own.
const strength: Record<string, number> = { Shopify: 3, Liquid: 3, 'Shopify Plus': 3, JavaScript: 3, CSS: 3, HTML: 3, Webflow: 2, WordPress: 2, GSAP: 2, Figma: 2, PHP: 2, SASS: 2, Klaviyo: 2, WooCommerce: 1, BigCommerce: 1, jQuery: 1, MySQL: 1, 'Adobe Photoshop': 1, HubSpot: 1, ActiveCampaign: 1 };
const toolNote: Record<string, string> = { Shopify: 'Custom themes, sections and store builds', Liquid: 'Theme logic and reusable sections', Webflow: 'CMS builds and interactions', WordPress: 'Custom themes and WooCommerce', GSAP: 'Scroll and page animation', Figma: 'Handing designs over to code', Klaviyo: 'Email sign-ups wired into stores', JavaScript: 'Interactive features and integrations' };
const byPlatform: Record<string, string[]> = { Shopify: ['Shopify', 'Shopify Plus', 'Liquid', 'JavaScript', 'CSS', 'Klaviyo', 'Figma'], Webflow: ['Webflow', 'GSAP', 'JavaScript', 'CSS', 'Figma', 'HubSpot'], WordPress: ['WordPress', 'WooCommerce', 'PHP', 'MySQL', 'jQuery', 'CSS'] };
const img = (slug: string, size = '-640') => withBase(`/images/projects/${slug}${size}.webp`);
const host = (url: string) => new URL(url).hostname.replace('www.', '');
const hueOf = (p: (typeof projects)[number]) => canvasHues[p.canvas] ?? 60;
// Idea 13: everything here is counted from the site's data.
const years = new Date().getFullYear() - 2019;
const stats = [
  { n: years, suffix: '+', label: 'years building websites' },
  { n: experience.length, suffix: '', label: 'companies and agencies' },
  { n: projects.length, suffix: '', label: 'featured projects' },
  { n: allTools.length, suffix: '', label: 'tools of the trade' },
];
// Idea 23: each role's dates as months since Jan 2019.
const monthsOf = (s: string) => { const [m, y] = s.trim().split(' '); return (Number(y) - 2019) * 12 + ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].indexOf(m); };
const span = monthsOf('Dec 2026');
const bars = experience.map((e) => { const [a, b] = e.dates.split('—'); return { company: e.company, role: e.role, from: monthsOf(a), to: monthsOf(b) }; });
const roleHues = [245, 20, 295, 105];
const skills = [
  ...[...new Set(projects.map((p) => p.platform))].map((s) => ({ label: s, slugs: projects.filter((p) => p.platform === s).map((p) => p.slug) })),
  ...[...new Set(projects.map((p) => p.agency).filter(Boolean))].map((a) => ({ label: `With ${a}`, slugs: projects.filter((p) => p.agency === a).map((p) => p.slug) })),
];
const latest = projects[0];
const logos = [...experience.filter((e) => e.logo), { company: 'MDO Digital' }, { company: 'Tecniqode' }];
---
<BaseLayout title="About ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current About page', href: '/about/' }]} />
  <div class="wrap ab-page">
    <header class="ab-head">
      <span class="tiny-heading">Preview · About page</span>
      <h1 class="display">Thirty ideas<br />for About</h1>
      <p>Each demo works. Real content is used wherever the site has it; anything marked “example” needs your own words before it goes live. Pick the numbers you like.</p>
    </header>

    {IDEAS.map(([n]) => {
      const t = tag(n);
      return (
        <section class="ab" id={`idea-${n}`}>
          {GROUPS[n] && <p class="ab-group">{GROUPS[n]}</p>}
          <div class="ab-top"><span class="idea-tag"><b>{n}</b>{t.name}{t.note && <em>{t.note}</em>}</span><p class="ab-why">{t.why}</p></div>

          {n === 1 && <canvas class="ab-dots ab-title-dots" data-text="ABOUT GRANT"></canvas>}

          {n === 2 && (
            <div class="ab-photo"><span class="ab-photo-frame"><canvas></canvas><svg viewBox="0 0 200 240" aria-hidden="true"><defs><radialGradient id="ab-face" cx="50%" cy="35%" r="60%"><stop offset="0" stop-color="#d9d4cc" /><stop offset="1" stop-color="#6d665c" /></radialGradient></defs><rect width="200" height="240" fill="#efece6" /><circle cx="100" cy="92" r="46" fill="url(#ab-face)" /><path d="M20 240c6-58 40-86 80-86s74 28 80 86z" fill="url(#ab-face)" /></svg></span><p>Placeholder figure: your photo would go here.</p></div>
          )}

          {n === 3 && (
            <div class="ab-mock"><p class="ab-mock-title display">ABOUT GRANT</p><p class="ab-oneliner">Shopify, Webflow & WordPress developer in the Philippines, building websites for brands and agencies worldwide.</p></div>
          )}

          {n === 4 && <p class="ab-pill"><i></i>Taking new projects from <b>December</b> <span>· example</span></p>}

          {n === 5 && (
            <div class="ab-time">
              <div class="ab-clocks"><p><span>Grant · Manila</span><b data-clock="Asia/Manila">--:--</b></p><p><span>You · <em data-you-zone></em></span><b data-clock="">--:--</b></p><p><span>Working hours that overlap</span><b data-overlap>–</b></p></div>
              <div class="ab-day" aria-hidden="true"><span class="ab-day-grant"></span><span class="ab-day-you"></span><span class="ab-day-now"></span></div>
              <p class="ab-day-key"><i class="g"></i>Grant, 9 am – 6 pm Manila <i class="y"></i>You, 9 am – 6 pm your time</p>
            </div>
          )}

          {n === 6 && (
            <a class="ab-resume" href={withBase('/resume/grant-payad-resume.pdf')} download><span class="ab-doc"><b>{profile.name}</b><i></i><i></i><i class="s"></i><i></i><i class="s"></i><i></i></span><span><strong>Download résumé</strong><small>PDF</small></span><Arrow diagonal /></a>
          )}

          {n === 7 && (
            <div class="ab-scrollbox ab-index-demo">
              <ol class="ab-index">{['Who I am', 'How I work', 'Experience', 'Tools', 'Education'].map((s, i) => <li><a href={`#ab-s${i}`}><b>{String(i + 1).padStart(2, '0')}</b>{s}</a></li>)}</ol>
              <div class="ab-index-body">{['Who I am', 'How I work', 'Experience', 'Tools', 'Education'].map((s, i) => <section id={`ab-s${i}`} data-i={i}><h3>{s}</h3><p>Section content goes here. Scroll on and the list on the left follows where you are.</p></section>)}</div>
            </div>
          )}

          {n === 8 && <blockquote class="ab-quote display">“I care about the details you see, and the foundations you don’t.”</blockquote>}

          {n === 9 && (
            <ol class="ab-steps">{[['Brief', 'We agree what we’re building, by when, and for how much.'], ['Build', 'I build in a staging site you can check at any time.'], ['Review', 'You test it; I fix and polish until it’s right.'], ['Launch', 'We go live together, then I hand over clean, documented code.']].map(([h, p], i) => <li style={`--i:${i}`}><b>{String(i + 1).padStart(2, '0')}</b><h3>{h}</h3><p>{p}</p></li>)}</ol>
          )}

          {n === 10 && (
            <div class="ab-promises">{[['Clear updates', 'You’ll always know what’s done and what’s next.'], ['No surprises', 'Scope and cost agreed before the work starts.'], ['Clean handover', 'Code your team can keep working on.']].map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}</div>
          )}

          {n === 11 && (
            <p class="ab-fill">My experience spans <mark>ecommerce development</mark>, <mark>custom themes</mark>, <mark>platform migrations</mark>, third-party integrations, and <mark>technical SEO</mark>. Alongside hands-on development, I’ve <mark>led development teams</mark> and coordinated projects from planning through delivery.</p>
          )}

          {n === 12 && (
            <ol class="ab-dayline">{[['9:00', 'Replies and planning'], ['10:00', 'Building'], ['13:00', 'Calls with clients in Europe'], ['15:00', 'Building and testing'], ['18:00', 'Daily update sent']].map(([t, l]) => <li><b>{t}</b><span>{l}</span></li>)}</ol>
          )}

          {n === 13 && (
            <div class="ab-stats">{stats.map((s) => <p><b data-count={s.n} data-suffix={s.suffix}>0</b><span>{s.label}</span></p>)}</div>
          )}

          {n === 14 && (
            <div class="ab-skills">
              <div class="ab-chips" role="group" aria-label="Skill">{skills.map((s, i) => <button type="button" data-slugs={s.slugs.join(' ')} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label} <span>{s.slugs.length}</span></button>)}</div>
              <ul class="ab-skill-list">{projects.map((p) => <li data-slug={p.slug} hidden={!skills[0].slugs.includes(p.slug)}><a href={withBase(`/work/${p.slug}/`)}><img src={img(p.slug, '-320')} alt="" width="320" height="180" loading="lazy" /><strong>{p.name}</strong><span>{p.platform} · {p.category}</span></a></li>)}</ul>
            </div>
          )}

          {n === 15 && (
            <div class="ab-logos" aria-label="Companies Grant has worked with"><div class="ab-logos-track">{[0, 1].map(() => logos.map((l) => <span class="ab-logo"><CompanyLogo name={l.company} logo={'logo' in l ? l.logo : undefined} size={26} /></span>))}</div></div>
          )}

          {n === 16 && <div class="ab-video"><VideoReviews /></div>}

          {n === 17 && (
            <ol class="ab-sites">{projects.map((p, i) => <li><a href={p.url} target="_blank" rel="noopener noreferrer"><b>{String(i + 1).padStart(2, '0')}</b><strong>{p.name}</strong><span>{p.platform} · {p.category}</span><span class="ab-host">{host(p.url)}</span><span aria-hidden="true">↗</span></a></li>)}</ol>
          )}

          {n === 18 && (
            <a class="ab-latest" href={withBase(`/work/${latest.slug}/`)} style={`--h:${hueOf(latest)}`}><img src={img(latest.slug, '-480')} alt="" width="480" height="270" /><span><small><i></i>Recently shipped</small><strong>{latest.name}</strong><em>{latest.description}</em></span><Arrow diagonal /></a>
          )}

          {n === 19 && <ul class="ab-strength">{[...allTools].sort((a, b) => (strength[b] ?? 1) - (strength[a] ?? 1)).map((tool) => <li data-s={strength[tool] ?? 1}>{tool}</li>)}</ul>}

          {n === 20 && <ul class="ab-notes">{allTools.map((tool) => <li tabindex="0">{tool}<span role="tooltip">{toolNote[tool] ?? 'Used on client projects'}</span></li>)}</ul>}

          {n === 21 && <div class="ab-ring" aria-label="Tools"><div class="ab-ring-spin">{allTools.map((tool, i) => <span style={`--i:${i};--n:${allTools.length}`}>{tool}</span>)}</div></div>}

          {n === 22 && (
            <div class="ab-plat">
              <div class="ab-chips" role="group" aria-label="Platform">{Object.keys(byPlatform).map((k, i) => <button type="button" data-tools={byPlatform[k].join('|')} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>)}</div>
              <ul class="ab-plat-tools">{allTools.map((tool) => <li data-tool={tool} class:list={{ 'is-on': byPlatform.Shopify.includes(tool) }}>{tool}</li>)}</ul>
            </div>
          )}

          {n === 23 && (
            <div class="ab-timeline">
              <div class="ab-years">{Array.from({ length: 8 }, (_, i) => <span style={`left:${((i * 12) / span) * 100}%`}>{2019 + i}</span>)}</div>
              {bars.map((b, i) => <div class="ab-bar-row"><span class="ab-bar" style={`left:${(b.from / span) * 100}%;width:${((b.to - b.from) / span) * 100}%;--h:${roleHues[i]}`}><b>{b.company}</b></span></div>)}
            </div>
          )}

          {n === 24 && (
            <div class="ab-roles">{experience.map((e, i) => <article style={`--h:${roleHues[i]}`}><span class="ab-role-logo"><CompanyLogo name={e.company} logo={e.logo} size={22} /></span><div><h3>{e.role}</h3><p>{e.dates}</p></div></article>)}</div>
          )}

          {n === 25 && (
            <div class="ab-edu"><span class="ab-edu-year display">2019</span><div><span class="tiny-heading">Education</span><h3>BS Information Technology</h3><p>Major in Web Development · Bulacan State University</p></div></div>
          )}

          {n === 26 && (
            <div class="ab-fit">
              <div><h3 class="display">Sound like<br />a fit?</h3><p>Tell me about your project, or get a realistic timeline in two minutes.</p><div class="ab-fit-actions"><a class="cta-primary" href={withBase('/contact/')}>Tell me about it <Arrow diagonal /></a><a class="cta-ghost" href={withBase('/estimate/')}>Get an estimate</a></div></div>
              <canvas class="ab-dots ab-fit-dots" data-lines="LET’S|TALK."></canvas>
            </div>
          )}

          {n === 27 && (
            <div class="ab-faq">{[['Do you work white-label for agencies?', 'Yes. I can work under your agency’s name and talk to your clients as part of your team.'], ['Will you sign an NDA?', 'Happy to, before we share anything confidential.'], ['How do time zones work?', 'I overlap with UK mornings and Australian afternoons, and send an update at the end of each day.'], ['What happens after launch?', 'You get clean code, a short handover, and help with fixes or new features whenever you need it.']].map(([q, a]) => <details><summary>{q}<i aria-hidden="true"></i></summary><p>{a}</p></details>)}</div>
          )}

          {n === 28 && <p class="ab-learning"><span>Currently learning</span><strong>Shopify Hydrogen and headless storefronts</strong><em>example · updated Nov 2026</em></p>}

          {n === 29 && (
            <a class="next-project" href={withBase('/#work')} style={`--next-hue:${hueOf(latest)}`}><span class="next-project-label">Next</span><strong class="display">Selected work</strong><span class="next-project-meta">{projects.length} projects · Shopify, Webflow & WordPress</span><span class="next-project-arrow"><Arrow diagonal /></span><img src={img(latest.slug, '-960')} alt="" width="960" height="540" loading="lazy" /></a>
          )}

          {n === 30 && (
            <div class="ab-wash">{[['Who I am', 245], ['How I work', 20], ['Experience', 105]].map(([h, hue]) => <div class="ab-wash-panel" data-h={hue}><h3 class="display">{h}</h3><p>The page background eases into a faint shade for each section as it reaches the middle of the screen.</p></div>)}</div>
          )}
        </section>
      );
    })}
  </div>
</BaseLayout>

<script>
  import { Dots } from './_dots';
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  // 1, 26: dot text.
  document.querySelectorAll<HTMLCanvasElement>('canvas.ab-dots').forEach((c) => new Dots(c, c.dataset.text ?? '', { lines: c.dataset.lines?.split('|'), color: c.classList.contains('ab-fit-dots') ? '#f2f0ea' : undefined, accent: 'oklch(0.8 0.12 245)' }));

  // 2: the placeholder figure as a dot halftone, sharpening on hover.
  const frame = document.querySelector<HTMLElement>('.ab-photo-frame');
  if (frame) {
    const svg = frame.querySelector('svg')!, cv = frame.querySelector('canvas')!;
    const im = new Image();
    im.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(new XMLSerializer().serializeToString(svg));
    im.decode().then(() => {
      const r = cv.getBoundingClientRect(), W = Math.floor(r.width), H = Math.floor(r.height), dpr = Math.min(2, devicePixelRatio || 1), g = 7;
      cv.width = W * dpr; cv.height = H * dpr;
      const c = cv.getContext('2d')!; c.setTransform(dpr, 0, 0, dpr, 0, 0);
      const cols = Math.ceil(W / g), rows = Math.ceil(H / g), s = document.createElement('canvas'); s.width = cols; s.height = rows;
      const sc = s.getContext('2d', { willReadFrequently: true })!; sc.drawImage(im, 0, 0, cols, rows);
      const px = sc.getImageData(0, 0, cols, rows).data, p = new Path2D();
      for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) { const k = (y * cols + x) * 4, lum = (px[k] + px[k + 1] + px[k + 2]) / 765, rad = (1 - lum) * g * 0.6; if (rad > 0.4) { p.moveTo(x * g + g / 2 + rad, y * g + g / 2); p.arc(x * g + g / 2, y * g + g / 2, rad, 0, 6.2832); } }
      c.fillStyle = '#161616'; c.fill(p);
    });
  }

  // 5: Manila time, the visitor's time, and the overlap of 9–6 working days.
  const timeBox = document.querySelector<HTMLElement>('.ab-time');
  if (timeBox) {
    const you = Intl.DateTimeFormat().resolvedOptions().timeZone;
    timeBox.querySelector('[data-you-zone]')!.textContent = you.split('/').pop()!.replace(/_/g, ' ');
    // Minutes the visitor's zone is ahead of Manila.
    const offset = (zone: string) => { const d = new Date(); const t = new Date(d.toLocaleString('en-US', { timeZone: zone })); return t.getTime(); };
    const diff = Math.round((offset(you) - offset('Asia/Manila')) / 60000);
    // Grant 9–18 Manila; the visitor's 9–18, in Manila minutes.
    const a = [540, 1080], b = [540 - diff, 1080 - diff];
    let overlap = 0;
    for (const shift of [-1440, 0, 1440]) overlap += Math.max(0, Math.min(a[1], b[1] + shift) - Math.max(a[0], b[0] + shift));
    const hrs = overlap / 60;
    timeBox.querySelector('[data-overlap]')!.textContent = hrs >= 9 ? 'All day' : hrs ? `${+hrs.toFixed(1)} hours` : 'None: replies the next morning';
    const pct = (m: number) => `${(((m % 1440) + 1440) % 1440) / 14.4}%`;
    const g = timeBox.querySelector<HTMLElement>('.ab-day-grant')!, y = timeBox.querySelector<HTMLElement>('.ab-day-you')!, now = timeBox.querySelector<HTMLElement>('.ab-day-now')!;
    g.style.left = pct(a[0]); g.style.width = `${(540 / 1440) * 100}%`;
    y.style.left = pct(b[0]); y.style.width = `${(540 / 1440) * 100}%`;
    const tick = () => {
      timeBox.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => { el.textContent = new Date().toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: el.dataset.clock || undefined }); });
      const m = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }));
      now.style.left = pct(m.getHours() * 60 + m.getMinutes());
    };
    tick(); setInterval(tick, 15000);
  }

  // 7: the side list follows the section in view inside the box.
  const idx = document.querySelector<HTMLElement>('.ab-index-demo');
  if (idx) {
    const links = [...idx.querySelectorAll<HTMLElement>('.ab-index a')];
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((l, i) => l.classList.toggle('is-on', i === Number((e.target as HTMLElement).dataset.i))); }), { root: idx, rootMargin: '-40% 0px -55% 0px' });
    idx.querySelectorAll('.ab-index-body section').forEach((s) => io.observe(s));
    links[0].classList.add('is-on');
    links.forEach((l) => l.addEventListener('click', (e) => { e.preventDefault(); idx.querySelector(l.getAttribute('href')!)!.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  }

