---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { seoDetailIdeas } from '../../data/seo-detail-ideas';
import { services } from '../../data/services';
import { auditCardMarkup, auditScopeMarkup } from '../../scripts/service-card-media';
import { withBase } from '../../utils/paths';
import '../../styles/service-card-media.css';
import '../../styles/seo-details-preview.css';
export function getStaticPaths() { return import.meta.env.DEV ? [{params:{preview:'ideas'}}] : []; }
const service=services[4];
const image=(name:string)=>withBase(`/images/projects/tero-${name}.webp`);
const kb=(name:string)=>(fs.statSync(`public/images/projects/tero-${name}.webp`).size/1024).toFixed(1);
const luminance=(hex:string)=>[1,3,5].map((n)=>parseInt(hex.slice(n,n+2),16)/255).map(v=>v<=.04045?v/12.92:((v+.055)/1.055)**2.4).reduce((sum,v,i)=>sum+v*[.2126,.7152,.0722][i],0);
const contrast=(hex:string)=>((1.05)/(luminance(hex)+.05)).toFixed(2);
const prioritySets=[
  {name:'Speed',items:['Right-size heavy images.','Review apps and extra scripts.','Check what delays the first screen.']},
  {name:'Ease of use',items:['Make text easier to read.','Check buttons on a phone.','Review forms and keyboard access.']},
  {name:'Search',items:['Clarify page titles and descriptions.','Review headings and useful content.','Check links and indexing settings.']},
];
const process=[['Review','Understand the existing website and its important customer journeys.'],['Prioritise','Agree on the issues worth addressing first.'],['Improve','Prepare the agreed changes for review.'],['Check','Test the updated pages and confirm the next steps.']];
---
<BaseLayout title="20 SEO Card Additions | Grant Dev14" description="Local interactive preview of twenty additions to the website performance and SEO card." noindex>
  <div class="wrap sd-root">
    <header class="sd-intro"><a class="text-link" href={withBase('/#services')}>Current homepage card <Arrow diagonal /></a><div><h1 class="display">More than a score.</h1><p>Twenty additions for the right side of the SEO card. Compare one at a time, then choose what earns its place.</p></div><p class="sd-disclaimer">Local design preview. Scores, reports, timings and page-weight figures are illustrative. Image file sizes and contrast ratios are calculated from the displayed examples.</p></header>
    <div class="sd-controls"><label for="sd-select">Choose an addition<select id="sd-select">{seoDetailIdeas.map((idea,i)=><option value={i}>{String(i+1).padStart(2,'0')} — {idea.name}</option>)}</select></label><div class="sd-pager"><button type="button" id="sd-prev" aria-label="Previous addition"><span><Arrow /></span></button><span id="sd-count" aria-hidden="true">01 / 20</span><button type="button" id="sd-next" aria-label="Next addition"><Arrow /></button></div><button type="button" id="sd-replay">Replay</button><button type="button" id="sd-all" aria-pressed="false">Show all additions</button><label class="sd-check"><input type="checkbox" id="sd-hide-scores" />Hide scores while comparing</label><label class="sd-check"><input type="checkbox" id="sd-still" />Still previews</label></div>
    <div class="sd-layout">
      <details class="sd-directory" open><summary>Browse all 20 additions</summary><nav aria-label="SEO card additions"><ol>{seoDetailIdeas.map((idea,i)=><li><a href={`#seo-addition-${i+1}`} data-sd-select={i}><span>{String(i+1).padStart(2,'0')}</span><span>{idea.name}{'recommended' in idea && idea.recommended && <small>Recommended</small>}</span></a></li>)}</ol></nav></details>
      <div class="sd-stage">
        <article class="sd-service cc-card">
          <span class="sd-word" aria-hidden="true" data-word="PERFORMANCE">PERFORMANCE</span>
          <div class="sd-copy"><h2>{service.name}</h2><p>{service.text}</p><small>{service.tags}</small><p class="sd-audit-prompt">Not sure what’s holding your website back?</p><a class="sd-button sd-audit-cta" href={service.href}>Get my free website audit <Arrow diagonal /></a><p class="sd-audit-reassurance">Grant reviews your website and emails you the findings. <strong>Free, no obligation.</strong></p><p class="sd-context">“What’s included” is now on the homepage. The other additions remain here to compare.</p></div>
          <div class="sd-report"><div class="sd-base" set:html={auditCardMarkup(false)}/><div class="sd-addons" id="sd-addons">
            {seoDetailIdeas.map((idea,i)=><section class="sd-addon" id={`seo-addition-${i+1}`} data-sd-addon={i} aria-labelledby={`sd-title-${i}`} hidden={i!==0}>
              <header class="sd-addon-heading"><span>{String(i+1).padStart(2,'0')} / Addition</span><h3 id={`sd-title-${i}`}>{idea.name}</h3></header>
              <div class:list={['sd-example',`sd-example-${i+1}`]}>
                {i===0 && <div class="sd-verdict"><span class="sd-status-dot" aria-hidden="true"></span><div><strong data-sd-verdict-title>A clearer, quicker experience.</strong><p data-sd-verdict-copy>The example checks are complete. Review the improvements, then agree on what comes next.</p></div></div>}
                {i===1 && <div><div class="sd-options" role="group" aria-label="Priority area">{prioritySets.map((group,j)=><button type="button" data-sd-group="priorities" data-sd-value={j} aria-pressed={j===0}>{group.name}</button>)}</div>{prioritySets.map((group,j)=><ol class="sd-priorities" data-sd-panel="priorities" data-sd-value={j} hidden={j!==0}>{group.items.map((text,k)=><li><span>{k+1}</span>{text}</li>)}</ol>)}</div>}
                {i===2 && <div set:html={auditScopeMarkup()} />}
                {i===3 && <div><p class="sd-small-label">Illustrative fixes</p><ul class="sd-fix-list">{['Right-size the main images','Review unnecessary scripts','Improve labels and contrast','Tidy page titles and links'].map((text,j)=><li data-sd-fix={j}><span class="sd-fix-mark" aria-hidden="true"></span>{text}</li>)}</ul><p class="sd-micro" data-sd-fix-count>4 of 4 example fixes shown</p><button type="button" class="sd-text-button" data-sd-action="replay">Replay the example <Arrow /></button></div>}
                {i===4 && <div><div class="sd-options" role="group" aria-label="Who benefits">{['Visitors','Your team','Your business'].map((name,j)=><button type="button" data-sd-group="benefits" data-sd-value={j} aria-pressed={j===0}>{name}</button>)}</div>{[['Less waiting. Less friction.','People can find useful content, read it and take the next step more comfortably.'],['A clearer set of priorities.','Your team can understand the issues and discuss the work in plain language.'],['A website that supports the work.','Make the important journeys clearer, from finding a product to sending an enquiry.']].map(([title,copy],j)=><div class="sd-benefit" data-sd-panel="benefits" data-sd-value={j} hidden={j!==0}><h4>{title}</h4><p>{copy}</p></div>)}</div>}
                {i===5 && <figure><div class="sd-options" role="group" aria-label="Preview device"><button type="button" data-sd-group="device" data-sd-value="desktop" aria-pressed="true">Desktop</button><button type="button" data-sd-group="device" data-sd-value="phone" aria-pressed="false">Phone</button></div><div class="sd-device" data-sd-device="desktop"><img data-sd-device-image src={image('960')} data-desktop={image('960')} data-phone={image('mobile-720')} alt="Tero website preview on desktop" width="960" height="600" loading="lazy" decoding="async"/></div><figcaption>Tero · Company project · MDO Digital</figcaption></figure>}
                {i===6 && <div class="sd-timelines"><p class="sd-small-label">Illustrative load times</p>{[['Before','6.8 s',85],['After','1.9 s',24]].map(([name,time,width])=><div class="sd-time-row"><span>{name}</span><div><i style={`--length:${width}%`}></i></div><strong>{time}</strong></div>)}<div class="sd-time-axis"><span>0 s</span><span>8 s</span></div><button type="button" class="sd-text-button" data-sd-action="replay">Replay the timeline <Arrow /></button></div>}
                {i===7 && <div><p class="sd-small-label">Example page weight</p><div class="sd-weight-bar" aria-label="Example distribution: images 55%, apps 30%, fonts 15%"><span>55%</span><span>30%</span><span>15%</span></div><div class="sd-options" role="group" aria-label="Page weight source">{['Images','Apps','Fonts'].map((name,j)=><button type="button" data-sd-group="weight" data-sd-value={j} aria-pressed={j===0}>{name}</button>)}</div>{['Images can often be resized for the space they actually occupy.','Review which app scripts are needed on each page.','Review font files, styles and the text they serve.'].map((copy,j)=><p data-sd-panel="weight" data-sd-value={j} hidden={j!==0}>{copy}</p>)}</div>}
                {i===8 && <figure><div class="sd-image-compare" style="--image-split:.5"><img src={image('480')} alt="Tero preview sized to 480 pixels wide" width="480" height="300" loading="lazy" decoding="async"/><img class="sd-larger-image" src={image('1920')} alt="The same Tero preview at 1920 pixels wide" width="1920" height="1200" loading="lazy" decoding="async"/><span aria-hidden="true"></span></div><label class="sd-range-label">Compare the image sizes<input type="range" min="0" max="100" value="50" data-sd-image-range /></label><div class="sd-file-sizes"><span><strong>Larger preview</strong>1920 px · {kb('1920')} KB</span><span><strong>Right-sized preview</strong>480 px · {kb('480')} KB</span></div><figcaption>Actual files used in this demonstration. Tero · Company project · MDO Digital.</figcaption></figure>}
                {i===9 && <div class="sd-script-review"><p class="sd-small-label">Example items to review</p>{[['Duplicate app script','Confirm whether another app already does this job.'],['Unused widget','Check whether it is still useful on this page.'],['Essential checkout code','Keep required customer journeys working.']].map(([name,copy],j)=><label><input type="checkbox" data-sd-script={j}/><span><strong>{name}</strong><small>{copy}</small></span></label>)}<p class="sd-micro" data-sd-script-count role="status">Select items for review. No code is removed.</p></div>}
                {i===10 && <div class="sd-search-demo"><label>Sample page title<input data-sd-snippet-title value="Lighting Kits for Model Builders | Your Store" maxlength="90"/></label><label>Sample description<textarea data-sd-snippet-description rows="2" maxlength="220">Explore lighting kits for your favourite builds, with clear guides and helpful product details.</textarea></label><div class="sd-search-result"><span>yourstore.example / lighting-kits</span><h4 data-sd-search-title>Lighting Kits for Model Builders | Your Store</h4><p data-sd-search-description>Explore lighting kits for your favourite builds, with clear guides and helpful product details.</p></div><p class="sd-micro">Local example only. Search engines may display different wording; no ranking is promised.</p></div>}
                {i===11 && <div><label class="sd-field-label">Example broken link<select id="sd-broken-select"><option value="collection">An old collection</option><option value="product">A moved product</option><option value="contact">A missing enquiry page</option></select></label><div class="sd-link-route"><span data-sd-old-link>/old-collection</span><Arrow /><strong data-sd-link-result>Page not found</strong></div><button type="button" class="sd-outline-button" data-sd-action="repair">Preview a working link</button><p class="sd-micro" data-sd-repair-status role="status">Illustrative link. Your website is unchanged.</p></div>}
                {i===12 && <div><div class="sd-options" role="group" aria-label="Page outline"><button type="button" data-sd-group="outline" data-sd-value="before" aria-pressed="true">Confusing outline</button><button type="button" data-sd-group="outline" data-sd-value="after" aria-pressed="false">Clearer outline</button></div><ol class="sd-outline" data-sd-panel="outline" data-sd-value="before"><li><span>H3</span>Welcome</li><li><span>H1</span>Our services</li><li><span>H1</span>Get in touch</li></ol><ol class="sd-outline" data-sd-panel="outline" data-sd-value="after" hidden><li><span>H1</span>Website development</li><li class="sd-indent"><span>H2</span>Our services</li><li class="sd-indent-more"><span>H3</span>Shopify development</li><li class="sd-indent"><span>H2</span>Get in touch</li></ol></div>}
                {i===13 && <div><div class="sd-options" role="group" aria-label="Text contrast"><button type="button" data-sd-group="contrast" data-sd-value="before" aria-pressed="true">Faint text</button><button type="button" data-sd-group="contrast" data-sd-value="after" aria-pressed="false">Stronger text</button></div>{[['before','#999999'],['after','#161616']].map(([name,color])=><div data-sd-panel="contrast" data-sd-value={name} hidden={name!=='before'}><div class="sd-contrast-text" style={`color:${color}`}>Details worth reading.</div><p class="sd-micro">These example colours have a calculated contrast ratio of <strong>{contrast(color)}:1</strong> against white.</p></div>)}</div>}
                {i===14 && <div><p>Use Tab to visit each button. The focus outline shows where you are.</p><div class="sd-keyboard-demo" role="group" aria-label="Keyboard demonstration">{['Browse','Details','Enquire'].map(name=><button type="button" data-sd-key={name}>{name}</button>)}</div><p class="sd-keyboard-status" data-sd-key-status role="status">Try the buttons with a keyboard.</p><p class="sd-micro">Demonstration controls only. They do not submit an enquiry.</p></div>}
                {i===15 && <div><div class="sd-tap-comparison"><div><span>Cramped appearance</span><span class="sd-tap-small" aria-hidden="true">Menu</span><small>Illustration only</small></div><div><span>Comfortable target</span><button type="button" class="sd-outline-button" data-sd-action="tap">Try this button <Arrow /></button><small>At least 44 px high</small></div></div><p class="sd-micro" data-sd-tap-status role="status">The larger example is a real button you can try.</p></div>}
                {i===16 && <div><div class="sd-process-tabs" role="group" aria-label="Improvement process">{process.map(([name],j)=><button type="button" data-sd-group="process" data-sd-value={j} aria-pressed={j===0}><small>{j+1}</small>{name}</button>)}</div>{process.map(([name,copy],j)=><div class="sd-process-copy" data-sd-panel="process" data-sd-value={j} hidden={j!==0}><h4>{name}</h4><p>{copy}</p></div>)}</div>}
                {i===17 && <div class="sd-disclosures">{[['Overview','The sample report separates loading experience, ease of use and search foundations.'],['Priorities','Start with the agreed work that best supports the important customer journeys.'],['What we would check next','Review the updated pages, record what changed and discuss the remaining work.']].map(([name,copy])=><details><summary>{name}<span aria-hidden="true">+</span></summary><p>{copy}</p></details>)}<p class="sd-micro">Sample report structure, not an actual audit.</p></div>}
                {i===18 && <div><div class="sd-options" role="group" aria-label="Website platform">{['Shopify','Webflow','WordPress'].map((name,j)=><button type="button" data-sd-group="platform" data-sd-value={j} aria-pressed={j===0}>{name}</button>)}</div>{[['Shopify',['Review the theme and installed apps.','Check product images and key shopping journeys.','Review page titles, links and content structure.']],['Webflow',['Review large images, embeds and interactions.','Check layouts and forms across screen sizes.','Review page titles and CMS content structure.']],['WordPress',['Review the theme and active plugins.','Check image sizes and important forms.','Review page titles, links and content structure.']]].map(([name,items],j)=><div data-sd-panel="platform" data-sd-value={j} hidden={j!==0}><h4>{name}</h4><ul class="sd-bullets">{(items as string[]).map(text=><li>{text}</li>)}</ul></div>)}</div>}
                {i===19 && <div class="sd-next-step"><h4>What could work better?</h4><p>Share your website and the part you would like to improve.</p><ul class="sd-bullets"><li>Your website address</li><li>What feels slow or difficult</li><li>The pages that matter most</li></ul><a class="sd-button" href={withBase('/contact/#audit')}>Get a free website audit <Arrow diagonal /></a><p class="sd-micro">Opens the existing contact page. Nothing is sent from this preview.</p></div>}
              </div>
              <footer class="sd-idea-note"><p><strong>Why add it</strong>{idea.why}</p><p><strong>Try it</strong>{idea.hint}</p></footer>
            </section>)}
          </div></div>
        </article>
      </div>
    </div>
    <p class="sr-only" id="sd-announcement" role="status" aria-live="polite"></p>
  </div>
  <noscript><style is:inline>.sd-addon[hidden] { display:block!important; }</style></noscript>
</BaseLayout>
<script>
  import { mountSeoDetailsPreview } from '../../scripts/seo-details-preview';
  const root=document.querySelector<HTMLElement>('.sd-root');if(root)mountSeoDetailsPreview(root);
</script>
