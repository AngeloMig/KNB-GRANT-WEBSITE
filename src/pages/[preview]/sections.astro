    {/* 17 ─ Field notes */}
    <section class="sx" id="idea-17">
      <div class="sx-top"><span class="idea-tag"><b>17</b>{IDEAS[16][1]}<em>{NOTES[17][0]}</em></span><p class="sx-why">{NOTES[17][1]} <i>Fits: {NOTES[17][2]}</i></p></div>
      <div class="sx-stage sx-notes">{notes.map(([t, tag, tone], i) => <a href="#idea-17" class={`sx-notecard t-${tone}`} style={`--r:${[-2.2, 1.4, -0.8][i]}deg`}><span class="sx-tape" aria-hidden="true"></span><small>{tag} · Suggested topic</small><h3>{t}</h3><span class="sx-lines" aria-hidden="true"></span><em>Read the note →</em></a>)}</div>
    </section>

    {/* 18 ─ Globe */}
    <section class="sx" id="idea-18">
      <div class="sx-top"><span class="idea-tag"><b>18</b>{IDEAS[17][1]}<em>{NOTES[18][0]}</em></span><p class="sx-why">{NOTES[18][1]} Only Australia and the UK can be read from the projects’ web addresses; you’d add the rest. <i>Fits: {NOTES[18][2]}</i></p></div>
      <div class="sx-stage sx-globe-stage" data-globe>
        <canvas class="sx-globe" width="560" height="560" aria-hidden="true"></canvas>
        <div class="sx-globe-copy"><p class="sx-kicker">Based in Manila, working worldwide</p><ul class="sx-places"><li><i class="home"></i><b>Manila</b><span>Home base</span></li>{clientCountries.map(([c, names]) => <li><i></i><b>{c}</b><span>{names.join(', ')}</span></li>)}<li class="todo"><i></i><b>More to add</b><span>e.g. Road Armor, Skinistry: you’d confirm where</span></li></ul></div>
      </div>
    </section>

    {/* 19 ─ Support month */}
    <section class="sx" id="idea-19">
      <div class="sx-top"><span class="idea-tag"><b>19</b>{IDEAS[18][1]}<em>{NOTES[19][0]}</em></span><p class="sx-why">{NOTES[19][1]} <i>Fits: {NOTES[19][2]}</i></p></div>
      <div class="sx-stage sx-board" data-board>
        <div class="sx-board-head"><p class="sx-kicker">A month on the Basic plan <span class="sx-example">Example</span></p><div class="sx-usage"><span><b class="sx-used">0</b> of {plans[0].hours} hours used</span><div class="sx-usage-bar"><i></i></div></div></div>
        <div class="sx-cols">{['Asked', 'Doing', 'Done'].map((c) => <div class="sx-col" data-col={c}><h4>{c}</h4><div class="sx-col-body"></div></div>)}</div>
      </div>
    </section>

    {/* 20 ─ Mad libs */}
    <section class="sx" id="idea-20">
      <div class="sx-top"><span class="idea-tag"><b>20</b>{IDEAS[19][1]}<em>{NOTES[20][0]}</em></span><p class="sx-why">{NOTES[20][1]} <i>Fits: {NOTES[20][2]}</i></p></div>
      <div class="sx-stage sx-libs" data-libs>
        <p class="sx-kicker">Tell me in one sentence</p>
        <p class="sx-sentence">Hi Grant, I need
          <label class="sx-blank"><select data-k="what"><option>a new online store</option><option>a redesign of my site</option><option>a move to a new platform</option><option>a faster, better-ranked site</option><option>ongoing help each month</option></select></label>
          on
          <label class="sx-blank"><select data-k="on"><option>Shopify</option><option>Webflow</option><option>WordPress</option><option>whatever suits best</option></select></label>
          for my
          <label class="sx-blank"><select data-k="for"><option>skincare brand</option><option>fashion label</option><option>car parts shop</option><option>agency</option><option>local business</option><option>startup</option></select></label>,
          ideally live
          <label class="sx-blank"><select data-k="when"><option>in the next month</option><option>within three months</option><option>this year</option><option>whenever it’s right</option></select></label>,
          with a budget of about
          <label class="sx-blank"><select data-k="budget"><option>under $2,000</option><option>$2,000–5,000</option><option>$5,000–10,000</option><option>$10,000 or more</option><option>not sure yet</option></select></label>.
        </p>
        <div class="sx-libs-foot"><a class="sx-btn" href={withBase('/contact/')} data-libs-send>Send this to Grant</a><button type="button" class="sx-btn ghost" data-libs-copy>Copy sentence</button><span class="sx-libs-note" aria-live="polite"></span></div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type Role = { company: string; role: string; from: number; to: number; dates: string; lane: number };
  type Data = { roles: Role[]; minM: number; maxM: number; plans: { id: string; name: string; hours: number; price: number; reply: string; daily: number }[]; payg: number; wall: { slug: string; name: string; platform: string; src: string; href: string }[]; industries: { name: string; list: { slug: string; name: string; platform: string; src: string; href: string }[] }[]; base: string };
  const D: Data = JSON.parse(document.getElementById('sx-data')!.textContent!);
  const root = document.documentElement;
  const motion = () => root.classList.contains('motion') && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const onView = (el: Element, fn: () => void, threshold = 0.35) => { const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); fn(); } }, { threshold }); io.observe(el); };
  const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // 1 ─ Project line
  document.querySelectorAll<HTMLElement>('[data-metro]').forEach((box) => {
    const btns = [...box.querySelectorAll<HTMLButtonElement>('button[data-i]')];
    const panels = [...box.querySelectorAll<HTMLElement>('[data-panel]')];
    let auto = 0;
    const go = (i: number) => { box.style.setProperty('--p', String(i / (btns.length - 1))); btns.forEach((b, j) => { b.setAttribute('aria-pressed', String(j === i)); b.classList.toggle('is-past', j < i); }); panels.forEach((p, j) => (p.hidden = j !== i)); };
    btns.forEach((b, i) => b.addEventListener('click', () => { clearInterval(auto); go(i); }));
    go(0);
    onView(box, () => { if (!motion()) return; let i = 0; auto = window.setInterval(() => { i = (i + 1) % btns.length; go(i); }, 2600); });
  });

  // 2 ─ Platform matchmaker
  document.querySelectorAll<HTMLElement>('[data-match]').forEach((box) => {
    const W: Record<string, Record<string, number>> = { sell: { shopify: 3, wordpress: 1 }, subs: { shopify: 3, wordpress: 1 }, edit: { webflow: 3, shopify: 1 }, blog: { wordpress: 3, webflow: 2 }, motion: { webflow: 3 }, plugins: { wordpress: 3 } };
    const cards = [...box.querySelectorAll<HTMLElement>('.sx-pcard')];
    const update = () => {
      const on = [...box.querySelectorAll<HTMLElement>('.sx-toggle[aria-pressed="true"]')].map((b) => b.dataset.k!);
      const score: Record<string, number> = { shopify: 0, webflow: 0, wordpress: 0 };
      on.forEach((k) => Object.entries(W[k]).forEach(([p, v]) => (score[p] += v)));
      const max = Math.max(...Object.values(score));
      const total = on.reduce((s, k) => s + Math.max(...Object.values(W[k])), 0) || 1;
      cards.forEach((c) => { const s = score[c.dataset.p!]; c.style.setProperty('--m', String(on.length ? s / total : 0)); c.classList.toggle('is-best', on.length > 0 && s === max && s > 0); c.querySelector('.sx-score')!.textContent = on.length ? `${Math.round((s / total) * 100)}% match` : 'Tick a few to see'; });
    };
    box.querySelectorAll<HTMLButtonElement>('.sx-toggle').forEach((b) => b.addEventListener('click', () => { b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); update(); }));
    update();
  });

  // 3 ─ Time zones
  document.querySelectorAll<HTMLElement>('[data-tz]').forEach((box) => {
    const svg = box.querySelector('svg')!;
    const ticks = svg.querySelector('.sx-dial-ticks')!;
    for (let h = 0; h < 24; h++) {
      const a = (h / 24) * Math.PI * 2 - Math.PI / 2, r1 = h % 6 ? 138 : 130, r2 = 146;
      ticks.insertAdjacentHTML('beforeend', `<line x1="${160 + Math.cos(a) * r1}" y1="${160 + Math.sin(a) * r1}" x2="${160 + Math.cos(a) * r2}" y2="${160 + Math.sin(a) * r2}" />`);
      if (h % 6 === 0) ticks.insertAdjacentHTML('beforeend', `<text x="${160 + Math.cos(a) * 114}" y="${164 + Math.sin(a) * 114}">${h === 0 ? '12am' : h === 12 ? '12pm' : h < 12 ? h + 'am' : h - 12 + 'pm'}</text>`);
    }
    const offset = (zone: string, d = new Date()) => { const s = d.toLocaleString('en-US', { timeZone: zone || undefined, hour12: false, hour: '2-digit', minute: '2-digit' }); const [h, m] = s.split(':').map(Number); return (h % 24) + m / 60; };
    const arc = (r: number, h1: number, h2: number) => { const span = ((h2 - h1) % 24 + 24) % 24; if (span <= 0) return ''; const a1 = (h1 / 24) * Math.PI * 2 - Math.PI / 2, a2 = a1 + (span / 24) * Math.PI * 2; return `M${160 + Math.cos(a1) * r} ${160 + Math.sin(a1) * r}A${r} ${r} 0 ${span > 12 ? 1 : 0} 1 ${160 + Math.cos(a2) * r} ${160 + Math.sin(a2) * r}`; };
    const fmt = (h: number) => { const hh = Math.floor(((h % 24) + 24) % 24), mm = Math.round((h - Math.floor(h)) * 60); const d = new Date(2000, 0, 1, hh, mm); return d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).toLowerCase(); };
    let zone = '';
    const draw = () => {
      const now = offset(zone), manila = offset('Asia/Manila');
      const shift = now - manila; // Manila hour + shift = local hour
      const meStart = 9 + shift, meEnd = 18 + shift;
      svg.querySelector('.sx-arc-you')!.setAttribute('d', arc(100, 9, 18));
      svg.querySelector('.sx-arc-me')!.setAttribute('d', arc(122, meStart, meEnd));
      // overlap of [9,18] with [meStart, meEnd] on a 24h circle
      let best = 0, bStart = 0;
      for (let k = -1; k <= 1; k++) { const s = Math.max(9, meStart + 24 * k), e = Math.min(18, meEnd + 24 * k); if (e - s > best) { best = e - s; bStart = s; } }
      svg.querySelector('.sx-arc-both')!.setAttribute('d', best > 0 ? arc(111, bStart, bStart + best) : '');
      const a = (now / 24) * 360;
      svg.querySelector('.sx-hand')!.setAttribute('transform', `rotate(${a} 160 160)`);
      const who = zone ? box.querySelector(`[data-zone="${zone}"]`)!.textContent : 'you';
      box.querySelector('.sx-tz-line')!.textContent = `It’s ${fmt(now)} for ${who === 'you' ? 'you' : 'in ' + who} and ${fmt(manila)} in Manila.`;
      box.querySelector('.sx-tz-sub')!.textContent = best > 0 ? `Your working days overlap for about ${Math.round(best)} ${Math.round(best) === 1 ? 'hour' : 'hours'}: ${fmt(bStart)} to ${fmt(bStart + best)} ${who === 'you' ? 'your time' : 'there'}.` : `No overlap, which works in your favour: Grant works while you sleep, so you wake up to progress. His day starts at ${fmt(meStart)} ${who === 'you' ? 'your time' : 'there'}.`;
    };
    box.querySelectorAll<HTMLButtonElement>('[data-zone]').forEach((b) => b.addEventListener('click', () => { zone = b.dataset.zone!; box.querySelectorAll('[data-zone]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
    draw(); setInterval(draw, 30000);
  });

  // 4 ─ Periodic table
  document.querySelectorAll<HTMLElement>('[data-table]').forEach((box) => {
    const big = box.querySelector<HTMLElement>('.sx-el-big')!, h = box.querySelector('aside h3')!, p = box.querySelector('aside p')!;
    const show = (el: HTMLElement) => { big.className = `sx-el-big k-${el.dataset.kind}`; big.innerHTML = `<small>${el.dataset.n}</small><b>${el.dataset.sym}</b>`; h.textContent = el.dataset.name!; p.textContent = `Used at ${el.dataset.at!.split(' · ').join(', ')}`; box.querySelectorAll('.sx-el').forEach((x) => x.classList.toggle('is-on', x === el)); };
    box.querySelectorAll<HTMLElement>('.sx-el').forEach((el) => { el.addEventListener('pointerenter', () => show(el)); el.addEventListener('focus', () => show(el)); el.addEventListener('click', () => show(el)); });
    show(box.querySelector('.sx-el')!);
  });

  // 5 ─ Career scrubber
  document.querySelectorAll<HTMLElement>('[data-career]').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.sx-career-track')!, range = box.querySelector<HTMLInputElement>('.sx-career-range')!;
    const M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const bars = [...box.querySelectorAll<HTMLElement>('.sx-career-bar')];
    const set = (t: number) => {
      const m = Math.round(D.minM + t * (D.maxM - D.minM - 1));
      box.style.setProperty('--t', String(t));
      const on = D.roles.filter((r) => m >= r.from && m <= r.to);
      box.querySelector('.sx-career-date')!.textContent = `${M[m % 12]} ${Math.floor(m / 12)}`;
      box.querySelector('.sx-career-what')!.textContent = on.length ? on.map((r) => `${r.role} at ${r.company}`).join(' + ') : 'Between roles';
      bars.forEach((b, i) => b.classList.toggle('is-on', on.includes(D.roles[i])));
    };
    const fromX = (x: number) => { const r = track.getBoundingClientRect(); return Math.min(1, Math.max(0, (x - r.left) / r.width)); };
    let drag = false;
    track.addEventListener('pointerdown', (e) => { drag = true; track.setPointerCapture(e.pointerId); set(fromX(e.clientX)); range.value = String(fromX(e.clientX) * 1000); });
    track.addEventListener('pointermove', (e) => { if (drag || e.pointerType === 'mouse') { set(fromX(e.clientX)); range.value = String(fromX(e.clientX) * 1000); } });
    track.addEventListener('pointerup', () => (drag = false));
    range.addEventListener('input', () => set(Number(range.value) / 1000));
    set(1);
    onView(box, () => { if (!motion()) return; const t0 = performance.now(); const step = (now: number) => { const p = Math.min(1, (now - t0) / 2600); const e = 1 - (1 - p) ** 3; set(e); range.value = String(e * 1000); if (p < 1) requestAnimationFrame(step); }; requestAnimationFrame(step); });
  });

  // 6 ─ FAQ chat
  document.querySelectorAll<HTMLElement>('[data-chat]').forEach((box) => {
    const thread = box.querySelector<HTMLElement>('.sx-thread')!;
    let busy = false;
    const add = (cls: string, html: string) => { const p = document.createElement('p'); p.className = `sx-msg ${cls}`; p.innerHTML = html; thread.append(p); thread.scrollTo({ top: thread.scrollHeight, behavior: motion() ? 'smooth' : 'auto' }); return p; };
    box.querySelectorAll<HTMLButtonElement>('.sx-chips button').forEach((b) => b.addEventListener('click', async () => {
      if (busy) return; busy = true; b.classList.add('is-asked');
      add('me', b.textContent!);
      await wait(350);
      const typing = add('them typing', '<i></i><i></i><i></i>');
      await wait(motion() ? 900 + Math.min(900, b.dataset.a!.length * 6) : 0);
      typing.remove(); add('them', b.dataset.a!); busy = false;
    }));
  });

  // 7 ─ Launch clipboard (scroll-driven)
  document.querySelectorAll<HTMLElement>('[data-clip]').forEach((box) => {
    const items = [...box.querySelectorAll('li')], count = box.querySelector('.sx-clip-count b')!;
    let last = -1, queued = false;
    const update = () => {
      queued = false;
      const r = box.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (r.height * 0.9)));
      const n = motion() ? Math.round(p * items.length) : items.length;
      if (n === last) return; last = n;
      items.forEach((li, i) => li.classList.toggle('is-done', i < n));
      count.textContent = String(n);
      box.classList.toggle('is-ready', n === items.length);
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  });

  // 8 ─ Odometer
  document.querySelectorAll<HTMLElement>('[data-odo]').forEach((box) => {
    const nums = [...box.querySelectorAll<HTMLElement>('.sx-odo-num')];
    const set = (on: boolean) => nums.forEach((n, k) => { const digits = String(n.dataset.n).padStart(2, '0').split(''); n.querySelectorAll<HTMLElement>('.sx-odo-reel').forEach((reel, i) => { reel.style.transitionDelay = `${k * 120 + i * 90}ms`; reel.style.setProperty('--d', on ? digits[i] : '0'); }); });
    set(!motion());
    onView(box, () => requestAnimationFrame(() => set(true)), 0.5);
  });

  // 9 ─ Drag-around wall
  document.querySelectorAll<HTMLElement>('[data-wall]').forEach((box) => {
    const holder = box.querySelector<HTMLElement>('.sx-wall-tiles')!;
