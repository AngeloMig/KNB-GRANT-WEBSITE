      <div class="sx-stage sx-redpen" data-redpen>
        <div class="sx-mock" aria-hidden="true">
          <div class="sx-mock-bar"><span></span><span></span><span></span><i>example-shop.com</i></div>
          <div class="sx-mock-nav"><b>SHOP</b><span></span><span></span><span></span><em>☰</em></div>
          <div class="sx-mock-hero"><div><i></i><i></i><i class="short"></i><u>Shop now</u></div></div>
          <div class="sx-mock-grid"><span></span><span></span><span></span><span></span></div>
          <svg class="sx-ink" viewBox="0 0 600 420" preserveAspectRatio="none">
            <path pathLength="1" d="M330 120c90-12 210 6 214 60 4 62-150 80-232 64-70-14-82-112 18-124" />
            <path pathLength="1" d="M520 64c26-6 60 2 58 22s-40 26-62 18-20-36 4-40" />
            <path pathLength="1" d="M62 222c40 4 90 2 110-2" />
            <path pathLength="1" d="M40 330c60-10 140-8 200-2M330 334c60-6 160-6 220 2" />
          </svg>
          <p class="sx-note n1">2.4 MB hero image: 3 s on a phone</p>
          <p class="sx-note n2">Menu hidden behind ☰ even on desktop</p>
          <p class="sx-note n3">No clear next step</p>
          <p class="sx-note n4">No prices or reviews on the cards</p>
        </div>
        <div class="sx-redpen-copy"><p class="sx-kicker">Free website audit</p><h3>What a fresh pair of eyes finds</h3><p>A made-up shop, marked up the way a real audit would. Send your address and get your own notes within a day.</p><a class="sx-btn" href={withBase('/contact/#audit')}>Get my audit</a><button type="button" class="sx-btn ghost" data-redraw>Mark it up again</button></div>
      </div>
    </section>

    {/* 16 ─ Code → page */}
    <section class="sx" id="idea-16">
      <div class="sx-top"><span class="idea-tag"><b>16</b>{IDEAS[15][1]}<em>{NOTES[16][0]}</em></span><p class="sx-why">{NOTES[16][1]} <i>Fits: {NOTES[16][2]}</i></p></div>
      <div class="sx-stage sx-code" data-code>
        <pre class="sx-editor" aria-label="Example Shopify section code"><code></code><span class="sx-caret"></span></pre>
        <div class="sx-result" aria-hidden="true"><div class="sx-res-frame"><div class="sx-res-text"><h4 class="sx-res-title">Made for warm water</h4><p class="sx-res-p">Audio recorded to be heard in the bath.</p><span class="sx-res-btn">Listen now</span></div><div class="sx-res-img" style={`background-image:url(${img('tero', 480)})`}></div></div></div>
        <script type="application/json" id="sx-code-lines" set:html={JSON.stringify(codeLines)} />
