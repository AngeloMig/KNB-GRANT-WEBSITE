  .sx-best { position: absolute; top: 18px; right: 18px; padding: 4px 10px; border-radius: 999px; background: oklch(0.55 0.15 150); color: #fff; font-size: 12px; font-weight: 600; opacity: 0; transform: scale(0.8); transition: 0.4s var(--ease); }
  .sx-pcard.is-best { transform: translateX(-8px); border-color: oklch(0.55 0.15 150); box-shadow: 0 18px 40px -24px oklch(0.4 0.1 150 / 0.6); }
  .sx-pcard.is-best .sx-best { opacity: 1; transform: none; }
  .sx-pcard.is-best .sx-meter i { background: oklch(0.55 0.15 150); }
  @media (max-width: 800px) { .sx-match { grid-template-columns: 1fr; } .sx-pcard.is-best { transform: none; } }

  /* 3 — time zones */
  .sx-tz { display: grid; grid-template-columns: minmax(220px, 360px) minmax(0, 1fr); gap: clamp(24px, 5vw, 70px); align-items: center; }
  .sx-dial { width: 100%; height: auto; }
  .sx-dial-ticks line { stroke: var(--muted); stroke-width: 1.5; opacity: 0.5; }
  .sx-dial-ticks text { font: 600 11px Archivo, sans-serif; fill: var(--muted); text-anchor: middle; }
  .sx-arc { fill: none; stroke-linecap: round; transition: d 0.6s var(--ease); }
  .sx-arc-you { stroke: oklch(0.82 0.08 245); stroke-width: 16; }
  .sx-arc-me { stroke: oklch(0.78 0.12 60); stroke-width: 16; }
  .sx-arc-both { stroke: oklch(0.55 0.15 150); stroke-width: 6; }
  .sx-hand { stroke: var(--ink); stroke-width: 3; stroke-linecap: round; transition: transform 0.6s var(--ease); }
  .sx-hub { fill: var(--ink); }
  .sx-legend i.you { background: oklch(0.82 0.08 245); } .sx-legend i.me { background: oklch(0.78 0.12 60); } .sx-legend i.both { background: oklch(0.55 0.15 150); }
  .sx-tz-sub { font-size: 16px; max-width: 520px; color: var(--muted); }
  .sx-tz-cities { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .sx-tz-cities button, .sx-chips button { padding: 9px 15px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); font: 500 13.5px Archivo, sans-serif; cursor: pointer; }
  .sx-tz-cities button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  @media (max-width: 760px) { .sx-tz { grid-template-columns: 1fr; } .sx-dial { max-width: 300px; margin: 0 auto; } }

  /* 4 — periodic table */
  .sx-table { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 32px; align-items: start; background: oklch(0.2 0.01 260); color: oklch(0.96 0 0); }
  .sx-elements { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .sx-el, .sx-el-big { --c: oklch(0.7 0.13 245); position: relative; aspect-ratio: 1; padding: 8px 10px; border-radius: 10px; border: 1px solid color-mix(in oklch, var(--c) 60%, transparent); background: color-mix(in oklch, var(--c) 16%, transparent); color: inherit; font: inherit; text-align: left; display: flex; flex-direction: column; cursor: pointer; transition: transform 0.35s var(--ease), background 0.3s; }
  .sx-el small, .sx-el-big small { font-size: 11px; opacity: 0.7; }
  .sx-el b { font: 800 clamp(26px, 3vw, 40px)/1 "Big Shoulders Display", sans-serif; margin: auto 0 2px; color: var(--c); }
  .sx-el span { font-size: 10.5px; line-height: 1.2; opacity: 0.85; }
  .sx-el:hover, .sx-el.is-on { transform: translateY(-4px) scale(1.04); background: color-mix(in oklch, var(--c) 32%, transparent); }
  .k-platform { --c: oklch(0.72 0.14 245); } .k-craft { --c: oklch(0.78 0.14 75); } .k-care { --c: oklch(0.74 0.14 150); } .k-people { --c: oklch(0.72 0.15 330); }
  .sx-legend i.k-platform, .sx-legend i.k-craft, .sx-legend i.k-care, .sx-legend i.k-people { background: var(--c); }
  .sx-table .sx-legend { color: oklch(0.8 0 0); }
  .sx-el-detail { position: sticky; top: 20px; }
  .sx-el-big { width: 150px; margin-bottom: 18px; cursor: default; }
  .sx-el-big b { font: 800 84px/1 "Big Shoulders Display", sans-serif; margin: auto 0 0; color: var(--c); }
  .sx-el-detail p { color: oklch(0.8 0 0); }
  @media (max-width: 800px) { .sx-table { grid-template-columns: 1fr; } .sx-elements { grid-template-columns: repeat(3, 1fr); } .sx-el-detail { position: static; display: grid; grid-template-columns: 110px 1fr; gap: 0 16px; align-items: center; } .sx-el-big { width: 100px; margin: 0; grid-row: span 2; } .sx-el-big b { font-size: 54px; } .sx-el-detail .sx-legend { grid-column: 1 / -1; } }

  /* 5 — career */
  .sx-career { --t: 1; }
  .sx-career-read { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; min-height: 64px; margin: 0 0 24px; }
  .sx-career-date { font: 800 clamp(40px, 5vw, 64px)/1 "Big Shoulders Display", sans-serif; }
  .sx-career-what { font-size: 18px; font-weight: 500; }
  .sx-career-track { position: relative; height: calc(var(--lanes) * 74px); cursor: ew-resize; touch-action: pan-y; }
  .sx-career-bar { position: absolute; top: calc(var(--lane) * 74px); left: calc(var(--a) * 100%); width: calc((var(--b) - var(--a)) * 100%); height: 62px; padding: 10px 14px; border-radius: 14px; background: var(--bg); border: 1px solid var(--line); overflow: hidden; display: grid; align-content: center; transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .sx-career-bar b { font-size: 14px; white-space: nowrap; }
  .sx-career-bar span { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sx-career-bar.is-on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .sx-career-bar.is-on span { color: oklch(0.8 0 0); }
  .sx-career-cursor { position: absolute; top: -10px; bottom: -10px; left: calc(var(--t) * 100%); width: 2px; background: oklch(0.6 0.18 30); pointer-events: none; }
  .sx-career-cursor::before { content: ''; position: absolute; top: -6px; left: -5px; width: 12px; height: 12px; border-radius: 50%; background: oklch(0.6 0.18 30); }
  .sx-career-years { position: relative; height: 24px; margin-top: 14px; font-size: 12px; color: var(--muted); }
  .sx-career-years span { position: absolute; left: calc(var(--x) * 100%); }
  .sx-career-range { width: 100%; margin-top: 18px; accent-color: var(--ink); }
  @media (max-width: 640px) { .sx-career-years span:nth-child(odd) { display: none; } .sx-career-bar { padding: 8px 10px; } }

  /* 6 — chat */
  .sx-chat { display: grid; grid-template-columns: minmax(260px, 380px) minmax(0, 1fr); gap: clamp(24px, 5vw, 70px); align-items: center; background: oklch(0.96 0.02 150); }
  .sx-phone-chat { border-radius: 32px; background: var(--bg); box-shadow: 0 30px 60px -36px oklch(0.2 0.05 150 / 0.6); overflow: hidden; border: 8px solid oklch(0.18 0 0); }
  .sx-phone-chat header { display: flex; gap: 10px; align-items: center; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .sx-phone-chat header small { display: block; color: var(--muted); font-size: 11.5px; }
  .sx-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--bg); display: grid; place-items: center; font-weight: 700; }
  .sx-thread { height: 360px; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 8px; scrollbar-width: none; }
  .sx-msg { margin: 0; max-width: 84%; padding: 10px 14px; border-radius: 18px; font-size: 14px; line-height: 1.4; animation: sx-pop 0.35s var(--ease); }
  .sx-msg.them { align-self: flex-start; background: var(--surface); border-bottom-left-radius: 6px; }
  .sx-msg.me { align-self: flex-end; background: oklch(0.55 0.15 150); color: #fff; border-bottom-right-radius: 6px; }
  .sx-msg.typing { display: flex; gap: 4px; padding: 14px; }
  .sx-msg.typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: sx-dot 1s infinite; }
  .sx-msg.typing i:nth-child(2) { animation-delay: 0.15s; } .sx-msg.typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes sx-dot { 50% { transform: translateY(-4px); opacity: 0.4; } }
  @keyframes sx-pop { from { opacity: 0; transform: translateY(8px) scale(0.96); } }
  .sx-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .sx-chips button { padding: 12px 18px; font-size: 15px; transition: background 0.3s, color 0.3s; }
  .sx-chips button:hover { background: var(--ink); color: var(--bg); }
  .sx-chips button.is-asked { opacity: 0.55; }
  @media (max-width: 760px) { .sx-chat { grid-template-columns: 1fr; } .sx-thread { height: 300px; } }

  /* 7 — clipboard */
  .sx-clip-stage { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 40px; align-items: center; background: oklch(0.95 0.03 80); }
  .sx-clip-count { font-size: 18px; } .sx-clip-count b { font: 800 46px/1 "Big Shoulders Display", sans-serif; margin-right: 4px; }
  .sx-clipboard { position: relative; padding: 46px 26px 26px; border-radius: 18px; background: oklch(0.62 0.07 60); box-shadow: 0 30px 50px -30px oklch(0.3 0.06 60 / 0.7); transform: rotate(1.2deg); }
  .sx-clip-top { position: absolute; top: -14px; left: 50%; width: 120px; height: 38px; margin-left: -60px; border-radius: 10px; background: linear-gradient(oklch(0.82 0 0), oklch(0.62 0 0)); box-shadow: 0 4px 8px oklch(0 0 0 / 0.25); }
  .sx-clipboard ol { list-style: none; margin: 0; padding: 18px 22px; background: #fffdf6; border-radius: 6px; counter-reset: c; }
  .sx-clipboard li { display: flex; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px dashed oklch(0.85 0.02 80); font-size: 14.5px; transition: color 0.3s; }
  .sx-box { width: 20px; height: 20px; border: 1.5px solid oklch(0.5 0.02 80); border-radius: 5px; flex: none; position: relative; }
  .sx-clipboard li.is-done { color: oklch(0.5 0.02 80); }
  .sx-clipboard li.is-done .sx-box::after { content: ''; position: absolute; left: 5px; top: -3px; width: 7px; height: 15px; border: solid oklch(0.5 0.17 150); border-width: 0 3px 3px 0; transform: rotate(40deg); animation: sx-tick 0.35s var(--ease); }
  @keyframes sx-tick { from { transform: rotate(40deg) scale(0); } }
  .sx-stamp { position: absolute; right: 30px; bottom: 40px; padding: 8px 16px; border: 4px solid oklch(0.55 0.2 27); border-radius: 10px; color: oklch(0.55 0.2 27); font: 800 28px/1 "Big Shoulders Display", sans-serif; text-transform: uppercase; letter-spacing: 0.04em; transform: rotate(-12deg) scale(2.4); opacity: 0; transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1), opacity 0.2s; mix-blend-mode: multiply; }
  .sx-clip-stage.is-ready .sx-stamp { opacity: 0.9; transform: rotate(-12deg) scale(1); }
  @media (max-width: 760px) { .sx-clip-stage { grid-template-columns: 1fr; } .sx-clipboard { padding: 40px 12px 14px; } .sx-clipboard ol { padding: 12px 14px; } .sx-stamp { right: 14px; bottom: 24px; font-size: 22px; } }

  /* 8 — odometer */
  .sx-odo { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; background: var(--ink); color: var(--bg); }
  .sx-odo-num { display: flex; gap: 4px; margin-bottom: 12px; }
  .sx-odo-col { height: clamp(64px, 7vw, 100px); width: clamp(44px, 4.8vw, 68px); overflow: hidden; border-radius: 10px; background: oklch(0.26 0 0); box-shadow: inset 0 10px 14px -8px oklch(0 0 0 / 0.8), inset 0 -10px 14px -8px oklch(0 0 0 / 0.8); }
  .sx-odo-reel { --d: 0; display: flex; flex-direction: column; transform: translateY(calc(var(--d) * -10%)); transition: transform 1.6s cubic-bezier(0.2, 0.9, 0.2, 1); }
  .sx-odo-reel i { font: 800 clamp(48px, 5.6vw, 80px)/clamp(64px, 7vw, 100px) "Big Shoulders Display", sans-serif; font-style: normal; text-align: center; height: clamp(64px, 7vw, 100px); }
  .sx-odo p { margin: 0; color: oklch(0.78 0 0); font-size: 14px; max-width: 200px; }
  @media (max-width: 900px) { .sx-odo { grid-template-columns: repeat(2, 1fr); row-gap: 30px; } }

  /* 9 — wall */
  .sx-wall { position: relative; height: clamp(420px, 52vw, 640px); border-radius: 26px; overflow: hidden; background: oklch(0.94 0.01 260); cursor: grab; touch-action: none; user-select: none; }
  .sx-wall.is-dragging { cursor: grabbing; }
  .sx-wall-tiles { position: absolute; inset: 0; }
  .sx-tile { position: absolute; top: 0; left: 0; border-radius: 16px; overflow: hidden; background: var(--bg); box-shadow: 0 16px 30px -20px oklch(0.2 0.02 260 / 0.5); will-change: transform; }
  .sx-tile img { width: 100%; height: 100%; object-fit: cover; object-position: top; pointer-events: none; }
  .sx-tile span { position: absolute; left: 10px; bottom: 10px; padding: 6px 12px; border-radius: 999px; background: oklch(1 0 0 / 0.92); font-size: 12px; color: var(--muted); display: flex; gap: 8px; opacity: 0; transform: translateY(6px); transition: 0.3s var(--ease); }
  .sx-tile span b { color: var(--ink); }
  .sx-tile:hover span { opacity: 1; transform: none; }
  .sx-wall-hint { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 14px 22px; border-radius: 999px; background: var(--ink); color: var(--bg); font-weight: 600; pointer-events: none; transition: opacity 0.4s; }
  .sx-wall.was-dragged .sx-wall-hint { opacity: 0; }

  /* 10 — receipt */
  .sx-receipt-stage { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 18px; background: oklch(0.93 0.015 60); padding-top: 30px; }
  .sx-printer { position: relative; width: min(360px, 100%); }
  .sx-slot { display: block; height: 28px; margin: 0 -18px; border-radius: 14px; background: linear-gradient(oklch(0.32 0 0), oklch(0.2 0 0)); box-shadow: 0 10px 18px -8px oklch(0 0 0 / 0.5); position: relative; z-index: 2; }
  .sx-paper-clip { overflow: hidden; margin-top: -12px; padding: 0 10px 20px; }
  .sx-paper { position: relative; padding: 28px 22px 34px; background: #fffef9; font: 13px/1.6 ui-monospace, "SF Mono", Menlo, monospace; color: oklch(0.25 0 0); box-shadow: 0 10px 20px -12px oklch(0 0 0 / 0.3); transform: translateY(-101%); --mask: radial-gradient(circle at 8px 100%, transparent 7px, #000 7.5px) 0 0 / 16px 100%; -webkit-mask: linear-gradient(#000, #000) top / 100% calc(100% - 8px) no-repeat, radial-gradient(circle at 8px 8px, transparent 7px, #000 7.5px) bottom / 16px 8px repeat-x; }
  .sx-receipt-stage.is-printing .sx-paper { animation: sx-print 2.6s steps(26) forwards; }
  @keyframes sx-print { to { transform: none; } }
  .sx-r-head { text-align: center; font-weight: 700; letter-spacing: 0.2em; margin: 0; }
  .sx-r-head small { font-weight: 400; letter-spacing: 0.04em; }
  .sx-r-dash { border-top: 1.5px dashed oklch(0.6 0 0); margin: 12px 0; }
  .sx-r-line { display: flex; justify-content: space-between; gap: 10px; margin: 2px 0; }
  .sx-r-line span { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; }
  .sx-r-line b { flex: none; }
  .sx-r-line span::after { content: ' ..........................................'; color: oklch(0.7 0 0); }
  .sx-r-total { font-weight: 700; font-size: 15px; }
  .sx-r-foot { text-align: center; margin: 18px 0 0; font-size: 11px; color: oklch(0.5 0 0); }
  .sx-barcode { display: block; height: 40px; margin: 10px auto 0; width: 80%; background: repeating-linear-gradient(90deg, #222 0 2px, transparent 2px 4px, #222 4px 5px, transparent 5px 8px, #222 8px 11px, transparent 11px 12px); }

  /* 11 — myths */
  .sx-myths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; background: none; padding: 0; overflow: visible; }
  .sx-flip { position: relative; height: 250px; padding: 0; border: 0; background: none; cursor: pointer; perspective: 1000px; font: inherit; text-align: left; transform: rotate(var(--r)); transition: transform 0.4s var(--ease); }
  .sx-flip:hover { transform: rotate(0) translateY(-4px); }
  .sx-face { position: absolute; inset: 0; padding: 24px; border-radius: 22px; display: flex; flex-direction: column; gap: 10px; backface-visibility: hidden; transition: transform 0.8s var(--ease); }
  .sx-face small { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .sx-face b { font-size: 21px; line-height: 1.2; font-weight: 600; }
  .sx-front { background: oklch(0.93 0.05 25); color: oklch(0.32 0.1 25); }
  .sx-front b { font-size: 26px; text-decoration: line-through; text-decoration-thickness: 0; transition: text-decoration-thickness 0.3s; }
  .sx-front em { margin-top: auto; font-style: normal; font-size: 13px; opacity: 0.7; }
  .sx-back { background: oklch(0.3 0.06 150); color: oklch(0.95 0.03 150); transform: rotateY(180deg); }
  .sx-back b { font-size: 17px; font-weight: 500; }
  .sx-flip[aria-pressed='true'] .sx-front { transform: rotateY(-180deg); }
  .sx-flip[aria-pressed='true'] .sx-back { transform: none; }
  @media (max-width: 900px) { .sx-myths { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .sx-myths { grid-template-columns: 1fr; } .sx-flip { height: 210px; } }

  /* 12 — hours */
  .sx-hours { --v: 0.1; }
  .sx-hours-top { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 10px; }
  .sx-hours-big { margin: 0; display: flex; align-items: baseline; gap: 10px; }
  .sx-hours-big b { font-size: clamp(64px, 8vw, 110px); line-height: 0.9; }
  .sx-hours-range { width: 100%; margin: 26px 0 6px; accent-color: var(--ink); height: 28px; }
  .sx-hours-ticks { position: relative; height: 34px; font-size: 12px; font-weight: 600; }
  .sx-hours-ticks span { position: absolute; left: calc(var(--x) * 100%); transform: translateX(-50%); text-align: center; display: grid; }
  .sx-hours-ticks span::before { content: ''; width: 1px; height: 8px; background: var(--muted); margin: 0 auto 2px; }
  .sx-hours-ticks small { color: var(--muted); font-weight: 400; }
  .sx-hours-compare { display: grid; gap: 12px; margin-top: 26px; }
  .sx-cost { --w: 0; display: grid; grid-template-columns: 200px 120px 1fr; align-items: center; gap: 14px; }
  .sx-cost small { color: var(--muted); font-size: 13.5px; }
  .sx-cost b { font-size: 20px; }
  .sx-cost i { height: 18px; border-radius: 9px; background: var(--line); width: calc(var(--w) * 100%); transition: width 0.5s var(--ease), background 0.3s; }
  .sx-cost.is-better i { background: oklch(0.55 0.15 150); }
  .sx-hours-save { font-size: 18px; margin: 22px 0 0; }
  @media (max-width: 700px) { .sx-cost { grid-template-columns: 1fr auto; } .sx-cost i { grid-column: 1 / -1; } .sx-hours-ticks { font-size: 10.5px; } .sx-hours-ticks span:nth-child(1) { transform: translateX(-80%); } .sx-hours-ticks span:nth-child(2) { transform: translateX(-10%); } .sx-hours-ticks span:nth-child(4) { transform: translateX(-90%); } }

  /* 13 — booking */
  .sx-weeks { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-top: 18px; }
  .sx-week { padding: 14px; border-radius: 14px; display: grid; gap: 2px; opacity: 0; transform: rotateX(-80deg); transform-origin: top; transition: 0.6s var(--ease) calc(var(--i) * 60ms); }
  .sx-book.is-in .sx-week { opacity: 1; transform: none; }
  .sx-week small { font-size: 11px; opacity: 0.7; } .sx-week b { font-size: 18px; } .sx-week span { font-size: 12.5px; font-weight: 600; }
  .sx-week.full, .sx-legend i.full { background: oklch(0.86 0 0); color: oklch(0.45 0 0); }
  .sx-week.some, .sx-legend i.some { background: oklch(0.9 0.09 85); color: oklch(0.35 0.08 70); }
  .sx-week.open, .sx-legend i.open { background: oklch(0.88 0.1 150); color: oklch(0.3 0.08 150); }
  @media (max-width: 800px) { .sx-weeks { grid-template-columns: repeat(3, 1fr); } }

  /* 14 — bubbles */
  .sx-bubbles-stage { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 30px; align-items: center; background: oklch(0.97 0.01 300); }
  .sx-bubbles { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px; min-height: 380px; }
  .sx-bubble { --s: 1; width: calc(118px * var(--s)); aspect-ratio: 1; border-radius: 50%; border: 0; display: grid; place-content: center; text-align: center; padding: 10px; background: oklch(0.9 0.07 var(--h)); color: oklch(0.3 0.08 var(--h)); font: inherit; cursor: pointer; animation: sx-float 6s ease-in-out var(--d) infinite; transition: background 0.3s, transform 0.3s; }
  .sx-bubble b { font-size: calc(13px * var(--s)); line-height: 1.15; } .sx-bubble small { font-size: 11.5px; opacity: 0.75; }
  .sx-bubble:hover, .sx-bubble[aria-pressed='true'] { background: oklch(0.45 0.13 var(--h)); color: #fff; }
  @keyframes sx-float { 50% { transform: translate(4px, -10px); } }
