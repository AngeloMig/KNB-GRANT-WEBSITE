<script>
  const root6 = document.documentElement;
  const motion6 = root6.classList.contains('motion');
  const fine6 = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const onScreen = (el: Element, threshold = 0.15) => {
    const state = { on: false };
    new IntersectionObserver(([e]) => { state.on = e.isIntersecting; el.classList.toggle('is-on', e.isIntersecting || el.classList.contains('is-on')); }, { threshold }).observe(el);
    return state;
  };

  // 6: Departure board — each tile shuffles through letters before landing on the next platform.
  {
    const board = document.querySelector<HTMLElement>('.hx6-flaps')!;
    const section = board.closest('section')!;
    const tiles = [...board.querySelectorAll<HTMLElement>('.hx6-flap')];
    const words = JSON.parse(board.dataset.words!) as string[];
    const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const seen = onScreen(section);
    const flip = (tile: HTMLElement, ch: string) => {
      if (tile.textContent === ch) return;
      tile.textContent = ch;
      tile.animate([{ transform: 'rotateX(0)' }, { transform: 'rotateX(-75deg)', offset: 0.5 }, { transform: 'rotateX(0)' }], { duration: 110 });
    };
    if (motion6) (async () => {
      for (let w = 1; ; w = (w + 1) % words.length) {
        await wait(2600);
        while (!seen.on) await wait(300);
        const word = words[w];
        await Promise.all(tiles.map(async (tile, i) => {
          for (let k = 0; k < 4 + i; k++) { flip(tile, letters[(Math.random() * 26) | 0]); await wait(55); }
          flip(tile, word[i] ?? '');
        }));
      }
    })();
  }

  // 7: Wall of work — scrolling nudges the rows along on top of their slow drift.
  {
    const section = document.querySelector<HTMLElement>('.hx7')!;
    if (motion6) {
      let ticking = false;
      const update = () => { ticking = false; section.style.setProperty('--shift', `${(section.getBoundingClientRect().top * -0.35).toFixed(1)}px`); };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  }

  // 8: Project names — hovering a name shows its screenshot by the cursor and tints the background.
  {
    const section = document.querySelector<HTMLElement>('.hx8')!;
    const items = [...section.querySelectorAll<HTMLElement>('.hx8-list li')];
    const float = section.querySelector<HTMLElement>('.hx8-float')!;
    const shots = [...float.querySelectorAll('img')];
    if (fine6) {
      section.querySelector('.hx8-list')!.addEventListener('pointermove', (e) => { float.style.translate = `${(e as PointerEvent).clientX}px ${(e as PointerEvent).clientY}px`; });
      items.forEach((item, i) => {
        item.addEventListener('pointerenter', () => {
          shots.forEach((s, j) => s.classList.toggle('is-active', i === j));
          float.classList.add('is-on');
          section.style.setProperty('--tint', item.dataset.tint!);
        });
      });
      section.querySelector('.hx8-list')!.addEventListener('pointerleave', () => { float.classList.remove('is-on'); section.style.removeProperty('--tint'); });
      addEventListener('scroll', () => float.classList.remove('is-on'), { passive: true });
    }
  }

  // 9: Command palette — filter as you type, arrow keys and Enter, ⌘K / Ctrl+K to jump in,
  // and an example request typed into the empty box.
  {
    const section = document.querySelector<HTMLElement>('.hx9')!;
    const input = section.querySelector('input')!;
    const options = [...section.querySelectorAll<HTMLElement>('.hx9-options li:not(.hx9-empty)')];
    const empty = section.querySelector<HTMLElement>('.hx9-empty')!;
    let active = 0;
    const visible = () => [...options, empty].filter((o) => !o.hidden);
    const paint = () => visible().forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
    const filter = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter((w) => w.length > 1);
      options.forEach((o) => { o.hidden = words.length > 0 && !words.some((w) => o.dataset.keywords!.includes(w)); });
      empty.hidden = options.some((o) => !o.hidden);
      active = 0;
      paint();
    };
    input.addEventListener('input', filter);
    input.addEventListener('keydown', (e) => {
      const list = visible();
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); active = (active + (e.key === 'ArrowDown' ? 1 : -1) + list.length) % list.length; paint(); }
      if (e.key === 'Enter') { e.preventDefault(); list[active]?.querySelector('a')?.click(); }
    });
    [...options, empty].forEach((o) => o.addEventListener('pointerenter', () => { active = visible().indexOf(o); paint(); }));
    addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); section.scrollIntoView({ block: 'center' }); input.focus(); }
    });
    const examples = ['A new Shopify store for my brand…', 'Move my site from WordPress to Shopify…', 'Make my store load faster…', 'Help with my site every month…'];
    const seen = onScreen(section);
    if (motion6) (async () => {
      for (let i = 0; ; i = (i + 1) % examples.length) {
        while (!seen.on || document.activeElement === input || input.value) await wait(400);
        for (let n = 1; n <= examples[i].length; n++) { if (document.activeElement === input) break; input.placeholder = examples[i].slice(0, n); await wait(38); }
        await wait(1800);
      }
    })();
    input.addEventListener('focus', () => { input.placeholder = 'Describe your project…'; });
  }

  // 10: Dot-matrix name — the letters are sampled into dots that the cursor pushes away and that
  // spring back home. On touch screens a ripple plays on its own every few seconds.
  {
    const canvas = document.querySelector<HTMLCanvasElement>('.hx10-canvas')!;
    const ctx = canvas.getContext('2d')!;
    type Dot = { hx: number; hy: number; x: number; y: number; vx: number; vy: number };
    let dots: Dot[] = [], W = 0, H = 0, gap = 7, px = -9999, py = -9999;
    const seen = onScreen(canvas, 0);
    const ink = getComputedStyle(root6).getPropertyValue('--ink').trim() || '#161616';
    const build = async () => {
      await document.fonts.load('800 200px "Big Shoulders Display"');
      const r = canvas.getBoundingClientRect();
      W = Math.floor(r.width); H = Math.floor(r.height);
      const dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const o = off.getContext('2d')!;
      const lines = W < 640 ? ['GRANT', 'DEV14.'] : ['GRANT DEV14.'];
      let size = (H / lines.length) * 1.12;
      o.font = `800 ${size}px "Big Shoulders Display"`;
      const widest = Math.max(...lines.map((l) => o.measureText(l).width));
      size = Math.min(size, (size * W * 0.99) / widest);
      o.font = `800 ${size}px "Big Shoulders Display"`;
      o.textAlign = 'center'; o.textBaseline = 'middle';
      lines.forEach((l, i) => o.fillText(l, W / 2, (H * (i + 0.5)) / lines.length + size * 0.04));
      const data = o.getImageData(0, 0, W, H).data;
      gap = W < 640 ? 5 : 7;
      dots = [];
      for (let y = gap / 2; y < H; y += gap) for (let x = gap / 2; x < W; x += gap) {
        if (data[((y | 0) * W + (x | 0)) * 4 + 3] > 128) dots.push({ hx: x, hy: y, x, y, vx: 0, vy: 0 });
      }
      draw();
    };
    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      const still = new Path2D(), moved = new Path2D();
      const rad = gap * 0.36;
      for (const d of dots) {
        const p = Math.abs(d.x - d.hx) + Math.abs(d.y - d.hy) > 2 ? moved : still;
        p.moveTo(d.x + rad, d.y); p.arc(d.x, d.y, rad, 0, Math.PI * 2);
      }
      ctx.fillStyle = ink; ctx.fill(still);
      ctx.fillStyle = 'oklch(0.6 0.15 255)'; ctx.fill(moved);
    };
    const R = 110;
    const step = () => {
      if (seen.on) {
        for (const d of dots) {
          const dx = d.x - px, dy = d.y - py, dist = Math.hypot(dx, dy);
          if (dist < R && dist > 0.1) { const f = (1 - dist / R) * 5; d.vx += (dx / dist) * f; d.vy += (dy / dist) * f; }
          d.vx += (d.hx - d.x) * 0.07; d.vy += (d.hy - d.y) * 0.07;
          d.vx *= 0.8; d.vy *= 0.8;
          d.x += d.vx; d.y += d.vy;
        }
        draw();
      }
      requestAnimationFrame(step);
    };
    build().then(() => { if (motion6) requestAnimationFrame(step); });
    let resizeTimer = 0;
    addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(build, 200); });
    if (motion6 && fine6) {
      canvas.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); px = e.clientX - r.left; py = e.clientY - r.top; });
      canvas.addEventListener('pointerleave', () => { px = py = -9999; });
    } else if (motion6) {
      (async () => {
        for (;;) {
          await wait(2600);
          if (!seen.on || !dots.length) continue;
          const d = dots[(Math.random() * dots.length) | 0];
          for (let t = 0; t < 24; t++) { px = d.hx + (t - 12) * 6; py = d.hy; await wait(16); }
          px = py = -9999;
        }
      })();
    }
  }
</script>

