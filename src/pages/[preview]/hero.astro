---
// Design preview of ten homepage hero ideas. Local preview only: in a build this route has no pages.
// Open http://localhost:4321/ideas/hero/ while `npm run dev` runs. Only real content is used: your
// projects and their screenshots, the Carlos quote and video, and the site's own fonts and colours.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import HeroCopy from './_HeroCopy.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'The Live Build'], [2, 'Type window'], [3, 'Project orbit'], [4, 'The desk'], [5, 'Design to live'],
  [6, 'Departure board'], [7, 'Wall of work'], [8, 'Project names'], [9, 'Command palette'], [10, 'Dot-matrix name'],
] as const;
const img = (slug: string, size = '') => withBase(`/images/projects/${slug}${size}.webp`);
const host = (url: string) => new URL(url).hostname.replace('www.', '');
// The site's project-card tints, so backgrounds match each project.
const tints: Record<string, string> = {
  olive: 'oklch(0.79 0.025 105)', lilac: 'oklch(0.91 0.017 295)', violet: 'oklch(0.84 0.04 285)',
  rose: 'oklch(0.91 0.018 20)', blue: 'oklch(0.84 0.02 245)', clay: 'oklch(0.87 0.02 60)',
};
const bySlug = (slug: string) => projects.find((p) => p.slug === slug)!;

// 1: example code for each platform. It's illustrative, not taken from the client projects.
const code: Record<string, string> = {
  Shopify: `{% section 'hero-banner' %}\n\n<ul class="product-grid">\n  {% for product in collection.products limit: 8 %}\n    {% render 'product-card', product: product %}\n  {% endfor %}\n</ul>\n\n{{ 'theme.css' | asset_url | stylesheet_tag }}`,
  WordPress: `<?php get_header(); ?>\n\n<main class="site-main">\n  <?php while ( have_posts() ) : the_post(); ?>\n    <?php get_template_part( 'parts/card' ); ?>\n  <?php endwhile; ?>\n</main>\n\n<?php get_footer(); ?>`,
};
const lang: Record<string, string> = { Shopify: 'Liquid', WordPress: 'PHP' };
const build = ['road-armor', 'coptrz', 'tero', 'omenz'].map(bySlug).filter(Boolean).map((p) => ({ slug: p.slug, name: p.name, platform: p.platform, host: host(p.url), code: code[p.platform] ?? code.Shopify, lang: lang[p.platform] ?? 'HTML' }));

// 2: a strip of screenshots that pans inside the letters (repeated so the loop is seamless).
const strip = projects.map((p) => p.slug);
const STRIP_W = 462, STRIP_H = 260;

// 4: windows on the desk.
const desk = [
  { slug: 'road-armor', x: 2, y: 7, w: 22, depth: 0.12, rot: -2 },
  { slug: 'tero', x: 76, y: 6, w: 22, depth: 0.2, rot: 2 },
  { slug: 'light-my-bricks', x: 75, y: 62, w: 21, depth: 0.08, rot: -1.5 },
  { slug: 'coptrz', x: 3, y: 63, w: 20, depth: 0.16, rot: 1.5 },
].map((d) => ({ ...d, project: bySlug(d.slug) })).filter((d) => d.project);

// 6: the departure board. Words flip through on the big board; the rows are your real projects.
const flapWords = ['SHOPIFY', 'WEBFLOW', 'WORDPRESS'];
const FLAPS = Math.max(...flapWords.map((w) => w.length));

// 7: rows of screenshots for the tilted wall (each row starts on a different project).
const wallRows = [0, 2, 4, 1].map((start) => [...projects.slice(start), ...projects.slice(0, start)]);

// 9: the command palette. Each option opens the estimator on the next question (?brief=…).
const brief = (answers: Record<string, string>) => `${withBase('/estimate/')}?brief=${Buffer.from(JSON.stringify(answers)).toString('base64url')}`;
const palette = [
  { label: 'A new website or store', hint: 'Custom themes and ecommerce builds', icon: '+', keywords: 'new build store shop launch start', href: brief({ type: 'new' }) },
  { label: 'Redesign my current site', hint: 'A new look for an existing website', icon: '↻', keywords: 'redesign refresh revamp update look', href: brief({ type: 'redesign' }) },
  { label: 'Move to a new platform', hint: 'Platform migrations and integrations', icon: '⇄', keywords: 'move migrate migration switch platform shopify webflow wordpress', href: brief({ type: 'migration' }) },
  { label: 'Speed and fixes', hint: 'Page speed, bugs and technical SEO', icon: '⚡', keywords: 'speed fast slow fix bug seo performance', href: brief({ type: 'improvements' }) },
  { label: 'Monthly help', hint: 'Ongoing support every month', icon: '◷', keywords: 'monthly support help maintenance retainer', href: brief({ type: 'support' }) },
];
---
<BaseLayout title="Hero ideas preview | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Homepage ideas 1–20', href: '/ideas/' }, { label: 'Compare with the current homepage', href: '/' }]} />

  <!-- Current hero, for comparison -->
  <div class="wrap hx-current">
    <span class="idea-tag hx-tag-muted"><b>0</b>Current hero</span>
    <SectionTitle title="PROJECTS" detail="A selection of web development work" id="top-title" />
    <section class="intro-split" aria-label="Current introduction">
      <div class="intro-aside"><p class="tiny-heading">Shopify, Webflow & WordPress developer</p><p>Custom websites & ecommerce<br />Based in the Philippines</p><p class="intro-trust"><strong>4+ years</strong> building Shopify stores at Rivyl<br />Trusted by Rivyl, MDO Digital & Modern Shelving</p></div>
      <div class="intro-copy">
        <p class="lead">Thoughtful websites. <br />Built to work beautifully.</p>
        <p class="intro-support">I’m Grant, a web developer turning designs into custom websites and ecommerce experiences for brands and agencies.</p>
      </div>
    </section>
  </div>

  <!-- 1: The Live Build -->
  <section class="hx hx1" id="idea-1" aria-label="Idea 1: The Live Build">
    <span class="idea-tag hx-tag"><b>1</b>The Live Build<em>code types itself, then the finished site wipes in</em></span>
    <div class="wrap hx1-grid">
      <HeroCopy headline="Thoughtful websites.<br />Built to work beautifully." first />
      <div class="hx1-device">
        <div class="hx1-laptop" data-build={JSON.stringify(build)}>
          <div class="laptop-lid"><div class="laptop-screen hx1-screen">
            <span class="laptop-notch" aria-hidden="true"></span>
            <div class="laptop-toolbar" aria-hidden="true"><i></i><i></i><i></i><span class="hx1-host">{build[0].host}</span></div>
            <div class="hx1-stage">
              <pre class="hx1-code" aria-hidden="true"><code></code><b class="hx1-caret"></b></pre>
              {build.map((b, i) => <img class:list={['hx1-shot', { 'is-active': i === 0 }]} src={img(b.slug, '-960')} srcset={`${img(b.slug, '-960')} 960w, ${img(b.slug)} 1275w`} sizes="(max-width: 900px) 90vw, 50vw" alt={`${b.name} homepage`} width="960" height="540" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />)}
            </div>
          </div></div>
          <div class="laptop-base" aria-hidden="true"></div>
        </div>
        <p class="hx1-chip" aria-live="polite"><i></i><span class="hx1-chip-text">{build[0].name} · {build[0].platform} · {build[0].lang}</span></p>
      </div>
    </div>
  </section>

  <!-- 2: Type window -->
  <section class="hx2" id="idea-2" aria-label="Idea 2: Type window">
    <div class="hx2-sticky">
      <span class="idea-tag hx-tag"><b>2</b>Type window<em>your screenshots pan inside the letters; scroll to open it up</em></span>
      <div class="hx2-full" aria-hidden="true"><img src={img('road-armor')} alt="" width="1275" height="717" loading="lazy" /></div>
      <div class="wrap hx2-inner">
        <p class="tiny-heading hx2-kicker">Shopify, Webflow & WordPress developer</p>
        {[{ id: 'wide', vb: '0 0 1000 250', lines: [['BUILT TO WORK.', 222]] }, { id: 'narrow', vb: '0 0 600 470', lines: [['BUILT TO', 215], ['WORK.', 450]] }].map((v) => (
          <svg class={`hx2-word hx2-word-${v.id}`} viewBox={v.vb} role="img" aria-label="Built to work.">
            <defs><clipPath id={`hx2-clip-${v.id}`}>{v.lines.map(([t, y]) => <text x="0" y={y} textLength={v.id === 'wide' ? 1000 : 600} lengthAdjust="spacingAndGlyphs">{t}</text>)}</clipPath></defs>
            <g clip-path={`url(#hx2-clip-${v.id})`}>
              <rect width="100%" height="100%" fill="#161616" />
              <g class="hx2-strip" style={`--strip:-${strip.length * STRIP_W}px`}>{[...strip, ...strip].map((slug, i) => <image href={img(slug, '-640')} x={i * STRIP_W} y="0" width={STRIP_W} height={v.id === 'wide' ? 250 : 470} preserveAspectRatio="xMidYMin slice" />)}</g>
              <rect width="100%" height="100%" fill="#000" opacity="0.12" />
            </g>
            {v.lines.map(([t, y]) => <text class="hx2-outline" x="0" y={y} textLength={v.id === 'wide' ? 1000 : 600} lengthAdjust="spacingAndGlyphs" aria-hidden="true">{t}</text>)}
          </svg>
        ))}
        <div class="hx2-row">
          <p class="hx2-lead">Thoughtful websites, built to work beautifully. I’m Grant: I turn designs into custom websites and ecommerce for brands and agencies.</p>
          <div class="hx2-actions">
            <a class="cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a>
            <a class="cta-ghost" href={withBase('/#work')}>See my work</a>
          </div>
          <a class="intro-quote" href={withBase('/#reviews')}><span class="review-avatar" aria-hidden="true">C</span><span><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital</small></span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3: Project orbit -->
  <section class="hx hx3" id="idea-3" aria-label="Idea 3: Project orbit" style={`--tint:${tints[projects[0].canvas]}`}>
    <span class="idea-tag hx-tag"><b>3</b>Project orbit<em>drag or swipe to spin; the background takes the front project’s colour</em></span>
    <div class="wrap hx3-top"><HeroCopy headline="Thoughtful websites.<br />Built to work beautifully." align="center" quote={false} /></div>
    <div class="hx3-ring" aria-roledescription="carousel" aria-label="Projects">
      <div class="hx3-spin" style={`--step:${360 / projects.length}deg`}>{projects.map((p, i) => (
        <a class="hx3-card" href={withBase(`/work/${p.slug}/`)} style={`--i:${i}`} data-tint={tints[p.canvas]} draggable="false">
          <span class="hx3-bar" aria-hidden="true"><i></i><i></i><i></i><b>{host(p.url)}</b></span>
          <img src={img(p.slug, '-640')} alt={`${p.name} homepage`} width="640" height="360" loading={i < 2 ? 'eager' : 'lazy'} draggable="false" />
        </a>
      ))}</div>
    </div>
    <div class="wrap hx3-foot">
      <button type="button" class="hx3-arrow" data-dir="-1" aria-label="Previous project">←</button>
      <div class="hx3-captions" aria-live="polite">{projects.map((p, i) => <p class:list={['hx3-caption', { 'is-active': i === 0 }]}><strong>{p.name}</strong><span>{p.platform} · {p.category}</span><a href={withBase(`/work/${p.slug}/`)}>View project <Arrow diagonal /></a></p>)}</div>
      <button type="button" class="hx3-arrow" data-dir="1" aria-label="Next project">→</button>
    </div>
  </section>

  <!-- 4: The desk -->
  <section class="hx hx4" id="idea-4" aria-label="Idea 4: The desk">
    <span class="idea-tag hx-tag"><b>4</b>The desk<em>drag the windows by their top bar; play Carlos’s video</em></span>
    <div class="hx4-desk">
      {desk.map((d) => (
        <figure class="hx4-win" style={`--x:${d.x}%;--y:${d.y}%;--w:${d.w}%;--depth:${d.depth};--rot:${d.rot}deg`}>
          <div class="hx4-bar"><i></i><i></i><i></i><span>{host(d.project.url)}</span></div>
          <a href={withBase(`/work/${d.slug}/`)} draggable="false"><img src={img(d.slug, '-640')} alt={`${d.project.name} homepage`} width="640" height="360" loading="lazy" draggable="false" /></a>
        </figure>
      ))}
      <figure class="hx4-win hx4-video" style="--x:25.5%;--y:5%;--w:9%;--depth:0.24;--rot:-3deg">
        <div class="hx4-bar"><i></i><i></i><i></i><span>Carlos · MDO Digital</span></div>
        <div class="hx4-video-body">
          <video preload="none" playsinline poster={withBase('/videos/carlos-mdo-digital.jpg')} data-src={withBase('/videos/carlos-mdo-digital.mp4')} width="1080" height="1350"></video>
          <button type="button" class="hx4-play"><span aria-hidden="true">▶</span> Watch Carlos</button>
        </div>
      </figure>
      <figure class="hx4-win hx4-note" style="--x:25%;--y:68%;--w:13%;--depth:0.1;--rot:3deg">
        <blockquote>“He’s just an absolute weapon when it comes to Shopify.”</blockquote>
        <figcaption>Carlos · CEO & Owner, MDO Digital</figcaption>
      </figure>
    </div>
    <div class="wrap hx4-center"><HeroCopy headline="Thoughtful websites.<br />Built to work beautifully." align="center" quote={false} /></div>
  </section>

  <!-- 5: Design to live -->
  <section class="hx hx5" id="idea-5" aria-label="Idea 5: Design to live">
    <span class="idea-tag hx-tag"><b>5</b>Design to live<em>move over the blueprint to reveal the live site; click to open it fully</em></span>
    <div class="wrap hx5-grid">
      <HeroCopy headline="From design<br />to development." light />
      <div class="hx5-frame">
        <div class="hx5-bar" aria-hidden="true"><i></i><i></i><i></i><span class="hx5-host">{host(projects[0].url)}</span></div>
        <div class="hx5-stage" role="img" aria-label="A website shown as a blueprint, with the finished site revealed under a spotlight">
          {projects.map((p, i) => (
            <div class:list={['hx5-pair', { 'is-active': i === 0 }]} data-host={host(p.url)} data-name={p.name}>
              <img class="hx5-blue" src={img(p.slug, '-960')} alt="" width="960" height="540" loading={i === 0 ? 'eager' : 'lazy'} />
              <img class="hx5-live" src={img(p.slug, '-960')} alt="" width="960" height="540" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
          <span class="hx5-grid-lines" aria-hidden="true"></span>
          <span class="hx5-ring" aria-hidden="true"><em>Live site</em></span>
          <span class="hx5-label" aria-hidden="true">Design</span>
        </div>
        <p class="hx5-caption"><span class="hx5-name">{projects[0].name}</span> · Click or tap to open the whole site</p>
      </div>
    </div>
  </section>
  <!-- 6: Departure board -->
  <section class="hx hx6" id="idea-6" aria-label="Idea 6: Departure board">
    <span class="idea-tag hx-tag"><b>6</b>Departure board<em>the platform flips like an airport board; your projects are the departures</em></span>
    <div class="wrap hx6-inner">
      <p class="tiny-heading hx6-kicker">Shopify, Webflow & WordPress developer</p>
      <p class="hx6-title" aria-label="I build Shopify, Webflow and WordPress websites.">
        <span aria-hidden="true">I build</span>
        <span class="hx6-flaps" aria-hidden="true" data-words={JSON.stringify(flapWords)}>{Array.from({ length: FLAPS }, (_, i) => <span class="hx6-flap">{flapWords[0][i] ?? ''}</span>)}</span>
        <span aria-hidden="true">websites.</span>
      </p>
      <div class="hx6-board" role="table" aria-label="Recent projects">
        <div class="hx6-row hx6-head" role="row"><span role="columnheader">Project</span><span role="columnheader">Platform</span><span role="columnheader" class="hx6-cat">Category</span><span role="columnheader">Status</span></div>
        {projects.map((p, i) => (
          <a class="hx6-row" role="row" href={withBase(`/work/${p.slug}/`)} style={`--i:${i}`}>
            <span role="cell">{p.name}</span><span role="cell">{p.platform}</span><span role="cell" class="hx6-cat">{p.category}</span><span role="cell" class="hx6-live"><i></i>Live</span>
          </a>
        ))}
      </div>
      <div class="hx6-foot">
        <div class="hc-actions hx6-actions">
          <a class="cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a>
          <a class="cta-ghost" href={withBase('/#work')}>See my work</a>
        </div>
        <a class="intro-quote hx6-quote" href={withBase('/#reviews')}><span class="review-avatar" aria-hidden="true">C</span><span><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital</small></span></a>
      </div>
    </div>
  </section>

  <!-- 7: Tilted wall -->
  <section class="hx hx7" id="idea-7" aria-label="Idea 7: Tilted wall">
    <span class="idea-tag hx-tag"><b>7</b>Wall of work<em>tilted rows of your sites drift past; scrolling pushes them along</em></span>
    <div class="hx7-wall" aria-hidden="true">{wallRows.map((row, r) => (
      <div class="hx7-row" style={`--dur:${70 + r * 12}s;--dir:${r % 2 ? 1 : -1}`}>{[...row, ...row].map((p) => <img src={img(p.slug, '-480')} alt="" width="480" height="270" loading="lazy" />)}</div>
    ))}</div>
    <div class="wrap hx7-center"><div class="hx7-card"><HeroCopy headline="Thoughtful websites.<br />Built to work beautifully." align="center" /></div></div>
  </section>

  <!-- 8: Name list -->
  <section class="hx hx8" id="idea-8" aria-label="Idea 8: Project names">
    <span class="idea-tag hx-tag"><b>8</b>Project names<em>huge names; hover one to see the site and its colour</em></span>
    <div class="wrap">
      <div class="hx8-top">
        <div><p class="tiny-heading">Shopify, Webflow & WordPress developer</p><p class="hx8-title">Thoughtful websites.<br />Built to work beautifully.</p></div>
        <div class="hx8-side">
          <p>I’m Grant, a web developer turning designs into custom websites and ecommerce experiences for brands and agencies.</p>
          <div class="hc-actions"><a class="cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a><a class="cta-ghost" href={withBase('/#work')}>See my work</a></div>
        </div>
      </div>
      <ol class="hx8-list">{projects.map((p, i) => (
        <li data-tint={tints[p.canvas]}><a href={withBase(`/work/${p.slug}/`)}>
          <span class="hx8-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="hx8-name">{p.name}</span>
          <span class="hx8-meta">{p.platform}<br />{p.category}</span>
          <Arrow diagonal />
        </a></li>
      ))}</ol>
    </div>
    <div class="hx8-float" aria-hidden="true">{projects.map((p) => <img src={img(p.slug, '-640')} alt="" width="640" height="360" loading="lazy" />)}</div>
  </section>

  <!-- 9: Command palette -->
  <section class="hx hx9" id="idea-9" aria-label="Idea 9: Command palette">
    <span class="idea-tag hx-tag"><b>9</b>Command palette<em>type what you need, or pick one; each option opens the estimator</em></span>
    <div class="wrap hx9-inner">
      <p class="tiny-heading">Shopify, Webflow & WordPress developer</p>
      <p class="hx9-title">What are we<br />building?</p>
      <div class="hx9-palette">
        <label class="hx9-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          <span class="sr-only">Describe your project</span>
          <input type="text" autocomplete="off" placeholder="Describe your project…" aria-controls="hx9-options" />
          <kbd>⌘K</kbd>
        </label>
        <ul class="hx9-options" id="hx9-options" role="listbox" aria-label="What you need">
          {palette.map((o, i) => (
            <li role="option" aria-selected={i === 0 ? 'true' : 'false'} data-keywords={`${o.label} ${o.hint} ${o.keywords}`.toLowerCase()}>
              <a href={o.href}><span class="hx9-icon" aria-hidden="true">{o.icon}</span><span><strong>{o.label}</strong><small>{o.hint}</small></span><em>Get an estimate ↵</em></a>
            </li>
          ))}
          <li class="hx9-empty" hidden><a href={withBase('/contact/')}><span class="hx9-icon" aria-hidden="true">✉</span><span><strong>Something else?</strong><small>Tell Grant about it directly</small></span><em>Get in touch ↵</em></a></li>
        </ul>
        <p class="hx9-foot"><span><kbd>↑</kbd><kbd>↓</kbd> to move</span><span><kbd>↵</kbd> to open</span><a href={withBase('/contact/')}>Or get in touch</a></p>
      </div>
      <a class="intro-quote hx9-quote" href={withBase('/#reviews')}><span class="review-avatar" aria-hidden="true">C</span><span><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital</small></span></a>
    </div>
  </section>

  <!-- 10: Dot-matrix name -->
  <section class="hx hx10" id="idea-10" aria-label="Idea 10: Dot-matrix name">
    <span class="idea-tag hx-tag"><b>10</b>Dot-matrix name<em>your name in dots that scatter under the cursor and spring back</em></span>
    <div class="wrap hx10-inner">
      <p class="tiny-heading">Shopify, Webflow & WordPress developer</p>
      <canvas class="hx10-canvas" role="img" aria-label="Grant Dev14."></canvas>
      <div class="hx2-row hx10-row">
        <p class="hx2-lead">Thoughtful websites, built to work beautifully. I’m Grant: I turn designs into custom websites and ecommerce for brands and agencies.</p>
        <div class="hx2-actions"><a class="cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a><a class="cta-ghost" href={withBase('/#work')}>See my work</a></div>
        <a class="intro-quote" href={withBase('/#reviews')}><span class="review-avatar" aria-hidden="true">C</span><span><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital</small></span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.documentElement;
  const motion = root.classList.contains('motion');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  // Run an idea's animation only while it is on screen.
  const whenVisible = (el: Element) => {
    const state = { on: false };
    new IntersectionObserver(([e]) => { state.on = e.isIntersecting; }, { threshold: 0.15 }).observe(el);
    return state;
  };

  // 1: The Live Build — type the code, wipe the finished site in, move to the next project.
  {
    const laptop = document.querySelector<HTMLElement>('.hx1-laptop')!;
    const items = JSON.parse(laptop.dataset.build!) as { name: string; platform: string; host: string; code: string; lang: string }[];
    const screen = laptop.querySelector<HTMLElement>('.hx1-screen')!;
    const codeEl = laptop.querySelector('code')!;
    const shots = [...laptop.querySelectorAll<HTMLElement>('.hx1-shot')];
    const hostEl = laptop.querySelector('.hx1-host')!;
    const chip = document.querySelector('.hx1-chip-text')!;
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const paint = (s: string) => esc(s)
      .replace(/('[^'\n]*'?)/g, '<span class="s">$1</span>')
      .replace(/(\{%|%\}|\{\{|\}\}|&lt;\?php|\?&gt;)/g, '<span class="k">$1</span>');
    const show = (i: number) => {
      shots.forEach((s, j) => s.classList.toggle('is-active', i === j));
      hostEl.textContent = items[i].host;
      chip.textContent = `${items[i].name} · ${items[i].platform} · ${items[i].lang}`;
    };
    if (!motion) {
      screen.classList.add('is-live');
    } else {
      const seen = whenVisible(laptop);
      (async () => {
        for (let i = 0; ; i = (i + 1) % items.length) {
          while (!seen.on) await sleep(300);
          screen.classList.remove('is-live');
          await sleep(500);
          show(i);
          const text = items[i].code;
          for (let n = 0; n <= text.length; n += 2) { codeEl.innerHTML = paint(text.slice(0, n)); await sleep(14); }
          await sleep(350);
          screen.classList.add('is-live');
          await sleep(3600);
        }
      })();
    }
  }

  // 2: Type window — the letters grow and fade while the full screenshot opens behind them.
  {
    const stage = document.querySelector<HTMLElement>('.hx2')!;
    if (motion) {
      stage.classList.add('is-scrolly');
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = stage.getBoundingClientRect();
        const p = Math.max(0, Math.min(1, -r.top / (r.height - innerHeight)));
        stage.style.setProperty('--p', p.toFixed(3));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
  }

  // 3: Project orbit — steps to the next project every few seconds; drag or swipe with a little
  // momentum (it settles on the nearest project), arrows move one project.
  {
    const section = document.querySelector<HTMLElement>('.hx3')!;
    const ring = section.querySelector<HTMLElement>('.hx3-ring')!;
    const spin = section.querySelector<HTMLElement>('.hx3-spin')!;
    const cards = [...section.querySelectorAll<HTMLElement>('.hx3-card')];
    const captions = [...section.querySelectorAll<HTMLElement>('.hx3-caption')];
    const step = 360 / cards.length;
    const seen = whenVisible(section);
    let rot = 0, vel = 0, target: number | null = null, dragging = false, lastX = 0, moved = 0, front = -1, pausedUntil = 0, hover = false, nextStep = performance.now() + 3200;
    const frame = () => {
      if (!dragging) {
        if (target !== null) { rot += (target - rot) * (motion ? 0.12 : 1); if (Math.abs(target - rot) < 0.05) { rot = target; target = null; } }
        else if (Math.abs(vel) > 0.05) { rot += vel; vel *= 0.93; }
        else if (Math.abs(rot - Math.round(rot / step) * step) > 0.05) { vel = 0; target = Math.round(rot / step) * step; }
        else if (motion && seen.on && !hover && performance.now() > Math.max(pausedUntil, nextStep)) { target = (Math.round(rot / step) - 1) * step; nextStep = performance.now() + 3200; }
      }
      spin.style.transform = `translateZ(calc(var(--r) * -1)) rotateY(${rot}deg)`;
      cards.forEach((card, i) => {
        const d = ((((i * step + rot) % 360) + 540) % 360) - 180;
        const f = 1 - Math.abs(d) / 180;
        card.style.opacity = String(0.18 + 0.82 * f ** 1.6);
        card.style.pointerEvents = Math.abs(d) < step / 2 ? 'auto' : 'none';
      });
      const now = ((Math.round(-rot / step) % cards.length) + cards.length) % cards.length;
      if (now !== front) {
        front = now;
        captions.forEach((c, i) => c.classList.toggle('is-active', i === now));
        section.style.setProperty('--tint', cards[now].dataset.tint!);
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    ring.addEventListener('pointerdown', (e) => { dragging = true; lastX = e.clientX; moved = 0; vel = 0; target = null; ring.setPointerCapture(e.pointerId); });
    ring.addEventListener('pointermove', (e) => { if (!dragging) return; const dx = e.clientX - lastX; lastX = e.clientX; moved += Math.abs(dx); rot += dx * 0.22; vel = dx * 0.22; });
    const release = () => { dragging = false; pausedUntil = performance.now() + 2500; };
    ring.addEventListener('pointerup', release);
    ring.addEventListener('pointercancel', release);
    ring.addEventListener('click', (e) => { if (moved > 6) e.preventDefault(); }, true);
    ring.addEventListener('pointerenter', () => { hover = true; });
    ring.addEventListener('pointerleave', () => { hover = false; });
    section.querySelectorAll<HTMLButtonElement>('.hx3-arrow').forEach((b) => b.addEventListener('click', () => {
      vel = 0;
      target = (Math.round(rot / step) - Number(b.dataset.dir)) * step;
      pausedUntil = performance.now() + 4000;
    }));
  }

  // 4: The desk — drag windows by their bar (mouse and trackpad), drift on scroll, play the video.
  {
    const desk = document.querySelector<HTMLElement>('.hx4-desk')!;
    const wins = [...desk.querySelectorAll<HTMLElement>('.hx4-win')];
    const wide = matchMedia('(min-width: 901px)');
    let z = 10;
    wins.forEach((win) => {
      let ox = 0, oy = 0, sx = 0, sy = 0, active = false;
      win.addEventListener('pointerdown', () => { win.style.zIndex = String(++z); });
      const handle = win.querySelector<HTMLElement>('.hx4-bar') ?? win;
      handle.addEventListener('pointerdown', (e) => {
        if (!wide.matches || (e.target as HTMLElement).closest('button')) return;
        active = true; sx = e.clientX - ox; sy = e.clientY - oy;
        handle.setPointerCapture(e.pointerId);
        win.classList.add('is-dragging');
      });
      handle.addEventListener('pointermove', (e) => { if (!active) return; ox = e.clientX - sx; oy = e.clientY - sy; win.style.translate = `${ox}px ${oy}px`; });
      const stop = () => { active = false; win.classList.remove('is-dragging'); };
      handle.addEventListener('pointerup', stop);
      handle.addEventListener('pointercancel', stop);
    });
    if (motion) {
      const section = desk.closest('section')!;
      let ticking = false;
      const update = () => {
        ticking = false;
        const top = section.getBoundingClientRect().top;
        wins.forEach((w) => w.style.setProperty('--drift', `${(top * Number(w.style.getPropertyValue('--depth'))).toFixed(1)}px`));
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }
    const video = desk.querySelector('video')!;
    const play = desk.querySelector<HTMLButtonElement>('.hx4-play')!;
    play.addEventListener('click', () => {
      if (!video.src) video.src = video.dataset.src!;
      video.controls = true;
      video.play();
      play.hidden = true;
    });
  }

  // 5: Design to live — the spotlight follows the cursor (or drifts on its own on touch screens);
  // a click opens the whole live site, then the next project comes in as a blueprint.
  {
    const stage = document.querySelector<HTMLElement>('.hx5-stage')!;
    const pairs = [...stage.querySelectorAll<HTMLElement>('.hx5-pair')];
    const hostEl = document.querySelector('.hx5-host')!;
    const nameEl = document.querySelector('.hx5-name')!;
    let index = 0, busy = false;
    const place = (x: number, y: number) => { stage.style.setProperty('--x', `${x}px`); stage.style.setProperty('--y', `${y}px`); };
    const centre = () => { const r = stage.getBoundingClientRect(); place(r.width * 0.6, r.height * 0.45); };
    centre();
    addEventListener('resize', centre);
    if (fine) {
      stage.addEventListener('pointermove', (e) => { const r = stage.getBoundingClientRect(); place(e.clientX - r.left, e.clientY - r.top); });
    } else if (motion) {
      const seen = whenVisible(stage);
      const drift = (t: number) => {
        if (seen.on && !busy) { const r = stage.getBoundingClientRect(); place(r.width * (0.5 + 0.32 * Math.sin(t / 1700)), r.height * (0.5 + 0.28 * Math.sin(t / 1100))); }
        requestAnimationFrame(drift);
      };
      requestAnimationFrame(drift);
    }
    stage.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      stage.classList.add('is-open');
      await sleep(motion ? 1900 : 1200);
      index = (index + 1) % pairs.length;
      pairs.forEach((p, i) => p.classList.toggle('is-active', i === index));
      hostEl.textContent = pairs[index].dataset.host!;
      nameEl.textContent = pairs[index].dataset.name!;
      stage.classList.remove('is-open');
      await sleep(600);
      busy = false;
    });
  }
</script>

