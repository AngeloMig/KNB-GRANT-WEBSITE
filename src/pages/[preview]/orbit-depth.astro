---
// Design preview: 10 ideas for depth in the hero orbit — the front card much bigger, the cards to
// its left and right smaller, the ones at the back much smaller. Local preview only: in a build this
// route has no pages. Open http://localhost:4321/ideas/orbit-depth/. Each idea runs on its own working
// orbit (drag it, use the arrows, or wait), over the hero's name, which the front card may overlap.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import ProjectOrbit from '../../components/ProjectOrbit.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Depth ladder'], [2, 'Spotlight and soft focus'], [3, 'Wings tucked in'], [4, 'Sides turn to face you'], [5, 'Back row peeks over the name'],
  [6, 'Front card pops out'], [7, 'Hand of cards'], [8, 'Staircase'], [9, 'Theatre lights'], [10, 'Swipe deck'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['the simplest', 'Three clear sizes: the front card at 125%, the two beside it at about 70%, the three behind at 50% and 36%. The ring stays a ring.'],
  2: ['', 'Sizes as in 1, and the further back a card is, the softer and greyer it gets, so the front one is the only sharp, full-colour thing.'],
  3: ['', 'The side cards shrink and tuck in closer to the front one, and the back cards sit a little higher, so the whole orbit is narrower and the front one dominates.'],
  4: ['', 'The side cards turn towards you instead of away, so their sites stay readable even small. Feels more like a showcase than a ring.'],
  5: ['', 'The ring tips back: the cards behind rise as they shrink, peeking out above the front card over GRANT DEV14.'],
  6: ['wait for it to turn', 'The front card comes forward out of the ring, with a deeper shadow and a small spring as each project arrives; the rest stay small and flat.'],
  7: ['', 'Cards tilt as they move round, fanned out like a hand of cards, the front one upright and biggest.'],
  8: ['', 'Each step back is smaller and higher, like a staircase climbing behind the name.'],
  9: ['', 'Sizes as in 1, with the back of the stage in shadow: the further back, the darker, and a glow in the project colour behind the front card.'],
  10: ['best on phones', 'Phone-first: the front card fills the space, the two beside it peek in at the edges, and the back ones are hidden. Swipe like a deck.'],
};
---
<BaseLayout title="Orbit depth ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current homepage', href: '/' }, { label: 'Orbit dots ideas', href: '/ideas/orbit-dots/' }]} />
  <div class="wrap odp-page">
    <header class="odp-head">
      <span class="tiny-heading">Preview · depth in the orbit</span>
      <h1 class="display">Big in front,<br />small behind</h1>
      <p>Ten ways to give the orbit depth: the front card much bigger, the cards beside it smaller, the ones at the back much smaller. Each runs on its own working orbit over the hero’s name, which the front card is allowed to overlap. Drag it, use the arrows, or wait for it to turn. Reflections are left out here.</p>
    </header>
    {IDEAS.map(([n, name]) => (
      <section class="odp" id={`idea-${n}`}>
        <div class="odp-top"><span class="idea-tag"><b>{n}</b>{name}{NOTES[n][0] && <em>{NOTES[n][0]}</em>}</span><p class="odp-why">{NOTES[n][1]}</p></div>
        <div class="odp-demo" data-v={n}>
          <p class="odp-name display" aria-hidden="true">GRANT DEV14.</p>
          <span class="odp-glow" aria-hidden="true"></span>
          <ProjectOrbit card="var(--odp-card)" />
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import { Orbit } from './_orbit-demo';
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const phone = matchMedia('(max-width: 640px)');
  // A value per step from the front: [front, beside it, next, at the back], blended in between.
  const steps = (d: number, v: number[]) => {
    const k = clamp(Math.abs(d) / 60, 0, 3), i = Math.min(2, Math.floor(k)), t = k - i;
    const ease = t * t * (3 - 2 * t);
    return v[i] + (v[i + 1] - v[i]) * ease;
  };
  const near = (d: number) => clamp(1 - Math.abs(d) / 60); // 1 at the front, 0 one step away

  type Look = { s: number; y?: number; z?: number; turn?: number; tilt?: number; filter?: string; shadow?: string };
  const looks: Record<number, (d: number, card: HTMLElement, arrived: number) => Look> = {
    1: (d) => ({ s: steps(d, [1.25, 0.72, 0.5, 0.36]) }),
    2: (d) => ({ s: steps(d, [1.28, 0.64, 0.45, 0.32]), filter: `blur(${steps(d, [0, 1.6, 3, 4]).toFixed(2)}px) saturate(${steps(d, [1, 0.6, 0.4, 0.3]).toFixed(2)})` }),
    3: (d) => ({ s: steps(d, [1.2, 0.66, 0.46, 0.36]), z: steps(d, [1, 0.8, 0.68, 0.6]), y: steps(d, [0, 0.02, 0.1, 0.16]) }),
    4: (d) => ({ s: steps(d, [1.2, 0.7, 0.5, 0.38]), turn: -d * 0.8 * clamp(Math.abs(d) < 100 ? 1 : (180 - Math.abs(d)) / 80) }),
    5: (d) => ({ s: steps(d, [1.22, 0.7, 0.5, 0.4]), y: ((1 - Math.cos((d * Math.PI) / 180)) / 2) * 0.62 }),
    6: (d, _card, arrived) => {
      const since = performance.now() - arrived, spring = since < 700 ? 1 + 0.06 * Math.sin((since / 700) * Math.PI) * (1 - since / 700) : 1;
      return { s: steps(d, [1.3, 0.62, 0.46, 0.36]) * (Math.abs(d) < 30 ? spring : 1), z: 1 + 0.35 * near(d), shadow: `0 ${(18 + 14 * near(d)).toFixed(0)}px ${(36 + 24 * near(d)).toFixed(0)}px oklch(0 0 0 / ${(0.2 + 0.14 * near(d)).toFixed(2)})` };
    },
    7: (d) => ({ s: steps(d, [1.2, 0.7, 0.5, 0.38]), tilt: d * 0.16, y: ((1 - Math.cos((d * Math.PI) / 180)) / 2) * -0.1 }),
    8: (d) => ({ s: steps(d, [1.25, 0.66, 0.46, 0.34]), y: steps(d, [0, 0.24, 0.42, 0.54]) }),
    9: (d) => ({ s: steps(d, [1.25, 0.7, 0.5, 0.36]), filter: `brightness(${steps(d, [1, 0.72, 0.52, 0.42]).toFixed(2)})` }),
    10: (d) => ({ s: steps(d, [1.4, 0.8, 0.5, 0.4]), z: steps(d, [1, 1.25, 1, 1]) }),
  };
  // How visible each card is: these ideas keep the back cards (smaller) in view rather than fading them out.
  const opacity: Record<number, (d: number) => number> = {
    10: (d) => clamp((110 - Math.abs(d)) / 40),
  };
  const backVisible = (d: number) => steps(d, [1, 1, 0.9, 0.7]);

  document.querySelectorAll<HTMLElement>('.odp-demo').forEach((box) => {
    const v = Number(box.dataset.v);
    const ob = box.querySelector<HTMLElement>('.ob')!;
    let arrived = 0;
    const look = looks[v];
    new Orbit(ob, {
      opacity: opacity[v] ?? backVisible,
      onFront: (card) => { box.style.setProperty('--h', card.dataset.hue!); arrived = performance.now(); },
      onCard: (card, d) => {
        const a = Number(card.dataset.angle);
        const l = look(d, card, arrived);
        // Placed on the ring as before, then moved and sized in place (so a card shrinks where it stands).
        card.style.transform = `rotateY(${a}deg) translateZ(calc(var(--r) * ${(l.z ?? 1).toFixed(3)})) translateY(calc(var(--odp-card) * ${(-(l.y ?? 0)).toFixed(3)})) rotateY(${(l.turn ?? 0).toFixed(2)}deg) rotateZ(${(l.tilt ?? 0).toFixed(2)}deg) scale(${l.s.toFixed(3)})`;
        card.style.filter = l.filter ?? '';
        // (Phones: the card's box is a rectangle around the phone shape, so a box shadow would show as a grey panel.)
        if (l.shadow && !phone.matches) card.style.boxShadow = l.shadow;
      },
    });
  });
</script>

<style is:global>
  .odp-page { padding-bottom: 160px; }
  .odp-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .odp-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .odp-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .odp { padding-block: 48px; border-top: 1px solid var(--line); }
  .odp-top { display: grid; gap: 4px; margin-bottom: 22px; }
  .odp-why { max-width: 700px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .odp-demo { --h: 245; --odp-card: clamp(200px, 26vw, 400px); position: relative; padding: clamp(150px, 15vw, 230px) 0 60px; border-radius: 28px; overflow: hidden; background: oklch(0.982 0.009 var(--h)); transition: background-color 1.4s var(--ease); isolation: isolate; }
  /* The hero's name behind the orbit, so the overlap can be judged. */
  .odp-name { position: absolute; z-index: 0; top: clamp(24px, 3vw, 44px); left: 0; right: 0; margin: 0; text-align: center; font-size: clamp(64px, 13vw, 210px); line-height: 1; color: oklch(0.33 0.07 var(--h) / 0.85); white-space: nowrap; transition: color 1.4s var(--ease); pointer-events: none; }
  .odp-demo .ob { z-index: 1; }
  .odp-demo .ob-mirror { display: none; }
  .odp-demo .ob-card { transition: none; }
  /* The bigger front card reaches further down, so the caption moves below it. */
  .odp-demo .ob-foot { translate: 0 calc(var(--odp-card) * 0.12); }
  .odp-demo { padding-bottom: 90px; }
  .odp-demo .ob-caption strong { color: oklch(0.33 0.07 var(--h)); transition: color 1.4s var(--ease); }
  .odp-glow { display: none; }
  .odp-demo[data-v="9"] { background: linear-gradient(to bottom, oklch(0.9 0.012 var(--h)), oklch(0.982 0.009 var(--h)) 70%); }
  .odp-demo[data-v="9"] .odp-glow { display: block; position: absolute; z-index: 0; left: 50%; top: 52%; width: calc(var(--odp-card) * 1.9); aspect-ratio: 1.6; translate: -50% -50%; border-radius: 50%; background: radial-gradient(closest-side, oklch(0.75 0.12 var(--h) / 0.45), transparent); transition: background 1.4s var(--ease); pointer-events: none; }
  @media (max-width: 640px) {
    .odp-demo { --odp-card: 36vw; padding-top: 110px; padding-bottom: 120px; }
    .odp-demo .ob-foot { translate: 0 calc(var(--odp-card) * 0.5); }
    .odp-name { font-size: 15vw; }
    .odp-demo[data-v="10"] { --odp-card: 40vw; }
  }
</style>
