---
// Design preview of ten layouts for the homepage "Good work comes from experience" section.
// Local preview only: in a build this route has no pages. Open http://localhost:4321/ideas/experience/.
// The data (durations, logos, lanes) lives in _experience-data.ts.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import ExpLogo from './_ExpLogo.astro';
import ExperienceSection from '../../components/ExperienceSection.astro';
import { roles, lanes, lane, first, totalYears, years, pct, gpct, longest, shot } from './_experience-data';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Proportional timeline bar'], [2, 'Headline numbers'], [3, 'Expandable roles'],
  [4, 'Vertical rail'], [5, 'Big-type dark band'], [6, 'Logo cards'], [7, 'Logo tabs'],
  [8, 'Moving logo strip'], [9, 'Year grid'], [10, 'Cursor preview'],
] as const;

---
<BaseLayout title="Experience section ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Homepage ideas 1–20', href: '/ideas/' }, { label: 'Compare with the current homepage', href: '/#experience-heading' }]} />

  <div class="wrap xp-page">
    <header class="xp-page-head">
      <span class="tiny-heading">Preview · experience section</span>
      <p>Ten ways to redesign “Good work comes from experience.” The current version is at the top for comparison. Durations are worked out from your real dates; nothing is made up.</p>
      <p>Logos come from each company’s website, shown in one ink colour and sized so they carry the same weight. Tecniqode has no logo file yet, so it shows its name in the display type. Switch to matching wordmarks to compare.</p>
      <div class="xp-switch" role="group" aria-label="Logo style"><button type="button" data-logos="real" aria-pressed="true">Real logos</button><button type="button" data-logos="type" aria-pressed="false">Matching wordmarks</button></div>
    </header>

    <!-- Current -->
    <span class="idea-tag xp-tag-muted"><b>0</b>Live on the homepage</span>
    <div class="xp-current"><ExperienceSection /></div>

    <!-- 1: Proportional timeline bar -->
    <span class="idea-tag" id="idea-1"><b>1</b>{IDEAS[0][1]}<em>bar lengths match the real time in each role; overlaps get a second lane</em></span>
    <section class="xp xp1" aria-labelledby="xp1-h">
      <div class="xp-intro" data-reveal><h2 id="xp1-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div class="xp1-body" data-reveal>
        <div class="xp1-chart" aria-hidden="true" style={`--lanes:${lanes.length}`}>
          <div class="xp1-track">{roles.map((r, i) => <span class="xp1-seg" style={`left:${pct(r.start)}%;width:${pct(r.end) - pct(r.start)}%;--lane:${lane.get(r.company)};--i:${i};${r.style}`}></span>)}</div>
          <div class="xp1-years">{years.filter((y) => y * 12 >= first).map((y) => <span style={`left:${pct(y * 12)}%`}>{y}</span>)}</div>
        </div>
        <ul class="xp-rows">{roles.map((r) => <li style={r.style}><h3 class="xp-logo-cell"><ExpLogo {...r.logo} size={34} /></h3><p><i class="xp-key"></i>{r.role}</p><span class="xp-when"><b>{r.length}</b>{r.dates}</span></li>)}</ul>
      </div>
    </section>

    <!-- 2: Headline numbers -->
    <span class="idea-tag" id="idea-2"><b>2</b>{IDEAS[1][1]}<em>all three numbers come from the dates and summaries</em></span>
    <section class="xp xp2" aria-labelledby="xp2-h">
      <div class="xp-intro" data-reveal>
        <h2 id="xp2-h" data-lines>Good work comes<br />from experience.</h2>
        <a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a>
        <div class="xp2-logos" aria-label="Teams I’ve worked with">{roles.map((r) => <ExpLogo {...r.logo} size={30} />)}</div>
      </div>
      <div data-reveal>
        <dl class="xp2-stats">
          <div><dt>Years building websites</dt><dd class="display">{totalYears}+</dd></div>
          <div><dt>Platforms, every day</dt><dd class="display">3</dd></div>
          <div><dt>Team-lead roles</dt><dd class="display">2</dd></div>
        </dl>
        <ul class="xp-rows">{roles.map((r) => <li><h3 class="xp-logo-cell"><ExpLogo {...r.logo} size={34} /></h3><p>{r.role}</p><span class="xp-when"><b>{r.length}</b>{r.dates}</span></li>)}</ul>
      </div>
    </section>

    <!-- 3: Expandable roles -->
    <span class="idea-tag" id="idea-3"><b>3</b>{IDEAS[2][1]}<em>open a role to see what the work was</em></span>
    <section class="xp xp3" aria-labelledby="xp3-h">
      <div class="xp-intro" data-reveal><h2 id="xp3-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div class="xp3-list" data-reveal>{roles.map((r, i) => (
        <details open={i === 0}>
          <summary><h3 class="xp-logo-cell"><ExpLogo {...r.logo} size={34} /></h3><p>{r.role}</p><span class="xp-when xp3-when"><b>{r.length}</b>{r.dates}</span><i aria-hidden="true"></i></summary>
          <div class="xp3-panel"><div class="xp3-inner">
            {r.summary && <p>{r.summary}</p>}
            <ul>{r.focus.map((f) => <li>{f}</li>)}</ul>
          </div></div>
        </details>
      ))}</div>
    </section>

    <!-- 4: Vertical rail -->
    <span class="idea-tag" id="idea-4"><b>4</b>{IDEAS[3][1]}<em>a classic timeline, newest at the top</em></span>
    <section class="xp xp4" aria-labelledby="xp4-h">
      <div class="xp-intro" data-reveal><h2 id="xp4-h" data-lines>Good work comes<br />from experience.</h2><p class="xp4-sub">{totalYears}+ years across agency, freelance and team-lead work.</p><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <ol class="xp4-rail">{roles.map((r, i) => (
        <li data-reveal style={`--reveal-index:${i};${r.style}`} class:list={{ 'is-latest': i === 0 }}>
          <span class="xp4-year display">{r.startYear}</span>
          <span class="xp4-dot" aria-hidden="true"></span>
          <div class="xp4-card">
            <span class="xp4-dates">{r.dates} · {r.length}</span>
            <h3><ExpLogo {...r.logo} size={34} /></h3>
            <p class="xp4-role">{r.role}</p>
            {r.summary && <p class="xp4-sum">{r.summary}</p>}
            {r.work.length > 0 && <div class="xp4-work">{r.work.map((p) => <a href={withBase(`/work/${p.slug}/`)} title={p.name}><img src={shot(p.slug)} alt={`${p.name} homepage`} width="320" height="180" loading="lazy" /></a>)}</div>}
          </div>
        </li>
      ))}</ol>
    </section>

    <!-- 5: Big-type dark band -->
    <span class="idea-tag" id="idea-5"><b>5</b>{IDEAS[4][1]}<em>hover a name: its logo lights up and the project shots fan out</em></span>
    <section class="xp5" aria-labelledby="xp5-h">
      <div class="xp5-head" data-reveal>
        <h2 id="xp5-h" data-lines>Good work comes<br />from experience.</h2>
        <a href={withBase('/about/')} class="xp5-link">The full story <Arrow diagonal /></a>
      </div>
      <ul class="xp5-list">{roles.map((r, i) => (
        <li data-reveal style={`--reveal-index:${i}`}>
          <span class="xp5-logo"><ExpLogo {...r.logo} size={30} light /></span>
          <h3 class="display">{r.company}</h3>
          {r.work.length > 0 && <div class="xp5-fan" aria-hidden="true">{r.work.slice(0, 3).map((p, j) => <img src={shot(p.slug)} alt="" width="320" height="180" loading="lazy" style={`--j:${j}`} />)}</div>}
          <div class="xp5-meta"><p>{r.role}</p><span>{r.dates}</span><span>{r.length}</span></div>
        </li>
      ))}</ul>
      <p class="xp5-foot">{longest.length} at {longest.company}, {totalYears}+ years in all.</p>
    </section>

    <!-- 6: Logo cards -->
    <span class="idea-tag" id="idea-6"><b>6</b>{IDEAS[5][1]}<em>one tinted card per company; the longest role gets the big card</em></span>
    <section class="xp xp6" aria-labelledby="xp6-h">
      <div class="xp-intro" data-reveal><h2 id="xp6-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div class="xp6-grid">{roles.map((r, i) => (
        <article class:list={['xp6-card', { 'is-big': r === longest }]} style={`--reveal-index:${i};${r.style}`} data-reveal>
          <h3><ExpLogo {...r.logo} size={r === longest ? 38 : 30} /></h3>
          {r === longest && r.work.length > 0 && <div class="xp6-work">{r.work.map((p) => <img src={shot(p.slug)} alt={`${p.name} homepage`} width="320" height="180" loading="lazy" />)}</div>}
          <div class="xp6-foot"><p>{r.role}</p><span>{r.dates}</span><b>{r.length}</b></div>
        </article>
      ))}</div>
    </section>

    <!-- 7: Logo tabs -->
    <span class="idea-tag" id="idea-7"><b>7</b>{IDEAS[6][1]}<em>click a logo to switch roles</em></span>
    <section class="xp xp7" aria-labelledby="xp7-h">
      <div class="xp-intro" data-reveal><h2 id="xp7-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div data-reveal>
        <div class="xp7-tabs" role="tablist" aria-label="Roles">{roles.map((r, i) => <button type="button" role="tab" id={`xp7-tab-${i}`} aria-controls={`xp7-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}><ExpLogo {...r.logo} size={32} /></button>)}</div>
        {roles.map((r, i) => (
          <div class="xp7-panel" role="tabpanel" id={`xp7-panel-${i}`} aria-labelledby={`xp7-tab-${i}`} hidden={i !== 0} style={r.style}>
            <span class="xp7-when">{r.dates} · {r.length}</span>
            <p class="xp7-role">{r.role}</p>
            {r.summary && <p class="xp7-sum">{r.summary}</p>}
            <ul class="xp7-tags">{r.focus.map((f) => <li>{f}</li>)}</ul>
            {r.work.length > 0 && <div class="xp7-work">{r.work.map((p) => <a href={withBase(`/work/${p.slug}/`)} class={`project-canvas ${p.canvas}`}><img src={shot(p.slug)} alt={`${p.name} homepage`} width="320" height="180" loading="lazy" /></a>)}</div>}
          </div>
        ))}
      </div>
    </section>

    <!-- 8: Moving logo strip -->
    <span class="idea-tag" id="idea-8"><b>8</b>{IDEAS[7][1]}<em>logos drift past like the platform strip under the hero</em></span>
    <section class="xp8" aria-labelledby="xp8-h">
      <div class="xp8-head" data-reveal><h2 id="xp8-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div class="xp8-strip" aria-hidden="true"><div class="xp8-track">{[0, 1].map(() => <div class="xp8-group">{[...roles, ...roles].map((r) => <><ExpLogo {...r.logo} size={40} /><i></i></>)}</div>)}</div></div>
      <ul class="xp8-facts">{roles.map((r, i) => <li data-reveal style={`--reveal-index:${i}`}><h3>{r.company}</h3><p>{r.role}</p><span>{r.dates} · {r.length}</span></li>)}</ul>
    </section>

    <!-- 9: Year grid -->
    <span class="idea-tag" id="idea-9"><b>9</b>{IDEAS[8][1]}<em>one row per company, bars on a year-by-year grid</em></span>
    <section class="xp9" aria-labelledby="xp9-h">
      <div class="xp9-head" data-reveal><h2 id="xp9-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div class="xp9-grid" data-reveal style={`--cols:${years.length}`}>
        <div class="xp9-years" aria-hidden="true"><span></span><div>{years.map((y) => <span>{y}</span>)}</div></div>
        {roles.map((r, i) => (
          <div class="xp9-row" style={r.style}>
            <h3 class="xp-logo-cell"><ExpLogo {...r.logo} size={32} /></h3>
            <div class="xp9-lane"><span class:list={['xp9-bar', { 'is-short': r.months < 12 }]} style={`left:${gpct(r.start)}%;width:${gpct(r.end) - gpct(r.start)}%;--i:${i}`}><b>{r.length}</b></span></div>
            <p class="xp9-role">{r.role} <span>{r.dates}</span></p>
          </div>
        ))}
      </div>
    </section>

    <!-- 10: Cursor preview -->
    <span class="idea-tag" id="idea-10"><b>10</b>{IDEAS[9][1]}<em>hover a row: a card follows the cursor</em></span>
    <section class="xp xp10" aria-labelledby="xp10-h">
      <div class="xp-intro" data-reveal><h2 id="xp10-h" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <ul class="xp-rows xp10-list" data-reveal>{roles.map((r) => <li><h3 class="xp-logo-cell"><ExpLogo {...r.logo} size={34} /></h3><p>{r.role}</p><span class="xp-when"><b>{r.length}</b>{r.dates}</span></li>)}</ul>
      <div class="xp10-float" aria-hidden="true">{roles.map((r) => (
        <div class="xp10-card" style={r.style}>
          {r.work.length > 0
            ? <div class="xp10-shots">{r.work.slice(0, 2).map((p) => <img src={shot(p.slug)} alt="" width="320" height="180" />)}</div>
            : <div class="xp10-plain"><ExpLogo {...r.logo} size={40} /></div>}
          <span>{r.work.length > 0 ? `${r.work.length} projects on this site` : r.length}</span>
        </div>
      ))}</div>
    </section>
  </div>
</BaseLayout>

<script>
  // Logo style switch: matching wordmarks or each company's real logo.
  const switches = [...document.querySelectorAll<HTMLButtonElement>('[data-logos]')];
  switches.forEach((button) => button.addEventListener('click', () => {
    document.documentElement.classList.toggle('xp-type', button.dataset.logos === 'type');
    switches.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
  }));

  // 3: roles open and close smoothly (height and fade), instead of jumping.
  const easing = 'cubic-bezier(0.22, 1, 0.36, 1)';
  document.querySelectorAll<HTMLDetailsElement>('.xp3-list details').forEach((details) => {
    const summary = details.querySelector('summary')!;
    const panel = details.querySelector<HTMLElement>('.xp3-panel')!;
    const inner = details.querySelector<HTMLElement>('.xp3-inner')!;
    let running: Animation | undefined;
    summary.addEventListener('click', (e) => {
      if (!document.documentElement.classList.contains('motion')) return;
      e.preventDefault();
      const from = panel.getBoundingClientRect().height;
      running?.cancel();
      const closing = details.open && !details.classList.contains('is-closing');
      if (closing) {
        details.classList.add('is-closing');
        running = panel.animate([{ height: `${from}px` }, { height: '0px' }], { duration: 450, easing });
        inner.animate([{ opacity: 1 }, { opacity: 0, transform: 'translateY(-6px)' }], { duration: 300, easing, fill: 'forwards' });
        running.onfinish = () => { details.open = false; details.classList.remove('is-closing'); inner.getAnimations().forEach((a) => a.cancel()); };
      } else {
        details.classList.remove('is-closing');
        details.open = true;
        inner.getAnimations().forEach((a) => a.cancel());
        const to = inner.offsetHeight;
        running = panel.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 550, easing });
        inner.animate([{ opacity: 0, transform: 'translateY(-8px)' }, { opacity: 1, transform: 'none' }], { duration: 500, delay: 80, easing, fill: 'backwards' });
      }
    });
  });

  // 7: logo tabs.
  document.querySelectorAll<HTMLElement>('.xp7').forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (index: number) => {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = (i + step + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    });
    select(0);
  });

  // 10: a card that follows the cursor over the role rows (mouse and trackpad only).
  const list = document.querySelector<HTMLElement>('.xp10-list');
  const float = document.querySelector<HTMLElement>('.xp10-float');
  if (list && float && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const cards = [...float.querySelectorAll<HTMLElement>('.xp10-card')];
    list.addEventListener('pointermove', (e) => { float.style.translate = `${e.clientX}px ${e.clientY}px`; });
    list.querySelectorAll('li').forEach((row, i) => row.addEventListener('pointerenter', () => {
      cards.forEach((card, j) => card.classList.toggle('is-active', i === j));
      float.classList.add('is-on');
    }));
    list.addEventListener('pointerleave', () => float.classList.remove('is-on'));
    addEventListener('scroll', () => float.classList.remove('is-on'), { passive: true });
  }
</script>

<style>
  .xp-page { padding-top: 140px; }
  .xp-page-head { max-width: 640px; margin-bottom: 70px; }
  .xp-page-head p { margin-top: 12px; color: var(--muted); font-size: 15px; line-height: 1.55; }
  .xp-page-head code { font-size: 13px; color: var(--ink); }
  .xp-switch { display: inline-flex; margin-top: 20px; padding: 3px; border-radius: 99px; background: var(--surface); }
  .xp-switch button { padding: 8px 16px; border: 0; border-radius: 99px; background: none; font: 500 13px Archivo, sans-serif; color: var(--muted); cursor: pointer; }
  .xp-switch button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .xp-tag-muted { background: var(--surface); }
  .xp-current { margin-bottom: 120px; }

  .xp { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 140px; }
  .xp-intro h2, .xp5-head h2, .xp8-head h2, .xp9-head h2 { font-weight: 500; letter-spacing: -0.03em; font-size: clamp(27px, 2.5vw, 36px); line-height: 1.2; }
  .xp-intro > .text-link { margin-top: 27px; }
  .xp h3 { font-size: 16px; font-weight: 500; }

  /* Shared rows: a fixed logo column so every logo lines up on the same left edge and centre line. */
  .xp-logo-cell { display: flex; align-items: center; min-height: 34px; }
  .xp-rows { list-style: none; padding: 0; margin: 0; }
  .xp-rows li { display: grid; grid-template-columns: 150px 1fr auto; gap: 20px; align-items: center; border-top: 1px solid var(--line); padding-block: 18px; }
  .xp-rows p { font-size: 12px; color: var(--muted); }
  .xp-when { text-align: right; font-size: 10px; color: var(--muted); white-space: nowrap; }
  .xp-when b { display: block; font-size: 14px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .xp-key { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; background: oklch(0.58 0.07 var(--hue)); }

  /* 1 */
  .xp1-chart { position: relative; padding-bottom: 34px; margin-bottom: 18px; }
  .xp1-track { position: relative; height: calc(var(--lanes) * 18px - 4px); }
  .xp1-track::before { content: ''; position: absolute; inset: 0 0 auto; height: 14px; border-radius: 99px; background: var(--surface); }
  .xp1-seg { position: absolute; top: calc(var(--lane) * 18px); height: 14px; border-radius: 99px; background: oklch(0.58 0.07 var(--hue)); box-shadow: 0 0 0 2px var(--bg); transform-origin: left; transition: transform 1.1s var(--ease) calc(var(--i) * 0.12s + 0.2s); }
  :global(.motion) .xp1-body:not(:global(.is-in)) .xp1-seg { transform: scaleX(0); }
  .xp1-years span { position: absolute; top: calc(var(--lanes) * 18px + 10px); font-size: 10px; color: var(--muted); translate: -50% 0; }
  .xp1-years span::before { content: ''; position: absolute; left: 50%; top: -9px; width: 1px; height: 5px; background: var(--line); }

  /* 2 */
  .xp2-logos { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 30px; margin-top: 48px; max-width: 380px; }
  .xp2-logos > :global(.xp-logo) { opacity: 0.55; transition: opacity 0.3s; }
  .xp2-logos > :global(.xp-logo:hover) { opacity: 1; }
  .xp2-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 0 34px; border-top: 1px solid var(--ink); }
  .xp2-stats > div { padding: 16px 16px 0 0; }
  .xp2-stats > div + div { padding-left: 16px; border-left: 1px solid var(--line); }
  .xp2-stats dt { font-size: 11px; color: var(--muted); }
  .xp2-stats dd { margin: 10px 0 0; font-size: clamp(64px, 7vw, 112px); }

  /* 3 */
  .xp3 .xp-intro { position: sticky; top: 110px; align-self: start; }
  .xp3-list details { border-top: 1px solid var(--line); }
  .xp3-list details:last-child { border-bottom: 1px solid var(--line); }
  .xp3-list summary { display: grid; grid-template-columns: 150px 1fr auto 18px; gap: 20px; align-items: center; padding-block: 18px; cursor: pointer; list-style: none; }
  .xp3-list summary::-webkit-details-marker { display: none; }
  .xp3-list summary p { font-size: 12px; color: var(--muted); }
  .xp3-list summary i { position: relative; width: 14px; height: 14px; }
  .xp3-list summary i::before, .xp3-list summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--ink); transition: transform 0.35s var(--ease); }
  .xp3-list summary i::after { transform: rotate(90deg); }
  .xp3-list details[open]:not(.is-closing) summary i::after { transform: rotate(0); }
  .xp3-list summary h3 { transition: transform 0.45s var(--ease); }
  .xp3-list summary:hover h3, .xp3-list details[open]:not(.is-closing) summary h3 { transform: translateX(6px); }
  .xp3-list summary p { transition: color 0.3s; }
  .xp3-list summary:hover p, .xp3-list details[open]:not(.is-closing) summary p { color: var(--ink); }
  .xp3-panel { overflow: hidden; }
