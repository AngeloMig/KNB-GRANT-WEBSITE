---
// Design preview: 20 ideas for the orbit's dotted ring. Local preview only: in a build this route
// has no pages. Open http://localhost:4321/ideas/orbit-dots/. Each ring uses the hero's geometry
// (a ring of dots under the cards, in perspective) on its own working orbit.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import ProjectOrbit from '../../components/ProjectOrbit.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Comet trail'], [2, 'Dashes that stretch with speed'], [3, 'Countdown arc'], [4, 'A marker per project'], [5, 'Coloured segments'],
  [6, 'Pulse on arrival'], [7, 'Two rings, turning apart'], [8, 'Magnetic to the cursor'], [9, 'Breathing dots'], [10, 'Lights up with speed'],
  [11, 'Numbers on the ring'], [12, 'Watch-bezel ticks'], [13, 'Sparks from the front'], [14, 'Glowing halo'], [15, 'Card shadows on the ring'],
  [16, 'A line, with dots only in front'], [17, 'Colour all the way round'], [18, 'Tap for a ripple'], [19, 'Satellites'], [20, 'Cleaner depth'],
] as const;
const NOTES: Record<number, [string, string]> = {
  1: ['turn it', 'The lit dots leave a fading tail behind the front as the ring turns.'],
  2: ['drag it fast', 'At rest the ring is dots; while it turns they stretch into short dashes, like motion blur.'],
  3: ['watch it fill', 'The arc under the front card fills in the project colour until the orbit turns to the next one.'],
  4: ['', 'A bigger dot at each card’s foot, in that project’s colour, turning with the cards.'],
  5: ['', 'The ring is split into six arcs, one per project, each in its colour; the front one brightest.'],
  6: ['change project', 'When a project arrives, a pulse runs round the ring from the front in both directions.'],
  7: ['', 'An inner ring turns the other way, slower, for a sense of machinery.'],
  8: ['move over the ring', 'The dots near the cursor are drawn towards it and light up.'],
  9: ['', 'The dots slowly grow and shrink in a wave travelling round the ring.'],
  10: ['drag it', 'Calm and faint at rest; the faster it turns, the brighter and bigger the dots.'],
  11: ['', 'Small numbers 01 to 06 sit on the ring at each card, the front one in its colour.'],
  12: ['', 'Short ticks instead of dots, like the bezel of a watch, longer at each card.'],
  13: ['change project', 'Tiny sparks fly off the front of the ring as a new project arrives.'],
  14: ['', 'A soft glowing halo in the project colour runs under the dots.'],
  15: ['', 'Each card darkens the dots under it, like a shadow on the floor.'],
  16: ['', 'A thin solid line for the ring, with dots only in the lit arc under the front card.'],
  17: ['', 'The dots run through all six project colours round the ring.'],
  18: ['tap or click the floor', 'Tapping near the ring sends a ripple of light round it from that spot.'],
  19: ['', 'A few bright dots orbit faster than the ring, like satellites, leaving short trails.'],
  20: ['', 'True depth: the dots behind the cards shrink and fade away, so only the front arc is crisp.'],
};
---
<BaseLayout title="Orbit dots ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current homepage', href: '/' }, { label: 'Orbit floor ideas', href: '/ideas/orbit-floor/' }]} />
  <div class="wrap od-page">
    <header class="od-head">
      <span class="tiny-heading">Preview · the orbit’s dotted ring</span>
      <h1 class="display">Twenty rings<br />of dots</h1>
      <p>Each ring uses the hero’s geometry, on its own working orbit: drag it, use the arrows, or wait for it to turn. Several can be combined.</p>
    </header>
    {IDEAS.map(([n, name]) => (
      <section class="od" id={`idea-${n}`}>
        <div class="od-top"><span class="idea-tag"><b>{n}</b>{name}{NOTES[n][0] && <em>{NOTES[n][0]}</em>}</span><p class="od-why">{NOTES[n][1]}</p></div>
        <div class="od-demo" data-v={n}><canvas class="od-track" aria-hidden="true"></canvas><ProjectOrbit card="var(--od-card)" /></div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import { Orbit } from './_orbit-demo';
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const ink = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#161616';
  const TAU = Math.PI * 2;
  const wrap = (deg: number) => ((((deg % 360) + 540) % 360) - 180);

  document.querySelectorAll<HTMLElement>('.od-demo').forEach((box) => {
    const v = Number(box.dataset.v);
    const cv = box.querySelector<HTMLCanvasElement>('.od-track')!, c = cv.getContext('2d')!;
    const ob = box.querySelector<HTMLElement>('.ob')!;
    let hue = 245, burst = -1e9, mx = -1e4, my = -1e4, tap = { at: -1e9, deg: 0 };
    const sparks: { x: number; y: number; vx: number; vy: number; life: number }[] = [];
    const orbit = new Orbit(ob, { onFront: (card) => { hue = Number(card.dataset.hue); box.style.setProperty('--h', String(hue)); burst = performance.now(); } });
    const hues = orbit.cards.map((card) => Number(card.dataset.hue));
    let W = 0, H = 0, cx = 0, horizon = 0, floor = 0, R = 0, on = false, lastRot = 0, speed = 0;
    const P = 1800, N = 150;
    const pull = Array.from({ length: N }, () => ({ x: 0, y: 0 }));
    const size = () => {
      const b = box.getBoundingClientRect(), card = ob.querySelector<HTMLElement>('.ob-card')!, ring = ob.querySelector<HTMLElement>('.ob-ring')!.getBoundingClientRect();
      W = Math.floor(b.width); H = Math.floor(b.height); R = card.offsetWidth * 1.05;
      const dpr = Math.min(2, devicePixelRatio || 1); cv.width = W * dpr; cv.height = H * dpr; c.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = ring.left - b.left + ring.width / 2; horizon = ring.top - b.top + ring.height / 2; floor = ring.top - b.top + card.offsetHeight + 16;
    };
    requestAnimationFrame(size); addEventListener('resize', size);
    new IntersectionObserver(([e]) => { on = e.isIntersecting; }).observe(box);
    // A point on the ring at an angle from the front (degrees), in perspective.
    const at = (deg: number, r = R) => { const a = (deg * Math.PI) / 180, k = P / (P - (Math.cos(a) * r - r)); return { x: cx + Math.sin(a) * r * k, y: horizon + (floor - horizon) * k * (r / R), k }; };
    if (fine) { box.addEventListener('pointermove', (e) => { const b = box.getBoundingClientRect(); mx = e.clientX - b.left; my = e.clientY - b.top; }); box.addEventListener('pointerleave', () => { mx = my = -1e4; }); }
    // 18: a tap on the floor starts a ripple from the nearest point of the ring.
    box.addEventListener('pointerdown', (e) => {
      if (v !== 18 || (e.target as HTMLElement).closest('.ob-card, .ob-arrow, a')) return;
      const b = box.getBoundingClientRect(), x = e.clientX - b.left;
      tap = { at: performance.now(), deg: (Math.asin(Math.max(-1, Math.min(1, (x - cx) / R))) * 180) / Math.PI };
    });

    const draw = (t: number) => {
      requestAnimationFrame(draw);
      if (!on || !W) return;
      const rot = orbit.rot;
      speed = speed * 0.85 + Math.abs(rot - lastRot) * 0.15; lastRot = rot;
      c.clearRect(0, 0, W, H);
      const lit = `oklch(0.58 0.15 ${hue})`;
      const dot = (x: number, y: number, r: number, color: string, alpha = 1) => { c.globalAlpha = Math.max(0, Math.min(1, alpha)); c.fillStyle = color; c.beginPath(); c.arc(x, y, Math.max(0.3, r), 0, TAU); c.fill(); };
      const depthA = (k: number) => Math.min(0.85, 0.25 + 0.7 * (k - 0.6));
      const since = (t - burst) / 1000;

      // Rings drawn as a line rather than dots (14 halo, 16 line).
      if (v === 14 || v === 16) {
        c.globalAlpha = 1; c.beginPath();
        for (let i = 0; i <= 120; i++) { const p = at((i / 120) * 360); i ? c.lineTo(p.x, p.y) : c.moveTo(p.x, p.y); }
        if (v === 14) { c.save(); c.shadowColor = `oklch(0.7 0.15 ${hue} / 0.9)`; c.shadowBlur = 24; c.strokeStyle = `oklch(0.75 0.13 ${hue} / 0.55)`; c.lineWidth = 6; c.stroke(); c.restore(); }
        else { c.strokeStyle = 'oklch(0.16 0 0 / 0.22)'; c.lineWidth = 1.2; c.stroke(); }
      }
      // 7: the inner ring, turning the other way.
      if (v === 7) for (let i = 0; i < 110; i++) { const deg = (i / 110) * 360 - rot * 0.6; const p = at(wrap(deg), R * 0.78); dot(p.x, p.y, 1.3 * p.k ** 1.4, ink, depthA(p.k) * 0.6); }

      for (let i = 0; i < N; i++) {
        const ringDeg = (i / N) * 360 + rot, d = wrap(ringDeg), p = at(d);
        let { x, y } = p; const k = p.k;
        let r = 2 * k ** 1.5, color = ink, a = depthA(k);
        const near = Math.abs(d) < 22;
        if (near) { r = 3.4 * k ** 1.5; color = lit; a = 1; }
        switch (v) {
          case 1: { const dir = Math.sign(orbit.tween ? orbit.tween.to - rot : 0) || 1, behind = -d * dir; if (behind > 0 && behind < 70) { const f = 1 - behind / 70; r = Math.max(r, 3.2 * f * k ** 1.5); color = lit; a = Math.max(a, f); } break; }
          case 2: { if (speed > 0.15) { const len = Math.min(14, speed * 4) * k; const a2 = (d * Math.PI) / 180; c.globalAlpha = a; c.strokeStyle = color; c.lineWidth = r * 1.4; c.lineCap = 'round'; c.beginPath(); c.moveTo(x - Math.cos(a2) * len, y); c.lineTo(x + Math.cos(a2) * len, y); c.stroke(); continue; } break; }
          case 3: { const prog = orbit.progress(); if (near) { const f = (d + 22) / 44; color = f <= prog ? lit : ink; a = f <= prog ? 1 : 0.35; } break; }
          case 4: { r *= 0.8; break; }
          case 5: { const seg = ((Math.round(-wrap(ringDeg - rot) / 60) % 6) + 6) % 6; const idx = orbit.cards.findIndex((_, j) => Math.abs(wrap(orbit.angles[j] - (ringDeg - rot))) <= 30); color = `oklch(${near ? 0.58 : 0.7} 0.13 ${hues[idx >= 0 ? idx : seg]})`; a = near ? 1 : a * 0.9; break; }
          case 6: { const front = since * 260; const w = Math.exp(-((Math.abs(d) - front) ** 2) / 120) * Math.max(0, 1 - since / 1.6); if (w > 0.05) { r = Math.max(r, (2 + 3 * w) * k ** 1.5); color = lit; a = Math.max(a, w); } break; }
          case 8: { const o = pull[i], dx = mx - (x + o.x), dy = my - (y + o.y), dist = Math.hypot(dx, dy); const f = dist < 110 ? (1 - dist / 110) : 0; o.x += (dx * f * 0.35 - o.x) * 0.15; o.y += (dy * f * 0.35 - o.y) * 0.15; x += o.x; y += o.y; if (f > 0.1) { color = lit; a = Math.max(a, f + 0.3); r = Math.max(r, 3 * k); } break; }
          case 9: { r *= 1 + 0.6 * Math.sin((ringDeg * 3 * Math.PI) / 180 - t / 500); break; }
          case 10: { const s = Math.min(1, speed / 1.5); if (!near) { r *= 0.8 + s * 0.8; a = a * (0.35 + s); if (s > 0.3) color = lit; } break; }
          case 12: { const major = orbit.angles.some((ang) => Math.abs(wrap(ang + rot - d)) < 1.3); const len = (major ? 12 : 5) * k; c.globalAlpha = near ? 1 : a; c.strokeStyle = near ? lit : ink; c.lineWidth = (major ? 2 : 1.2) * k; c.beginPath(); c.moveTo(x, y - len / 2); c.lineTo(x, y + len / 2); c.stroke(); continue; }
          case 15: { orbit.cards.forEach((card, j) => { const off = Math.abs(wrap(orbit.angles[j] + rot - d)); if (off < 26) { const o = Number(card.style.opacity || 1) * (1 - off / 26); if (!near) { a = Math.max(a, 0.9 * o); r *= 1 + 0.5 * o; } } }); break; }
          case 16: { if (!near) continue; break; }
          case 17: { const h = (((ringDeg % 360) + 360) % 360); const seg = Math.floor(h / 60), f = (h % 60) / 60; const h1 = hues[seg % 6], h2 = hues[(seg + 1) % 6]; const dh = ((h2 - h1 + 540) % 360) - 180; color = `oklch(${near ? 0.56 : 0.68} 0.14 ${(h1 + dh * f + 360) % 360})`; a = near ? 1 : Math.max(a, 0.55); break; }
          case 18: { const s2 = (t - tap.at) / 1000, w = Math.exp(-((Math.abs(wrap(d - tap.deg)) - s2 * 240) ** 2) / 100) * Math.max(0, 1 - s2 / 1.5); if (w > 0.05) { r = Math.max(r, (2 + 3.5 * w) * k ** 1.5); color = lit; a = Math.max(a, w); } break; }
          case 20: { if (k < 0.86) { a *= Math.max(0, (k - 0.7) / 0.16) * 0.5; r *= 0.7; } break; }
        }
        dot(x, y, r, color, a);
      }

      // 4: a marker at each card's foot, in its colour.
      if (v === 4) orbit.cards.forEach((card, j) => { const d = wrap(orbit.angles[j] + rot); const p = at(d); dot(p.x, p.y, (Math.abs(d) < 10 ? 6.5 : 4.5) * p.k ** 1.5, `oklch(0.58 0.15 ${hues[j]})`, Number(card.style.opacity || 1)); });
      // 11: numbers at each card.
      if (v === 11) orbit.cards.forEach((card, j) => { const d = wrap(orbit.angles[j] + rot); const p = at(d); const front = Math.abs(d) < 10; c.globalAlpha = Math.max(0, Number(card.style.opacity || 1)) * (front ? 1 : 0.6); c.fillStyle = front ? lit : ink; c.font = `${front ? 600 : 500} ${Math.round((front ? 15 : 11) * p.k)}px Archivo, sans-serif`; c.textAlign = 'center'; c.fillText(String(j + 1).padStart(2, '0'), p.x, p.y + 22 * p.k); });
      // 13: sparks from the front as a project arrives.
      if (v === 13) {
        if (since < 0.25) for (let s = 0; s < 3; s++) { const f = at((Math.random() - 0.5) * 30); sparks.push({ x: f.x, y: f.y, vx: (Math.random() - 0.5) * 5, vy: -1.5 - Math.random() * 3.5, life: 1 }); }
        for (let s = sparks.length - 1; s >= 0; s--) { const sp = sparks[s]; sp.x += sp.vx; sp.y += sp.vy; sp.vy += 0.15; sp.life -= 0.022; if (sp.life <= 0) { sparks.splice(s, 1); continue; } dot(sp.x, sp.y, 2.2 * sp.life, lit, sp.life); }
      }
      // 19: satellites, each with a short trail.
      if (v === 19) for (let s = 0; s < 3; s++) { const base = t * (0.03 + s * 0.017) + s * 120; for (let tr = 0; tr < 10; tr++) { const p = at(wrap(base - tr * 2.2)); dot(p.x, p.y, (3.4 - tr * 0.28) * p.k ** 1.4, lit, (1 - tr / 10) * Math.min(1, p.k)); } }
      c.globalAlpha = 1;
    };
    requestAnimationFrame(draw);
  });
</script>

<style is:global>
  .od-page { padding-bottom: 160px; }
  .od-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .od-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .od-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .od { padding-block: 48px; border-top: 1px solid var(--line); }
  .od-top { display: grid; gap: 4px; margin-bottom: 22px; }
  .od-why { max-width: 700px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .od-demo { --h: 245; --od-card: clamp(230px, 30vw, 440px); position: relative; padding: 56px 0 40px; border-radius: 28px; overflow: hidden; background: oklch(0.982 0.009 var(--h)); transition: background-color 1.4s var(--ease); isolation: isolate; }
  .od-track { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .od-demo .ob { z-index: 1; }
  .od-demo .ob-caption strong { color: oklch(0.33 0.07 var(--h)); transition: color 1.4s var(--ease); }
</style>
