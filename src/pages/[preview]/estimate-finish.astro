---
// Design preview: 10 calm "finish" moments for the estimator, for when someone reaches their brief.
// Local preview only: in a build this route has no pages. Open http://localhost:4321/ideas/estimate-finish/.
// Each idea plays in a copy of the estimate card (example numbers), with a Replay button.
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Odometer roll'], [2, 'Weeks cascade and flag'], [3, 'The timeline draws itself'], [4, 'A quiet stamp'], [5, 'Built from dots'],
  [6, 'Sealed like a letter'], [7, 'Calendar flip to launch'], [8, 'The ring closes'], [9, 'One soft breath'], [10, 'Typed out, then signed'],
] as const;
const NOTES: Record<number, string> = {
  1: 'Each digit rolls up like a car’s odometer and settles on the estimate, one after another.',
  2: 'The week squares drop in one by one from kick-off, then the launch flag raises on the last one.',
  3: 'A line runs from kick-off to launch, colouring each phase as it passes, and the number follows it in.',
  4: 'A round “Estimate ready” stamp presses in once, with a slight ink spread, then the numbers appear under it.',
  5: 'The number gathers from scattered dots, the same way the page titles build across the site.',
  6: 'The brief folds into an envelope, the flap closes and a tick seals it: ready to send.',
  7: 'A small calendar flips month by month from today to the launch window, then rests on it.',
  8: 'The progress ring of the questions closes into a full circle, a tick draws in, then it opens into the estimate.',
  9: 'The card takes one slow breath: a soft glow in the project colour and a light sweep across the number.',
  10: 'The brief types itself out line by line, then the estimate lands at the bottom like a signature.',
};
const cells = ['discovery', 'design', 'design', 'design', 'build', 'build', 'build', 'build', 'content', 'qa', 'maybe', 'maybe', 'maybe'];
const briefLines = ['Project: A new website or store', 'Platform: Shopify', 'Products: 50–500', 'Store features: Subscriptions, Bundles', 'Design: I need a designer too'];
---
<BaseLayout title="Estimate finish ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Open the estimator', href: '/estimate/' }]} />
  <div class="wrap ef-page">
    <header class="ef-head">
      <span class="tiny-heading">Preview · the estimator’s finish</span>
      <h1 class="display">Ten calm<br />finishes</h1>
      <p>What could happen when someone answers the last question and their estimate is complete. Satisfying, never noisy: no confetti. Each plays when it scrolls into view; press Replay to see it again. The numbers are an example.</p>
    </header>
    {IDEAS.map(([n, name]) => (
      <section class="ef" id={`idea-${n}`}>
        <div class="ef-top"><span class="idea-tag"><b>{n}</b>{name}</span><p class="ef-why">{NOTES[n]}</p></div>
        <div class="ef-stage">
          <div class="ef-card" data-v={n}>
            {n === 4 && <span class="ef-stamp" aria-hidden="true"><span>Estimate<br />ready</span></span>}
            {n === 6 && (
              <div class="ef-letter" aria-hidden="true">
                <div class="ef-paper">{briefLines.slice(0, 3).map((l) => <i>{l}</i>)}</div>
                <span class="ef-env"><span class="ef-flap"></span></span>
                <span class="ef-seal"><svg viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7" /></svg></span>
                <p class="ef-letter-note">Your brief is ready to send</p>
              </div>
            )}
            {n === 7 && (
              <div class="ef-cal" aria-hidden="true"><span class="ef-cal-top"></span><span class="ef-cal-month">Nov</span><span class="ef-cal-year">2026</span></div>
            )}
            {n === 8 && (
              <span class="ef-ring" aria-hidden="true"><svg viewBox="0 0 120 120"><circle class="ef-ring-track" cx="60" cy="60" r="52" /><circle class="ef-ring-bar" cx="60" cy="60" r="52" pathLength="100" /><path class="ef-ring-tick" d="M42 61 54 73 79 47" pathLength="100" /></svg></span>
            )}
            {n === 10 && <div class="ef-type" aria-hidden="true">{briefLines.map((l) => <p data-text={l}></p>)}</div>}
            <div class="ef-result">
              <p class="ef-eyebrow">Your rough estimate</p>
              {n === 5 ? <canvas class="ef-dots" aria-label="8 to 13 weeks"></canvas> : <p class="ef-num" aria-label="8 to 13 weeks"><span class="ef-num-text">8–13</span></p>}
              <p class="ef-unit">weeks</p>
              <p class="ef-months">{n === 7 ? <span class="ef-window"></span> : 'About 2–3 months'}</p>
            </div>
            {n === 3 && (
              <div class="ef-line" aria-hidden="true"><span class="ef-line-track"><i class="phase-discovery" style="flex-grow:1"></i><i class="phase-design" style="flex-grow:3"></i><i class="phase-build" style="flex-grow:4"></i><i class="phase-content" style="flex-grow:0.5"></i><i class="phase-qa" style="flex-grow:1"></i></span><span class="ef-runner"></span><span class="ef-line-labels"><span>Kick-off</span><span class="ef-line-launch">Launch · week 13</span></span></div>
            )}
            {(n === 2 || n === 9 || n === 1) && (
              <div class="ef-weeks" aria-hidden="true">{cells.map((c, i) => <span class:list={['ef-wk', c === 'maybe' ? 'is-maybe' : `phase-${c}`, { 'is-launch': i === cells.length - 1 }]} style={`--i:${i}`}></span>)}</div>
            )}
            {n === 10 && <p class="ef-sign" aria-hidden="true">Rough estimate: 8–13 weeks</p>}
          </div>
          <button type="button" class="ef-replay">Replay ↻</button>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const restart = (el: HTMLElement) => { el.classList.remove('is-playing'); void el.offsetWidth; el.classList.add('is-playing'); };

  // 1 · Odometer: each character becomes a column of digits that rolls to its value.
  const odometer = (card: HTMLElement) => {
    const holder = card.querySelector<HTMLElement>('.ef-num-text')!;
    const text = '8–13';
    // Each column is as wide as the character it lands on (a column of all ten digits is as wide as the widest).
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;white-space:pre';
    holder.parentElement!.append(probe);
    const widthOf = (ch: string) => { probe.textContent = ch; return probe.getBoundingClientRect().width; };
    holder.replaceChildren(...[...text].map((ch, i) => {
      const col = document.createElement('span');
      col.className = 'ef-odo';
      if (!/\d/.test(ch)) { col.textContent = ch; col.classList.add('is-static'); col.style.setProperty('--i', String(i)); return col; }
      const strip = document.createElement('span');
      strip.className = 'ef-odo-strip';
      strip.textContent = '0123456789'.split('').join('\n') + '\n' + ch;
      strip.style.setProperty('--d', String(i));
      col.style.setProperty('--w', `${widthOf(ch)}px`);
      col.append(strip);
      return col;
    }));
    probe.remove();
  };

  // 5 · Dots: the number gathers from scattered dots.
  const dotsPlay = (card: HTMLElement) => {
    const cv = card.querySelector<HTMLCanvasElement>('.ef-dots')!;
    const ctx = cv.getContext('2d')!;
    const W = cv.clientWidth, H = cv.clientHeight, dpr = Math.min(2, devicePixelRatio || 1);
    cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const off = document.createElement('canvas'); off.width = W; off.height = H;
    const o = off.getContext('2d')!;
    o.font = `800 ${H * 0.95}px "Big Shoulders Display"`; o.textBaseline = 'alphabetic'; o.fillText('8–13', 0, H * 0.88);
    const data = o.getImageData(0, 0, W, H).data;
    const gap = 4, dots: { x: number; y: number; sx: number; sy: number; d: number }[] = [];
    for (let y = gap / 2; y < H; y += gap) for (let x = gap / 2; x < W; x += gap) if (data[((y | 0) * W + (x | 0)) * 4 + 3] > 128) dots.push({ x, y, sx: Math.random() * W, sy: Math.random() * H * 1.6 - H * 0.3, d: Math.random() * 500 });
    const ink = getComputedStyle(card).color;
    const start = performance.now();
    const ease = (t: number) => 1 - (1 - t) ** 3;
    const frame = (now: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = ink;
      let done = true;
      for (const p of dots) {
        const t = Math.min(1, Math.max(0, (now - start - p.d) / 1100));
        if (t < 1) done = false;
        const e = ease(t);
        ctx.beginPath(); ctx.arc(p.sx + (p.x - p.sx) * e, p.sy + (p.y - p.sy) * e, 1.5, 0, 6.283); ctx.fill();
      }
      if (!done && !reduce) requestAnimationFrame(frame);
    };
    requestAnimationFrame(reduce ? () => frame(start + 99999) : frame);
  };

  // 7 · Calendar: flips month by month from now to the launch window (8–13 weeks away).
  const calendar = (card: HTMLElement) => {
    const month = card.querySelector<HTMLElement>('.ef-cal-month')!, year = card.querySelector<HTMLElement>('.ef-cal-year')!;
    const now = new Date();
    const add = (w: number) => new Date(now.getTime() + w * 7 * 864e5);
    const end = add(13), startWin = add(8);
    const fmt = (d: Date) => d.toLocaleDateString('en', { month: 'short' });
    card.querySelector('.ef-window')!.textContent = `Launch around ${startWin.toLocaleDateString('en', { month: 'long' })}–${end.toLocaleDateString('en', { month: 'long', year: 'numeric' })}`;
    const months: Date[] = [];
    for (let d = new Date(now.getFullYear(), now.getMonth(), 1); d <= end; d = new Date(d.getFullYear(), d.getMonth() + 1, 1)) months.push(d);
    const cal = card.querySelector<HTMLElement>('.ef-cal')!;
    months.forEach((d, i) => setTimeout(() => {
      month.textContent = fmt(d); year.textContent = String(d.getFullYear());
      cal.classList.remove('is-flip'); void cal.offsetWidth; cal.classList.add('is-flip');
      if (i === months.length - 1) cal.classList.add('is-there');
    }, reduce ? 0 : 200 + i * 380));
    cal.classList.remove('is-there');
  };

  // 10 · Typewriter: each brief line types out, then the estimate signs off at the bottom.
  const typewriter = (card: HTMLElement) => {
    const lines = [...card.querySelectorAll<HTMLElement>('.ef-type p')];
    lines.forEach((p) => { p.textContent = ''; });
    let delay = 150;
    lines.forEach((p) => {
      const text = p.dataset.text!;
      [...text].forEach((_, i) => setTimeout(() => { p.textContent = text.slice(0, i + 1); }, reduce ? 0 : delay + i * 14));
      delay += text.length * 14 + 120;
    });
    card.style.setProperty('--sign-delay', `${reduce ? 0 : delay}ms`);
  };

  const play = (card: HTMLElement) => {
    const v = Number(card.dataset.v);
    if (v === 1) odometer(card);
    if (v === 5) dotsPlay(card);
    if (v === 7) calendar(card);
    if (v === 10) typewriter(card);
    restart(card);
  };
  document.querySelectorAll<HTMLElement>('.ef-card').forEach((card) => {
    let played = false;
    new IntersectionObserver(([e]) => { if (e.isIntersecting && !played) { played = true; play(card); } }, { threshold: 0.5 }).observe(card);
    card.parentElement!.querySelector('.ef-replay')!.addEventListener('click', () => play(card));
  });
  // Fonts first, so the dots and odometer measure the real typeface.
  document.fonts?.load('800 80px "Big Shoulders Display"');
</script>

<style is:global>
  .ef-page { padding-bottom: 160px; }
  .ef-head { display: grid; gap: 18px; max-width: 820px; padding-block: 24px 40px; }
  .ef-head h1 { margin: 0; font-size: clamp(56px, 8vw, 130px); }
  .ef-head p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .ef { padding-block: 44px; border-top: 1px solid var(--line); }
  .ef-top { display: grid; gap: 4px; margin-bottom: 22px; }
  .ef-why { max-width: 700px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .ef-stage { display: grid; grid-template-columns: minmax(0, 420px) auto; justify-content: start; align-items: end; gap: 24px; }
  .ef-replay { padding: 10px 16px; border: 1px solid var(--ink); border-radius: 999px; background: none; color: var(--ink); font-size: 13px; cursor: pointer; }
  .ef-card { position: relative; display: grid; gap: 18px; min-height: 320px; padding: 30px; border-radius: 22px; background: var(--surface); color: var(--ink); overflow: hidden; }
  .ef-eyebrow { margin: 0; font-size: 12px; font-weight: 600; text-transform: uppercase; }
  .ef-result { display: grid; grid-template-columns: auto 1fr; align-items: end; column-gap: 10px; }
  .ef-result .ef-eyebrow { grid-column: 1 / -1; margin-bottom: 12px; }
  .ef-num { margin: 0; font-family: "Big Shoulders Display", Impact, sans-serif; font-weight: 800; font-size: 104px; line-height: 0.88; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .ef-unit { margin: 0 0 8px; font-size: 18px; font-weight: 500; }
  .ef-months { grid-column: 1 / -1; margin: 8px 0 0; font-size: 15px; font-weight: 500; color: var(--muted); }
  .ef-weeks { display: grid; grid-template-columns: repeat(10, 22px); gap: 5px; }
  .ef-wk { position: relative; aspect-ratio: 1; border-radius: 5px; }
  .ef-wk.is-maybe { background: repeating-linear-gradient(135deg, color-mix(in oklch, var(--ink) 22%, transparent) 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--ink) 18%, transparent); }
  .ef-wk.is-launch::after { content: ""; position: absolute; left: 34%; top: 18%; bottom: 18%; width: 2px; background: var(--ink); }
  .ef-wk.is-launch::before { content: ""; position: absolute; left: calc(34% + 2px); top: 18%; width: 40%; height: 32%; background: oklch(0.62 0.17 35); clip-path: polygon(0 0, 100% 50%, 0 100%); transform-origin: left center; }

  /* 1 · Odometer */
  .ef-odo { display: inline-block; width: var(--w, auto); height: 0.88em; overflow: hidden; vertical-align: top; text-align: center; }
  .ef-odo-strip { display: block; white-space: pre; line-height: 0.88; transform: translateY(0); }
  .is-playing .ef-odo-strip { animation: ef-odo 1.3s cubic-bezier(0.2, 0.9, 0.25, 1) both; animation-delay: calc(var(--d) * 140ms); }
  @keyframes ef-odo { from { transform: translateY(0); } to { transform: translateY(calc(-10 * 0.88em)); } }
  .ef-card[data-v="1"].is-playing .ef-unit, .ef-card[data-v="1"].is-playing .ef-months { animation: ef-fade 0.6s 1.4s both; }
  .ef-card[data-v="1"].is-playing .ef-wk { animation: ef-fade 0.5s both; animation-delay: calc(1.5s + var(--i) * 20ms); }

  /* 2 · Cascade and flag */
  .ef-card[data-v="2"].is-playing .ef-wk { animation: ef-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--i) * 70ms); }
  .ef-card[data-v="2"] .ef-wk.is-launch::after { transform-origin: bottom; }
  .ef-card[data-v="2"].is-playing .ef-wk.is-launch::after { animation: ef-pole 0.4s 1.1s both; }
  .ef-card[data-v="2"].is-playing .ef-wk.is-launch::before { animation: ef-unfurl 0.5s 1.45s cubic-bezier(0.34, 1.56, 0.64, 1) both, ef-wave 2.4s 2s ease-in-out infinite; }
  .ef-card[data-v="2"].is-playing .ef-num { animation: ef-rise 0.7s 0.2s both; }
  @keyframes ef-pop { from { transform: scale(0); opacity: 0; } }
  @keyframes ef-pole { from { transform: scaleY(0); } }
  @keyframes ef-unfurl { from { transform: scaleX(0); } }
  @keyframes ef-wave { 50% { transform: scaleX(0.75) skewY(4deg); } }

  /* 3 · The timeline draws itself */
  .ef-line { position: relative; display: grid; gap: 8px; }
  .ef-line-track { display: flex; gap: 3px; height: 12px; }
  .ef-line-track i { border-radius: 4px; }
  .ef-card[data-v="3"] .ef-line-track { clip-path: inset(0 100% 0 0 round 4px); }
  .ef-card[data-v="3"].is-playing .ef-line-track { animation: ef-draw 1.5s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards; }
  .ef-runner { position: absolute; top: -3px; left: 0; width: 18px; height: 18px; margin-left: -9px; border-radius: 50%; background: var(--bg); box-shadow: 0 0 0 2px var(--ink); opacity: 0; }
  .ef-card[data-v="3"].is-playing .ef-runner { animation: ef-run 1.5s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards; }
  .ef-line-labels { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); }
  .ef-card[data-v="3"].is-playing .ef-line-launch { animation: ef-fade 0.5s 1.6s both; }
  .ef-card[data-v="3"].is-playing .ef-num, .ef-card[data-v="3"].is-playing .ef-unit, .ef-card[data-v="3"].is-playing .ef-months { animation: ef-rise 0.7s 1.4s both; }
  @keyframes ef-draw { to { clip-path: inset(0 0 0 0 round 4px); } }
  @keyframes ef-run { 0% { left: 0; opacity: 1; } 90% { opacity: 1; } 100% { left: 100%; opacity: 0; } }

  /* 4 · A quiet stamp */
  .ef-stamp { position: absolute; top: 24px; right: 24px; display: grid; place-items: center; width: 108px; height: 108px; border: 2px solid oklch(0.5 0.14 30); border-radius: 50%; color: oklch(0.5 0.14 30); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; line-height: 1.2; rotate: -10deg; box-shadow: inset 0 0 0 5px var(--surface), inset 0 0 0 6px oklch(0.5 0.14 30 / 0.6); opacity: 0; }
  .ef-card[data-v="4"].is-playing .ef-stamp { animation: ef-stamp 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) 0.2s both; }
  .ef-card[data-v="4"].is-playing .ef-result > * { animation: ef-rise 0.6s both; animation-delay: 0.9s; }
  @keyframes ef-stamp { 0% { opacity: 0; scale: 1.7; filter: blur(2px); } 60% { opacity: 1; scale: 0.96; filter: blur(0); } 100% { opacity: 0.9; scale: 1; } }

  /* 5 · Built from dots */
  .ef-dots { width: 170px; height: 92px; display: block; }

  /* 6 · Sealed like a letter */
  .ef-letter { position: relative; height: 150px; }
  .ef-paper { position: absolute; left: 50%; top: 0; width: 200px; padding: 14px; translate: -50% 0; border-radius: 8px; background: var(--bg); box-shadow: 0 6px 16px oklch(0 0 0 / 0.08); display: grid; gap: 6px; font-size: 10px; color: var(--muted); font-style: normal; z-index: 1; }
  .ef-paper i { font-style: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ef-env { position: absolute; left: 50%; bottom: 18px; width: 220px; height: 92px; translate: -50% 0; border-radius: 10px; background: var(--ink); z-index: 2; opacity: 0; perspective: 600px; }
  .ef-flap { position: absolute; left: 0; right: 0; top: 0; height: 60px; background: color-mix(in oklch, var(--ink) 85%, white); clip-path: polygon(0 0, 100% 0, 50% 100%); transform-origin: top; transform: rotateX(180deg); }
  .ef-seal { position: absolute; left: 50%; bottom: 44px; width: 34px; height: 34px; translate: -50% 0; border-radius: 50%; background: oklch(0.62 0.17 35); display: grid; place-items: center; z-index: 3; opacity: 0; }
  .ef-seal svg { width: 18px; fill: none; stroke: #fff; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 24; stroke-dashoffset: 24; }
  .ef-letter-note { position: absolute; left: 0; right: 0; bottom: -6px; margin: 0; text-align: center; font-size: 12px; color: var(--muted); opacity: 0; }
  .ef-card[data-v="6"] .ef-result { opacity: 0.35; }
  .ef-card[data-v="6"].is-playing .ef-paper { animation: ef-into 0.8s cubic-bezier(0.65, 0, 0.35, 1) 0.3s both; }
  .ef-card[data-v="6"].is-playing .ef-env { animation: ef-appear 0.3s 0.2s both; }
  .ef-card[data-v="6"].is-playing .ef-flap { animation: ef-flap 0.6s cubic-bezier(0.65, 0, 0.35, 1) 1.05s both; }
  .ef-card[data-v="6"].is-playing .ef-seal { animation: ef-pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.55s both; }
  .ef-card[data-v="6"].is-playing .ef-seal svg { animation: ef-tick 0.4s 1.85s forwards; }
  .ef-card[data-v="6"].is-playing .ef-letter-note { animation: ef-appear 0.5s 2.1s both; }
  .ef-card[data-v="6"].is-playing .ef-result { animation: ef-full 0.6s 2.2s both; }
  @keyframes ef-into { 70% { opacity: 1; } to { translate: -50% 70px; scale: 0.8; opacity: 0; } }
  @keyframes ef-flap { to { transform: rotateX(0deg); } }
  @keyframes ef-tick { to { stroke-dashoffset: 0; } }
  @keyframes ef-full { to { opacity: 1; } }

  /* 7 · Calendar flip */
  .ef-cal { position: absolute; top: 26px; right: 26px; display: grid; justify-items: center; width: 86px; padding-bottom: 10px; border-radius: 12px; background: var(--bg); box-shadow: 0 8px 20px oklch(0 0 0 / 0.08); overflow: hidden; transform-origin: top; }
  .ef-cal-top { width: 100%; height: 16px; background: oklch(0.62 0.17 35); }
  .ef-cal-month { margin-top: 8px; font-family: "Big Shoulders Display", Impact, sans-serif; font-weight: 800; font-size: 34px; line-height: 1; }
  .ef-cal-year { font-size: 11px; color: var(--muted); }
  .ef-cal.is-flip { animation: ef-flip 0.32s ease-out; }
  .ef-cal.is-there { box-shadow: 0 0 0 2px oklch(0.62 0.17 35), 0 12px 26px oklch(0.62 0.17 35 / 0.25); }
  @keyframes ef-flip { 0% { transform: rotateX(-70deg); } 100% { transform: rotateX(0); } }
  .ef-window { color: var(--ink); }

  /* 8 · The ring closes */
  .ef-ring { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; opacity: 0; }
  .ef-ring svg { width: 120px; height: 120px; rotate: -90deg; }
  .ef-ring-track { fill: none; stroke: var(--line); stroke-width: 6; }
  .ef-ring-bar { fill: none; stroke: var(--ink); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 30; }
  .ef-ring-tick { fill: none; stroke: var(--ink); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 100; stroke-dashoffset: 100; rotate: 90deg; transform-origin: 60px 60px; }
  .ef-card[data-v="8"] .ef-result { opacity: 0; }
  .ef-card[data-v="8"].is-playing .ef-ring { animation: ef-ring 2.4s both; }
  .ef-card[data-v="8"].is-playing .ef-ring-bar { animation: ef-close 0.8s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards; }
  .ef-card[data-v="8"].is-playing .ef-ring-tick { animation: ef-tick 0.45s 1.1s forwards; }
  .ef-card[data-v="8"].is-playing .ef-result { animation: ef-show 0.7s 2s both; }
