---
// Design preview: 20 more ideas for the navigation as a whole (header, menu, getting around, phones).
// Local preview only: in a build this route has no pages. Open http://localhost:4321/ideas/nav-more/.
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import IdeaLegend from '../../components/IdeaLegend.astro';
import { projects, canvasHues } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { preview: 'ideas' } }] : [];
}

const IDEAS = [
  [1, 'Wordmark turns to dots'], [2, 'Section name beside the wordmark'], [3, '“Let’s talk” that fits the page'], [4, 'Menu button with a scroll ring'], [5, 'Address follows the section'], [6, 'Tap the header to go up'],
  [7, 'Page turns away on the ring'], [8, 'Dotted ring behind the links'], [9, 'A detail under each link'], [10, 'Quick actions row'], [11, 'Press M to open'], [12, 'Motion switch in the menu'], [13, 'Tap buzz on Android'],
  [14, 'Link grows into the page title'], [15, '“Next: Reviews ↓”'], [16, 'Project switcher'], [17, '← → and swipe between projects'], [18, 'Footer as a second menu'],
  [19, 'Menu button within thumb reach'], [20, 'Long-press for quick actions'],
] as const;
const GROUPS: Record<number, string> = { 1: 'Header', 7: 'Menu', 14: 'Getting around', 19: 'Phones' };
const NOTES: Record<number, [string, string]> = {
  1: ['hover the name', 'The header’s “Grant Dev14.” breaks into the hero’s dots for a moment, then settles back.'],
  2: ['scroll inside the box', 'A small “/ Services”, “/ Reviews”… beside the name while you scroll the homepage.'],
  3: ['pick a page', 'The header link changes with the page: “Want one like this?” on projects, “Work with me” on About, hidden on the estimator.'],
  4: ['scroll inside the box to the end', 'A ring around the menu button fills as you scroll; at the bottom it turns into ↑ for back to top.'],
  5: ['scroll inside the box', 'The address changes to /#work, /#services… as you scroll, so a shared link opens at that spot.'],
  6: ['scroll down, then tap the header', 'On phones, tapping the header glides back to the top, like iPhone apps.'],
  7: ['open the menu', 'The page swings back around a 3D ring as the menu opens, the same motion as the hero orbit.'],
  8: ['', 'The hero’s dotted track turns slowly behind the links, as a quiet brand texture.'],
  9: ['', 'A short detail under each link, so visitors know what’s there before they click.'],
  10: ['click them', 'Three small buttons in the menu: copy email, download résumé, get an estimate.'],
  11: ['press M (or click the button)', 'The menu opens with the M key; the first time, the button shows a small “Press M” hint.'],
  12: ['turn motion off', 'A switch in the menu for visitors who find the animation distracting, remembered on their device.'],
  13: ['press a link on an Android phone', 'A tiny buzz when a menu link is pressed. Phones that don’t support it (iPhones, computers) just show the press.'],
  14: ['click “About Grant”', 'The clicked link’s text flies and grows into the page’s big title as the page opens.'],
  15: ['scroll inside the box, then click a pill', 'At the end of each homepage section, a small link to the next one.'],
  16: ['open the project name', 'On project pages the project name opens a list of all six projects.'],
  17: ['use the arrows, ← → keys or swipe', 'Move straight to the previous or next project, with its colour washing in.'],
  18: ['hover the links', 'The footer’s links set big in the display type, so the end of every page leads somewhere.'],
  19: ['tap the button', 'On phones the menu button sits bottom-right, in reach of a thumb, and the menu rises from the bottom.'],
  20: ['press and hold the button', 'Holding the menu button pops out Estimate, Email and Work in a small arc.'],
};
const tag = (n: number) => ({ name: IDEAS[n - 1][1], note: NOTES[n][0], why: NOTES[n][1] });
const img = (slug: string, size = '-480') => withBase(`/images/projects/${slug}${size}.webp`);
const hueOf = (p: (typeof projects)[number]) => canvasHues[p.canvas] ?? 60;
const years = new Date().getFullYear() - 2019;
const links = [
  { label: 'Selected work', meta: `${projects.length} projects`, hash: 'work' },
  { label: 'About Grant', meta: `Building websites since 2019 · ${years}+ years`, hash: 'about' },
  { label: 'Services', meta: '4 services, from builds to support', hash: 'services' },
  { label: 'Estimate a project', meta: 'A realistic timeline in two minutes', hash: 'estimate' },
  { label: 'Get in touch', meta: 'Replies within a working day · example', hash: 'contact' },
  { label: 'Free website audit', meta: 'Of the site you already have', hash: 'audit' },
];
const sections = ['Hero', 'Work', 'Reviews', 'Services', 'Experience', 'Let’s talk'];
const hashes = ['', '#work', '#reviews', '#services', '#experience', '#contact'];
const projData = projects.map((p) => ({ name: p.name, platform: p.platform, category: p.category, description: p.description, hue: hueOf(p), img: img(p.slug, '-640') }));
const ctas = [['Homepage', 'Let’s talk'], ['Project page', 'Want one like this?'], ['About', 'Work with me'], ['Estimate', '']];
---
<BaseLayout title="More navigation ideas | Grant Dev14" description="Local design preview." noindex>
  <IdeaLegend ideas={IDEAS} links={[{ label: 'Compare with the current site', href: '/' }, { label: 'First 20 navigation ideas', href: '/ideas/nav/' }]} />
  <div class="wrap nm-page">
    <header class="nm-head">
      <span class="tiny-heading">Preview · more navigation</span>
      <h1 class="display">Twenty more<br />for getting around</h1>
      <p>Header ideas run in small boxes with a stand-in header; menu ideas in a small copy of the menu; phone ideas in a phone frame. Pick the numbers you like.</p>
    </header>

    {IDEAS.map(([n]) => {
      const t = tag(n);
      return (
        <section class="nm" id={`idea-${n}`}>
          {GROUPS[n] && <p class="nm-group">{GROUPS[n]}</p>}
          <div class="nm-top"><span class="idea-tag"><b>{n}</b>{t.name}{t.note && <em>{t.note}</em>}</span><p class="nm-why">{t.why}</p></div>

          {n === 1 && <div class="nm-bar"><a class="nm-wordmark" href="#idea-1"><span class="nm-wm-text">Grant<br />Dev14.</span><canvas aria-hidden="true"></canvas></a><span class="nm-bar-right">Let’s talk ↗<i class="nm-btn-dot"></i></span></div>}

          {[2, 4, 5, 15].includes(n) && (
            <div class={`nm-box nm-box-${n}`} data-box={n}>
              {n === 5 && <div class="nm-address"><i></i><i></i><i></i><span>grantdev14.com/<b class="nm-hash"></b></span></div>}
              <div class="nm-mh"><span class="nm-mh-mark">Grant<br />Dev14.</span>{n === 2 && <span class="nm-crumb"><span>/</span><span class="nm-crumb-text">Hero</span></span>}<span class="nm-mh-right">Let’s talk ↗{n !== 4 && <i class="nm-btn-dot"></i>}</span></div>
              {sections.map((s, i) => <div class="nm-sec" data-i={i} data-hash={hashes[i]} id={`nm${n}-s${i}`}><h3 class="display">{s}</h3><p>Section content. Keep scrolling.</p>{n === 15 && i < sections.length - 1 && <a class="nm-next" href={`#nm15-s${i + 1}`}>Next: {sections[i + 1]} <span aria-hidden="true">↓</span></a>}</div>)}
              {n === 4 && <button type="button" class="nm-ring-btn" aria-label="Open navigation"><svg viewBox="0 0 60 60" aria-hidden="true"><circle cx="30" cy="30" r="27" class="bg" /><circle cx="30" cy="30" r="27" class="fg" pathLength="100" /></svg><span class="nm-lines"><i></i><i></i></span><span class="nm-up">↑</span></button>}
            </div>
          )}

          {n === 3 && (
            <div class="nm-cta-demo">
              <div class="nm-chips" role="group" aria-label="Page">{ctas.map(([p], i) => <button type="button" data-cta={ctas[i][1]} aria-pressed={i === 0 ? 'true' : 'false'}>{p}</button>)}</div>
              <div class="nm-bar"><span class="nm-mh-mark">Grant<br />Dev14.</span><span class="nm-bar-right"><span class="nm-cta-slot"><span class="nm-cta">Let’s talk ↗</span></span><i class="nm-btn-dot"></i></span></div>
            </div>
          )}

          {(n === 6 || n === 19 || n === 20) && (
            <div class={`nm-phone nm-phone-${n}`}>
              <div class="nm-phone-screen">
                <div class="nm-phone-scroll">
                  <div class="nm-phone-head"><span>Grant<br />Dev14.</span>{n === 6 && <i class="nm-btn-dot"></i>}</div>
                  <p class="display nm-phone-title">GRANT<br />DEV14.</p>
                  {projects.slice(0, 4).map((p) => <img src={img(p.slug, '-480')} alt="" width="480" height="270" loading="lazy" />)}
                  <p class="nm-phone-end">End of the page</p>
                </div>
                {n === 19 && <button type="button" class="nm-thumb" aria-label="Open navigation"><i></i><i></i></button>}
                {n === 19 && <div class="nm-sheet"><span class="nm-sheet-handle"></span>{links.map((l) => <a href="#idea-19">{l.label}<Arrow /></a>)}</div>}
                {n === 20 && <div class="nm-arc">{[['Estimate', '◷'], ['Email', '✉'], ['Work', '▦']].map(([l, ic], i) => <button type="button" style={`--i:${i}`} data-label={l}><span aria-hidden="true">{ic}</span><small>{l}</small></button>)}</div>}
                {n === 20 && <button type="button" class="nm-thumb nm-hold" aria-label="Open navigation (hold for quick actions)"><i></i><i></i></button>}
                {n === 20 && <p class="nm-toast" aria-live="polite"></p>}
              </div>
            </div>
          )}

          {[7, 8, 9, 10, 11, 12, 13, 14].includes(n) && (
            <div class:list={['nm-stage', `nm-stage-${n}`, { 'is-open': [8, 9, 10, 12, 13, 14].includes(n) }]} data-stage={n}>
              {n === 8 && <canvas class="nm-ring-canvas" aria-hidden="true"></canvas>}
              <div class="nm-card">
                <div class="nm-mock"><div class="nm-mock-head"><span>Grant<br />Dev14.</span><span>Let’s talk ↗</span></div><p class="nm-mock-name display">GRANT DEV14.</p>{n === 12 ? <div class="nm-marquee" aria-hidden="true"><div>{[0, 1].map(() => ['Shopify', 'Webflow', 'WordPress', 'Migrations', 'Technical SEO'].map((m) => <><span>{m}</span><i></i></>))}</div></div> : <div class="nm-mock-cards">{projects.slice(0, 3).map((p) => <img src={img(p.slug)} alt="" width="480" height="270" loading="lazy" />)}</div>}</div>
                {(n === 7 || n === 11) && <button type="button" class="nm-open" aria-label="Open navigation" aria-expanded="false"><i></i><i></i>{n === 11 && <span class="nm-hint">Press M</span>}</button>}
              </div>
              {(n === 7 || n === 11) && <button type="button" class="nm-close" aria-label="Close navigation"><i></i><i></i></button>}
              <div class="nm-menu">
                {n === 12 && <label class="nm-switch"><input type="checkbox" checked /><span></span>Motion</label>}
                <nav class="nm-links" aria-label={`Menu demo ${n}`}>{links.map((l, i) => <a href={`#idea-${n}`} style={`--i:${i}`} data-i={i}><span class="nm-label"><span>{l.label}</span>{n === 9 && <small>{l.meta}</small>}</span><Arrow /></a>)}</nav>
                {n === 10 && <div class="nm-actions"><button type="button" data-copy={profile.email}><span aria-hidden="true">✉</span><b>Copy email</b></button><a href={withBase('/resume/grant-payad-resume.pdf')} download><span aria-hidden="true">↓</span><b>Résumé</b></a><a href={withBase('/estimate/')} class="nm-action-main"><span aria-hidden="true">◷</span><b>Get an estimate</b></a></div>}
                <div class="nm-bottom"><span>{profile.email}</span><span>LinkedIn ↗</span></div>
              </div>
              {n === 14 && <div class="nm-about" aria-hidden="true"><span class="nm-about-back">← Back to the menu</span><h3 class="display nm-about-title">ABOUT GRANT</h3><p>A developer with an eye for detail. And a mindset for making things work.</p></div>}
              {n === 13 && <p class="nm-toast" aria-live="polite"></p>}
            </div>
          )}

          {(n === 16 || n === 17) && (
            <div class={`nm-proj nm-proj-${n}`} style={`--h:${projData[0].hue}`} tabindex={n === 17 ? 0 : undefined}>
              <div class="nm-proj-head">
                <span class="nm-proj-back">← All projects</span>
                {n === 16 && <div class="nm-switcher"><button type="button" aria-expanded="false"><span class="nm-proj-name-btn">{projData[0].name}</span> <span aria-hidden="true">▾</span></button><ul hidden>{projData.map((p, i) => <li><button type="button" data-i={i}><img src={p.img} alt="" width="640" height="360" /><span><strong>{p.name}</strong><small>{p.platform} · {p.category}</small></span></button></li>)}</ul></div>}
                {n === 17 && <div class="nm-proj-arrows"><button type="button" data-d="-1" aria-label="Previous project">←</button><span class="nm-proj-count">01 / {String(projData.length).padStart(2, '0')}</span><button type="button" data-d="1" aria-label="Next project">→</button></div>}
              </div>
              <div class="nm-proj-body"><h3 class="display nm-proj-title">{projData[0].name}</h3><p class="nm-proj-desc">{projData[0].description}</p><img class="nm-proj-img" src={projData[0].img} alt="" width="640" height="360" /></div>
            </div>
          )}

          {n === 18 && (
            <div class="nm-footer"><p class="nm-footer-label">Keep exploring</p><nav class="nm-footer-links" aria-label="Footer demo">{links.map((l, i) => <a href="#idea-18"><b>{String(i + 1).padStart(2, '0')}</b><span>{l.label}</span><Arrow diagonal /></a>)}</nav><div class="nm-footer-bottom"><span>{profile.email}</span><span>LinkedIn ↗</span><span>Back to top ↑</span></div></div>
          )}
        </section>
      );
    })}
  </div>
  <script type="application/json" id="nm-projects" set:html={JSON.stringify(projData)} />
</BaseLayout>

<script>
  import { Dots } from './_dots';
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const projData: { name: string; platform: string; category: string; description: string; hue: number; img: string }[] = JSON.parse(document.getElementById('nm-projects')!.textContent!);
  const box = (n: number) => document.querySelector<HTMLElement>(`[data-box="${n}"]`)!;
  const toast = (el: HTMLElement | null, text: string) => { if (!el) return; el.textContent = text; el.classList.add('is-on'); setTimeout(() => el.classList.remove('is-on'), 1400); };
  // The section under the top of a scroll box.
  const current = (b: HTMLElement) => { const top = b.getBoundingClientRect().top + 90; return [...b.querySelectorAll<HTMLElement>('.nm-sec')].find((s) => { const r = s.getBoundingClientRect(); return r.top <= top && r.bottom > top; }); };

  // 1: the wordmark turns to dots on hover, then settles back to text.
  {
    const wm = document.querySelector<HTMLElement>('.nm-wordmark')!, cv = wm.querySelector('canvas')!;
    let dots: Dots | null = null, timer = 0;
    wm.addEventListener('pointerenter', () => {
      clearTimeout(timer);
      dots ??= new Dots(cv, 'Grant Dev14.', { lines: ['Grant', 'Dev14.'], align: 'left', color: '#161616', accent: 'oklch(0.6 0.14 245)' });
      wm.classList.add('is-dots');
      dots.build().then(() => dots!.glide(260));
    });
    wm.addEventListener('pointerleave', () => { timer = window.setTimeout(() => wm.classList.remove('is-dots'), 500); });
  }

  // 2: the section's name beside the wordmark.
  { const b = box(2), text = b.querySelector<HTMLElement>('.nm-crumb-text')!, crumb = b.querySelector<HTMLElement>('.nm-crumb')!;
    let last = '';
    b.addEventListener('scroll', () => { const s = current(b); const name = s?.querySelector('h3')!.textContent ?? ''; crumb.classList.toggle('is-on', b.scrollTop > 40); if (name && name !== last) { last = name; text.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }); text.textContent = name; } }, { passive: true }); }

  // 3: the header link fits the page.
  document.querySelectorAll<HTMLButtonElement>('.nm-cta-demo .nm-chips button').forEach((b) => b.addEventListener('click', () => {
    const demo = b.closest('.nm-cta-demo')!, cta = demo.querySelector<HTMLElement>('.nm-cta')!;
    demo.querySelectorAll('.nm-chips button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    cta.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-8px)' }], { duration: 200 }).finished.then(() => {
      const text = b.dataset.cta!; cta.textContent = text ? `${text} ↗` : ''; cta.parentElement!.classList.toggle('is-empty', !text);
      cta.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
    });
  }));

  // 4: the ring fills with the scroll; at the bottom the button means "back to top".
  { const b = box(4), btn = b.querySelector<HTMLElement>('.nm-ring-btn')!, ring = btn.querySelector<SVGCircleElement>('.fg')!;
    b.addEventListener('scroll', () => { const p = clamp(b.scrollTop / (b.scrollHeight - b.clientHeight)); ring.style.strokeDashoffset = String(100 - p * 100); btn.classList.toggle('is-up', p > 0.98); }, { passive: true });
    btn.addEventListener('click', () => { if (btn.classList.contains('is-up')) b.scrollTo({ top: 0, behavior: 'smooth' }); else toast(null, ''); }); }

  // 5: the address follows the section.
  { const b = box(5), hash = b.querySelector<HTMLElement>('.nm-hash')!;
    b.addEventListener('scroll', () => { const s = current(b); hash.textContent = s?.dataset.hash ?? ''; }, { passive: true }); }

  // 15: "Next" pills scroll the box to the next section.
  box(15).querySelectorAll<HTMLAnchorElement>('.nm-next').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); const b = box(15), t = b.querySelector<HTMLElement>(a.getAttribute('href')!)!; b.scrollTo({ top: t.offsetTop - 70, behavior: 'smooth' }); }));

  // 6: tap the phone's header to glide to the top.
  { const ph = document.querySelector<HTMLElement>('.nm-phone-6')!, sc = ph.querySelector<HTMLElement>('.nm-phone-scroll')!;
    ph.querySelector('.nm-phone-head')!.addEventListener('click', () => sc.scrollTo({ top: 0, behavior: 'smooth' })); }

  // Menu stages: open and close (7, 11), and links that stay on this page.
  let openStage: HTMLElement | null = null;
  document.querySelectorAll<HTMLElement>('.nm-stage').forEach((stage) => {
    const n = Number(stage.dataset.stage);
    const open = () => { stage.classList.add('is-open'); openStage = stage; stage.querySelector('.nm-hint')?.remove(); };
    const close = () => { stage.classList.remove('is-open'); if (openStage === stage) openStage = null; };
    stage.querySelector('.nm-open')?.addEventListener('click', open);
    stage.querySelector('.nm-close')?.addEventListener('click', close);
    if (n !== 14) stage.querySelectorAll<HTMLAnchorElement>('.nm-links a').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
    (stage as HTMLElement & { nm?: { open: () => void; close: () => void } }).nm = { open, close };
  });
  // 11: the M key opens the menu in view (Esc closes).
  addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea')) return;
    const s11 = document.querySelector<HTMLElement & { nm?: { open: () => void; close: () => void } }>('.nm-stage-11')!;
    const r = s11.getBoundingClientRect();
    if (e.key.toLowerCase() === 'm' && !e.metaKey && !e.ctrlKey && r.top < innerHeight && r.bottom > 0) s11.nm!.open();
    if (e.key === 'Escape' && openStage) (openStage as HTMLElement & { nm?: { close: () => void } }).nm!.close();
  });

  // 8: the hero's dotted ring, turning slowly behind the links.
  {
    const cv = document.querySelector<HTMLCanvasElement>('.nm-ring-canvas')!, c = cv.getContext('2d')!;
    let on = false, W = 0, H = 0;
    new IntersectionObserver(([e]) => { on = e.isIntersecting; }).observe(cv);
    const size = () => { const r = cv.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1); W = r.width; H = r.height; cv.width = W * dpr; cv.height = H * dpr; c.setTransform(dpr, 0, 0, dpr, 0, 0); };
    size(); addEventListener('resize', size);
    const tick = (t: number) => {
      if (on) {
        c.clearRect(0, 0, W, H);
        const cx = W * 0.72, cy = H * 0.55, R = W * 0.34, N = 120, P = 1800;
        for (let i = 0; i < N; i++) {
          const a = (i / N) * Math.PI * 2 + t * 0.00012, k = P / (P - (Math.cos(a) * R - R));
          const x = cx + Math.sin(a) * R * k, y = cy + (Math.cos(a) * 0.5 + 0.5) * H * 0.22 * k - H * 0.1;
          c.beginPath(); c.arc(x, y, 1.8 * k ** 1.4, 0, 6.2832); c.fillStyle = `oklch(1 0 0 / ${(0.08 + 0.22 * (k - 0.6)).toFixed(3)})`; c.fill();
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // 10: copy the email.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const label = b.querySelector('b')!;
    try { await navigator.clipboard.writeText(b.dataset.copy!); label.textContent = 'Copied ✓'; } catch { label.textContent = 'Press ⌘C'; }
    setTimeout(() => { label.textContent = 'Copy email'; }, 1600);
  }));
  document.querySelectorAll<HTMLAnchorElement>('.nm-actions a').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));

  // 12: the motion switch stops the page's moving strip.
  document.querySelector<HTMLInputElement>('.nm-switch input')?.addEventListener('change', (e) => { document.querySelector('.nm-stage-12')!.classList.toggle('is-still', !(e.target as HTMLInputElement).checked); });

  // 13: a short buzz where the phone supports it, and a press ripple everywhere.
  { const s = document.querySelector<HTMLElement>('.nm-stage-13')!, t = s.querySelector<HTMLElement>('.nm-toast');
    s.querySelectorAll<HTMLAnchorElement>('.nm-links a').forEach((a) => a.addEventListener('pointerdown', () => {
      const buzzed = 'vibrate' in navigator && navigator.vibrate(12);
      a.animate([{ backgroundColor: 'oklch(1 0 0 / 0.12)' }, { backgroundColor: 'oklch(1 0 0 / 0)' }], { duration: 500 });
      toast(t, buzzed ? 'Bzz (10 ms)' : 'This device can’t buzz: just the press');
    })); }

  // 14: the clicked link's text grows into the page's title.
  {
    const s = document.querySelector<HTMLElement>('.nm-stage-14')!, about = s.querySelector<HTMLElement>('.nm-about')!, title = about.querySelector<HTMLElement>('.nm-about-title')!;
    const link = s.querySelectorAll<HTMLAnchorElement>('.nm-links a')[1];
    s.querySelectorAll<HTMLAnchorElement>('.nm-links a').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
    link.addEventListener('click', () => {
      const label = link.querySelector<HTMLElement>('.nm-label span')!, from = label.getBoundingClientRect(), sb = s.getBoundingClientRect();
      about.classList.add('is-on');
      const to = title.getBoundingClientRect();
      const fly = document.createElement('span');
      fly.className = 'nm-fly'; fly.textContent = 'About Grant';
      fly.style.cssText = `left:${from.left - sb.left}px;top:${from.top - sb.top}px;font-size:${getComputedStyle(label).fontSize}`;
      s.append(fly);
      title.style.opacity = '0';
      const sx = to.height / from.height;
      fly.animate([{ transform: 'none', color: '#fff' }, { transform: `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(${sx})`, color: '#161616' }], { duration: 800, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'forwards' }).finished.then(() => {
        fly.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, fill: 'forwards' }).finished.then(() => fly.remove());
