---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CURRENCIES, LINE_PRESETS } from '../data/pricing';
import { STATUSES } from '../data/quote-model';
---
<BaseLayout title="Quotation Builder | Grant Dev14" description="Private tool for preparing project quotations." noindex>
  <div class="wrap quote-page">
    <header class="q-top">
      <div>
        <p class="tiny-heading">Private tool</p>
        <h1>Quotation builder</h1>
      </div>
      <nav class="q-tabs" aria-label="Views">
        <button type="button" data-view="dashboard">Quotes</button>
        <button type="button" data-view="editor">Editor</button>
      </nav>
      <div class="q-top-actions">
        <button type="button" class="q-btn q-ghost" id="q-lock" title="Forget the saved password on this device">Lock</button>
        <button type="button" class="q-btn q-ghost" id="q-open-profile">Business profile</button>
        <button type="button" class="q-btn" id="q-new">New quote</button>
      </div>
    </header>

    <!-- Dashboard -->
    <section class="q-dash" id="v-dashboard" aria-label="Quotes" hidden>
      <div class="q-stats" id="q-stats"></div>
      <div class="q-dash-bar">
        <div class="q-filters" id="q-filters" role="group" aria-label="Filter by status">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          {STATUSES.map((s) => <button type="button" data-filter={s.id} aria-pressed="false">{s.label}</button>)}
        </div>
        <input type="search" id="q-search" placeholder="Search client, project or number" aria-label="Search quotes" />
      </div>
      <div class="q-list" id="q-list"></div>
      <div class="q-dash-foot">
        <button type="button" class="q-link" id="q-export">Back up all quotes</button>
        <label class="q-link">Restore a backup<input type="file" accept="application/json,.json" id="q-restore" hidden /></label>
        <span class="q-dash-note">Quotes are saved in this browser only. Back up now and then.</span>
      </div>
    </section>

    <!-- Editor -->
    <div class="q-layout" id="v-editor" hidden>
      <div class="q-main">
        <section class="q-card" id="s-import" aria-labelledby="q-h-import">
          <header class="q-head"><span class="q-step">01</span><h2 id="q-h-import">Start from the client’s estimate</h2></header>
          <label class="q-drop" id="q-drop">
            <input type="file" accept="application/pdf,.pdf" id="q-file" />
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M12 16V4m0 0-4.5 4.5M12 4l4.5 4.5M4 15v3.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <strong>Upload the estimate PDF</strong>
            <span>Drop it here, or click to choose. The client’s answers are read from the file.</span>
          </label>
          <details class="q-paste">
            <summary>No PDF? Paste the brief from their email</summary>
            <textarea id="q-brief" rows="7" placeholder="Project: A new website or store&#10;Platform: Shopify Plus&#10;Page layouts: 12 layouts&#10;…"></textarea>
            <button type="button" class="q-btn" id="q-read">Read brief</button>
          </details>
          <p class="q-status" id="q-status" role="status"></p>
        </section>

        <section class="q-card" id="s-client" aria-labelledby="q-h-client">
          <header class="q-head"><span class="q-step">02</span><h2 id="q-h-client">Client & quote details</h2></header>
          <div class="q-grid">
            <label>Client name<input data-bind="client.name" autocomplete="off" /></label>
            <label>Company<input data-bind="client.company" autocomplete="off" /></label>
            <label>Email<input type="email" data-bind="client.email" autocomplete="off" /></label>
            <label>Website<input data-bind="client.website" autocomplete="off" placeholder="example.com" /></label>
          </div>
          <div class="q-grid q-grid-4 q-gap-top">
            <label>Quote number<input data-bind="meta.number" /></label>
            <label>Date<input type="date" data-bind="meta.date" /></label>
            <label>Valid for (days)<input type="number" min="1" data-bind="meta.validDays" /></label>
            <label>Estimate ref<input data-bind="meta.ref" placeholder="EST-…" /></label>
          </div>
          <div class="q-stack q-gap-top">
            <label>Project title<input data-bind="project.title" placeholder="e.g. New Shopify store" /></label>
            <label>Project summary<textarea rows="3" data-bind="project.summary" placeholder="One or two sentences on what you’re building and why."></textarea></label>
          </div>
        </section>

        <section class="q-card" id="s-scope" aria-labelledby="q-h-scope">
          <header class="q-head"><span class="q-step">03</span><h2 id="q-h-scope">Scope</h2></header>
          <p class="q-help">The client’s answers. Adjust anything agreed on the call, then recalculate.</p>
          <div id="q-scope" class="q-scope"></div>
          <p class="q-estimate" id="q-estimate"></p>
          <div class="q-recalc"><button type="button" class="q-btn" id="q-recalc">Recalculate pricing</button><span id="q-dirty" class="q-dirty" hidden>Scope changed since pricing was calculated</span></div>
        </section>

        <section class="q-card" id="s-pricing" aria-labelledby="q-h-pricing">
          <header class="q-head"><span class="q-step">04</span><h2 id="q-h-pricing">Pricing</h2></header>
          <div class="q-grid q-grid-4">
            <label>Currency<select data-bind="settings.currency">{CURRENCIES.map((c) => <option value={c}>{c}</option>)}</select></label>
            <label>Your hourly rate<input type="number" min="0" step="1" data-bind="settings.rate" /></label>
            <label>Billable hours / week<input type="number" min="1" data-bind="settings.hoursPerWeek" /></label>
            <label>Project management %<input type="number" min="0" data-bind="settings.pmPercent" /></label>
          </div>
          <p class="q-help">Changing your rate updates every line still on the old rate. Hours per week and project management apply when you recalculate.</p>

          <div class="q-options">
            <div class="q-option-tabs" id="q-option-tabs" role="tablist" aria-label="Options"></div>
            <details class="q-menu q-menu-right" id="q-option-menu">
              <summary class="q-btn q-ghost">+ Add option</summary>
              <div class="q-menu-list">
                <button type="button" data-new-option="copy">Copy of this option</button>
                <button type="button" data-new-option="team2">2 developers, full scope</button>
                <button type="button" data-new-option="team3">3 developers, full scope</button>
                <button type="button" data-new-option="essentials">Essentials first (1 developer)</button>
                <button type="button" data-new-option="both">Essentials first, bigger team</button>
              </div>
            </details>
          </div>

          <div class="q-option-settings">
            <label>Option name<input id="q-option-name" /></label>
            <label class="q-check"><input type="checkbox" id="q-option-essentials" />Launch the essentials first (Phase 1 / Phase 2)</label>
            <button type="button" class="q-link q-danger" id="q-option-remove">Remove this option</button>
          </div>

          <div class="q-team" id="q-team-box">
            <div class="q-team-head">
              <p class="q-team-title">Team size</p>
              <div class="q-team-fields">
                <label class="q-team-rate">Faster delivery premium<span class="q-suffix"><input type="number" min="0" step="1" data-bind="teamPremium" />% per extra dev</span></label>
                <label class="q-team-rate">Extra developers’ rate<input type="number" min="0" step="1" data-bind="teamRate" /></label>
              </div>
            </div>
            <div class="q-seg" id="q-team" role="radiogroup" aria-label="Team size"></div>
            <p class="q-team-note" id="q-team-note"></p>
          </div>

          <div class="q-table" id="q-lines" role="table" aria-label="Line items"></div>
          <div class="q-add-row">
            <details class="q-menu" id="q-add-menu">
              <summary class="q-btn q-ghost">+ Add item</summary>
              <div class="q-menu-list">
                <p class="q-menu-title">Built in</p>
                {LINE_PRESETS.map((preset, i) => <button type="button" data-preset={i}>{preset.label}</button>)}
                <p class="q-menu-title">Your items</p>
                <div id="q-library"></div>
              </div>
            </details>
            <span class="q-legend">Tick <b>Phase 2</b> for work after launch, <b>At cost</b> for things you pay on (e.g. licences), <b>Optional</b> for extras outside the total. ☆ saves an item to Your items.</span>
          </div>

          <div class="q-grid q-grid-4 q-adjust">
            <label>Discount<input type="number" min="0" step="any" data-bind="pricing.discount" /></label>
            <label>Discount type<select data-bind="pricing.discountType"><option value="percent">Percent (%)</option><option value="amount">Fixed amount</option></select></label>
            <label>Tax label<input data-bind="pricing.taxLabel" /></label>
            <label>Tax %<input type="number" min="0" step="any" data-bind="pricing.tax" /></label>
          </div>
          <dl class="q-totals" id="q-totals"></dl>
        </section>

        <section class="q-card" id="s-payment" aria-labelledby="q-h-pay">
          <header class="q-head"><span class="q-step">05</span><h2 id="q-h-pay">Payments & invoices</h2></header>
          <p class="q-help">Milestones apply to every option. Invoices use the accepted option (or the one you’re editing).</p>
          <div class="q-schedule" id="q-schedule"></div>
          <div class="q-schedule-foot"><button type="button" class="q-btn q-ghost" id="q-add-milestone">+ Add milestone</button><p class="q-status" id="q-schedule-status" role="status"></p></div>
          <div class="q-invoices" id="q-invoices"></div>
        </section>

        <section class="q-card" id="s-terms" aria-labelledby="q-h-terms">
          <header class="q-head"><span class="q-step">06</span><h2 id="q-h-terms">Included, not included & terms</h2></header>
          <p class="q-help">One item per line. <code>{'{validDays}'}</code> becomes the validity period.</p>
          <div class="q-grid">
            <label>What’s included<textarea rows="7" data-bind="text.included"></textarea></label>
            <label>Not included<textarea rows="7" data-bind="text.excluded"></textarea></label>
          </div>
          <div class="q-stack q-gap-top">
            <label>Terms<textarea rows="8" data-bind="text.terms"></textarea></label>
            <label>Note to the client (optional)<textarea rows="3" data-bind="text.note" placeholder="e.g. Thanks for the call on Tuesday. Here’s the quote we discussed…"></textarea></label>
          </div>
        </section>
      </div>

      <aside class="q-summary" aria-label="Quotation summary">
        <div class="q-summary-card">
          <div class="q-status-row">
            <label>Status<select id="q-status-select">{STATUSES.map((s) => <option value={s.id}>{s.label}</option>)}</select></label>
            <label>Follow up on<input type="date" data-bind="followUp" /></label>
          </div>
          <label class="q-accepted" id="q-accepted-wrap" hidden>Accepted option<select id="q-accepted"></select></label>
          <p class="tiny-heading" id="q-total-label">Quotation total</p>
          <p class="q-total" id="q-total"></p>
          <p class="q-sub" id="q-sub"></p>
          <dl class="q-facts" id="q-facts"></dl>
          <div class="q-actions">
            <button class="q-download" id="q-download" type="button">Download PDF</button>
            <button class="q-btn q-ghost" id="q-preview" type="button">Preview</button>
          </div>
          <div class="q-email">
            <button class="q-btn q-ghost" id="q-copy-email" type="button">Copy email</button>
            <a class="q-btn q-ghost" id="q-mail" href="#">Open in email</a>
          </div>
        </div>

        <details class="q-profit" id="q-profit" open>
          <summary>Profit check <span>private, never in the PDF</span></summary>
          <label class="q-cost">What you pay extra developers / hr<input type="number" min="0" step="1" data-bind="costRate" /></label>
          <dl id="q-margin"></dl>
          <p class="q-margin-note" id="q-margin-note"></p>
        </details>

        <nav class="q-progress" aria-label="Sections">
          <a href="#s-import" data-check="import"><i></i>Estimate imported</a>
          <a href="#s-client" data-check="client"><i></i>Client details</a>
          <a href="#s-scope" data-check="scope"><i></i>Scope</a>
          <a href="#s-pricing" data-check="pricing"><i></i>Pricing</a>
          <a href="#s-payment" data-check="payment"><i></i>Payments add up to 100%</a>
          <a href="#s-terms" data-check="terms"><i></i>Terms</a>
        </nav>
      </aside>
    </div>
  </div>

  <div class="q-mobile-bar" id="q-mobile-bar" hidden><span id="q-mobile-total"></span><button type="button" class="q-btn" id="q-mobile-download">Download PDF</button></div>

  <dialog class="q-dialog" id="q-dialog" aria-label="PDF preview">
    <div class="q-dialog-bar">
      <strong id="q-dialog-title">Preview</strong>
      <div><button type="button" class="q-btn" id="q-dialog-download">Download PDF</button><button type="button" class="q-btn q-ghost" id="q-dialog-close">Close</button></div>
    </div>
    <iframe id="q-frame" title="PDF preview"></iframe>
  </dialog>

  <dialog class="q-dialog q-profile-dialog" id="q-profile" aria-labelledby="q-profile-title">
    <form method="dialog" class="q-profile-form" id="q-profile-form">
      <div class="q-dialog-bar"><strong id="q-profile-title">Business profile</strong><div><button type="submit" class="q-btn" value="save">Save</button><button type="submit" class="q-btn q-ghost" value="cancel" formnovalidate>Cancel</button></div></div>
      <div class="q-profile-body q-card">
        <p class="q-help">Shown on every quotation and invoice. Saved in this browser.</p>
        <div class="q-grid">
          <label>Business name<input name="name" required /></label>
          <label>Tagline<input name="tagline" /></label>
          <label>Email<input name="email" type="email" /></label>
          <label>Phone<input name="phone" /></label>
          <label>Website<input name="website" /></label>
          <label>Tax ID (optional)<input name="taxId" /></label>
          <label>Address<textarea name="address" rows="3"></textarea></label>
          <label>How clients pay you (one per line)<textarea name="payment" rows="3" placeholder="Wise: name@email.com (USD, AUD, GBP)&#10;PayPal: paypal.me/yourname&#10;Bank: bank name, account number, account name"></textarea></label>
          <label>Invoice number prefix<input name="invoicePrefix" /></label>
          <label>Invoices due after (days)<input name="paymentDays" type="number" min="0" /></label>
        </div>
        <div class="q-grid q-gap-top">
          <div class="q-image-field"><span>Logo (replaces your name on PDFs)</span><img id="q-logo-preview" alt="" hidden /><div><label class="q-btn q-ghost">Upload<input type="file" accept="image/*" id="q-logo-file" hidden /></label><button type="button" class="q-link q-danger" data-clear="logo">Remove</button></div></div>
          <div class="q-image-field"><span>Signature (on the acceptance line)</span><img id="q-signature-preview" alt="" hidden /><div><label class="q-btn q-ghost">Upload<input type="file" accept="image/*" id="q-signature-file" hidden /></label><button type="button" class="q-link q-danger" data-clear="signature">Remove</button></div></div>
        </div>
      </div>
    </form>
  </dialog>
</BaseLayout>

<script>
  import '../scripts/quote-app';
</script>
