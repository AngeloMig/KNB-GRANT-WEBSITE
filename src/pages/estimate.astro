---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SupportPlanComparison from '../components/SupportPlanComparison.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
import { steps } from '../data/estimator';
import { FORM_CC, FORM_INBOX } from '../data/forms';
import { projects } from '../data/projects';
import { withBase } from '../utils/paths';
// Real projects, shown as examples once a platform is picked.
const examples = projects.map((p) => ({ name: p.name, platform: p.platform, category: p.category, href: withBase(`/work/${p.slug}/`), img: withBase(`/images/projects/${p.slug}-480.webp`) }));
---
<BaseLayout title="Project Estimator — Plan Your Website | Grant Dev14" description="Plan a Shopify, Webflow or WordPress project in about a minute. Answer a few questions to get a realistic timeline, what drives it, and a ready-to-send brief.">
  <div class="wrap estimate-page">
    <SectionTitle title="ESTIMATE" detail="Plan your project in about a minute" as="h1" />
    <section class="intro-split estimate-intro">
      <div class="intro-aside is-in" data-reveal="load" style="--reveal-index:0"><span class="tiny-heading">Project estimator</span><p>A realistic guide, not a quote.<br />Grant confirms after a quick chat.</p><p class="estimate-promise">About 2 minutes · No account needed</p></div>
      <div><p class="lead is-in" data-reveal="load" style="--reveal-index:1">What are you building?</p><p class="intro-support is-in" data-reveal="load" style="--reveal-index:2">Start with your name and email, then answer 8–10 quick questions. The timeline updates as you go, shows what’s driving it, and turns into a brief you can send to Grant in one click. Your answers are saved on this device, so you can come back to them.</p></div>
    </section>

    <p class="wiz-restored" hidden><span></span> <button type="button" class="wiz-reset">Start over</button></p>

    <noscript><p class="wiz-noscript">The estimator needs JavaScript. You can still <a href={`mailto:${profile.email}`}>email Grant about your project</a>.</p></noscript>

    <div class="wizard" data-wizard>
      <div class="wiz-main">
        <div class="wiz-progress">
          <p class="wiz-count"><span class="wiz-current">01</span><span class="wiz-of">/ <span class="wiz-total">01</span></span></p>
          <div class="wiz-track" role="progressbar" aria-label="Estimator progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="wiz-fill"></span></div>
          <ol class="wiz-dots" aria-label="Steps"></ol>
        </div>

        <form class="wiz-form" novalidate>
          <fieldset class="wiz-step wiz-start" data-step="contact" data-kind="contact">
            <legend class="wiz-eyebrow">Start</legend>
            <h2 class="wiz-question" tabindex="-1">First, who’s the estimate for?</h2>
            <p class="wiz-help">So Grant can follow up on your project. Just a name and an email: no account, no newsletter.</p>
            <div class="wiz-contact-grid wiz-start-grid">
              <label><span>Your name <i aria-hidden="true">*</i></span><input name="c-name" autocomplete="name" required /></label>
              <label><span>Email <i aria-hidden="true">*</i></span><input type="email" name="c-email" autocomplete="email" inputmode="email" required /></label>
            </div>
            <input type="text" name="_honey" class="wiz-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form-human-check" data-human-check></div>
            <p class="wiz-start-note" role="status" aria-live="polite"></p>
          </fieldset>
          {steps.map((step) => (
            <fieldset class="wiz-step" data-step={step.id} data-kind={step.kind} hidden>
              <legend class="wiz-eyebrow">{step.label}{step.optional && <span> · optional</span>}</legend>
              <h2 class="wiz-question" tabindex="-1">{step.question}</h2>
              {step.help && <p class="wiz-help">{step.help}</p>}
              {(step.kind === 'single' || step.kind === 'multi') && (
                <div class:list={['wiz-options', { 'is-multi': step.kind === 'multi' }]}>
                  {step.options?.map((option, index) => (
                    <label class="wiz-option" data-option={option.id}>
                      <input type={step.kind === 'single' ? 'radio' : 'checkbox'} name={step.id} value={option.id} data-label={option.label} />
                      <span class="wiz-key" aria-hidden="true">{index + 1}</span>
                      <span class="wiz-option-text"><strong>{option.label}</strong>{(option.hint || option.hintFor) && <small>{option.hint}</small>}</span>
                      <span class="wiz-check" aria-hidden="true"></span>
                    </label>
                  ))}
                </div>
              )}
              {step.noteFor && <div class="wiz-note" aria-live="polite" hidden><strong></strong><p></p></div>}
              {step.id === 'platform' && <div class="wiz-examples wiz-examples-inline" hidden><p class="wiz-examples-title"></p><div class="wiz-examples-list"></div></div>}
              {step.id === 'hours' && (
                <details class="wiz-plans">
                  <summary>Compare what each plan includes</summary>
                  <SupportPlanComparison />
                </details>
              )}
              {step.kind === 'range' && step.range && (
                <div class="wiz-range">
                  <p class="wiz-range-readout"><output class="wiz-range-value" for={`range-${step.id}`}>{step.range.initial}</output><span>{step.range.unit}</span></p>
                  <input id={`range-${step.id}`} type="range" name={step.id} min={step.range.min} max={step.range.max} step={step.range.step} value={step.range.initial} aria-label={step.question} />
                  <div class="wiz-marks" aria-hidden="true">{step.range.marks.map((mark) => <span>{mark}{mark === step.range!.max ? '+' : ''}</span>)}</div>
                </div>
              )}
              {step.kind === 'text' && <textarea name={step.id} rows="5" placeholder="e.g. Current site: example.com. Launch before our spring sale, budget around…" aria-label={step.question}></textarea>}
            </fieldset>
          ))}
          <section class="wiz-step wiz-review" data-step="review" hidden>
            <p class="wiz-eyebrow">Your brief</p>
            <h2 class="wiz-question" tabindex="-1">Here’s your project at a glance.</h2>
            <p class="wiz-help">Check it over, change anything, then send it to Grant.</p>
            <dl class="wiz-review-list"></dl>
            <div class="wiz-routes" hidden>
              <p class="wiz-contact-title">Ways to build it</p>
              <p class="wiz-routes-help">Each one shown against the same scope. Pick the one that suits you; Grant prices it in the proposal.</p>
              <div class="wiz-routes-list" role="group" aria-label="Ways to build it"></div>
              <p class="wiz-routes-dots" aria-hidden="true"></p>
              <button type="button" class="wiz-routes-more" hidden></button>
              <p class="wiz-routes-pick" aria-live="polite"></p>
            </div>
            <div class="wiz-choose" role="radiogroup" aria-label="What would you like to do next?">
              <p class="wiz-contact-title">What’s next?</p>
              <div class="wiz-choose-list">
                <button type="button" role="radio" aria-checked="true" data-next="send"><span class="wiz-choose-icon" aria-hidden="true">✉︎</span><strong>Send the brief</strong><small>Grant replies within 1 business day</small></button>
                <button type="button" role="radio" aria-checked="false" data-next="call"><span class="wiz-choose-icon" aria-hidden="true">☏</span><strong>Talk it through</strong><small>Ask for a 15-minute call</small></button>
                <button type="button" role="radio" aria-checked="false" data-next="later"><span class="wiz-choose-icon" aria-hidden="true">↓</span><strong>Keep it for later</strong><small>PDF, share link or email it to yourself</small></button>
              </div>
            </div>
            <div class="wiz-later" hidden>
              <p class="wiz-contact-title">Keep it for later</p>
              <p class="wiz-routes-help">Your answers are also saved on this device, so you can come back to them.</p>
              <div class="wiz-later-list">
                <button type="button" class="wiz-later-pdf"><strong>Download the PDF</strong><small>Your estimate and brief, ready to share</small></button>
                <button type="button" class="wiz-later-link wiz-share"><strong>Copy a share link</strong><small>Opens these answers on any device</small></button>
                <a class="wiz-later-mail" href="#"><strong>Email it to yourself</strong><small>The brief, in your own inbox</small></a>
                <button type="button" class="wiz-copy"><strong>Copy the brief</strong><small>As text, to paste anywhere</small></button>
              </div>
            </div>
            <div class="wiz-contact" data-email={FORM_INBOX} data-cc={FORM_CC}>
              <p class="wiz-contact-title">Send it to Grant</p>
              <p class="wiz-sending-as"><span class="wiz-as-avatar" aria-hidden="true"></span><span class="wiz-as-text"></span><button type="button" class="wiz-as-edit">Change</button></p>
              <div class="wiz-contact-grid">
                <label><span>Company <em>Optional</em></span><input name="c-company" autocomplete="organization" placeholder="Your business name" /></label>
                <div class="wiz-site-field">
                  <label><span>Current website <em>Optional</em></span><input name="c-website" autocomplete="url" inputmode="url" placeholder="yourstore.com" /></label>
                  <label class="wiz-no-site"><input type="checkbox" name="c-nosite" /><span>I don’t have a website yet</span></label>
                </div>
                <label class="wiz-call-time" hidden>Best time for a call<select name="c-call"><option>Mornings</option><option>Afternoons</option><option>Evenings</option><option>Any time</option></select></label>
              </div>
              <button type="button" class="wiz-submit">Send to Grant <Arrow diagonal /></button>
              <p class="wiz-send-status" role="status" aria-live="polite"></p>
              <p class="wiz-send-note">Your details go only to Grant.</p>
              <p class="wiz-send-alt" hidden>Couldn’t send it? <a class="wiz-send" href={`mailto:${profile.email}`} data-email={profile.email}>Email it to Grant instead</a></p>
            </div>
            <div class="wiz-after">
              <div class="wiz-next-steps">
                <h3>What happens next</h3>
                <ol>
                  <li><strong>Grant reads your brief</strong><span>And replies within 1 business day.</span></li>
                  <li><strong>A short call</strong><span>About 15 minutes to confirm goals and details.</span></li>
                  <li><strong>A fixed-price proposal</strong><span>Scope, timeline and price, usually within 48 hours.</span></li>
                </ol>
              </div>
              <figure class="wiz-quote">
                <blockquote>“He’s just an absolute weapon when it comes to Shopify.”</blockquote>
                <figcaption>Carlos · CEO & Owner, MDO Digital</figcaption>
              </figure>
            </div>
          </section>
        </form>

        <div class="wiz-nav">
          <button class="wiz-back" type="button">← Back</button>
          <p class="wiz-hint" aria-hidden="true">Tip: press <kbd>1</kbd>–<kbd>9</kbd> to choose, <kbd>Enter</kbd> to continue</p>
          <button class="wiz-return" type="button" hidden>Back to where you were ↩</button>
          <button class="wiz-next" type="button">Continue <Arrow /></button>
        </div>
      </div>

      <aside class="wiz-summary" id="estimate-summary" aria-labelledby="estimate-heading">
        <p class="wiz-warning" role="note"><svg class="wiz-warning-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3 22 20.5H2L12 3Z" fill="currentColor" /><path d="M12 9.5v5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" /><circle cx="12" cy="17.4" r="1.3" fill="#fff" /></svg><span><strong>Not a quotation</strong> · a rough timeline guide, with no price or commitment</span></p>
        <h2 class="tiny-heading" id="estimate-heading">Your rough estimate</h2>
        <p class="wiz-result" aria-live="polite"><span class="wiz-num">—</span><span class="wiz-unit"></span></p>
        <p class="wiz-months" aria-live="polite"></p>
        <p class="wiz-caption">Answer a few questions to see a realistic timeline.</p>
        <p class="wiz-pick" hidden></p>
        <div class="wiz-phases" hidden>
          <div class="wiz-timeline">
            <div class="wiz-line" role="img"><span class="wiz-line-track"></span><span class="wiz-runner" aria-hidden="true"></span><span class="wiz-line-flag" aria-hidden="true"></span></div>
            <div class="wiz-weeks-scale" aria-hidden="true"><span>Kick-off</span><span class="wiz-weeks-end">Launch</span></div>
          </div>
          <ul class="wiz-legend"></ul>
          <p class="wiz-phase-why" aria-live="polite">Tap a colour to see what happens in it.</p>
        </div>
        <div class="wiz-drivers" hidden>
          <h3>What’s driving the time</h3>
          <ul></ul>
        </div>
        <div class="wiz-examples wiz-examples-side" hidden data-projects={JSON.stringify(examples)}><h3 class="wiz-examples-title"></h3><div class="wiz-examples-list"></div></div>
        <details class="wiz-answers" hidden><summary>Your answers <span></span></summary><ul></ul></details>
        <ul class="wiz-notes"></ul>
        <div class="wiz-actions">
          <button class="wiz-to-send" type="button">Send this brief to Grant <Arrow diagonal /></button>
          <button class="wiz-pdf" type="button" disabled>Download summary (PDF)</button>
        </div>
        <p class="wiz-disclaimer">Calendar time for one developer, assuming feedback within a couple of days.</p>
      </aside>
    </div>
  </div>
  <a class="estimate-bar" href="#estimate-summary" aria-hidden="true" tabindex="-1"><span>Estimate</span><strong class="bar-value">—</strong><span>View ↓︎</span></a>
</BaseLayout>
<script>
  import { steps, estimate, planFor, type Answers, type Estimate, type Phase } from '../data/estimator';
  import { supportInquiryNotes, vipSupport } from '../data/support-plans';
  import { formEndpoint } from '../data/forms';
  import { sourceFields } from '../scripts/lead-source';
  import { sendLead } from '../scripts/leads';
  import { humanCheck } from '../scripts/turnstile';

  const wizard = document.querySelector<HTMLElement>('[data-wizard]');
  if (wizard) {
    const form = wizard.querySelector<HTMLFormElement>('.wiz-form')!;
    const back = wizard.querySelector<HTMLButtonElement>('.wiz-back')!;
    const next = wizard.querySelector<HTMLButtonElement>('.wiz-next')!;
    const fill = wizard.querySelector<HTMLElement>('.wiz-fill')!;
    const track = wizard.querySelector<HTMLElement>('.wiz-track')!;
    const dots = wizard.querySelector<HTMLOListElement>('.wiz-dots')!;
    const current = wizard.querySelector('.wiz-current')!;
    const total = wizard.querySelector('.wiz-total')!;
    const reviewList = wizard.querySelector('.wiz-review-list')!;
    const summary = wizard.querySelector<HTMLElement>('.wiz-summary')!;
    const num = summary.querySelector<HTMLElement>('.wiz-num')!;
    const unit = summary.querySelector('.wiz-unit')!;
    const caption = summary.querySelector('.wiz-caption')!;
    const disclaimer = summary.querySelector('.wiz-disclaimer')!;
    const phasesBox = summary.querySelector<HTMLElement>('.wiz-phases')!;
    const legend = summary.querySelector('.wiz-legend')!;
    const driversBox = summary.querySelector<HTMLElement>('.wiz-drivers')!;
    const notesList = summary.querySelector('.wiz-notes')!;
    const send = wizard.querySelector<HTMLAnchorElement>('.wiz-send')!;
    const copy = wizard.querySelector<HTMLButtonElement>('.wiz-copy')!;
    const share = wizard.querySelector<HTMLButtonElement>('.wiz-share')!;
    const toSend = summary.querySelector<HTMLButtonElement>('.wiz-to-send')!;
    const contactBox = wizard.querySelector<HTMLElement>('.wiz-contact')!;
    const submit = contactBox.querySelector<HTMLButtonElement>('.wiz-submit')!;
    const sendStatus = contactBox.querySelector<HTMLElement>('.wiz-send-status')!;
    const field = (name: string) => wizard.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
    const startNote = wizard.querySelector<HTMLElement>('.wiz-start-note')!;
    // One widget on the first step; reset after each send, since a token works once.
    const human = humanCheck(wizard.querySelector<HTMLElement>('[data-human-check]'));
    const sendingAs = contactBox.querySelector<HTMLElement>('.wiz-as-text')!;
    const restored = document.querySelector<HTMLElement>('.wiz-restored')!;
    const pdfButton = summary.querySelector<HTMLButtonElement>('.wiz-pdf')!;
    const monthsLine = summary.querySelector('.wiz-months')!;
    const barValue = document.querySelector('.bar-value');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The timeline: one line of phases from kick-off to launch (the flag), hatched past the likely end.
    const weeksGrid = summary.querySelector<HTMLElement>('.wiz-line')!;
    const weeksEnd = summary.querySelector<HTMLElement>('.wiz-weeks-end')!;
    const phaseWhy = summary.querySelector<HTMLElement>('.wiz-phase-why')!;
    const pickLine = summary.querySelector<HTMLElement>('.wiz-pick')!;
    const answersBox = summary.querySelector<HTMLDetailsElement>('.wiz-answers')!;
    const routesBox = wizard.querySelector<HTMLElement>('.wiz-routes')!;
    const routesList = routesBox.querySelector<HTMLElement>('.wiz-routes-list')!;
    const returnButton = wizard.querySelector<HTMLButtonElement>('.wiz-return')!;
    const keyHint = wizard.querySelector<HTMLElement>('.wiz-hint')!;
    const chooser = wizard.querySelector<HTMLElement>('.wiz-choose')!;
    const later = wizard.querySelector<HTMLElement>('.wiz-later')!;
    const laterMail = later.querySelector<HTMLAnchorElement>('.wiz-later-mail')!;
    const callTime = wizard.querySelector<HTMLElement>('.wiz-call-time')!;
    type Example = { name: string; platform: string; category: string; href: string; img: string };
    const exampleData = JSON.parse(summary.querySelector<HTMLElement>('.wiz-examples-side')!.dataset.projects || '[]') as Example[];

    /* ---------- Why each part takes the time it does ---------- */
    const PHASE_WHY: Record<string, string> = {
      discovery: 'Agreeing goals, pages and features before any code, so the build never changes direction halfway.',
      Audit: 'Measuring what’s slow or broken first, so the fixes target what actually matters.',
      design: 'Pages designed and signed off before the build starts.',
      build: 'Building every layout and feature, tested as it goes on phones and desktops.',
      Fixes: 'The fixes themselves, each one tested before it goes live.',
      data: 'Moving products, customers and content across, then checking it all arrived.',
      content: 'Writing and gathering copy and photos. It runs alongside the build.',
      qa: 'Testing on real phones and browsers, fixing what turns up, then the launch itself.',
    };
    const DRIVER_WHY: Record<string, string> = {
      'Subscriptions': 'Recurring orders need an app set up, plus testing renewals and the customer portal.',
      'B2B / wholesale': 'Separate prices, customer groups and order rules, each tested on its own.',
      'Product customiser': 'Build-your-own options are custom code: every combination has to price and show correctly.',
      'Advanced filters & search': 'Filters rely on tidy product data, which usually needs setting up first.',
      'Bundles & upsells': 'Offers on product pages and in the cart, tested so prices always add up.',
      'Reviews & loyalty': 'Connecting and styling the review and rewards apps to match the store.',
      'Multiple markets': 'Each currency or language needs its own prices, translations and checks.',
      'Pre-orders': 'Stock rules and back-in-stock alerts, tested against real orders.',
      'Checkout customisation': 'Built with Shopify’s upgrade-safe checkout tools and tested end to end.',
      'CMS collections': 'Setting up the content structure so your team can add posts and pages themselves.',
      'Advanced interactions': 'Scroll animations are built and tuned by hand, then checked for speed on phones.',
      'Localisation': 'Every page in each language, plus the language switch and SEO for each.',
      'Members-only areas': 'Sign-up, log-in and gated pages, usually through a membership tool.',
      'Webflow Ecommerce': 'Products, cart and checkout set up and styled inside Webflow.',
      'Email marketing': 'Connecting sign-up forms and store events to your email tool.',
      'CRM integration': 'Sending leads or customers to your CRM, matched field by field.',
      'Tracking setup': 'Analytics and ad tracking installed and checked, so the numbers can be trusted.',
      'Search integration': 'A hosted search tool connected and styled.',
      'Inventory / ERP link': 'Two systems kept in sync. It depends on the other system’s API, so it’s the least predictable part.',
      'Custom API work': 'Custom code against another service, including what happens when it’s down or slow.',
      'Customer migration': 'Accounts moved across, with a plan for passwords (most platforms can’t move them).',
      'Order history': 'Past orders imported so customers and your team can still see them.',
      'Blog & page migration': 'Posts and pages moved and checked, so nothing is lost or broken.',
      'Redirects & SEO': 'Every old link pointed at its new page, so search rankings carry over.',
      'Speed work': 'An audit first, then fixes aimed at what really slows the site down.',
      'Technical SEO': 'Fixing what stops search engines reading the site properly.',
      'Accessibility pass': 'Checking every template with a keyboard and screen reader, then fixing what fails.',
      'App clean-up': 'Removing apps you don’t need, and the code they leave behind.',
      'Fixes': 'Bugs and small changes, each tested before it goes live.',
      'Product setup': 'Adding and organising products, variants and collections.',
      'Product data migration': 'Products, variants and images moved across and checked.',
      'Design phase': 'Pages designed and approved before the build starts.',
      'Content preparation': 'Writing and gathering copy and photos in time for launch.',
    };
    const driverWhy = (label: string) => DRIVER_WHY[label]
      ?? (label.startsWith('Migrating from') ? 'Getting the data out of the old platform in a usable shape, and mapping it to the new one.'
        : / page layouts$/.test(label) ? 'Each layout beyond the first five is built into the theme and tested on every screen size.' : '');
    const phaseWhyText = (p: Phase) => PHASE_WHY[p.label] ?? PHASE_WHY[p.id] ?? '';

    /* ---------- The timeline, week by week ---------- */
    // One square per week (two weeks once the range passes 30), coloured by phase. Squares up to the low
    // end of the range are solid; the rest, up to the high end, are hatched ("might run to"). The last one
    // carries a launch flag. New squares pop in; changed ones recolour.
    const renderWeeks = (phases: Phase[], low: number, high: number) => {
      const total = phases.reduce((s, p) => s + p.weeks, 0) || 1;
      // The phases share the likely weeks; a hatched end runs on to the high end of the range.
      const lineTrack = summary.querySelector<HTMLElement>('.wiz-line-track')!;
      const key = `${phases.map((p) => `${p.id}:${p.weeks.toFixed(2)}`).join()}|${low}|${high}`;
      if (lineTrack.dataset.key !== key) {
        lineTrack.dataset.key = key;
        lineTrack.innerHTML = phases.map((p) => `<i class="phase-${p.id}" data-phase="${p.id}" title="${p.label}: ~${p.display}" style="flex-grow:${((p.weeks / total) * low).toFixed(3)}"></i>`).join('') + (high > low ? `<i class="is-maybe" title="Possible extra time" style="flex-grow:${high - low}"></i>` : '');
      }
      weeksGrid.setAttribute('aria-label', `About ${low} to ${high} weeks: ${phases.map((p) => `${p.label} about ${p.display}`).join(', ')}.`);
      weeksEnd.textContent = `Launch · week ${high}`;
    };
    // Tap or hover a phase (in the legend or on the line) to see what happens in it.
    let shownPhases: Phase[] = [];
    const focusPhase = (id: string | null) => {
      weeksGrid.dataset.focus = id ?? '';
      legend.querySelectorAll<HTMLElement>('button[data-phase]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.phase === id)));
      const p = shownPhases.find((x) => x.id === id);
      phaseWhy.textContent = p ? `${p.label}, about ${p.display}: ${phaseWhyText(p)}` : 'Tap a colour to see what happens in it.';
    };

    /* ---------- The finish: the timeline draws itself ---------- */
    // When someone reaches their brief, a line runs from kick-off to launch, colouring each phase as it
    // passes; the launch flag goes up at the end, and the number follows in. Plays once per arrival, when
    // the summary is on screen (on phones it sits below the questions).
    let finishPending = false;
    let summaryOnScreen = false;
    const playFinish = () => {
      if (!finishPending || !summaryOnScreen || !lastResult || lastResult.mode !== 'weeks') return;
      finishPending = false;
      summary.classList.remove('is-finishing'); void summary.offsetWidth; summary.classList.add('is-finishing');
      window.setTimeout(() => summary.classList.remove('is-finishing'), 2600);
    };
    new IntersectionObserver(([entry]) => { summaryOnScreen = entry.isIntersecting; playFinish(); }, { threshold: 0.35 }).observe(summary);

    /* ---------- Example projects for the platform picked ---------- */
    const PLATFORM_OF: Record<string, string> = { shopify: 'Shopify', 'shopify-plus': 'Shopify', webflow: 'Webflow', wordpress: 'WordPress', woocommerce: 'WordPress' };
    // The sidebar follows the answer; the list under the platform question also follows whichever
    // platform is being hovered or focused, so the examples show before anything is clicked.
    let hoverPlatform = '';
    const renderExamples = () => {
      fillExamples(wizard.querySelectorAll<HTMLElement>('.wiz-examples-side'), String(answers.platform || ''));
      fillExamples(wizard.querySelectorAll<HTMLElement>('.wiz-examples-inline'), hoverPlatform || String(answers.platform || ''));
    };
    const fillExamples = (boxes: NodeListOf<HTMLElement>, picked: string) => {
      const platform = PLATFORM_OF[picked];
      const list = picked ? (platform ? exampleData.filter((e) => e.platform === platform) : exampleData) : [];
      const chosen = list.slice(0, 3);
      const title = platform ? `Built on ${platform}, like these` : 'Some recent work';
      boxes.forEach((box) => {
        box.hidden = !chosen.length;
        box.querySelector('.wiz-examples-title')!.textContent = title;
        const holder = box.querySelector<HTMLElement>('.wiz-examples-list')!;
        const key = chosen.map((e) => e.href).join();
        if (holder.dataset.key === key) return;
        holder.dataset.key = key;
        holder.replaceChildren(...chosen.map((e, i) => {
          const a = document.createElement('a');
          a.className = 'wiz-example';
          a.href = e.href; a.target = '_blank'; a.rel = 'noopener';
          a.style.setProperty('--i', String(i));
          const img = Object.assign(document.createElement('img'), { src: e.img, alt: '', width: 480, height: 270, loading: 'lazy', decoding: 'async' });
          a.append(img, Object.assign(document.createElement('strong'), { textContent: e.name }), Object.assign(document.createElement('small'), { textContent: e.category }));
          a.setAttribute('aria-label', `${e.name}, ${e.category} (opens in a new tab)`);
          return a;
        }));
      });
    };

    const platformStep = form.querySelector<HTMLElement>('.wiz-step[data-step="platform"]');
    if (platformStep) {
      const preview = (event: Event) => {
        const option = (event.target as HTMLElement).closest<HTMLElement>('.wiz-option');
        const id = option?.dataset.option ?? '';
        if (id && id !== hoverPlatform) { hoverPlatform = id; renderExamples(); }
      };
      const options = platformStep.querySelector<HTMLElement>('.wiz-options')!;
      options.addEventListener('pointerover', preview);
      options.addEventListener('focusin', preview);
      const clear = () => { if (hoverPlatform) { hoverPlatform = ''; renderExamples(); } };
      options.addEventListener('pointerleave', clear);
      options.addEventListener('focusout', (event) => { if (!options.contains((event as FocusEvent).relatedTarget as Node)) clear(); });
    }

    /* ---------- Your answers, each one a tap away from changing ---------- */
    const renderAnswers = () => {
      const items = visibleSteps().filter((s) => s.kind !== 'text' && answerText(s.id));
      // On the review step the brief itself lists every answer with an Edit button, so this would repeat it.
      answersBox.hidden = items.length < 2 || at === 'review';
      answersBox.querySelector('summary span')!.textContent = `(${items.length})`;
      answersBox.querySelector('ul')!.replaceChildren(...items.map((s) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button'; b.dataset.go = s.id;
        b.setAttribute('aria-label', `Change ${s.label}: ${answerText(s.id)}`);
        b.append(Object.assign(document.createElement('span'), { textContent: s.label }), Object.assign(document.createElement('strong'), { textContent: answerText(s.id) }), Object.assign(document.createElement('em'), { textContent: 'Change' }));
        li.append(b);
        return li;
      }));
    };

    /* ---------- Ways to build it, and which one they prefer ---------- */
    let preferred = '';
    let previewRoute = '';
    const ROUTE_PLAN: Record<string, [number, boolean]> = { standard: [1, false], team2: [2, false], team3: [3, false], phase: [1, true], priority: [1, true] };
    /** The route to show in the summary: the one being hovered, else the one they picked (if it isn't already the result). */
    const viewOf = (r: Estimate) => {
      const id = previewRoute || preferred;
      if (r.mode !== 'weeks' || !id || id === (r.choice ?? 'standard')) return null;
      const route = r.routes.find((x) => x.id === id);
      if (!route) return null;
      const plan = ROUTE_PLAN[id] ? planFor(r, ...ROUTE_PLAN[id]) : id === 'both' ? planFor(r, Math.max(...r.teams.map((t) => t.n)), true) : null;
      return { id, low: route.low, high: route.high, phases: plan?.phases ?? r.basePhases, label: routeName(route), cost: route.cost, preview: Boolean(previewRoute) };
    };
    const FIT: Record<string, string> = { fits: 'Fits your date', close: 'A little past your date', far: 'Well past your date' };
    // Plain-English names for each route, with the team detail underneath.
    const ROUTE_NAME: Record<string, [string, string]> = {
      standard: ['Steady', '1 developer, full scope'], team2: ['Faster', '2 developers, full scope'], team3: ['Fastest full build', '3 developers, full scope'],
      phase: ['Launch sooner, add later', '1 developer, essentials first'], priority: ['Biggest fixes first', '1 developer, highest impact first'],
      theme: ['From a ready-made theme', '1 developer, premium theme'], both: ['Quickest launch', 'Essentials first, bigger team'],
    };
    const routeName = (x: { id: string; label: string }) => ROUTE_NAME[x.id]?.[0] ?? x.label;
    const ROUTE_COST: Record<string, number> = { theme: 1, standard: 1, phase: 1, priority: 1, team2: 2, team3: 3, both: 3 };
    // Fewer cards: the standard way, the best fit for their date, the fastest (and their pick), with the rest behind "Show more ways".
    let showAllRoutes = false;
    let routeOrder: string[] = [];
    const renderRoutes = (r: Estimate) => {
      const routes = r.mode === 'weeks' ? r.routes : [];
      routesBox.hidden = routes.length < 2;
      if (routesBox.hidden) return;
      const wanted = preferred || r.choice || 'standard';
      const current = routes.some((x) => x.id === wanted) ? wanted : 'standard';
      const max = Math.max(...routes.map((x) => x.high)) || 1;
      const fitting = routes.filter((x) => x.fit === 'fits').sort((a, b) => (ROUTE_COST[a.id] ?? 2) - (ROUTE_COST[b.id] ?? 2) || a.low - b.low);
      const best = fitting[0]?.id;
      const fastest = [...routes].sort((a, b) => a.low - b.low)[0]?.id;
      // The order never changes with the pick (so nothing moves under the cursor); a picked extra just stays shown.
      const main = new Set(['standard', best, fastest].filter(Boolean) as string[]);
      const tagOf = (id: string) => (id === best ? 'Best fit for your date' : id === fastest ? 'Fastest' : id === 'standard' ? 'The standard way' : '');
      const ordered = [...routes.filter((x) => main.has(x.id)), ...routes.filter((x) => !main.has(x.id))];
      routeOrder = ordered.map((x) => x.id);
      routesList.replaceChildren(...ordered.map((x) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = `wiz-route${main.has(x.id) || x.id === current ? '' : ' is-extra'}${x.id === best ? ' is-best' : ''}`; b.dataset.route = x.id;
        b.setAttribute('aria-pressed', String(x.id === current));
        const tag = tagOf(x.id);
        b.innerHTML = `${tag ? `<span class="wiz-route-tag"></span>` : ''}<strong class="wiz-route-name"></strong><span class="wiz-route-sub"></span><span class="wiz-route-weeks">${x.low}–${x.high} weeks</span><span class="wiz-route-bar" aria-hidden="true"><i style="width:${((x.low / max) * 100).toFixed(1)}%"></i><i style="width:${(((x.high - x.low) / max) * 100).toFixed(1)}%"></i></span><small></small>${x.fit ? `<em data-fit="${x.fit}">${FIT[x.fit]}</em>` : ''}`;
        if (tag) b.querySelector('.wiz-route-tag')!.textContent = `${x.id === best ? '★ ' : ''}${tag}`;
        b.querySelector('.wiz-route-name')!.textContent = routeName(x);
        b.querySelector('.wiz-route-sub')!.textContent = ROUTE_NAME[x.id]?.[1] ?? x.label;
        b.querySelector('small')!.textContent = x.cost;
        b.setAttribute('aria-label', `${routeName(x)}: ${ROUTE_NAME[x.id]?.[1] ?? x.label}, ${x.low} to ${x.high} weeks, ${x.cost}${x.fit ? `, ${FIT[x.fit]}` : ''}`);
        return b;
      }));
      const extra = routes.filter((x) => !main.has(x.id) && x.id !== current).length;
      const more = routesBox.querySelector<HTMLButtonElement>('.wiz-routes-more')!;
      more.hidden = extra < 1;
      more.textContent = showAllRoutes ? 'Show fewer' : `Show ${extra} more way${extra > 1 ? 's' : ''}`;
      routesBox.classList.toggle('is-all', showAllRoutes);
      const picked = routes.find((x) => x.id === current);
      routesBox.querySelector('.wiz-routes-pick')!.innerHTML = picked ? `Your pick: <strong>${routeName(picked)} · ${picked.low}–${picked.high} weeks</strong>` : '';
      syncRouteDots();
    };
    // Phones: the cards are a swipe row; dots show where you are in it.
    const routesDots = routesBox.querySelector<HTMLElement>('.wiz-routes-dots')!;
    const syncRouteDots = () => {
      const cards = [...routesList.querySelectorAll<HTMLElement>('.wiz-route')].filter((c) => c.offsetParent !== null);
      const step = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : 1;
      const at = Math.round(routesList.scrollLeft / (step || 1));
      routesDots.innerHTML = cards.length > 1 ? cards.map((_, i) => `<i class="${i === at ? 'on' : ''}"></i>`).join('') : '';
    };
    routesList.addEventListener('scroll', () => requestAnimationFrame(syncRouteDots), { passive: true });
    routesBox.querySelector('.wiz-routes-more')!.addEventListener('click', () => {
      showAllRoutes = !showAllRoutes;
      // The extra cards rise in only when they're first shown, not on every redraw.
      routesBox.classList.toggle('is-revealing', showAllRoutes);
      window.setTimeout(() => routesBox.classList.remove('is-revealing'), 600);
      if (lastResult) renderRoutes(lastResult);
    });
    let pickedAt = 0;
    routesList.addEventListener('click', (event) => {
      const b = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-route]');
      if (!b) return;
      pickedAt = performance.now();
      preferred = b.dataset.route!;
      previewRoute = '';
      routesList.querySelectorAll('[data-route]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      renderSummary();
      saveProgress();
    });
    // Hovering a route previews it in the summary (desktop); leaving goes back to the one picked.
    routesList.addEventListener('pointerover', (event) => {
      const b = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-route]');
      // (Cards are redrawn after a pick; the cursor "arriving" on the new ones isn't a hover.)
      if (!b || (event as PointerEvent).pointerType !== 'mouse' || performance.now() - pickedAt < 400) return;
      // Hovering the one already picked is no preview.
      const id = b.dataset.route === (preferred || (lastResult?.choice ?? 'standard')) ? '' : b.dataset.route!;
      if (id !== previewRoute) { previewRoute = id; renderSummary(); }
    });
    routesList.addEventListener('pointerleave', () => { if (previewRoute) { previewRoute = ''; renderSummary(); } });

    /* ---------- What's next: send, ask for a call, or keep it for later ---------- */
    let nextChoice: 'send' | 'call' | 'later' = 'send';
    const timeZone = (() => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone; } catch { return ''; } })();
    const callLine = () => `Next step: a 15-minute call, ${(wizard.querySelector<HTMLSelectElement>('[name="c-call"]')!.value || 'any time').toLowerCase()}${timeZone ? ` (${timeZone})` : ''}`;

    let answers: Answers = {};
    let at = 'contact';
    // The furthest step reached, so someone who goes back to change one answer can jump straight back.
    let furthest = 'contact';
    // Contact details (name and email on the first step, the rest on the review), and one reference per brief.
    let contact = { name: '', email: '', company: '', website: '' };
    const NO_SITE = 'No website yet';
    // The email Grant was already told about when this person started, so it's sent once.
    let captured = '';
    const newRef = () => `EST-${new Date().toLocaleDateString('en-CA').replace(/-/g, '')}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`;
    // Saved with the progress, so the "started" email and the final brief share it across reloads.
    let ref = newRef();
    let sent = false;
    let brief = '';
    let shown = { low: 0, high: 0 };
    let estimateSummary = '';
    let lastResult: Estimate | null = null;
    // The first step is server-rendered visible, so it doesn't animate in or shift the layout on load.
    let lastShownStep = 'contact';
    const emailOk = (email: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    // "About 1½–2 months" under the weeks (4.345 weeks in a month).
    const half = (m: number) => (m % 1 ? `${Math.floor(m) || ''}½` : `${m}`);
    const monthsText = (low: number, high: number) => {
      if (high <= 4) return 'Under a month';
      const ml = Math.max(0.5, Math.round((low / 4.345) * 2) / 2);
      const mh = Math.max(ml, Math.round((high / 4.345) * 2) / 2);
      return ml === mh ? `About ${half(mh)} month${mh > 1 ? 's' : ''}` : `About ${half(ml)}–${half(mh)} months`;
    };

    const visibleSteps = () => steps.filter((step) => !step.when || step.when(answers));
    const order = () => ['contact', ...visibleSteps().map((step) => step.id), 'review'];
    const section = (id: string) => form.querySelector<HTMLElement>(`[data-step="${id}"]`)!;
    const stepById = (id: string) => steps.find((step) => step.id === id);
    const labelOf = (id: string) => (id === 'contact' ? 'You' : stepById(id)?.label ?? id);

    // Only answers from steps that still apply count (e.g. store features drop out if you switch to Webflow).
    const effective = (): Answers => {
      const live: Answers = {};
      for (const step of visibleSteps()) if (answers[step.id] !== undefined) live[step.id] = answers[step.id];
      return live;
    };

    const read = (id: string) => {
      const step = stepById(id);
      if (!step) return;
      const el = section(id);
      if (step.kind === 'single') answers[id] = el.querySelector<HTMLInputElement>('input:checked')?.value;
      if (step.kind === 'multi') answers[id] = [...el.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value);
      if (step.kind === 'range') answers[id] = Number(el.querySelector<HTMLInputElement>('input')!.value);
      if (step.kind === 'text') answers[id] = el.querySelector('textarea')!.value.trim();
    };

    // Hide options that don't apply (e.g. checkout customisation unless Shopify Plus).
    const syncOptions = () => {
      for (const step of steps) {
        if (!step.options) continue;
        for (const option of step.options) {
          const label = section(step.id).querySelector<HTMLElement>(`[data-option="${option.id}"]`)!;
          const ok = !option.when || option.when(answers);
          label.hidden = !ok;
          if (!ok) label.querySelector('input')!.checked = false;
          // Live hints, e.g. how realistic each launch date is for this project.
          if (option.hintFor && ok) { const hint = option.hintFor(answers); label.querySelector('small')!.textContent = hint; label.dataset.fit = hint.startsWith('Not realistic') || hint.startsWith('Very tight') ? 'no' : hint.startsWith('Fits') ? 'yes' : ''; }
        }
        read(step.id);
        // Number the visible options 1, 2, 3… for keyboard shortcuts.
        let n = 0;
        section(step.id).querySelectorAll<HTMLElement>('.wiz-option').forEach((label) => { if (!label.hidden) label.querySelector('.wiz-key')!.textContent = String(++n); });
      }
    };

    const answered = (id: string) => {
      if (id === 'contact') return Boolean(contact.name) && emailOk(contact.email);
      const step = stepById(id);
      if (!step || step.optional || step.kind === 'range' || step.kind === 'text') return true;
      const value = answers[id];
      return Array.isArray(value) ? value.length > 0 : Boolean(value);
    };

    const answerText = (id: string) => {
      const step = stepById(id)!;
      const value = answers[id];
      if (step.kind === 'range') return `${value} ${step.range?.unit}`;
      if (step.kind === 'text') return String(value || '');
      const ids = Array.isArray(value) ? value : value ? [value] : [];
      return ids.map((v) => step.options?.find((o) => o.id === v)?.label ?? v).join(', ');
    };

    const animateNumbers = (low: number, high: number) => {
      const from = { ...shown };
      shown = { low, high };
      if (reduce || (!from.low && !from.high)) { num.textContent = `${low}–${high}`; return; }
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / 450);
        const e = 1 - (1 - p) ** 3;
        num.textContent = `${Math.round(from.low + (low - from.low) * e)}–${Math.round(from.high + (high - from.high) * e)}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const renderSummary = () => {
      form.querySelectorAll<HTMLElement>('[data-compact-plan]').forEach(card => {
        const selected = answers.type === 'support' && card.dataset.compactPlan === String(answers.hours);
        card.classList.toggle('is-selected', selected);
        card.querySelector<HTMLElement>('.mini-selected')!.hidden = !selected;
        const button = card.querySelector<HTMLButtonElement>('[data-support-plan]')!;
        button.setAttribute('aria-pressed', String(selected));
        button.querySelector('[data-select-label]')!.textContent = `${selected ? 'Selected' : 'Select'} ${button.dataset.planName}`;
      });
      const live = effective();
      const result: Estimate = estimate(live);
      lastResult = result;
      // A route picked (or hovered) on the review step shows its own timeline.
      const view = viewOf(result);
      const low = view?.low ?? result.low, high = view?.high ?? result.high;
      const phases = view?.phases ?? result.phases;
      pickLine.hidden = !view;
      pickLine.textContent = view ? `${view.preview ? 'Previewing' : 'Your pick'}: ${view.label} · ${view.cost}` : '';
      monthsLine.textContent = result.mode === 'weeks' ? monthsText(low, high) : '';
      pdfButton.disabled = result.mode === 'none';
      if (result.mode === 'none') {
        num.textContent = '—'; unit.textContent = ''; shown = { low: 0, high: 0 };
        caption.textContent = 'Answer a few questions to see a realistic timeline.';
      } else if (result.mode === 'monthly') {
        const plan = result.support!;
        num.textContent = `${plan.daily || result.hours}`; unit.textContent = plan.daily ? 'hrs / day' : 'hrs / month'; shown = { low: 0, high: 0 };
        const reply = plan.id === 'vip' ? `${vipSupport.reply}. ${vipSupport.emergency.replace(/\.$/, '')}` : plan.reply;
        caption.textContent = `${plan.name} plan${plan.recommended ? ', a good place to start' : ''}${plan.daily ? ', Monday to Friday' : ''}. ${reply}. Move up or down with a month’s notice.`;
      } else {
        animateNumbers(low, high);
        unit.textContent = 'weeks';
        const scenario = result.scenario ? `${result.scenario}.${result.baseline && (result.baseline.low !== result.low || result.baseline.high !== result.high) ? ` One developer, full scope: ${result.baseline.low}–${result.baseline.high} weeks.` : ''}` : '';
        const fit = result.fit === 'close' ? 'A little past your date: see the tip below.' : result.fit === 'far' ? 'Well past your date: see the tip below.' : result.tight ? 'Tighter than your deadline: see the tip below.' : '';
        caption.textContent = [scenario, fit || (scenario ? '' : 'Typical calendar time from kick-off to launch.')].filter(Boolean).join(' ');
      }
      summary.classList.toggle('is-tight', result.tight);
      disclaimer.textContent = result.mode === 'monthly'
        ? 'A set number of hours each month. Grant confirms the plan and price with you before anything starts.'
        : `Calendar time for ${result.team > 1 ? `a team of ${result.team} developers` : 'one developer'}, assuming feedback within a couple of days.`;
      if (barValue) barValue.textContent = result.mode === 'weeks' ? `${low}–${high} weeks` : result.mode === 'monthly' ? `${result.support?.name} · ${result.support?.daily ? `${result.support.daily} hrs / day` : `${result.hours} hrs / month`}` : '—';

      phasesBox.hidden = phases.length === 0 || result.mode !== 'weeks';
      shownPhases = phases;
      if (!phasesBox.hidden) renderWeeks(phases, low, high);
      const focused = weeksGrid.dataset.focus;
      legend.innerHTML = phases.map((p) => `<li><button type="button" data-phase="${p.id}" aria-pressed="false"><i class="phase-${p.id}"></i>${p.label}<span>~${p.display}</span></button></li>`).join('');
      focusPhase(focused && phases.some((p) => p.id === focused) ? focused : null);

      driversBox.hidden = result.drivers.length === 0;
      driversBox.querySelector('ul')!.innerHTML = result.drivers.map((d) => { const why = driverWhy(d.label); return `<li><span class="wiz-driver-row">${d.label}<span>+${Math.round(d.weeks * 10) / 10} wk</span></span>${why ? `<small>${why}</small>` : ''}</li>`; }).join('');
      renderExamples();
      renderAnswers();
      renderRoutes(result);
      notesList.innerHTML = result.notes.map((n) => `<li>${n}</li>`).join('');

      // Brief text for email / copy.
      const lines = visibleSteps().filter((s) => s.kind !== 'text' && answerText(s.id)).map((s) => `${s.label}: ${answerText(s.id)}`);
      const estimateLine = result.mode === 'weeks' ? `Rough estimate: ${result.low}–${result.high} weeks${result.scenario ? `, ${result.scenario.toLowerCase()}` : ''} (${result.phases.map((p) => `${p.label} ~${p.display}`).join(', ')})${result.baseline ? `\nOne developer, full scope: ${result.baseline.low}–${result.baseline.high} weeks` : ''}` : result.mode === 'monthly' ? `Support plan: ${result.support?.name}${result.support?.daily ? `, ${result.support.daily} hours a day, Monday to Friday` : `, about ${result.hours} hours a month`}` : '';
      const notes = String(live.notes || '');
      const who = [contact.name, contact.company, contact.email, contact.website].filter(Boolean);
      const chosenRoute = result.mode === 'weeks' && preferred ? result.routes.find((x) => x.id === preferred) : undefined;
      const extra = [
        ...(chosenRoute && preferred !== (result.choice ?? 'standard') ? [`Preferred approach: ${routeName(chosenRoute)} (${chosenRoute.label}), about ${chosenRoute.low}–${chosenRoute.high} weeks (${chosenRoute.cost.toLowerCase()})`] : []),
        ...(nextChoice === 'call' ? [callLine()] : []),
      ];
      brief = ['Hi Grant,', '', 'I used the estimator on your site. Here’s my project:', '', ...lines, estimateLine, ...extra, ...(notes ? ['', `Notes: ${notes}`] : []), '', `Reference: ${ref}`, ...(who.length ? ['', `From: ${who.join(' · ')}`] : []), '', 'Thanks,'].filter((l, i, all) => !(l === '' && all[i - 1] === '')).join('\n');
      estimateSummary = estimateLine;
      const subject = `Project brief${answers.platform ? `: ${answerText('platform')}` : ''}${answers.type ? ` – ${answerText('type')}` : ''}`;
      send.href = `mailto:${send.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(brief)}`;
      laterMail.href = `mailto:${contact.email}?subject=${encodeURIComponent('My project estimate')}&body=${encodeURIComponent(brief)}`;
    };
    legend.addEventListener('click', (event) => { const b = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-phase]'); if (b) focusPhase(b.getAttribute('aria-pressed') === 'true' ? null : b.dataset.phase!); });
    weeksGrid.addEventListener('pointerover', (event) => { const part = (event.target as HTMLElement).closest<HTMLElement>('[data-phase]'); if (part) focusPhase(part.dataset.phase!); });
    weeksGrid.addEventListener('pointerleave', () => focusPhase(null));
    answersBox.addEventListener('click', (event) => { const b = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-go]'); if (b) go(b.dataset.go!, -1); });

    const renderReview = () => {
      reviewList.innerHTML = '';
      for (const step of visibleSteps()) {
        const text = answerText(step.id);
        const dt = document.createElement('dt');
        dt.textContent = step.label;
        const dd = document.createElement('dd');
        dd.textContent = text || '—';
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'wiz-edit';
        edit.textContent = 'Edit';
        edit.setAttribute('aria-label', `Edit ${step.label}`);
        edit.addEventListener('click', () => go(step.id, -1));
        dd.append(edit);
        reviewList.append(dt, dd);
      }
    };

    /** Where "Back to where you were" goes: the first unanswered question before the furthest step, else that step. */
    const returnTarget = () => {
      const ids = order();
      const i = ids.indexOf(at), f = ids.indexOf(furthest);
      if (f <= i || f < 0) return '';
      return ids.slice(i + 1, f).find((id) => !answered(id)) ?? furthest;
    };
    const render = (direction = 1) => {
      syncOptions();
      const ids = order();
      if (!ids.includes(at)) at = ids[0];
      const index = ids.indexOf(at);
      form.querySelectorAll<HTMLElement>('.wiz-step').forEach((el) => {
        const active = el.dataset.step === at;
        el.hidden = !active;
        el.classList.toggle('is-back', active && direction < 0);
        if (active && !reduce && at !== lastShownStep) { el.classList.remove('is-entering'); void el.offsetWidth; el.classList.add('is-entering'); }
      });
      const isReview = at === 'review';
      if (isReview) renderReview();
      current.textContent = String(Math.min(index + 1, ids.length - 1)).padStart(2, '0');
      total.textContent = String(ids.length - 1).padStart(2, '0');
      const progress = isReview ? 100 : Math.round((index / (ids.length - 1)) * 100);
      fill.style.transform = `scaleX(${progress / 100})`;
      track.setAttribute('aria-valuenow', String(progress));
      dots.innerHTML = ids.slice(0, -1).map((id, i) => `<li class="${i < index ? 'is-done' : i === index ? 'is-current' : ''}"><button type="button" data-go="${id}" ${i <= index || answered(id) ? '' : 'disabled'} aria-label="${labelOf(id)}">${labelOf(id)}</button></li>`).join('');
      if (!ids.includes(furthest) || index > ids.indexOf(furthest)) furthest = at;
      const target = returnTarget();
      returnButton.hidden = !target || isReview;
      keyHint.hidden = !returnButton.hidden;
      if (target) returnButton.textContent = target === 'review' ? 'Back to your brief ↩' : `Back to ${labelOf(target)} ↩`;
      // Phones: the step chips are one swipeable row; keep the current one in view.
      const currentChip = dots.querySelector<HTMLElement>('.is-current');
      if (currentChip && dots.scrollWidth > dots.clientWidth) dots.scrollTo({ left: currentChip.offsetLeft - dots.clientWidth / 2 + currentChip.offsetWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
      back.disabled = index === 0;
      next.hidden = isReview;
      const step = stepById(at);
      // Plain-English verdict under the options (e.g. whether the launch date is realistic).
      if (step?.noteFor) {
        const box = section(at).querySelector<HTMLElement>('.wiz-note')!;
        const note = step.noteFor(answers);
        box.hidden = !note;
        if (note) { box.dataset.tone = note.tone; box.querySelector('strong')!.textContent = note.title; box.querySelector('p')!.textContent = note.text; }
      }
      // Some help text depends on earlier answers (e.g. the one-developer timeline on the speed-up step).
      if (step?.helpFor) { const help = section(at).querySelector('.wiz-help'); const text = step.helpFor(answers); if (help && text) help.textContent = text; }
      next.disabled = !isReview && !answered(at);
      next.firstChild!.textContent = at === 'contact' ? 'Start the estimate ' : index === ids.length - 2 ? 'See my brief ' : step?.optional && !answered(at) ? 'Skip ' : 'Continue ';
      if (step?.optional && step.kind === 'multi') next.firstChild!.textContent = (answers[at] as string[] | undefined)?.length ? 'Continue ' : 'Skip ';
      wizard.classList.toggle('is-review', isReview);
      // Arriving at the brief: the timeline draws itself once the summary is on screen.
      if (isReview && lastShownStep !== 'review' && !reduce) finishPending = true;
      renderSendingAs();
      lastShownStep = at;
      renderSummary();
      saveProgress();
      playFinish();
    };

    const go = (id: string, direction: number) => {
      at = id;
      render(direction);
      const heading = section(at).querySelector<HTMLElement>('.wiz-question');
      heading?.focus({ preventScroll: true });
      const top = heading?.getBoundingClientRect().top ?? 0;
      if (top < 60 || top > innerHeight * 0.55) wizard.querySelector('.wiz-main')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    };
    let switching = false;
    // Set when a plan button on /plans/ opened the estimator (?plan=40):
    // after name and email, skip the questions the plan already answered.
    let fromPlan = false;
    const step = (delta: number) => {
      const ids = order();
      let index = ids.indexOf(at) + delta;
      if (fromPlan && at === 'contact' && delta > 0) {
        const open = ids.findIndex((id) => id !== 'contact' && !answered(id));
        index = open === -1 ? ids.indexOf('review') : open;
      }
      if (index < 0 || index >= ids.length || switching) return;
      if (at === 'contact' && delta > 0) captureLead();
      if (reduce) { go(ids[index], delta); return; }
      // The current question fades out first, then the next one slides in.
      switching = true;
      const leaving = section(at);
      leaving.classList.remove('is-entering');
      leaving.classList.add(delta > 0 ? 'is-leaving' : 'is-leaving-back');
      window.setTimeout(() => {
        leaving.classList.remove('is-leaving', 'is-leaving-back');
        switching = false;
        go(ids[index], delta);
      }, 180);
    };

    let autoTimer = 0;
    form.querySelectorAll<HTMLButtonElement>('[data-support-plan]').forEach(button => button.addEventListener('click', () => {
      if (at !== 'hours') return;
      const input = [...section('hours').querySelectorAll<HTMLInputElement>('input[name="hours"]')].find(input => input.value === button.dataset.supportPlan);
      if (!input) return;
      clearTimeout(autoTimer);
      input.checked = true;
      read('hours'); render(0);
      document.getElementById('support-comparison-status')!.textContent = `${button.dataset.planName} selected. Use Continue when you’re ready.`;
    }));
    form.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      const id = input.closest<HTMLElement>('.wiz-step')?.dataset.step;
      if (!id) return;
      read(id);
      render(0);
      // Phones: the platform's examples appear under all the options, so bring them (and Continue) into view.
      if (id === 'platform' && !matchMedia('(hover: hover)').matches) {
        const examples = section(id).querySelector<HTMLElement>('.wiz-examples-inline');
        if (examples && !examples.hidden) window.setTimeout(() => examples.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }), 120);
      }
      // Single choices move on by themselves after a short beat, unless the step shows a note to read.
      // (Not on the platform question: its examples are worth a look before moving on.)
      if (input.type === 'radio' && !stepById(id)?.noteFor && id !== 'platform') {
        clearTimeout(autoTimer);
        autoTimer = window.setTimeout(() => {
          if (at !== id) return;
          // Changing an earlier answer goes straight back to where they were (or to anything the change made new).
          const target = returnTarget();
          if (target && target !== order()[order().indexOf(at) + 1]) go(target, 1); else step(1);
        }, reduce ? 0 : 650);
      }
    });
    form.addEventListener('input', (event) => {
      const el = event.target as HTMLInputElement;
      const id = el.closest<HTMLElement>('.wiz-step')?.dataset.step;
      if (!id || (el.type !== 'range' && el.tagName !== 'TEXTAREA')) return;
      if (el.type === 'range') {
        const output = section(id).querySelector('output')!;
        output.textContent = `${el.value}${Number(el.value) >= Number(el.max) ? '+' : ''}`;
        el.style.setProperty('--fill', `${((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100}%`);
      }
      read(id);
      renderSummary();
    });
    form.addEventListener('submit', (event) => event.preventDefault());
    next.addEventListener('click', () => step(1));
    returnButton.addEventListener('click', () => { const target = returnTarget(); if (target) go(target, 1); });
    back.addEventListener('click', () => step(-1));
    dots.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-go]');
      if (target && !target.disabled) go(target.dataset.go!, -1);
    });

    // Keyboard: 1–9 pick an option, Enter continues (not while typing in the notes or contact fields).
    document.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const typing = (event.target as HTMLElement).closest('textarea, input[type="range"], input[type="text"], input[type="email"], input:not([type])');
      if (/^[1-9]$/.test(event.key) && !typing) {
        const options = [...section(at).querySelectorAll<HTMLElement>('.wiz-option')].filter((o) => !o.hidden);
        const input = options[Number(event.key) - 1]?.querySelector('input');
        if (input) { input.click(); event.preventDefault(); }
      }
      if (event.key === 'Enter' && !typing && !(event.target as HTMLElement).closest('button, a, summary') && !next.disabled && !next.hidden) {
        event.preventDefault();
        step(1);
      }
    });

    /** The estimate as the PDF should show it: the route they picked, if they picked one. */
    const pdfResult = (r: Estimate): Estimate => {
      const saved = previewRoute; previewRoute = '';
      const v = viewOf(r);
      previewRoute = saved;
      return v ? { ...r, low: v.low, high: v.high, phases: v.phases, scenario: `${v.label} · ${v.cost}` } : r;
    };
    const makePdf = async (button: HTMLElement) => {
      if (!lastResult || lastResult.mode === 'none') return;
      const labelNode = button.querySelector('strong') ?? button;
      const label = labelNode.textContent;
      labelNode.textContent = 'Preparing PDF…';
      button.toggleAttribute('disabled', true);
      try {
        const { downloadEstimatePdf } = await import('../scripts/estimate-pdf');
        const rows = visibleSteps().filter((s) => s.kind !== 'text' && answerText(s.id)).map((s) => [s.label, answerText(s.id)] as [string, string]);
        const shownResult = pdfResult(lastResult);
        await downloadEstimatePdf({
          rows,
          result: shownResult,
          months: shownResult.mode === 'weeks' ? monthsText(shownResult.low, shownResult.high) : '',
          notes: String(effective().notes || ''),
          email: send.dataset.email || '',
          answers: effective(),
          ref,
          contact,
        });
        labelNode.textContent = 'Downloaded';
      } catch (error) {
        console.warn('The estimate PDF could not be created:', error);
        labelNode.textContent = 'Couldn’t create the PDF';
      }
      window.setTimeout(() => { labelNode.textContent = label; button.toggleAttribute('disabled', false); }, 2200);
    };
    pdfButton.addEventListener('click', () => void makePdf(pdfButton));
    later.querySelector<HTMLButtonElement>('.wiz-later-pdf')!.addEventListener('click', (event) => void makePdf(event.currentTarget as HTMLElement));

    copy.addEventListener('click', async () => {
      const labelNode = copy.querySelector('strong')!;
      try { await navigator.clipboard.writeText(brief); labelNode.textContent = 'Brief copied'; }
      catch { labelNode.textContent = 'Couldn’t copy it'; }
      window.setTimeout(() => { labelNode.textContent = 'Copy the brief'; }, 2200);
    });

    /* ---------- Contact details, the early lead, and sending ---------- */
    const readContact = () => {
      const noSite = field('c-nosite').checked;
      contact = { name: field('c-name').value.trim(), email: field('c-email').value.trim(), company: field('c-company').value.trim(), website: noSite ? NO_SITE : field('c-website').value.trim() };
    };
    // "I don't have a website yet": the website field steps aside and Grant is told so.
    const syncNoSite = () => {
      const site = field('c-website'), none = field('c-nosite').checked;
      site.disabled = none;
      if (none) site.value = '';
    };
    field('c-nosite').addEventListener('change', () => { syncNoSite(); readContact(); renderSummary(); saveProgress(); });
    function renderSendingAs() {
      const ready = answered('contact');
      sendingAs.replaceChildren(...(ready
        ? [Object.assign(document.createElement('strong'), { textContent: contact.name }), Object.assign(document.createElement('span'), { textContent: contact.email })]
        : [Object.assign(document.createElement('span'), { textContent: 'Add your name and email first.' })]));
      contactBox.querySelector('.wiz-as-avatar')!.textContent = ready ? contact.name.trim().charAt(0).toUpperCase() : '?';
    }
    const focusContact = () => { field(contact.name ? 'c-email' : 'c-name').focus({ preventScroll: true }); };
    wizard.addEventListener('input', (event) => {
      if (!(event.target as HTMLInputElement).name?.startsWith('c-')) return;
      readContact();
      startNote.textContent = '';
      sendStatus.textContent = ''; sendStatus.dataset.tone = '';
      if (at === 'contact') next.disabled = !answered('contact');
      renderSendingAs();
      renderSummary();
      saveProgress();
    });
    // Say why Continue is greyed out, once they've left the email field.
    field('c-email').addEventListener('blur', () => {
      if (contact.email && !emailOk(contact.email)) startNote.textContent = 'That email doesn’t look right. Grant needs it to reply.';
    });
    section('contact').addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || !(event.target as HTMLElement).matches('input')) return;
      event.preventDefault();
      if (answered('contact')) step(1);
      else { startNote.textContent = !contact.name ? 'Please add your name.' : 'Please add a valid email.'; focusContact(); }
    });
    contactBox.querySelector('.wiz-as-edit')!.addEventListener('click', () => { go('contact', -1); focusContact(); });

    /** The full brief to the tracker's Inquiries inbox: answers, estimate and the PDF. Best effort, in parallel with the email. */
    async function sendBriefToTracker() {
      const live = effective();
      const answersByLabel: Record<string, string> = {};
      for (const s of visibleSteps()) { const text = answerText(s.id); if (text && s.kind !== 'text') answersByLabel[s.label] = text; }
      let pdf_base64: string | undefined;
      try {
        if (lastResult && lastResult.mode !== 'none') {
          const { estimatePdfBase64 } = await import('../scripts/estimate-pdf');
          const rows = visibleSteps().filter((s) => s.kind !== 'text' && answerText(s.id)).map((s) => [s.label, answerText(s.id)] as [string, string]);
          const shownResult = pdfResult(lastResult);
          pdf_base64 = await estimatePdfBase64({ rows, result: shownResult, months: shownResult.mode === 'weeks' ? monthsText(shownResult.low, shownResult.high) : '', notes: String(live.notes || ''), email: send.dataset.email || '', answers: live, ref, contact });
        }
      } catch { pdf_base64 = undefined; }
      const turnstile_token = await human.token();
      human.reset();
      await sendLead({
        kind: 'estimate', _honey: field('_honey').value, turnstile_token,
        name: contact.name, email: contact.email, company: contact.company, website: contact.website,
        reference: ref, estimate: estimateSummary, brief, budget: live.budget ? answerText('budget') : undefined,
        estimate_answers: answersByLabel, pdf_base64, ...sourceFields(),
      });
    }

    /**
     * Tells Grant someone started, so the lead isn't lost if they leave halfway.
     * Once per email; the full brief follows with the same reference if they finish.
     */
    function captureLead() {
      if (!answered('contact') || captured === contact.email || field('_honey').value) return;
      captured = contact.email;
      saveProgress();
      fetch(formEndpoint(contactBox.dataset.email!), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          _subject: `New estimator lead: ${contact.name}`,
          _cc: contactBox.dataset.cc || undefined,
          _template: 'table',
          _captcha: 'false',
          _honey: field('_honey').value,
          name: contact.name,
          email: contact.email,
          reference: ref,
          status: 'Started the estimator. If they finish, the full brief follows with the same reference.',
          ...sourceFields(),
        }),
      }).catch(() => { captured = ''; });
      // The tracker gets it too; the full brief later merges into this lead (same reference and email).
      void human.token().then((turnstile_token) => { void sendLead({ kind: 'estimate', _honey: field('_honey').value, turnstile_token, name: contact.name, email: contact.email, reference: ref, ...sourceFields() }); human.reset(); });
    }

    // The summary's button takes people to the review step (or to their name and email first).
    toSend.addEventListener('click', () => {
      if (at !== 'review') { const ids = order(); const missing = ids.slice(0, -1).find((id) => !answered(id)); go(missing ?? 'review', 1); if (missing) { if (missing === 'contact') focusContact(); return; } }
      window.setTimeout(() => { contactBox.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); submit.focus({ preventScroll: true }); }, 60);
    });
    const sendLabel = () => (nextChoice === 'call' ? 'Ask for a call ' : 'Send to Grant ');
    const setNext = (choice: typeof nextChoice) => {
      nextChoice = choice;
      chooser.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.next === choice)));
      later.hidden = choice !== 'later';
      contactBox.hidden = choice === 'later';
      callTime.hidden = choice !== 'call';
      contactBox.querySelector('.wiz-contact-title')!.textContent = choice === 'call' ? 'Ask for a call' : 'Send it to Grant';
      if (!sent && !submit.disabled) submit.firstChild!.textContent = sendLabel();
      renderSummary();
      saveProgress();
    };
    chooser.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => b.addEventListener('click', () => setNext(b.dataset.next as typeof nextChoice)));
    wizard.querySelector('[name="c-call"]')!.addEventListener('change', () => { renderSummary(); saveProgress(); });
    submit.addEventListener('click', async () => {
      readContact();
      if (!answered('contact')) {
        go('contact', -1);
        startNote.textContent = !contact.name ? 'Please add your name, so Grant knows who to reply to.' : 'Please add a valid email, so Grant can reply.';
        focusContact();
        return;
      }
      if (sent) { sendStatus.dataset.tone = 'ok'; sendStatus.textContent = 'Already sent. Grant will be in touch soon.'; return; }
      void sendBriefToTracker();
      const label = submit.innerHTML;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      sendStatus.textContent = '';
      try {
        // FormSubmit forwards the brief to Grant's inbox, with a copy to the second address.
        const response = await fetch(formEndpoint(contactBox.dataset.email!), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: `${nextChoice === 'call' ? 'Call request' : 'New project brief'} ${ref}: ${contact.name}${contact.company ? `, ${contact.company}` : ''}`,
            _cc: contactBox.dataset.cc || undefined,
            _template: 'box',
            _captcha: 'false',
            _honey: field('_honey').value,
            name: contact.name,
            email: contact.email,
            company: contact.company || '—',
            website: contact.website || '—',
            reference: ref,
            estimate: estimateSummary || '—',
            ...(nextChoice === 'call' ? { next_step: callLine() } : {}),
            brief,
            ...sourceFields(),
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || String(data.success) !== 'true') throw new Error(data.message || 'Not sent');
        sent = true;
        sendStatus.dataset.tone = 'ok';
        sendStatus.textContent = nextChoice === 'call'
          ? `Sent. Thanks, ${contact.name.split(' ')[0]}! Grant will email you a few times for a 15-minute call within 1 business day. Your reference is ${ref}.`
          : `Sent. Thanks, ${contact.name.split(' ')[0]}! Grant will reply within 1 business day. Your reference is ${ref}.`;
        submit.textContent = 'Sent ✓';
        return;
      } catch {
        sendStatus.dataset.tone = 'error';
        sendStatus.textContent = 'That didn’t go through. Try again in a moment, or email it instead.';
        contactBox.querySelector<HTMLElement>('.wiz-send-alt')!.hidden = false;
      }
      submit.disabled = false;
      submit.innerHTML = label;
    });

    /* ---------- Saved progress and share links ---------- */
    const STORE = 'estimate-progress-v1';
    const saveProgress = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ answers: effective(), at, furthest, preferred, nextChoice, contact, captured, ref, fromPlan, savedAt: Date.now() })); } catch { /* storage unavailable */ }
    };
    /** Puts saved answers back into the form. */
    const applyAnswers = (saved: Answers) => {
      for (const s of steps) {
        const value = saved[s.id];
        if (value === undefined) continue;
        const el = section(s.id);
        if (s.kind === 'single') el.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = input.value === value; });
        if (s.kind === 'multi') el.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = Array.isArray(value) && value.includes(input.value); });
        if (s.kind === 'range') { const input = el.querySelector<HTMLInputElement>('input')!; input.value = String(value); input.dispatchEvent(new Event('input', { bubbles: true })); }
        if (s.kind === 'text') el.querySelector('textarea')!.value = String(value);
        answers[s.id] = value;
      }
    };
    const encodeShare = (data: Answers) => btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(data)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const decodeShare = (text: string): Answers | null => {
      try { return JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(text.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0)))); } catch { return null; }
    };
    async function copyShareLink(button: HTMLElement) {
      // Answers only: contact details never go into the link.
      const url = `${location.origin}${location.pathname}?brief=${encodeShare(effective())}`;
      const labelNode = button.querySelector('strong') ?? button;
      const label = labelNode.textContent;
      try { await navigator.clipboard.writeText(url); labelNode.textContent = 'Link copied'; }
      catch { window.prompt('Copy this link:', url); }
      window.setTimeout(() => { labelNode.textContent = label; }, 2200);
    }
    share.addEventListener('click', () => void copyShareLink(share));
    wizard.ownerDocument.querySelector('.wiz-reset')?.addEventListener('click', () => {
      try { localStorage.removeItem(STORE); } catch { /* storage unavailable */ }
      form.querySelectorAll<HTMLInputElement>('input[type="radio"], input[type="checkbox"]').forEach((input) => { input.checked = false; });
      form.querySelectorAll('textarea').forEach((t) => { t.value = ''; });
      ['c-name', 'c-email', 'c-company', 'c-website'].forEach((n) => { field(n).value = ''; });
      field('c-nosite').checked = false; syncNoSite();
      answers = {};
      fromPlan = false;
      furthest = 'contact'; preferred = ''; previewRoute = '';
      contact = { name: '', email: '', company: '', website: '' };
      captured = '';
      ref = newRef();
      startNote.textContent = '';
      steps.forEach((s) => { if (s.kind === 'range' && s.range) { const input = section(s.id).querySelector<HTMLInputElement>('input')!; input.value = String(s.range.initial); input.dispatchEvent(new Event('input', { bubbles: true })); } });
      restored.hidden = true;
      history.replaceState(null, '', location.pathname);
      go('contact', -1);
    });
    /** The plan names, by the hours ids the support question uses. */
    const PLAN_NAMES: Record<string, string> = { '20': 'Basic', '40': 'Medium', '80': 'Large', vip: 'VIP' };
    /** A shared link wins; otherwise answers saved on this device. */
    const restore = () => {
      const plan = new URLSearchParams(location.search).get('plan') ?? '';
      if (PLAN_NAMES[plan]) return restorePlan(plan);
      const shared = new URLSearchParams(location.search).get('brief');
      const fromLink = shared ? decodeShare(shared) : null;
      let saved: { answers?: Answers; at?: string; furthest?: string; preferred?: string; nextChoice?: typeof nextChoice; contact?: typeof contact; captured?: string; ref?: string; fromPlan?: boolean } | null = null;
      try { saved = JSON.parse(localStorage.getItem(STORE) || 'null'); } catch { saved = null; }
      // Name and email come back even before any answer, so the first step is already filled in.
      if (saved?.contact) {
        contact = { ...contact, ...saved.contact };
        captured = saved.captured ?? '';
        if (saved.ref && /^EST-\d{8}-[A-Z0-9]{4}$/.test(saved.ref)) ref = saved.ref;
        field('c-name').value = contact.name; field('c-email').value = contact.email; field('c-company').value = contact.company;
        field('c-nosite').checked = contact.website === NO_SITE;
        field('c-website').value = contact.website === NO_SITE ? '' : contact.website;
        syncNoSite();
      }
      const data = fromLink ? { answers: fromLink, at: answered('contact') ? 'review' : 'contact' } : saved;
      if (!data?.answers || !Object.keys(data.answers).length) {
        if (fromLink) { at = 'contact'; lastShownStep = 'contact'; }
        return;
      }
      applyAnswers(data.answers);
      if (!fromLink && saved) { furthest = saved.furthest ?? furthest; preferred = saved.preferred ?? ''; if (saved.nextChoice) nextChoice = saved.nextChoice; fromPlan = saved.fromPlan === true && answers.type === 'support' && Boolean(PLAN_NAMES[String(answers.hours)]); }
      syncOptions();
      const ids = order();
      at = data.at && ids.includes(data.at) ? data.at : ids.find((id) => !answered(id)) ?? 'review';
      // Name and email come first, also for answers saved before that step existed.
      if (!answered('contact')) at = 'contact';
      lastShownStep = at;
      restored.querySelector('span')!.textContent = fromLink ? 'You opened a shared estimate. Change anything you like.' : 'Welcome back: your answers were saved on this device.';
      restored.hidden = false;
    };

    /**
     * Opened from a plan button: start a support estimate with that plan
     * chosen, keep any name and email saved on this device, and bring the
     * name and email into view. The link is tidied so a reload doesn't redo it.
     */
    const restorePlan = (plan: string) => {
      let saved: { contact?: typeof contact; captured?: string; ref?: string } | null = null;
      try { saved = JSON.parse(localStorage.getItem(STORE) || 'null'); } catch { saved = null; }
      if (saved?.contact) {
        contact = { ...contact, ...saved.contact };
        captured = saved.captured ?? '';
        if (saved.ref && /^EST-\d{8}-[A-Z0-9]{4}$/.test(saved.ref)) ref = saved.ref;
        field('c-name').value = contact.name; field('c-email').value = contact.email; field('c-company').value = contact.company;
        field('c-nosite').checked = contact.website === NO_SITE;
        field('c-website').value = contact.website === NO_SITE ? '' : contact.website;
        syncNoSite();
      }
      const supportNotes = supportInquiryNotes(new URLSearchParams(location.search));
      applyAnswers({ type: 'support', hours: plan, ...(supportNotes ? { notes: supportNotes } : {}) });
      syncOptions();
      fromPlan = true;
      at = answered('contact') ? order().find((id) => id !== 'contact' && !answered(id)) ?? 'review' : 'contact';
      lastShownStep = at;
      restored.querySelector('span')!.textContent = at === 'contact'
        ? `You picked the ${PLAN_NAMES[plan]} plan. Add your name and email, then a couple of quick questions.`
        : `You picked the ${PLAN_NAMES[plan]} plan. Just a couple of quick questions.`;
      restored.hidden = false;
      history.replaceState(null, '', location.pathname);
      requestAnimationFrame(() => {
        wizard.querySelector('.wiz-main')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        if (at === 'contact') focusContact();
      });
    };

    // Initial range fill + first render.
    form.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach((el) => el.style.setProperty('--fill', `${((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100}%`));
    steps.forEach((s) => { if (s.kind === 'range') read(s.id); });
    restore();
    render(0);
    if (nextChoice !== 'send') setNext(nextChoice);

    // Phones: a slim bar keeps the estimate in view until the summary is on screen.
    const mobileBar = document.querySelector<HTMLElement>('.estimate-bar');
    if (mobileBar && 'IntersectionObserver' in window) {
      let mainVisible = false;
      let summaryVisible = false;
      const sync = () => mobileBar.classList.toggle('is-visible', mainVisible && !summaryVisible && shown.high > 0);
      new IntersectionObserver(([entry]) => { mainVisible = entry.isIntersecting; sync(); }).observe(wizard.querySelector('.wiz-main')!);
      new IntersectionObserver(([entry]) => { summaryVisible = entry.isIntersecting; sync(); }).observe(summary);
      form.addEventListener('change', sync);
    }
  }
</script>
