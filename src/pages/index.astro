---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Arrow from '../components/Arrow.astro';
import VideoReviews from '../components/VideoReviews.astro';
import { projects } from '../data/projects';
import { experience } from '../data/profile';
const marqueeItems = ['Shopify', 'Webflow', 'WordPress', 'Migrations', 'Technical SEO', 'Integrations'];
const services = [
  { name: 'Shopify development', text: 'Custom themes, Liquid development, ecommerce builds, and integrations that connect your store to the tools you use.', tags: 'Shopify · Shopify Plus · Liquid' },
  { name: 'Webflow development', text: 'Bring your designs to life with responsive Webflow development, CMS-driven pages, and considered interactions.', tags: 'Webflow · Finsweet Client-First · GSAP' },
  { name: 'WordPress development', text: 'Flexible business websites, custom themes, WooCommerce stores, and ongoing website improvements.', tags: 'WordPress · WooCommerce · PHP' },
  { name: 'Migrations & technical SEO', text: 'Platform migrations, third-party integrations, page-speed improvements, and technical search optimization. Not sure where to start? Get a free audit.', tags: 'Migrations · APIs · Technical SEO', href: '/contact/#audit' },
];
---
<BaseLayout loader>
  <div class="wrap">
    <SectionTitle title="PROJECTS" detail="A selection of web development work" id="top-title" />
    <section class="intro-split" aria-label="Introduction">
      <div class="intro-aside is-in" data-reveal="load" style="--reveal-index:0"><h1 class="tiny-heading">Shopify, Webflow & WordPress developer</h1><p>Custom websites & ecommerce<br />Based in the Philippines</p><p class="intro-trust"><strong>4+ years</strong> building Shopify stores at Rivyl<br />Trusted by Rivyl, MDO Digital & Modern Shelving</p></div>
      <div class="intro-copy">
        <p class="lead is-in" data-reveal="load" style="--reveal-index:1">Thoughtful websites. <br />Built to work beautifully.</p>
        <p class="intro-support is-in" data-reveal="load" style="--reveal-index:2">I’m Grant, a web developer turning designs into custom websites and ecommerce experiences for brands and agencies.</p>
        <div class="intro-actions is-in" data-reveal="load" style="--reveal-index:3">
          <a class="cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a>
          <a class="cta-ghost" href="#work">See my work</a>
        </div>
        <a class="intro-quote is-in" href="#reviews" data-reveal="load" style="--reveal-index:4">
          <span class="review-avatar" aria-hidden="true">C</span>
          <span><q>He’s just an absolute weapon when it comes to Shopify.</q><small>Carlos · CEO & Owner, MDO Digital · <u>Watch the video</u></small></span>
        </a>
      </div>
    </section>
    <div class="marquee" aria-hidden="true"><div class="marquee-track">{[0, 1].map(() => <div class="marquee-group">{marqueeItems.map((item) => <><span>{item}</span><i class="marquee-dot"></i></>)}</div>)}</div></div>
    <section aria-label="Selected projects" id="work" class="work-section">
      <div class="work-toolbar" data-reveal><p>Selected work <span>({String(projects.length).padStart(2, '0')})</span></p><div class="project-filters" aria-label="Filter projects" hidden><button class="active" data-filter="All" aria-pressed="true">All</button><button data-filter="Shopify" aria-pressed="false">Shopify</button><button data-filter="Webflow" aria-pressed="false">Webflow</button><button data-filter="WordPress" aria-pressed="false">WordPress</button></div></div>
      <p class="sr-only" id="filter-status" aria-live="polite"></p>
      <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    </section>
    <VideoReviews />
    <section id="services" class="services-section">
      <SectionTitle title="SERVICES" detail="From the first build to what comes next" />
      <div class="intro-split section-intro" data-reveal><div class="intro-aside"><span class="tiny-heading">What I do</span><p>Build, migrate, improve<br />and support websites</p></div><p class="lead" data-lines>Your vision. <br />The right development.</p></div>
      <div class="services-list">{services.map((service, index) => <a class="service-row" data-reveal style={`--reveal-index:${index}`} href={withBase(service.href ?? '/contact/')}><h3>{service.name}</h3><div><p>{service.text}</p><span>{service.tags}</span></div><Arrow diagonal /></a>)}</div>
    </section>
    <section class="experience-section" aria-labelledby="experience-heading">
      <div class="experience-intro" data-reveal><h2 id="experience-heading" data-lines>Good work comes<br />from experience.</h2><a href={withBase('/about/')} class="text-link">The full story <Arrow diagonal /></a></div>
      <div class="experience-list">{experience.map((item, index) => <div class="experience-item" data-reveal style={`--reveal-index:${index}`}><div><h3>{item.company}</h3><p>{item.role}</p></div><span>{item.dates}</span></div>)}</div>
    </section>
    <section class="closing-cta" aria-labelledby="closing-cta-heading">
      <h2 id="closing-cta-heading" data-lines data-reveal>Have a project<br />in mind?</h2>
      <p data-reveal>Not sure what you need yet? Get a realistic timeline in two minutes, or tell me about it directly.</p>
      <div class="closing-cta-actions" data-reveal>
        <a class="closing-cta-primary" href={withBase('/estimate/')}>Get a free estimate <Arrow diagonal /></a>
        <a class="closing-cta-ghost" href={withBase('/contact/')}>Get in touch</a>
      </div>
      <p class="closing-cta-audit" data-reveal>Already have a website? <a href={withBase('/contact/#audit')}>Get a free audit of it <Arrow diagonal /></a></p>
    </section>
  </div>
  <a class="mobile-cta" href={withBase('/estimate/')} aria-hidden="true" tabindex="-1">Get a free estimate <Arrow diagonal /></a>
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>('.project-filters');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const status = document.querySelector('#filter-status');
  if (filters) {
    filters.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.filter;
        filters.querySelectorAll('button').forEach((other) => { other.classList.toggle('active', other === button); other.setAttribute('aria-pressed', String(other === button)); });
        let count = 0;
        cards.forEach((card) => { card.hidden = selected !== 'All' && card.dataset.platform !== selected; if (!card.hidden) count++; });
        if (status) status.textContent = `Showing ${count} ${selected === 'All' ? '' : selected + ' '}projects.`;
      });
    });
  }

  const motionOn = document.documentElement.classList.contains('motion');

  // A gentle parallax on the project devices: the laptop and phone drift a little apart while scrolling.
  const devices = [...document.querySelectorAll<HTMLElement>('.project-devices')];
  if (motionOn && devices.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = innerHeight;
      for (const box of devices) {
        const r = box.getBoundingClientRect();
        if (r.bottom < -100 || r.top > vh + 100) continue;
        const p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - vh / 2) / vh));
        box.style.setProperty('--py', `${(p * 12).toFixed(1)}px`);
      }
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }

  // Phones: a "Get a free estimate" button once the first screen's buttons are out of view, until the
  // closing call to action at the end of the page (the footer sits behind the page, so it can't be the marker).
  const mobileCta = document.querySelector<HTMLElement>('.mobile-cta');
  const heroActions = document.querySelector('.intro-actions');
  const endMarker = document.querySelector('.closing-cta');
  if (mobileCta && heroActions && 'IntersectionObserver' in window) {
    let pastHero = false;
    let atFooter = false;
    const sync = () => {
      const show = pastHero && !atFooter;
      mobileCta.classList.toggle('is-visible', show);
      mobileCta.toggleAttribute('aria-hidden', !show);
      mobileCta.tabIndex = show ? 0 : -1;
    };
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(heroActions);
    if (endMarker) new IntersectionObserver(([e]) => { atFooter = e.isIntersecting || e.boundingClientRect.top < 0; sync(); }).observe(endMarker);
  }
</script>
