---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Arrow from '../../components/Arrow.astro';
import DeviceFrames from '../../components/DeviceFrames.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } })); }
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
---
<BaseLayout title={`${project.name} — ${project.platform} Project | Grant Payad`} description={`${project.name}: a ${project.platform} website in Grant Payad’s selected development portfolio. Explore the project overview and visit the public website.`}>
  <div class="wrap project-page">
    <a class="text-link back-link" href={withBase('/#work')}>← All projects</a>
    <SectionTitle title={project.name.toUpperCase()} detail={project.platform} as="h1" />
    <div class="project-overview"><p class="lead">{project.description}</p><dl><div><dt>Platform</dt><dd>{project.platform}</dd></div><div><dt>Category</dt><dd>{project.category}</dd></div><div><dt>Engagement</dt><dd>{project.engagement}</dd></div>{project.agency && <div><dt>Agency</dt><dd>{project.agency}</dd></div>}</dl></div>
    <div class:list={['project-canvas', 'project-devices', 'detail-canvas', project.canvas]} style={`view-transition-name: project-${project.slug}`}><DeviceFrames project={project} sizes="(max-width: 640px) 66vw, 52vw" phoneSizes="(max-width: 640px) 27vw, 15vw" eager priority /></div>
    <div class="project-footnote"><p>Homepage preview captured October 2026. Live websites may evolve after project delivery.</p><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit live website <Arrow diagonal /></a></div>
    <div class="project-context"><h2>About the project</h2><p>{project.overview}</p></div>
    <a class="next-project" href={withBase(`/work/${next.slug}/`)}><span>Next project</span><strong>{next.name}</strong><Arrow diagonal /></a>
  </div>
</BaseLayout>
