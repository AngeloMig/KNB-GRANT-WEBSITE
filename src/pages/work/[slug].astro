---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Arrow from '../../components/Arrow.astro';
import DeviceFrames from '../../components/DeviceFrames.astro';
import ProjectPhoneModel from '../../components/ProjectPhoneModel.astro';
import { projects, canvasHues } from '../../data/projects';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } })); }
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
const nextImage = (suffix: string) => withBase(`/images/projects/${next.slug}${suffix}.webp`);
---
<BaseLayout title={`${project.name} — ${project.platform} Project | Grant Dev14`} description={`${project.name}: a ${project.platform} website in Grant Dev14’s selected development portfolio. Explore the project overview and visit the public website.`}>
  <div class="wrap project-page">
    <a class="text-link back-link" href={withBase('/#work')}>← All projects</a>
    <SectionTitle title={project.name.toUpperCase()} detail={project.platform} as="h1" hue={canvasHues[project.canvas]} />
    <div class="project-overview"><p class="lead">{project.description}</p><dl><div><dt>Platform</dt><dd>{project.platform}</dd></div><div><dt>Category</dt><dd>{project.category}</dd></div><div><dt>Engagement</dt><dd>{project.engagement}</dd></div>{project.agency && <div><dt>Agency</dt><dd>{project.agency}</dd></div>}</dl></div>
    {/* One device at a time: the laptop, or the phone brought to the middle (the switch needs script). */}
    <div class:list={['project-canvas', 'project-devices', 'detail-canvas', project.canvas]} style={`view-transition-name: project-${project.slug}`} data-mode="desktop">
      <script is:inline>
        // Choose the mobile preview before its markup paints, including arrivals from the hero.
        (() => {
          const root = document.currentScript.parentElement;
          let timeout;
          const settle = (state) => { clearTimeout(timeout); root.dataset.phoneModel = state; root.removeAttribute('aria-busy'); };
          const begin = () => {
            clearTimeout(timeout);
            root.dataset.phoneModel = 'loading'; root.setAttribute('aria-busy', 'true');
            timeout = setTimeout(() => settle('fallback'), 3500);
          };
          root.addEventListener('project-phone-loading', begin);
          root.addEventListener('project-phone-ready', () => settle('ready'));
          root.addEventListener('project-phone-error', () => settle('fallback'));
          if (matchMedia('(max-width: 640px)').matches) { root.dataset.mode = 'phone'; begin(); }
        })();
      </script>
      <DeviceFrames project={project} sizes="(max-width: 640px) 84vw, 70vw" phoneSizes="(max-width: 640px) min(calc(100vw - 80px), 300px), 360px" eager priority />
      <ProjectPhoneModel project={project} index={index} />
      <div class="device-switch" role="group" aria-label="Show the website on"><button type="button" data-mode="desktop" aria-pressed="true">Desktop</button><button type="button" data-mode="phone" aria-pressed="false">Phone</button></div>
    </div>
    <div class="project-footnote"><p>Homepage preview captured November 2026. Live websites may evolve after project delivery.</p><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit live website <Arrow diagonal /></a></div>
    <div class="project-context"><h2>About the project</h2><p>{project.overview}</p></div>
    {/* The next project as a full-width panel in its colour; hovering raises its site into view. */}
    <a class="next-project" href={withBase(`/work/${next.slug}/`)} style={`--next-hue:${canvasHues[next.canvas] ?? 60}`}>
      <span class="next-project-label">Next project</span>
      <strong class="display">{next.name}</strong>
      <span class="next-project-meta">{next.platform} · {next.category}</span>
      <span class="next-project-arrow"><Arrow diagonal /></span>
      <img src={nextImage('-640')} srcset={`${nextImage('-480')} 480w, ${nextImage('-640')} 640w, ${nextImage('-960')} 960w`} sizes="(max-width: 640px) 80vw, 44vw" alt="" width="640" height="360" loading="lazy" decoding="async" />
    </a>
  </div>
  <noscript><style>.device-switch { display: none; }</style></noscript>
</BaseLayout>

<script>
  import { rememberFrom } from '../../scripts/dot-title';
  // The next project's name breaks into the dots that build its title on the next page.
  document.querySelector('.next-project')?.addEventListener('click', (e) => { if (!(e as MouseEvent).metaKey && !(e as MouseEvent).ctrlKey) rememberFrom(document.querySelector('.next-project > strong')!); });
  // Desktop / Phone: the canvas shows one device at a time.
  const canvas = document.querySelector<HTMLElement>('.detail-canvas');
  const toggle = canvas?.querySelector<HTMLElement>('.device-switch');
  if (canvas && toggle) {
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>('button')];
    const setMode = (mode: string) => {
      canvas.dataset.mode = mode;
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
    };
    setMode(canvas.dataset.mode === 'phone' ? 'phone' : 'desktop');
    buttons.forEach(button => button.addEventListener('click', () => setMode(button.dataset.mode!)));
  }
</script>
