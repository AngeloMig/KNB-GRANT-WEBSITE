---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Arrow from '../../components/Arrow.astro';
import DeviceFrames from '../../components/DeviceFrames.astro';
import { projects, canvasHues } from '../../data/projects';
import fullpages from '../../data/project-fullpages.json';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } })); }
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length];
const nextImage = (suffix: string) => withBase(`/images/projects/${next.slug}${suffix}.webp`);
// The full homepage (desktop and phone) for "More of the site", and the colours read from it.
type FullPage = { desktop: Record<string, number>; mobile: Record<string, number>; palette: { hex: string; share: number }[] };
const full = (fullpages as Record<string, FullPage>)[project.slug];
const fullImage = (kind: string, width: number) => withBase(`/images/projects/full/${project.slug}-${kind}-${width}.webp`);
const hostname = new URL(project.url).hostname.replace(/^www\./, '');
// Dark text on light colours, light text on dark ones.
const isLight = (hex: string) => { const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255); return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.55; };
---
<BaseLayout title={`${project.name} — ${project.platform} Project | Grant Dev14`} description={`${project.name}: a ${project.platform} website in Grant Dev14’s selected development portfolio. Explore the project overview and visit the public website.`}>
  <div class="wrap project-page">
    <a class="text-link back-link" href={withBase('/#work')}>← All projects</a>
    <SectionTitle title={project.name.toUpperCase()} detail={project.platform} as="h1" hue={canvasHues[project.canvas]} />
    <div class="project-overview"><p class="lead">{project.description}</p><dl><div><dt>Platform</dt><dd>{project.platform}</dd></div><div><dt>Category</dt><dd>{project.category}</dd></div><div><dt>Engagement</dt><dd>{project.engagement}</dd></div>{project.agency && <div><dt>Agency</dt><dd>{project.agency}</dd></div>}</dl></div>
    {/* One device at a time: the laptop, or the phone screenshot brought to the middle (the switch needs script). */}
    <div class:list={['project-canvas', 'project-devices', 'detail-canvas', project.canvas]} style={`view-transition-name: project-${project.slug}`} data-mode="desktop">
      <script is:inline>
        // Phones open on the phone view, chosen before it paints (including arrivals from the hero).
        if (matchMedia('(max-width: 640px)').matches) document.currentScript.parentElement.dataset.mode = 'phone';
      </script>
      <DeviceFrames project={project} sizes="(max-width: 640px) 84vw, 70vw" phoneSizes="(max-width: 640px) min(calc(100vw - 80px), 300px), 360px" eager priority />
      <div class="device-switch" role="group" aria-label="Show the website on"><button type="button" data-mode="desktop" aria-pressed="true">Desktop</button><button type="button" data-mode="phone" aria-pressed="false">Phone</button></div>
    </div>
    <div class="project-footnote"><p>Homepage preview captured November 2026. Live websites may evolve after project delivery.</p><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit live website <Arrow diagonal /></a></div>
    <div class="project-context"><h2>About the project</h2><p>{project.overview}</p></div>
    {full && (
      <section class="project-more" aria-labelledby="more-title">
        <div class="project-more-head"><h2 id="more-title">More of the site</h2><p>The whole homepage, top to bottom. Scroll inside either screen.</p></div>
        <div class="project-more-grid">
          <figure class="more-desktop">
            <div class="more-browser" data-more-frame>
              <div class="more-toolbar" aria-hidden="true"><i></i><i></i><i></i><span>{hostname}</span></div>
              <div class="more-scroll" tabindex="0" role="region" aria-label={`${project.name} full homepage on desktop. Scroll to see more.`}>
                <img data-src={fullImage('desktop', 1100)} data-srcset={`${fullImage('desktop', 720)} 720w, ${fullImage('desktop', 1100)} 1100w`} sizes="(max-width: 900px) 92vw, 62vw" width="1100" height={full.desktop['1100']} alt={`${project.name} full homepage on desktop`} decoding="async" />
                <noscript><img src={fullImage('desktop', 1100)} width="1100" height={full.desktop['1100']} alt="" /></noscript>
              </div>
              <span class="more-hint" aria-hidden="true">Scroll ↓</span>
              <span class="more-progress" aria-hidden="true"><i></i></span>
            </div>
            <figcaption>Desktop</figcaption>
          </figure>
          <figure class="more-phone">
            <div class="more-handset" data-more-frame>
              <span class="more-island" aria-hidden="true"></span>
              <div class="more-scroll" tabindex="0" role="region" aria-label={`${project.name} full homepage on a phone. Scroll to see more.`}>
                <img data-src={fullImage('mobile', 600)} width="600" height={full.mobile['600']} alt={`${project.name} full homepage on a phone`} decoding="async" />
                <noscript><img src={fullImage('mobile', 600)} width="600" height={full.mobile['600']} alt="" /></noscript>
              </div>
              <span class="more-hint" aria-hidden="true">Scroll ↓</span>
              <span class="more-progress" aria-hidden="true"><i></i></span>
            </div>
            <figcaption>Phone</figcaption>
          </figure>
        </div>
      </section>
    )}
    {full && full.palette.length > 0 && (
      <section class="project-palette" aria-labelledby="palette-title">
        <div class="project-more-head"><h2 id="palette-title">Colours</h2><p>The main colours on the {project.name} homepage, sized by how much of the page they cover. Tap one to copy it.</p></div>
        <div class="palette-strip">{full.palette.map((c, i) => (
          <button type="button" class:list={['palette-chip', { light: isLight(c.hex) }]} style={`--c:${c.hex};--grow:${Math.max(0.07, c.share).toFixed(3)};--i:${i}`} data-hex={c.hex.toUpperCase()} aria-label={`Copy colour ${c.hex.toUpperCase()}`}>
            <span class="palette-hex">{c.hex.toUpperCase()}</span>
            <span class="palette-share">{c.share < 0.01 ? '<1' : Math.round(c.share * 100)}%</span>
            <span class="palette-copied" aria-hidden="true">Copied</span>
          </button>
        ))}</div>
        <p class="sr-only palette-status" aria-live="polite"></p>
      </section>
    )}
    {/* The next project as a full-width panel in its colour; hovering raises its site into view. */}
    <a class="next-project" href={withBase(`/work/${next.slug}/`)} style={`--next-hue:${canvasHues[next.canvas] ?? 60}`}>
      <span class="next-project-label">Next project</span>
      <strong class="display">{next.name}</strong>
      <span class="next-project-meta">{next.platform} · {next.category}</span>
      <span class="next-project-arrow"><Arrow diagonal /></span>
      <img src={nextImage('-640')} srcset={`${nextImage('-480')} 480w, ${nextImage('-640')} 640w, ${nextImage('-960')} 960w`} sizes="(max-width: 640px) 80vw, 44vw" alt="" width="640" height="360" loading="lazy" decoding="async" />
    </a>
  </div>
  {/* Once the page title has scrolled away, a slim bar keeps the project, its live site and the next step in reach. */}
  <div class="project-bar" data-project-bar>
    <a class="project-bar-name" href={project.url} target="_blank" rel="noopener noreferrer"><strong>{project.name}</strong><span>{project.platform} · Visit site <Arrow diagonal /></span></a>
    <a class="project-bar-cta" href={withBase('/contact/')}>Want one like this? <Arrow diagonal /></a>
  </div>
  <noscript><style>.device-switch, .more-scroll img[data-src], .more-hint { display: none; }</style></noscript>
</BaseLayout>

<script>
  import { rememberFrom } from '../../scripts/dot-title';
  // The next project's name breaks into the dots that build its title on the next page.
  document.querySelector('.next-project')?.addEventListener('click', (e) => { if (!(e as MouseEvent).metaKey && !(e as MouseEvent).ctrlKey) rememberFrom(document.querySelector('.next-project > strong')!); });
  // "More of the site": the tall screenshots (several hundred KB) load only once the gallery is close,
  // so they never compete with the top of the page.
  const morePanel = document.querySelector<HTMLElement>('.project-more');
  if (morePanel) {
    const near = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      near.disconnect();
      morePanel.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        img.src = img.dataset.src!;
      });
    }, { rootMargin: '400px 0px' });
    near.observe(morePanel);
  }
  // Each screen shows how far down it is, and its hint goes once it has been scrolled.
  document.querySelectorAll<HTMLElement>('[data-more-frame]').forEach((frame) => {
    const box = frame.querySelector<HTMLElement>('.more-scroll')!;
    let queued = false;
    const update = () => {
      queued = false;
      const max = box.scrollHeight - box.clientHeight;
      frame.style.setProperty('--p', max > 0 ? (box.scrollTop / max).toFixed(3) : '0');
      if (box.scrollTop > 8) frame.classList.add('was-scrolled');
    };
    box.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  });

  // Colours: the strip rises in, one colour after another, when it comes into view; tap a colour to copy its code.
  const paletteSection = document.querySelector<HTMLElement>('.project-palette');
  if (paletteSection) {
    const seen = new IntersectionObserver(([e]) => { if (e.isIntersecting) { paletteSection.classList.add('is-in'); seen.disconnect(); } }, { threshold: 0.25 });
    seen.observe(paletteSection);
  }
  const paletteStatus = document.querySelector('.palette-status');
  document.querySelectorAll<HTMLButtonElement>('.palette-chip').forEach((chip) => chip.addEventListener('click', async () => {
    const hex = chip.dataset.hex!;
    try { await navigator.clipboard.writeText(hex); } catch { return; }
    chip.classList.remove('is-copied'); void chip.offsetWidth; chip.classList.add('is-copied');
    if (paletteStatus) paletteStatus.textContent = `Copied ${hex}.`;
    setTimeout(() => chip.classList.remove('is-copied'), 1400);
  }));

  // The project bar: shown once the title is off screen, put away again at the "Next project" panel.
  const bar = document.querySelector<HTMLElement>('[data-project-bar]');
  const title = document.querySelector<HTMLElement>('.project-page .section-title');
  const nextPanel = document.querySelector<HTMLElement>('.next-project');
  if (bar && title && nextPanel) {
    let pastTitle = false, atNext = false;
    const show = () => bar.classList.toggle('is-shown', pastTitle && !atNext);
    new IntersectionObserver(([e]) => { pastTitle = !e.isIntersecting && e.boundingClientRect.top < 0; show(); }).observe(title);
    new IntersectionObserver(([e]) => { atNext = e.isIntersecting; show(); }, { rootMargin: '0px 0px -30% 0px' }).observe(nextPanel);
  }

  // Desktop / Phone: the canvas shows one device at a time.
  const canvas = document.querySelector<HTMLElement>('.detail-canvas');
  const toggle = canvas?.querySelector<HTMLElement>('.device-switch');
  if (canvas && toggle) {
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>('button')];
    const setMode = (mode: string) => {
      canvas.dataset.mode = mode;
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
    };
    setMode(canvas.dataset.mode === 'phone' ? 'phone' : 'desktop');
    buttons.forEach(button => button.addEventListener('click', () => setMode(button.dataset.mode!)));
  }
</script>
