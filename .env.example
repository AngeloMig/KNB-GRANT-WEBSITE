PUBLIC_SITE_URL=https://grant-payad-portfolio.infinite-mod-9611.chatgpt.site

# Password for the private quote builder (/quote/). Pick a long one; never commit the real .env.
QUOTE_PASSWORD=

# The KNB Attendance Tracker (optional). Forms post leads to its Inquiries inbox; the quote builder can sync quotes,
# invoices and PDFs into it after you sign in with your tracker account. The anon key is public by design (the tracker's
# access rules protect the data) — never put the service role key here.
PUBLIC_LEADS_ENDPOINT=https://knb-attendance-tracker.vercel.app/api/leads
PUBLIC_TRACKER_SUPABASE_URL=
PUBLIC_TRACKER_SUPABASE_ANON_KEY=
